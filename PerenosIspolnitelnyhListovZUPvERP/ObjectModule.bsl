////////////////////////////////////////////////////////////////////////////////
// Модуль объекта внешней обработки
// «Перенос исполнительных листов ЗУП -> ERP»
//
// Отбор документов: регистр сведений ПлановыеУдержания,
// СрезПоследних на дату переноса, Действует = Истина,
// основание (Документ) типа Документ.ИсполнительныйЛист.
//
// Работает в обеих базах: в ЗУП — выгрузка, в ERP — загрузка.
// АДАПТАЦИЯ: имена «плавающих» реквизитов, меняющиеся между релизами,
// собраны в функции ПрочитатьРеквизитыИсполнительногоЛиста() и отмечены
// комментарием // АДАПТАЦИЯ:.
////////////////////////////////////////////////////////////////////////////////

#Область ПодключениеБСП

// Стандартная функция для подсистемы ДополнительныеОтчетыИОбработки.
// Позволяет подключить обработку без изменения конфигурации.
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Перенос исполнительных листов ЗУП -> ERP");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Перенос документов ИсполнительныйЛист из ЗУП в ERP. "
		+ "Отбор по регистру сведений ПлановыеУдержания, действующие на дату переноса.");

	ТаблицаНазначений = Новый Массив;
	ТаблицаНазначений.Добавить("Документ.ИсполнительныйЛист");
	ПараметрыРегистрации.Вставить("Назначение", ТаблицаНазначений);

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	СтрокаКоманды = Команды.Добавить();
	СтрокаКоманды.Представление = "Перенос исполнительных листов (ЗУП -> ERP)";
	СтрокаКоманды.Идентификатор = "ОткрытьФормуПереноса";
	СтрокаКоманды.Использование = "ОткрытиеФормы";
	СтрокаКоманды.ПоказыватьОповещение = Ложь;
	СтрокаКоманды.Модификатор = "";

	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОтборПоРегистру

// Возвращает таблицу действующих на дату переноса исполнительных листов.
// Источник: срез регистра сведений ПлановыеУдержания.
// Колонки результата один в один соответствуют реквизиту формы НайденныеДокументы.
//
// Параметры:
//   ДатаПереноса       - Дата - действующие на конец этого дня попадают в результат.
//   Организация       - СправочникСсылка.Организации, Неопределено - отбор (пусто = все).
//   ТолькоПроведенные - Булево - исключить непроведенные документы.
//
Функция ДействующиеИсполнительныеЛисты(ДатаПереноса, Организация = Неопределено,
		ТолькоПроведенные = Истина) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Переносить", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("ГУИД", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Сотрудник");
	Результат.Колонки.Добавить("ФизическоеЛицо");
	Результат.Колонки.Добавить("Получатель");
	Результат.Колонки.Добавить("ПолучательПредставление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ВидУдержания");
	Результат.Колонки.Добавить("Размер", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));

	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ВызватьИсключение "Не указана дата переноса.";
	КонецЕсли;

	// Граница среза — конец дня даты переноса.
	ГраницаСреза = КонецДня(ДатаПереноса);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Срез.Документ КАК Документ,
	|	Срез.Организация КАК ОрганизацияСреза,
	|	Срез.Сотрудник КАК СотрудникСреза,
	|	Срез.Удержание КАК ВидУдержанияСреза,
	|	Срез.Размер КАК РазмерСреза,
	|	Срез.Получатель КАК ПолучательСреза,
	|	Срез.Действует КАК Действует
	|ПОМЕСТИТЬ ВТСрез
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(
	|			&ГраницаСреза,
	|			Документ ССЫЛКА Документ.ИсполнительныйЛист
	|			И Действует = ИСТИНА
	|			И &УсловиеПоОрганизации) КАК Срез
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСрез.Документ КАК Документ,
	|	ИспЛист.Номер КАК Номер,
	|	ИспЛист.Дата КАК ДатаДокумента,
	|	ИспЛист.Организация КАК Организация,
	|	ИспЛист.Сотрудник КАК Сотрудник,
	|	ИспЛист.Проведен КАК Проведен,
	|	ВТСрез.ВидУдержанияСреза КАК ВидУдержания,
	|	ВТСрез.РазмерСреза КАК Размер,
	|	ВТСрез.ПолучательСреза КАК Получатель
	|ИЗ
	|	ВТСрез КАК ВТСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК ИспЛист
	|		ПО ВТСрез.Документ = ИспЛист.Ссылка
	|ГДЕ
	|	НЕ ИспЛист.ПометкаУдаления
	|	И &УсловиеПоПроведенным";

	// Условия подставляем в текст, т.к. в параметрах среза нельзя передать
	// «пустую» организацию без разветвления запроса.
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОрганизации",
			"Организация = &Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОрганизации", "ИСТИНА");
	КонецЕсли;

	Если ТолькоПроведенные Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПроведенным",
			"ИспЛист.Проведен = ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПроведенным", "ИСТИНА");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ГраницаСреза", ГраницаСреза);
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Переносить   = Истина;
		НоваяСтрока.Документ     = Выборка.Документ;
		НоваяСтрока.Номер        = Выборка.Номер;
		НоваяСтрока.ДатаДокумента = Выборка.ДатаДокумента;
		НоваяСтрока.Организация  = Выборка.Организация;
		НоваяСтрока.Сотрудник    = Выборка.Сотрудник;
		НоваяСтрока.ВидУдержания = Выборка.ВидУдержания;
		НоваяСтрока.Размер       = Выборка.Размер;
		НоваяСтрока.Получатель   = Выборка.Получатель;
		НоваяСтрока.Проведен     = Выборка.Проведен;

		Попытка
			НоваяСтрока.ГУИД = Строка(Выборка.Документ.УникальныйИдентификатор());
		Исключение
			НоваяСтрока.ГУИД = "";
		КонецПопытки;

		// Реквизиты, чьи имена «плавают» между релизами, дочитываем отдельно.
		ДопРеквизиты = ПрочитатьРеквизитыИсполнительногоЛиста(Выборка.Документ);
		НоваяСтрока.ФизическоеЛицо = ДопРеквизиты.ФизическоеЛицо;
		НоваяСтрока.ДатаНачала     = ДопРеквизиты.ДатаНачала;
		НоваяСтрока.ДатаОкончания  = ДопРеквизиты.ДатаОкончания;
		Если Не ЗначениеЗаполнено(НоваяСтрока.Получатель) Тогда
			НоваяСтрока.Получатель = ДопРеквизиты.Получатель;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.Размер) Тогда
			НоваяСтрока.Размер = ДопРеквизиты.Размер;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.ВидУдержания) Тогда
			НоваяСтрока.ВидУдержания = ДопРеквизиты.ВидУдержания;
		КонецЕсли;

		Если ЗначениеЗаполнено(НоваяСтрока.Получатель) Тогда
			НоваяСтрока.ПолучательПредставление = Строка(НоваяСтрока.Получатель);
		Иначе
			НоваяСтрока.ПолучательПредставление = "";
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Дочитывает реквизиты документа, имена которых различаются между релизами.
// Возвращает структуру: ФизическоеЛицо, Получатель, ВидУдержания, Размер,
// ДатаНачала, ДатаОкончания, ОснованиеНомер, ОснованиеДата.
//
Функция ПрочитатьРеквизитыИсполнительногоЛиста(ДокументСсылка) Экспорт

	Пустышка = Новый Структура;
	Пустышка.Вставить("ФизическоеЛицо", Неопределено);
	Пустышка.Вставить("Получатель", Неопределено);
	Пустышка.Вставить("ВидУдержания", Неопределено);
	Пустышка.Вставить("Размер", 0);
	Пустышка.Вставить("ДатаНачала", Дата(1, 1, 1));
	Пустышка.Вставить("ДатаОкончания", Дата(1, 1, 1));
	Пустышка.Вставить("ОснованиеНомер", "");
	Пустышка.Вставить("ОснованиеДата", Дата(1, 1, 1));

	МетаДок = Метаданные.Документы.ИсполнительныйЛист;

	// АДАПТАЦИЯ: если в вашем релизе поле называется иначе
	// (например ДатаС вместо ДатаНачала) — допишите имя в соответствующий массив.
	ИменаФизЛица      = Новый Массив;
	ИменаФизЛица.Добавить("ФизическоеЛицо");
	ИменаФизЛица.Добавить("ФизЛицо");

	ИменаПолучателя   = Новый Массив;
	ИменаПолучателя.Добавить("Получатель");
	ИменаПолучателя.Добавить("ПолучательПлатежа");
	ИменаПолучателя.Добавить("Контрагент");

	ИменаВидаУдержания = Новый Массив;
	ИменаВидаУдержания.Добавить("Удержание");
	ИменаВидаУдержания.Добавить("ВидУдержания");
	ИменаВидаУдержания.Добавить("ВидРасчета");

	ИменаРазмера = Новый Массив;
	ИменаРазмера.Добавить("Размер");
	ИменаРазмера.Добавить("ПроцентУдержания");
	ИменаРазмера.Добавить("СуммаУдержания");

	ИменаНачала = Новый Массив;
	ИменаНачала.Добавить("ДатаНачала");
	ИменаНачала.Добавить("ДатаС");
	ИменаНачала.Добавить("ПериодС");
	ИменаНачала.Добавить("ДатаДействияС");

	ИменаОкончания = Новый Массив;
	ИменаОкончания.Добавить("ДатаОкончания");
	ИменаОкончания.Добавить("ДатаПо");
	ИменаОкончания.Добавить("ПериодПо");
	ИменаОкончания.Добавить("ДатаДействияПо");

	ИменаНомераОснования = Новый Массив;
	ИменаНомераОснования.Добавить("НомерИсполнительногоДокумента");
	ИменаНомераОснования.Добавить("НомерДокументаОснования");
	ИменаНомераОснования.Добавить("НомерИсполнительногоЛиста");

	ИменаДатыОснования = Новый Массив;
	ИменаДатыОснования.Добавить("ДатаИсполнительногоДокумента");
	ИменаДатыОснования.Добавить("ДатаДокументаОснования");

	ТекстПолей = "Ссылка";
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаФизЛица);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаПолучателя);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаВидаУдержания);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаРазмера);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаНачала);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаОкончания);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаНомераОснования);
	ДобавитьПоляПоИменам(ТекстПолей, МетаДок, ИменаДатыОснования);

	ТекстЗапроса = "ВЫБРАТЬ " + ТекстПолей + " ИЗ Документ.ИсполнительныйЛист КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Пустышка;
	КонецЕсли;

	Пустышка.ФизическоеЛицо = ПервоеЗаполненноеПоле(Выборка, ИменаФизЛица);
	Пустышка.Получатель     = ПервоеЗаполненноеПоле(Выборка, ИменаПолучателя);
	Пустышка.ВидУдержания   = ПервоеЗаполненноеПоле(Выборка, ИменаВидаУдержания);
	Пустышка.Размер         = ПервоеЗаполненноеПоле(Выборка, ИменаРазмера, 0);
	Пустышка.ДатаНачала     = ПервоеЗаполненноеПоле(Выборка, ИменаНачала, Дата(1, 1, 1));
	Пустышка.ДатаОкончания  = ПервоеЗаполненноеПоле(Выборка, ИменаОкончания, Дата(1, 1, 1));
	Пустышка.ОснованиеНомер = Строка(ПервоеЗаполненноеПоле(Выборка, ИменаНомераОснования, ""));
	Пустышка.ОснованиеДата  = ПервоеЗаполненноеПоле(Выборка, ИменаДатыОснования, Дата(1, 1, 1));

	Возврат Пустышка;

КонецФункции

Процедура ДобавитьПоляПоИменам(ТекстПолей, МетаДок, Имена)

	Для Каждого Имя Из Имена Цикл
		Если МетаДок.Реквизиты.Найти(Имя) <> Неопределено Тогда
			ТекстПолей = ТекстПолей + "," + Символы.ПС + "	Т." + Имя + " КАК " + Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПервоеЗаполненноеПоле(Выборка, Имена, ЗначениеПоУмолчанию = Неопределено)

	Для Каждого Имя Из Имена Цикл
		Попытка
			Значение = Выборка[Имя];
		Исключение
			Продолжить;
		КонецПопытки;
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти

#Область Выгрузка

// Выгружает действующие исполнительные листы в JSON-файл.
//
// Параметры:
//   ДатаПереноса       - Дата.
//   Организация       - ссылка или Неопределено.
//   ПутьКФайлу        - Строка, куда записать JSON.
//   ТолькоПроведенные - Булево.
//   ОтмеченныеГУИДы   - Массив строк ГУИД (выгрузить только их) или Неопределено.
//
// Возвращает структуру: Успех, Выгружено, Путь, ТекстОшибки.
//
Функция ВыгрузитьВФайл(ДатаПереноса, Организация, ПутьКФайлу,
		ТолькоПроведенные = Истина, ОтмеченныеГУИДы = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Выгружено, Путь, ТекстОшибки", Ложь, 0, ПутьКФайлу, "");

	Попытка
		Таблица = ДействующиеИсполнительныеЛисты(ДатаПереноса, Организация, ТолькоПроведенные);

		МассивДокументов = Новый Массив;
		Для Каждого СтрокаТЗ Из Таблица Цикл
			Если ОтмеченныеГУИДы <> Неопределено
				И ОтмеченныеГУИДы.Найти(СтрокаТЗ.ГУИД) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МассивДокументов.Добавить(СтрокуТЗВСтруктуруОбмена(СтрокаТЗ));
		КонецЦикла;

		Корень = Новый Структура;
		Корень.Вставить("ВерсияФормата", "1.0");
		Корень.Вставить("Источник", "ЗУП");
		Корень.Вставить("ДатаВыгрузки", ТекущаяДатаСеанса());
		Корень.Вставить("ДатаПереноса", ДатаПереноса);
		Если ЗначениеЗаполнено(Организация) Тогда
			Корень.Вставить("ОрганизацияГУИД", Строка(Организация.УникальныйИдентификатор()));
			Корень.Вставить("ОрганизацияИНН", СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ИНН")));
		КонецЕсли;
		Корень.Вставить("Документы", МассивДокументов);

		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(ПутьКФайлу, , , ПараметрыЗаписи);
		ЗаписатьJSON(Запись, Корень);
		Запись.Закрыть();

		Результат.Успех = Истина;
		Результат.Выгружено = МассивДокументов.Количество();
	Исключение
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сериализует строку таблицы отбора в структуру для JSON.
// Ссылки дублируются парой ГУИД + человекочитаемые ключи.
Функция СтрокуТЗВСтруктуруОбмена(СтрокаТЗ) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("ГУИД", СтрокаТЗ.ГУИД);
	Данные.Вставить("Номер", Строка(СтрокаТЗ.Номер));
	Данные.Вставить("Дата", СтрокаТЗ.ДатаДокумента);
	Данные.Вставить("Проведен", СтрокаТЗ.Проведен);
	Данные.Вставить("ДатаНачала", СтрокаТЗ.ДатаНачала);
	Данные.Вставить("ДатаОкончания", СтрокаТЗ.ДатаОкончания);
	Данные.Вставить("Размер", СтрокаТЗ.Размер);

	// Организация.
	Данные.Вставить("ОрганизацияГУИД", ГУИДСсылки(СтрокаТЗ.Организация));
	Данные.Вставить("ОрганизацияИНН", РеквизитБезопасно(СтрокаТЗ.Организация, "ИНН"));
	Данные.Вставить("ОрганизацияКПП", РеквизитБезопасно(СтрокаТЗ.Организация, "КПП"));
	Данные.Вставить("ОрганизацияНаименование", Строка(СтрокаТЗ.Организация));

	// Сотрудник и физлицо.
	Данные.Вставить("СотрудникГУИД", ГУИДСсылки(СтрокаТЗ.Сотрудник));
	Данные.Вставить("СотрудникНаименование", Строка(СтрокаТЗ.Сотрудник));
	Данные.Вставить("ФизическоеЛицоГУИД", ГУИДСсылки(СтрокаТЗ.ФизическоеЛицо));
	ФизЛицоПоля = ПоляФизЛица(СтрокаТЗ.ФизическоеЛицо);
	Данные.Вставить("ФизЛицоФИО", ФизЛицоПоля.ФИО);
	Данные.Вставить("ФизЛицоДатаРождения", ФизЛицоПоля.ДатаРождения);
	Данные.Вставить("ФизЛицоИНН", ФизЛицоПоля.ИНН);

	// Получатель (контрагент или физлицо — определяем по типу).
	Данные.Вставить("ПолучательПредставление", СтрокаТЗ.ПолучательПредставление);
	Данные.Вставить("ПолучательГУИД", ГУИДСсылки(СтрокаТЗ.Получатель));
	Данные.Вставить("ПолучательТип", Строка(ТипЗнч(СтрокаТЗ.Получатель)));
	Данные.Вставить("ПолучательИНН", РеквизитБезопасно(СтрокаТЗ.Получатель, "ИНН"));

	// Вид удержания.
	Данные.Вставить("ВидУдержанияГУИД", ГУИДСсылки(СтрокаТЗ.ВидУдержания));
	Данные.Вставить("ВидУдержанияКод", РеквизитБезопасно(СтрокаТЗ.ВидУдержания, "Код"));
	Данные.Вставить("ВидУдержанияНаименование", Строка(СтрокаТЗ.ВидУдержания));

	// Основание исполнительного документа.
	Доп = ПрочитатьРеквизитыИсполнительногоЛиста(СтрокаТЗ.Документ);
	Данные.Вставить("ОснованиеНомер", Доп.ОснованиеНомер);
	Данные.Вставить("ОснованиеДата", Доп.ОснованиеДата);

	Возврат Данные;

КонецФункции

Функция ГУИДСсылки(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция РеквизитБезопасно(Ссылка, ИмяРеквизита)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ПоляФизЛица(ФизЛицо)

	Поля = Новый Структура("ФИО, ДатаРождения, ИНН", "", Дата(1, 1, 1), "");
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат Поля;
	КонецЕсли;
	Поля.ФИО = Строка(ФизЛицо);
	Попытка
		Поля.ДатаРождения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо, "ДатаРождения");
	Исключение
	КонецПопытки;
	Попытка
		Поля.ИНН = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо, "ИНН"));
	Исключение
	КонецПопытки;
	Возврат Поля;

КонецФункции

#КонецОбласти

#Область Загрузка

// Загружает JSON-файл обмена в текущую базу (ERP).
// Создаёт документы с тем же ГУИДом, что в ЗУП, — дубли исключены.
//
// Возвращает структуру: Успех, Создано, Обновлено, Пропущено, Ошибок, Протокол (Массив строк).
//
Функция ЗагрузитьИзФайла(ПутьКФайлу, ОбновлятьСуществующие = Истина,
		ПроводитьДокументы = Истина) Экспорт

	Итог = Новый Структура("Успех, Создано, Обновлено, Пропущено, Ошибок, Протокол",
		Ложь, 0, 0, 0, 0, Новый Массив);

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьКФайлу);
		// Истина = соответствия вместо структур, чтобы пережить лишний/недостающий состав полей.
		Корень = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Итог.Протокол.Добавить("ОШИБКА: не удалось прочитать файл: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	Документы = ЗначениеПоля(Корень, "Документы");
	Если Документы = Неопределено Тогда
		Итог.Протокол.Добавить("ОШИБКА: в файле нет массива ""Документы"".");
		Возврат Итог;
	КонецЕсли;

	Для Каждого Данные Из Документы Цикл
		Попытка
			Статус = СоздатьИлиОбновитьИсполнительныйЛист(Данные,
				ОбновлятьСуществующие, ПроводитьДокументы);
			Если Статус = "Создан" Тогда
				Итог.Создано = Итог.Создано + 1;
				Итог.Протокол.Добавить("OK: создан " + ПредставлениеДокументаОбмена(Данные));
			ИначеЕсли Статус = "Обновлен" Тогда
				Итог.Обновлено = Итог.Обновлено + 1;
				Итог.Протокол.Добавить("OK: обновлен " + ПредставлениеДокументаОбмена(Данные));
			Иначе
				Итог.Пропущено = Итог.Пропущено + 1;
				Итог.Протокол.Добавить("ПРОПУЩЕН (уже существует): "
					+ ПредставлениеДокументаОбмена(Данные));
			КонецЕсли;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			Итог.Протокол.Добавить("ОШИБКА [" + ПредставлениеДокументаОбмена(Данные) + "]: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Итог.Успех = (Итог.Ошибок = 0);
	Возврат Итог;

КонецФункции

Функция ПредставлениеДокументаОбмена(Данные)

	Возврат "ИЛ №" + Строка(ЗначениеПоля(Данные, "Номер", "?"))
		+ " от " + Формат(ПривестиКДате(ЗначениеПоля(Данные, "Дата"), ТекущаяДатаСеанса()), "ДФ=dd.MM.yyyy")
		+ " (" + Строка(ЗначениеПоля(Данные, "ФизЛицоФИО", ""))
		+ ", ГУИД " + Строка(ЗначениеПоля(Данные, "ГУИД", "")) + ")";

КонецФункции

// Ключевая процедура загрузки: сопоставление НСИ + создание/обновление документа.
Функция СоздатьИлиОбновитьИсполнительныйЛист(Данные, ОбновлятьСуществующие, ПроводитьДокументы)

	ГУИДстр = СокрЛП(Строка(ЗначениеПоля(Данные, "ГУИД", "")));
	Если ПустаяСтрока(ГУИДстр) Тогда
		ВызватьИсключение "Пустой ГУИД документа в файле обмена.";
	КонецЕсли;

	СуществующаяСсылка = НайтиДокументПоГУИДу(ГУИДстр);
	Если СуществующаяСсылка <> Неопределено И Не ОбновлятьСуществующие Тогда
		Возврат "Пропущен";
	КонецЕсли;

	Организация    = НайтиОрганизацию(Данные);
	ФизическоеЛицо = НайтиФизическоеЛицо(Данные);
	Сотрудник      = НайтиСотрудника(Данные, Организация, ФизическоеЛицо);
	Получатель     = НайтиПолучателя(Данные);
	ВидУдержания   = НайтиВидУдержания(Данные);

	Если СуществующаяСсылка <> Неопределено Тогда
		ДокОбъект = СуществующаяСсылка.ПолучитьОбъект();
		ЭтоНовый = Ложь;
	Иначе
		ДокОбъект = Документы.ИсполнительныйЛист.СоздатьДокумент();
		ДокОбъект.УстановитьСсылкуНового(Новый УникальныйИдентификатор(ГУИДстр));
		ЭтоНовый = Истина;
	КонецЕсли;

	МетаДок = Метаданные.Документы.ИсполнительныйЛист;
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "Организация", Организация);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "Сотрудник", Сотрудник);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ФизическоеЛицо", ФизическоеЛицо);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ФизЛицо", ФизическоеЛицо);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "Получатель", Получатель);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ПолучательПлатежа", Получатель);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "Удержание", ВидУдержания);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ВидУдержания", ВидУдержания);
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "Размер", ЗначениеПоля(Данные, "Размер", 0));
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ДатаНачала", ПривестиКДате(ЗначениеПоля(Данные, "ДатаНачала")));
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ДатаС", ПривестиКДате(ЗначениеПоля(Данные, "ДатаНачала")));
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ДатаОкончания", ПривестиКДате(ЗначениеПоля(Данные, "ДатаОкончания")));
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ДатаПо", ПривестиКДате(ЗначениеПоля(Данные, "ДатаОкончания")));
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "НомерИсполнительногоДокумента",
		ЗначениеПоля(Данные, "ОснованиеНомер", ""));
	УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, "ДатаИсполнительногоДокумента",
		ПривестиКДате(ЗначениеПоля(Данные, "ОснованиеДата")));

	ДокОбъект.Дата = ПривестиКДате(ЗначениеПоля(Данные, "Дата"), ТекущаяДатаСеанса());
	Если ЗначениеЗаполнено(ЗначениеПоля(Данные, "Номер", "")) Тогда
		Попытка
			ДокОбъект.Номер = СокрЛП(Строка(ЗначениеПоля(Данные, "Номер", "")));
		Исключение
			// Номер может быть недоступен для записи — не критично.
		КонецПопытки;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Если ПроводитьДокументы Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Если проведение не удалось — пишем черновиком, чтобы данные не потерять.
		Если ПроводитьДокументы Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			ВызватьИсключение "Провести не удалось, записан черновиком: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;

	Если ЭтоНовый Тогда
		Возврат "Создан";
	Иначе
		Возврат "Обновлен";
	КонецЕсли;

КонецФункции

Процедура УстановитьРеквизитЕслиЕсть(ДокОбъект, МетаДок, ИмяРеквизита, Значение)

	Если МетаДок.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект[ИмяРеквизита] = Значение;

КонецПроцедуры

Функция ЗначениеПоля(Данные, Имя, ЗначениеПоУмолчанию = Неопределено)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

// JSON-чтение может вернуть дату строкой (зависит от формата записи).
// Приводит значение к Дате, не бросая исключений.
Функция ПривестиКДате(Значение, ЗначениеПоУмолчанию = Неопределено)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Значение)) Тогда
		Попытка
			Возврат XMLЗначение(Тип("Дата"), СокрЛП(Значение));
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если ЗначениеПоУмолчанию = Неопределено Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция НайтиДокументПоГУИДу(ГУИДстр)

	Попытка
		ГУИД = Новый УникальныйИдентификатор(ГУИДстр);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Ссылка = Документы.ИсполнительныйЛист.ПолучитьСсылку(ГУИД);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ.ИсполнительныйЛист ГДЕ Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

Функция НайтиОрганизацию(Данные)

	ГУИДстр = СокрЛП(Строка(ЗначениеПоля(Данные, "ОрганизацияГУИД", "")));
	Если Не ПустаяСтрока(ГУИДстр) Тогда
		Попытка
			Ссылка = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДстр));
			Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование")) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	ИНН = СокрЛП(Строка(ЗначениеПоля(Данные, "ОрганизацияИНН", "")));
	КПП = СокрЛП(Строка(ЗначениеПоля(Данные, "ОрганизацияКПП", "")));
	Если Не ПустаяСтрока(ИНН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	ВызватьИсключение "Организация не найдена (ГУИД=" + ГУИДстр + ", ИНН=" + ИНН + ", КПП=" + КПП + ").";

КонецФункции

Функция НайтиФизическоеЛицо(Данные)

	ГУИДстр = СокрЛП(Строка(ЗначениеПоля(Данные, "ФизическоеЛицоГУИД", "")));
	Если Не ПустаяСтрока(ГУИДстр) Тогда
		Попытка
			Ссылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДстр));
			Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование")) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	ФИО = СокрЛП(Строка(ЗначениеПоля(Данные, "ФизЛицоФИО", "")));
	ДатаРождения = ПривестиКДате(ЗначениеПоля(Данные, "ФизЛицоДатаРождения"));
	ИНН = СокрЛП(Строка(ЗначениеПоля(Данные, "ФизЛицоИНН", "")));

	Если Не ПустаяСтрока(ИНН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФизическиеЛица ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ФИО) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФизическиеЛица
		|ГДЕ Наименование = &ФИО И НЕ ПометкаУдаления";
		Запрос.УстановитьПараметр("ФИО", ФИО);
		Если ЗначениеЗаполнено(ДатаРождения) И ДатаРождения > Дата(1900, 1, 1) Тогда
			Запрос.Текст = Запрос.Текст + " И ДатаРождения = &ДатаРождения";
			Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
		КонецЕсли;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	ВызватьИсключение "Физическое лицо не найдено (" + ФИО + ").";

КонецФункции

Функция НайтиСотрудника(Данные, Организация, ФизическоеЛицо)

	ГУИДстр = СокрЛП(Строка(ЗначениеПоля(Данные, "СотрудникГУИД", "")));
	Если Не ПустаяСтрока(ГУИДстр) Тогда
		Попытка
			Ссылка = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДстр));
			Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование")) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Запасной ключ: сотрудник по физлицу и организации.
	МетаСотр = Метаданные.Справочники.Сотрудники;
	ЕстьФизЛицо = (МетаСотр.Реквизиты.Найти("ФизическоеЛицо") <> Неопределено);
	ЕстьОрганизация = (МетаСотр.Реквизиты.Найти("Организация") <> Неопределено)
		Или (МетаСотр.Реквизиты.Найти("ГоловнаяОрганизация") <> Неопределено);
	Если ЕстьФизЛицо И ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Сотрудники ГДЕ ФизическоеЛицо = &ФизЛицо И НЕ ПометкаУдаления";
		Если ЕстьОрганизация И ЗначениеЗаполнено(Организация) Тогда
			ИмяРеквОрг = ?(МетаСотр.Реквизиты.Найти("ГоловнаяОрганизация") <> Неопределено,
				"ГоловнаяОрганизация", "Организация");
			ТекстЗапроса = ТекстЗапроса + " И " + ИмяРеквОрг + " = &Организация";
			Запрос.УстановитьПараметр("Организация", Организация);
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ФизЛицо", ФизическоеЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	ВызватьИсключение "Сотрудник не найден (физлицо " + Строка(ФизическоеЛицо) + ").";

КонецФункции

Функция НайтиПолучателя(Данные)

	ГУИДстр = СокрЛП(Строка(ЗначениеПоля(Данные, "ПолучательГУИД", "")));
	ТипПолуч = Строка(ЗначениеПоля(Данные, "ПолучательТип", ""));
	ЭтоКонтрагент = (СтрНайти(ТипПолуч, "Контрагент") > 0) Или ПустаяСтрока(ТипПолуч);

	Если Не ПустаяСтрока(ГУИДстр) Тогда
		Попытка
			ГУИД = Новый УникальныйИдентификатор(ГУИДстр);
			Если ЭтоКонтрагент Тогда
				Ссылка = Справочники.Контрагенты.ПолучитьСсылку(ГУИД);
			Иначе
				Ссылка = Справочники.ФизическиеЛица.ПолучитьСсылку(ГУИД);
			КонецЕсли;
			Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование")) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	ИНН = СокрЛП(Строка(ЗначениеПоля(Данные, "ПолучательИНН", "")));
	Если ЭтоКонтрагент И Не ПустаяСтрока(ИНН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Получатель не обязателен для создания документа — возвращаем пустую ссылку,
	// документ всё равно будет создан, бухгалтер дозаполнит получателя вручную.
	Возврат Неопределено;

КонецФункции

Функция ИмяПланаВидовРасчетаУдержаний()

	Для Каждого МетаПВР Из Метаданные.ПланыВидовРасчета Цикл
		Если МетаПВР.Имя = "Удержания" Тогда
			Возврат "Удержания";
		КонецЕсли;
	КонецЦикла;
	// Запасной вариант для конфигураций с другим именем ПВР.
	Для Каждого МетаПВР Из Метаданные.ПланыВидовРасчета Цикл
		Если СтрНайти(МетаПВР.Имя, "Удержан") > 0 Тогда
			Возврат МетаПВР.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "Удержания";

КонецФункции

Функция НайтиВидУдержания(Данные)

	ИмяПВР = ИмяПланаВидовРасчетаУдержаний();
	Менеджер = ПланыВидовРасчета[ИмяПВР];

	ГУИДстр = СокрЛП(Строка(ЗначениеПоля(Данные, "ВидУдержанияГУИД", "")));
	Если Не ПустаяСтрока(ГУИДстр) Тогда
		Попытка
			Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДстр));
			Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование")) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Код = СокрЛП(Строка(ЗначениеПоля(Данные, "ВидУдержанияКод", "")));
	Если Не ПустаяСтрока(Код) Тогда
		Попытка
			Ссылка = Менеджер.НайтиПоКоду(Код);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Наименование = СокрЛП(Строка(ЗначениеПоля(Данные, "ВидУдержанияНаименование", "")));
	Если Не ПустаяСтрока(Наименование) Тогда
		Попытка
			Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Удержание по умолчанию: первое предопределённое (часто — «Удержание по исполнительному листу»).
	ВыборкаПВР = Менеджер.Выбрать();
	Пока ВыборкаПВР.Следующий() Цикл
		Если ВыборкаПВР.Предопределенный Тогда
			Возврат ВыборкаПВР.Ссылка;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Вид удержания не найден (код=" + Код + ", наименование=" + Наименование + ").";

КонецФункции

#КонецОбласти

#Область ПрямойПереносCOM

// Прямой перенос из базы ЗУП в текущую базу (ERP) через COM-соединение.
// Выполняется на сервере ERP. Тот же отбор по срезу регистра, но читается
// через COM-объект базы-источника, промежуточный файл не создаётся.
//
// Параметры:
//   СтрокаПодключения     - Строка для V83.COMConnector.Connect().
//   ДатаПереноса          - Дата.
//   Организация           - ссылка текущей базы (отбор) или Неопределено = все.
//   ОбновлятьСуществующие - Булево.
//   ПроводитьДокументы    - Булево.
//
// Возвращает структуру как ЗагрузитьИзФайла().
//
Функция ПрямойПереносЧерезCOM(СтрокаПодключения, ДатаПереноса, Организация = Неопределено,
		ОбновлятьСуществующие = Истина, ПроводитьДокументы = Истина) Экспорт

	Итог = Новый Структура("Успех, Создано, Обновлено, Пропущено, Ошибок, Протокол",
		Ложь, 0, 0, 0, 0, Новый Массив);

	Если ПустаяСтрока(СтрокаПодключения) Тогда
		Итог.Протокол.Добавить("ОШИБКА: не указана строка подключения к базе ЗУП.");
		Возврат Итог;
	КонецЕсли;

	Попытка
		COMConnector = Новый COMОбъект("V83.COMConnector");
		Соединение = COMConnector.Connect(СтрокаПодключения);
	Исключение
		Итог.Протокол.Добавить("ОШИБКА COM-подключения: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	Попытка
		МассивДанных = ПрочитатьДействующиеЛистыЧерезCOM(Соединение, ДатаПереноса, Организация);
	Исключение
		Итог.Протокол.Добавить("ОШИБКА чтения данных из ЗУП: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	Итог.Протокол.Добавить("Из ЗУП получено действующих листов: " + МассивДанных.Количество());

	Для Каждого Данные Из МассивДанных Цикл
		Попытка
			Статус = СоздатьИлиОбновитьИсполнительныйЛист(Данные,
				ОбновлятьСуществующие, ПроводитьДокументы);
			Если Статус = "Создан" Тогда
				Итог.Создано = Итог.Создано + 1;
				Итог.Протокол.Добавить("OK: создан " + ПредставлениеДокументаОбмена(Данные));
			ИначеЕсли Статус = "Обновлен" Тогда
				Итог.Обновлено = Итог.Обновлено + 1;
				Итог.Протокол.Добавить("OK: обновлен " + ПредставлениеДокументаОбмена(Данные));
			Иначе
				Итог.Пропущено = Итог.Пропущено + 1;
				Итог.Протокол.Добавить("ПРОПУЩЕН (уже существует): "
					+ ПредставлениеДокументаОбмена(Данные));
			КонецЕсли;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			Итог.Протокол.Добавить("ОШИБКА [" + ПредставлениеДокументаОбмена(Данные) + "]: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Итог.Успех = (Итог.Ошибок = 0);
	Возврат Итог;

КонецФункции

// Выполняет отбор по регистру ПлановыеУдержания в базе-источнике через COM
// и возвращает массив структур в формате файла обмена.
Функция ПрочитатьДействующиеЛистыЧерезCOM(Соединение, ДатаПереноса, Организация)

	ГраницаСреза = КонецДня(ДатаПереноса);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Срез.Документ КАК Документ,
	|	Срез.Организация КАК Организация,
	|	Срез.Сотрудник КАК Сотрудник,
	|	Срез.Удержание КАК ВидУдержания,
	|	Срез.Размер КАК Размер,
	|	Срез.Получатель КАК Получатель
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(
	|			&ГраницаСреза,
	|			Документ ССЫЛКА Документ.ИсполнительныйЛист
	|			И Действует = ИСТИНА) КАК Срез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК ИспЛист
	|		ПО Срез.Документ = ИспЛист.Ссылка
	|ГДЕ
	|	НЕ ИспЛист.ПометкаУдаления
	|	И ИспЛист.Проведен = ИСТИНА";

	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ГраницаСреза", ГраницаСреза);

	Выборка = Запрос.Выполнить().Выбрать();

	// ИНН организации-отбора сравниваем на нашей стороне, т.к. ссылки
	// разных баз напрямую сопоставлять нельзя.
	ИННОтбора = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ИННОтбора = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ИНН")));
	КонецЕсли;

	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Попытка
			Данные = Новый Структура;
			Данные.Вставить("ГУИД", Соединение.String(Выборка.Документ.УникальныйИдентификатор()));
			Данные.Вставить("Номер", Соединение.String(Выборка.Документ.Номер));
			Данные.Вставить("Дата", Выборка.Документ.Дата);
			Данные.Вставить("Проведен", Истина);
			Данные.Вставить("ДатаНачала", COMРеквизитДаты(Выборка.Документ,
				"ДатаНачала,ДатаС,ПериодС"));
			Данные.Вставить("ДатаОкончания", COMРеквизитДаты(Выборка.Документ,
				"ДатаОкончания,ДатаПо,ПериодПо"));
			Данные.Вставить("Размер", ?(Выборка.Размер = Неопределено, 0, Число(Выборка.Размер)));

			Данные.Вставить("ОрганизацияГУИД", Соединение.String(Выборка.Организация.УникальныйИдентификатор()));
			Данные.Вставить("ОрганизацияИНН", СокрЛП(Соединение.String(Выборка.Организация.ИНН)));
			Данные.Вставить("ОрганизацияКПП", COMСтрокаБезопасно(Соединение, Выборка.Организация, "КПП"));
			Данные.Вставить("ОрганизацияНаименование", Соединение.String(Выборка.Организация));

			Если Не ПустаяСтрока(ИННОтбора)
				И Данные.ОрганизацияИНН <> ИННОтбора Тогда
				Продолжить;
			КонецЕсли;

			Данные.Вставить("СотрудникГУИД", Соединение.String(Выборка.Сотрудник.УникальныйИдентификатор()));
			Данные.Вставить("СотрудникНаименование", Соединение.String(Выборка.Сотрудник));

			ФизЛицо = COMРеквизитСсылка(Выборка.Сотрудник, "ФизическоеЛицо,ФизЛицо");
			Если ФизЛицо = Неопределено Тогда
				ФизЛицо = COMРеквизитСсылка(Выборка.Документ, "ФизическоеЛицо,ФизЛицо");
			КонецЕсли;
			Если ФизЛицо = Неопределено Тогда
				Данные.Вставить("ФизическоеЛицоГУИД", "");
				Данные.Вставить("ФизЛицоФИО", Соединение.String(Выборка.Сотрудник));
				Данные.Вставить("ФизЛицоДатаРождения", Дата(1, 1, 1));
				Данные.Вставить("ФизЛицоИНН", "");
			Иначе
				Данные.Вставить("ФизическоеЛицоГУИД", Соединение.String(ФизЛицо.УникальныйИдентификатор()));
				Данные.Вставить("ФизЛицоФИО", Соединение.String(ФизЛицо));
				Данные.Вставить("ФизЛицоДатаРождения", COMРеквизитДаты(ФизЛицо, "ДатаРождения"));
				Данные.Вставить("ФизЛицоИНН", COMСтрокаБезопасно(Соединение, ФизЛицо, "ИНН"));
			КонецЕсли;

			Если Выборка.Получатель = Неопределено Тогда
				Данные.Вставить("ПолучательГУИД", "");
				Данные.Вставить("ПолучательТип", "");
				Данные.Вставить("ПолучательИНН", "");
				Данные.Вставить("ПолучательПредставление", "");
			Иначе
				Данные.Вставить("ПолучательГУИД", Соединение.String(Выборка.Получатель.УникальныйИдентификатор()));
				Данные.Вставить("ПолучательТип", Соединение.String(Выборка.Получатель.Метаданные().Имя));
				Данные.Вставить("ПолучательИНН", COMСтрокаБезопасно(Соединение, Выборка.Получатель, "ИНН"));
				Данные.Вставить("ПолучательПредставление", Соединение.String(Выборка.Получатель));
			КонецЕсли;

			Если Выборка.ВидУдержания = Неопределено Тогда
				Данные.Вставить("ВидУдержанияГУИД", "");
				Данные.Вставить("ВидУдержанияКод", "");
				Данные.Вставить("ВидУдержанияНаименование", "");
			Иначе
				Данные.Вставить("ВидУдержанияГУИД", Соединение.String(Выборка.ВидУдержания.УникальныйИдентификатор()));
				Данные.Вставить("ВидУдержанияКод", COMСтрокаБезопасно(Соединение, Выборка.ВидУдержания, "Код"));
				Данные.Вставить("ВидУдержанияНаименование", Соединение.String(Выборка.ВидУдержания));
			КонецЕсли;

			Данные.Вставить("ОснованиеНомер", COMСтрокаБезопасно(Соединение, Выборка.Документ,
				"НомерИсполнительногоДокумента,НомерДокументаОснования"));
			Данные.Вставить("ОснованиеДата", COMРеквизитДаты(Выборка.Документ,
				"ДатаИсполнительногоДокумента,ДатаДокументаОснования"));

			МассивДанных.Добавить(Данные);
		Исключение
			// Битые строки пропускаем, чтобы один «кривой» документ
			// не останавливал весь перенос; фиксируем в протоколе вызывающего кода.
			СтрокаПротокола = Новый Структура("ГУИД, Номер, ФизЛицоФИО",
				"", "?", "строка пропущена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			МассивДанных.Добавить(СтрокаПротокола);
		КонецПопытки;
	КонецЦикла;

	Возврат МассивДанных;

КонецФункции

Функция COMСтрокаБезопасно(Соединение, COMОбъект, ИменаЧерезЗапятую)

	Имена = СтрРазделить(ИменаЧерезЗапятую, ",");
	Для Каждого Имя Из Имена Цикл
		Попытка
			Возврат СокрЛП(Соединение.String(COMОбъект[СокрЛП(Имя)]));
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция COMРеквизитДаты(COMОбъект, ИменаЧерезЗапятую)

	Имена = СтрРазделить(ИменаЧерезЗапятую, ",");
	Для Каждого Имя Из Имена Цикл
		Попытка
			Значение = COMОбъект[СокрЛП(Имя)];
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Дата(1, 1, 1);

КонецФункции

Функция COMРеквизитСсылка(COMОбъект, ИменаЧерезЗапятую)

	Имена = СтрРазделить(ИменаЧерезЗапятую, ",");
	Для Каждого Имя Из Имена Цикл
		Попытка
			Значение = COMОбъект[СокрЛП(Имя)];
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
