////////////////////////////////////////////////////////////////////////////////
// Модуль управляемой формы обработки
// «Перенос исполнительных листов ЗУП -> ERP»
//
// Состав формы — см. FormDescription.md. Все перечисленные там реквизиты
// (ДатаПереноса, Организация, ФайлОбмена, НайденныеДокументы, Протокол, ...)
// являются РЕКВИЗИТАМИ ФОРМЫ и доступны в модуле по имени напрямую.
// Серверные процедуры вызывают экспортные функции модуля объекта
// (ДействующиеИсполнительныеЛисты, ВыгрузитьВФайл, ЗагрузитьИзФайла,
// ПрямойПереносЧерезCOM) — для формы своей внешней обработки такие вызовы
// разрешены и резолвятся без квалификации.
//
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ДатаПереноса = ТекущаяДатаСеанса();
	КонецЕсли;
	ТолькоПроведенные = Истина;
	ОбновлятьСуществующие = Истина;
	ПроводитьДокументы = Истина;

КонецПроцедуры

#КонецОбласти

#Область КомандыЗаполнениеИВыгрузка

// Заполняет таблицу по срезу регистра ПлановыеУдержания на дату переноса.
// Выполняется в базе-источнике (ЗУП).
&НаКлиенте
Процедура ЗаполнитьПоРегистру(Команда)

	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		Сообщить("Укажите дату переноса.");
		Возврат;
	КонецЕсли;

	ЗаполнитьПоРегиструНаСервере();

	ВывестиВПротокол("Заполнение завершено. Действующих листов на "
		+ Формат(ДатаПереноса, "ДФ=dd.MM.yyyy") + ": " + НайденныеДокументы.Количество());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоРегиструНаСервере()

	Таблица = ДействующиеИсполнительныеЛисты(ДатаПереноса,
		Организация, ТолькоПроведенные);

	НайденныеДокументы.Загрузить(Таблица);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаТЧ Из НайденныеДокументы Цикл
		СтрокаТЧ.Переносить = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	Для Каждого СтрокаТЧ Из НайденныеДокументы Цикл
		СтрокаТЧ.Переносить = Ложь;
	КонецЦикла;

КонецПроцедуры

// Выгрузка отмеченных строк в JSON-файл. Выполняется в ЗУП.
&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)

	Если НайденныеДокументы.Количество() = 0 Тогда
		Сообщить("Таблица пуста. Сначала нажмите «Заполнить по регистру».");
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Файлы обмена (*.json)|*.json";
	Диалог.Расширение = "json";
	Диалог.Заголовок = "Выберите файл выгрузки исполнительных листов";
	Если ЗначениеЗаполнено(ФайлОбмена) Тогда
		Диалог.ПолноеИмяФайла = ФайлОбмена;
	КонецЕсли;
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	ФайлОбмена = Диалог.ПолноеИмяФайла;
	ВыгрузитьВФайлНаСервере();

КонецПроцедуры

&НаСервере
Процедура ВыгрузитьВФайлНаСервере()

	Отмеченные = Новый Массив;
	Для Каждого СтрокаТЧ Из НайденныеДокументы Цикл
		Если СтрокаТЧ.Переносить И ЗначениеЗаполнено(СтрокаТЧ.ГУИД) Тогда
			Отмеченные.Добавить(СтрокаТЧ.ГУИД);
		КонецЕсли;
	КонецЦикла;

	Если Отмеченные.Количество() = 0 Тогда
		ВывестиВПротокол("Нет отмеченных строк для выгрузки.");
		Возврат;
	КонецЕсли;

	Результат = ВыгрузитьВФайл(ДатаПереноса, Организация,
		ФайлОбмена, ТолькоПроведенные, Отмеченные);

	Если Результат.Успех Тогда
		ВывестиВПротокол("Выгружено документов: " + Результат.Выгружено
			+ ". Файл: " + Результат.Путь);
	Иначе
		ВывестиВПротокол("ОШИБКА выгрузки: " + Результат.ТекстОшибки, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КомандыЗагрузка

// Загрузка JSON-файла в текущую базу (ERP).
&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)

	Если ПустаяСтрока(ФайлОбмена) Тогда
		ВыбратьФайлОбмена(Неопределено);
		Если ПустаяСтрока(ФайлОбмена) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗагрузитьИзФайлаНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзФайлаНаСервере()

	Итог = ЗагрузитьИзФайла(ФайлОбмена,
		ОбновлятьСуществующие, ПроводитьДокументы);

	ВывестиВПротокол("Загрузка завершена. Создано: " + Итог.Создано
		+ ", обновлено: " + Итог.Обновлено
		+ ", пропущено: " + Итог.Пропущено
		+ ", ошибок: " + Итог.Ошибок + ".");
	Для Каждого СтрокаПротокола Из Итог.Протокол Цикл
		ВывестиВПротокол(СтрокаПротокола, СтрНачинаетсяС(СтрокаПротокола, "ОШИБКА"));
	КонецЦикла;

КонецПроцедуры

// Прямой перенос ЗУП -> текущая база через COM. Выполняется в ERP.
&НаКлиенте
Процедура ВыполнитьПрямойПеренос(Команда)

	Если ПустаяСтрока(ПодключениеСтрока) Тогда
		Сообщить("Укажите строку подключения к базе ЗУП (закладка «Прямое подключение»).");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		Сообщить("Укажите дату переноса.");
		Возврат;
	КонецЕсли;

	Состояние("Выполняется прямое подключение к ЗУП...");
	ВыполнитьПрямойПереносНаСервере();
	Состояние();

КонецПроцедуры

&НаСервере
Процедура ВыполнитьПрямойПереносНаСервере()

	Итог = ПрямойПереносЧерезCOM(ПодключениеСтрока, ДатаПереноса,
		Организация, ОбновлятьСуществующие, ПроводитьДокументы);

	ВывестиВПротокол("Прямой перенос завершен. Создано: " + Итог.Создано
		+ ", обновлено: " + Итог.Обновлено
		+ ", пропущено: " + Итог.Пропущено
		+ ", ошибок: " + Итог.Ошибок + ".");
	Для Каждого СтрокаПротокола Из Итог.Протокол Цикл
		ВывестиВПротокол(СтрокаПротокола, СтрНачинаетсяС(СтрокаПротокола, "ОШИБКА"));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Сервисное

&НаКлиенте
Процедура ВыбратьФайлОбмена(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Файлы обмена (*.json)|*.json";
	Диалог.Заголовок = "Выберите файл обмена";
	Если Диалог.Выбрать() Тогда
		ФайлОбмена = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

// Добавляет строку в многострочный строковый реквизит формы Протокол.
&НаСервере
Процедура ВывестиВПротокол(Текст, ЭтоОшибка = Ложь)

	Префикс = Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "  ";
	Протокол = Протокол + Префикс + Текст + Символы.ПС;

КонецПроцедуры

#КонецОбласти
