#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаПереноса = НачалоДня(ТекущаяДатаСеанса());
	ПроводитьДокументы = Истина;
	ПропускатьСНеразрешеннымиСсылками = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выгрузка (ЗУП)

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	
	ЗаполнитьСписокНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Если НЕ ЕстьОтмеченныеДокументы() Тогда
		ПоказатьПредупреждение(, "Отметьте документы для выгрузки. Список формируется командой ""Подобрать документы"".");
		Возврат;
	КонецЕсли;
	
	АдресДанных = ВыгрузитьНаСервере();
	Если АдресДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = "ИсполнительныеЛисты_" + Формат(ДатаПереноса, "ДФ=yyyyMMdd") + ".xml";
	ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресДанных);
	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(ОписаниеФайла);
	НачатьПолучениеФайлов(Неопределено, ПолучаемыеФайлы, , Истина);
	
КонецПроцедуры

// Загрузка (ERP)

&НаКлиенте
Процедура ОткрытьФайл(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , "", Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДокументы(Команда)
	
	Если ПустаяСтрока(АдресФайла) Тогда
		ПоказатьПредупреждение(, "Сначала откройте файл переноса.");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьОтмеченныеДокументы() Тогда
		ПоказатьПредупреждение(, "Отметьте документы для загрузки.");
		Возврат;
	КонецЕсли;
	
	ЗагрузитьНаСервере();
	
КонецПроцедуры

// Общие

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	УстановитьПометки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	
	УстановитьПометки(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайла = Адрес;
	ИмяФайлаЗагрузки = ВыбранноеИмяФайла;
	ПрочитатьФайлНаСервере();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьОтмеченныеДокументы()
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометки(Значение)
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		СтрокаТаблицы.Пометка = Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере()
	
	ТаблицаДокументов.Очистить();
	ТекстПротокола = "";
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Документы = Обработка.ПолучитьСписокДокументов(ДатаПереноса);
	Исключение
		ТекстПротокола = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Для Каждого ДанныеДокумента Из Документы Цикл
		СтрокаТаблицы = ТаблицаДокументов.Добавить();
		СтрокаТаблицы.Пометка = Истина;
		СтрокаТаблицы.ИД = Строка(ДанныеДокумента.Ссылка.УникальныйИдентификатор());
		СтрокаТаблицы.Номер = ДанныеДокумента.Номер;
		СтрокаТаблицы.Дата = ДанныеДокумента.Дата;
		СтрокаТаблицы.Представление = ДанныеДокумента.Представление;
	КонецЦикла;
	
	ТекстПротокола = "Найдено документов, действующих на " + Формат(ДатаПереноса, "ДЛФ=D") + ": "
		+ Документы.Количество() + ".";
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()
	
	ТекстПротокола = "";
	
	Ссылки = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Ссылки.Добавить(Документы.ИсполнительныйЛист.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТаблицы.ИД)));
		КонецЕсли;
	КонецЦикла;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Пакет = Обработка.СформироватьПакет(Ссылки, ДатаПереноса);
		ДвоичныеДанные = Обработка.ПакетВДвоичныеДанные(Пакет);
	Исключение
		ТекстПротокола = Обработка.ТекстПротокола() + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;
	
	ТекстПротокола = Обработка.ТекстПротокола();
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ПрочитатьФайлНаСервере()
	
	ТаблицаДокументов.Очистить();
	ТекстПротокола = "";
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Пакет = Обработка.ПакетИзДвоичныхДанных(ПолучитьИзВременногоХранилища(АдресФайла));
		Описание = Обработка.ОписаниеДокументовПакета(Пакет);
	Исключение
		ТекстПротокола = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		АдресФайла = "";
		Возврат;
	КонецПопытки;
	
	Для Каждого ОписаниеДокумента Из Описание Цикл
		СтрокаТаблицы = ТаблицаДокументов.Добавить();
		СтрокаТаблицы.Пометка = Истина;
		СтрокаТаблицы.ИД = ОписаниеДокумента.ИД;
		СтрокаТаблицы.Номер = ОписаниеДокумента.Номер;
		СтрокаТаблицы.Дата = ОписаниеДокумента.Дата;
		СтрокаТаблицы.Представление = ОписаниеДокумента.Представление;
	КонецЦикла;
	
	ТекстПротокола = "Источник: " + Пакет.Конфигурация + ", дата переноса: " + Формат(Пакет.ДатаПереноса, "ДЛФ=D")
		+ ". Документов в файле: " + Описание.Количество() + ".";
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	ТекстПротокола = "";
	
	ОтобранныеИД = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		СтрокаТаблицы.Результат = "";
		Если СтрокаТаблицы.Пометка Тогда
			ОтобранныеИД.Добавить(СтрокаТаблицы.ИД);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ОбновлятьСуществующие", ОбновлятьСуществующие);
	ПараметрыЗагрузки.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	ПараметрыЗагрузки.Вставить("ПропускатьСНеразрешеннымиСсылками", ПропускатьСНеразрешеннымиСсылками);
	ПараметрыЗагрузки.Вставить("БратьПервыйПриНеоднозначности", БратьПервыйПриНеоднозначности);
	ПараметрыЗагрузки.Вставить("ТолькоПроверка", ТолькоПроверка);
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Пакет = Обработка.ПакетИзДвоичныхДанных(ПолучитьИзВременногоХранилища(АдресФайла));
		Результаты = Обработка.ЗагрузитьПакет(Пакет, ОтобранныеИД, ПараметрыЗагрузки);
	Исключение
		ТекстПротокола = Обработка.ТекстПротокола() + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Для Каждого РезультатДокумента Из Результаты Цикл
		НайденныеСтроки = ТаблицаДокументов.НайтиСтроки(Новый Структура("ИД", РезультатДокумента.ИД));
		Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			СтрокаТаблицы.Результат = РезультатДокумента.Результат;
		КонецЦикла;
	КонецЦикла;
	
	ТекстПротокола = Обработка.ТекстПротокола();
	
КонецПроцедуры

#КонецОбласти
