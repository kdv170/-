#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		Объект.ДатаПереноса = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Объект.ПроводитьДокументы = Истина;
	Объект.ПереноситьНомера = Истина;
	Объект.СохранятьДатыДокументов = Истина;
	Объект.ОбновлятьСуществующие = Ложь;
	Объект.СоздаватьПолучателей = Ложь;
	
	НастроитьЭлементыФормы();
	
	// В ЗУП по умолчанию открывается страница выгрузки, в остальных конфигурациях (ERP) - загрузки.
	Если СтрНайти(ВРег(Метаданные.Имя), "ЗАРПЛАТА") > 0 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаВыгрузка;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗагрузка;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьДокументы(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату переноса.'"));
		Возврат;
	КонецЕсли;
	
	Количество = ЗаполнитьДокументыНаСервере();
	
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Исполнительные листы, действующие на указанную дату, не найдены.'"));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Список заполнен'"), ,
			СтрШаблон(НСтр("ru = 'Найдено исполнительных листов: %1'"), Количество));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	УстановитьОтметки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	КоличествоВыбранных = 0;
	Для Каждого СтрокаСписка Из Объект.СписокДокументов Цикл
		Если СтрокаСписка.Выбран Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного документа для выгрузки.'"));
		Возврат;
	КонецЕсли;
	
	АдресВоВременномХранилище = ВыгрузитьНаСервере();
	
	ИмяФайла = СтрШаблон("ИсполнительныеЛисты_%1.xml", Формат(Объект.ДатаПереноса, "ДФ=yyyy-MM-dd"));
	
	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресВоВременномХранилище));
	
	ДополнительныеПараметры = Новый Структура("КоличествоДокументов", КоличествоВыбранных);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВФайлЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	НачатьПолучениеФайлов(Оповещение, ПолучаемыеФайлы, "", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , "", Истина, УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Элементы.ИнформацияОБазе.Заголовок = СтрШаблон(НСтр("ru = 'Текущая база: %1, версия %2'"),
		Метаданные.Синоним, Метаданные.Версия);
	
	Элементы.ПодсказкаВыгрузка.Заголовок = НСтр("ru = 'Выполняется в базе ЗУП. Укажите дату переноса и нажмите ""Заполнить список"":
		|будут подобраны исполнительные листы, действующие на эту дату по регистру сведений ""Плановые удержания"".
		|Отметьте нужные документы и выгрузите их в файл.'");
	
	Элементы.ПодсказкаЗагрузка.Заголовок = НСтр("ru = 'Выполняется в базе ERP. Укажите настройки и выберите файл, выгруженный из ЗУП.
		|Организации, сотрудники, физические лица и получатели сопоставляются по ИНН/КПП, СНИЛС, ФИО и дате рождения, кодам и наименованиям.
		|Документы создаются с теми же идентификаторами, что и в ЗУП, поэтому повторная загрузка не создает дублей.'");
	
	Для Каждого Группа Из Элементы.СтраницаВыгрузка.ПодчиненныеЭлементы Цикл
		НастроитьГруппу(Группа);
	КонецЦикла;
	Для Каждого Группа Из Элементы.СтраницаЗагрузка.ПодчиненныеЭлементы Цикл
		НастроитьГруппу(Группа);
	КонецЦикла;
	
	// Список документов: редактируется только отметка выбора.
	Элементы.СписокДокументов.ИзменятьСоставСтрок = Ложь;
	Элементы.СписокДокументов.ИзменятьПорядокСтрок = Ложь;
	Для Каждого Колонка Из Элементы.СписокДокументов.ПодчиненныеЭлементы Цикл
		Если Колонка <> Элементы.СписокДокументовВыбран Тогда
			Колонка.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.РезультатЗагрузки.ТолькоПросмотр = Истина;
	Элементы.РезультатЗагрузки.ИзменятьСоставСтрок = Ложь;
	Элементы.РезультатЗагрузкиСообщение.МногострочныйРежим = Истина;
	Элементы.РезультатЗагрузкиСообщение.РастягиватьПоГоризонтали = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьГруппу(Элемент)
	
	Если ТипЗнч(Элемент) = Тип("ГруппаФормы") И Элемент.Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
		Элемент.ОтображатьЗаголовок = Ложь;
		Элемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметки(Значение)
	
	Для Каждого СтрокаСписка Из Объект.СписокДокументов Цикл
		СтрокаСписка.Выбран = Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДокументыНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьСписокДокументов();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Возврат Объект.СписокДокументов.Количество();
	
КонецФункции

&НаСервере
Функция ВыгрузитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДвоичныеДанные = ОбработкаОбъект.ВыгрузитьДокументы();
	
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьВФайлЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПолученныеФайлы = Неопределено Или ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Выгрузка завершена'"), ,
		СтрШаблон(НСтр("ru = 'Выгружено документов: %1
			|Файл: %2'"), ДополнительныеПараметры.КоличествоДокументов, ПолученныеФайлы[0].Имя));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	Итоги = ЗагрузитьНаСервере(Адрес);
	
	ТекстИтогов = СтрШаблон(
		НСтр("ru = 'Документов в файле: %1
			|Создано: %2
			|Обновлено: %3
			|Пропущено: %4
			|Ошибок: %5'"),
		Итоги.Всего, Итоги.Создано, Итоги.Обновлено, Итоги.Пропущено, Итоги.Ошибок);
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Загрузка завершена'"), , ТекстИтогов);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Загрузка исполнительных листов завершена.'") + Символы.ПС + ТекстИтогов;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьНаСервере(Адрес)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Итоги = ОбработкаОбъект.ЗагрузитьДокументы(ДвоичныеДанные);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Возврат Итоги;
	
КонецФункции

#КонецОбласти
