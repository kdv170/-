///////////////////////////////////////////////////////////////////////////////////////////////////////
// Перенос документов "Исполнительный лист" из 1С:Зарплата и управление персоналом 3.1 в 1С:ERP.
//
// Схема работы (обработка используется в обеих базах):
//   1. База ЗУП (страница "Выгрузка"): по срезу последних регистра сведений "ПлановыеУдержания"
//      на дату переноса отбираются исполнительные листы, действующие на эту дату.
//      Отмеченные документы выгружаются в XML-файл обмена.
//   2. База ERP (страница "Загрузка"): файл читается, ссылочные реквизиты сопоставляются
//      с данными ERP по ключевым полям (ИНН/КПП, СНИЛС, ФИО и дата рождения, коды, наименования,
//      имена предопределенных элементов), создаются/обновляются документы "ИсполнительныйЛист".
//
// Документы в ERP создаются с тем же уникальным идентификатором, что и в ЗУП, поэтому повторная
// загрузка того же файла не приводит к дублям (документы либо пропускаются, либо обновляются).
//
// Состав реквизитов документа определяется по метаданным, поэтому обработка не зависит
// от точного набора реквизитов в конкретных релизах ЗУП и ERP: переносятся реквизиты,
// существующие в обеих конфигурациях.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заполняет табличную часть "СписокДокументов" исполнительными листами,
// действующими на дату переноса по данным регистра сведений "ПлановыеУдержания".
//
Процедура ЗаполнитьСписокДокументов() Экспорт
	
	СписокДокументов.Очистить();
	
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана дата переноса.'");
	КонецЕсли;
	
	ПроверитьНаличиеДокумента();
	
	Если Метаданные.РегистрыСведений.Найти("ПлановыеУдержания") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации отсутствует регистр сведений ""ПлановыеУдержания"".
			|Отбор действующих исполнительных листов невозможен.'");
	КонецЕсли;
	
	Запрос = ЗапросДействующихИсполнительныхЛистов();
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СписокДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Выбран = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Выгружает отмеченные документы табличной части "СписокДокументов" в XML.
//
// Возвращаемое значение:
//   ДвоичныеДанные - содержимое файла обмена.
//
Функция ВыгрузитьДокументы() Экспорт
	
	ПроверитьНаличиеДокумента();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента(ИмяКорневогоЭлемента());
	Запись.ЗаписатьАтрибут("ВерсияФормата", ВерсияФормата());
	Запись.ЗаписатьАтрибут("ДатаПереноса", XMLСтрока(ДатаПереноса));
	Запись.ЗаписатьАтрибут("ДатаВыгрузки", XMLСтрока(ТекущаяДатаСеанса()));
	Запись.ЗаписатьАтрибут("Источник", СтрШаблон("%1 (%2)", Метаданные.Синоним, Метаданные.Версия));
	
	Для Каждого СтрокаСписка Из СписокДокументов Цикл
		Если Не СтрокаСписка.Выбран Или Не ЗначениеЗаполнено(СтрокаСписка.Документ) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьДокумент(Запись, СтрокаСписка.Документ);
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат ДвоичныеДанные;
	
КонецФункции

// Загружает документы из файла обмена в текущую базу. Результат по каждому документу
// помещается в табличную часть "РезультатЗагрузки".
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные - содержимое файла обмена, созданного функцией ВыгрузитьДокументы.
//
// Возвращаемое значение:
//   Структура - Всего, Создано, Обновлено, Пропущено, Ошибок (Число).
//
Функция ЗагрузитьДокументы(ДвоичныеДанные) Экспорт
	
	РезультатЗагрузки.Очистить();
	ПроверитьНаличиеДокумента();
	
	Итоги = Новый Структура("Всего, Создано, Обновлено, Пропущено, Ошибок", 0, 0, 0, 0, 0);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяВременногоФайла);
		Построитель = Новый ПостроительDOM;
		ДокументDOM = Построитель.Прочитать(Чтение);
		Чтение.Закрыть();
	Исключение
		УдалитьФайлы(ИмяВременногоФайла);
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось прочитать файл обмена: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьФайлы(ИмяВременногоФайла);
	
	Корень = ДокументDOM.ЭлементДокумента;
	Если Корень = Неопределено Или Корень.ИмяУзла <> ИмяКорневогоЭлемента() Тогда
		ВызватьИсключение НСтр("ru = 'Файл не является файлом переноса исполнительных листов.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ДатаПереноса = ДатаИзXML(Атрибут(Корень, "ДатаПереноса"));
	КонецЕсли;
	
	КэшСсылок = Новый Соответствие;
	
	Для Каждого Узел Из Корень.ДочерниеУзлы Цикл
		Если Узел.ТипУзла <> ТипУзлаDOM.Элемент Или Узел.ИмяУзла <> "Документ" Тогда
			Продолжить;
		КонецЕсли;
		Итоги.Всего = Итоги.Всего + 1;
		ЗагрузитьДокумент(Узел, КэшСсылок, Итоги);
	КонецЦикла;
	
	Возврат Итоги;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Общее

Функция ИмяКорневогоЭлемента()
	Возврат "ПереносИсполнительныхЛистов";
КонецФункции

Функция ВерсияФормата()
	Возврат "1.0";
КонецФункции

Функция ИмяДокумента()
	Возврат "ИсполнительныйЛист";
КонецФункции

Процедура ПроверитьНаличиеДокумента()
	
	Если Метаданные.Документы.Найти(ИмяДокумента()) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В конфигурации ""%1"" отсутствует документ ""%2"". Перенос невозможен.'"),
			Метаданные.Синоним, ИмяДокумента());
	КонецЕсли;
	
КонецПроцедуры

// Реквизиты документа, которые не переносятся: заполняются в базе-приемнике автоматически.
Функция ИсключаемыеРеквизиты()
	
	Список = Новый Массив;
	Список.Добавить("Ответственный");
	Список.Добавить("ВерсияДанных");
	Список.Добавить("ДополнительныеРеквизиты");
	Возврат Список;
	
КонецФункции

// Реквизиты, без которых документ не имеет смысла: если ссылка не сопоставлена,
// документ не создается.
Функция ОбязательныеРеквизиты()
	
	Список = Новый Массив;
	Список.Добавить("Организация");
	Список.Добавить("Сотрудник");
	Список.Добавить("Получатель");
	Возврат Список;
	
КонецФункции

Функция ЕстьПоле(МетаОбъект, ИмяПоля)
	
	Если МетаОбъект.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого СтандартныйРеквизит Из МетаОбъект.СтандартныеРеквизиты Цикл
		Если СтандартныйРеквизит.Имя = ИмяПоля Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоСсылочныйТип(ТипЗначения)
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения);
	
КонецФункции

Функция МенеджерПоПолномуИмени(ПолноеИмя)
	
	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидОбъекта = ВРег(Части[0]);
	ИмяОбъекта = Части[1];
	
	Если ВидОбъекта = "СПРАВОЧНИК" Тогда
		Возврат Справочники[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ДОКУМЕНТ" Тогда
		Возврат Документы[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ПЕРЕЧИСЛЕНИЕ" Тогда
		Возврат Перечисления[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ПЛАНВИДОВРАСЧЕТА" Тогда
		Возврат ПланыВидовРасчета[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ПЛАНВИДОВХАРАКТЕРИСТИК" Тогда
		Возврат ПланыВидовХарактеристик[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ПЛАНСЧЕТОВ" Тогда
		Возврат ПланыСчетов[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ПЛАНОБМЕНА" Тогда
		Возврат ПланыОбмена[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "БИЗНЕСПРОЦЕСС" Тогда
		Возврат БизнесПроцессы[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "ЗАДАЧА" Тогда
		Возврат Задачи[ИмяОбъекта];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СсылкаСуществует(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Поле
		|ИЗ
		|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДатаИзXML(Строка)
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка);
	Исключение
		Возврат '00010101';
	КонецПопытки;
	
КонецФункции

Функция Атрибут(Узел, ИмяАтрибута)
	
	Значение = Узел.ПолучитьАтрибут(ИмяАтрибута);
	Возврат ?(Значение = Неопределено, "", Значение);
	
КонецФункции

#КонецОбласти

#Область Выгрузка

// Текст запроса строится по метаданным, так как состав полей регистра сведений
// "ПлановыеУдержания" и документа может отличаться между релизами.
Функция ЗапросДействующихИсполнительныхЛистов()
	
	МетаРегистр = Метаданные.РегистрыСведений.ПлановыеУдержания;
	МетаДокумент = Метаданные.Документы[ИмяДокумента()];
	
	Если МетаРегистр.Измерения.Найти("ДокументОснование") <> Неопределено Тогда
		ПолеДокумента = "ДокументОснование";
	ИначеЕсли МетаРегистр.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
		ПолеДокумента = "ДокументОснование";
	Иначе
		ПолеДокумента = "Регистратор";
	КонецЕсли;
	
	ЕстьДействует = МетаРегистр.Ресурсы.Найти("Действует") <> Неопределено
		Или МетаРегистр.Реквизиты.Найти("Действует") <> Неопределено;
	УсловиеДействует = ?(ЕстьДействует, "ПлановыеУдержания.Действует", "ИСТИНА");
	
	Периодический = МетаРегистр.ПериодичностьРегистраСведений
		<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	
	Если Периодический Тогда
		ТаблицаРегистра = "РегистрСведений.ПлановыеУдержания.СрезПоследних(
			|			&ГраницаПереноса,
			|			" + ПолеДокумента + " ССЫЛКА Документ.ИсполнительныйЛист)";
	Иначе
		ТаблицаРегистра = "РегистрСведений.ПлановыеУдержания";
		УсловиеДействует = УсловиеДействует + "
			|	И ПлановыеУдержания." + ПолеДокумента + " ССЫЛКА Документ.ИсполнительныйЛист";
	КонецЕсли;
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПлановыеУдержания." + ПолеДокумента + " КАК Документ
		|ПОМЕСТИТЬ ВТДействующиеДокументы
		|ИЗ
		|	" + ТаблицаРегистра + " КАК ПлановыеУдержания
		|ГДЕ
		|	" + УсловиеДействует + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсполнительныйЛист.Ссылка КАК Документ,
		|	" + ВыражениеПоля(МетаДокумент, "Организация", "ИсполнительныйЛист.Организация", "НЕОПРЕДЕЛЕНО") + " КАК Организация,
		|	" + ВыражениеПоля(МетаДокумент, "Сотрудник", "ИсполнительныйЛист.Сотрудник", "НЕОПРЕДЕЛЕНО") + " КАК Сотрудник,
		|	" + ВыражениеПоля(МетаДокумент, "Получатель", "ПРЕДСТАВЛЕНИЕ(ИсполнительныйЛист.Получатель)", """""") + " КАК Получатель,
		|	" + ВыражениеПоля(МетаДокумент, "ДатаНачала", "ИсполнительныйЛист.ДатаНачала", "ДАТАВРЕМЯ(1, 1, 1)") + " КАК ДатаНачала,
		|	" + ВыражениеПоля(МетаДокумент, "ДатаОкончания", "ИсполнительныйЛист.ДатаОкончания", "ДАТАВРЕМЯ(1, 1, 1)") + " КАК ДатаОкончания,
		|	" + ВыражениеПоля(МетаДокумент, "СпособРасчета", "ПРЕДСТАВЛЕНИЕ(ИсполнительныйЛист.СпособРасчета)", """""") + " КАК СпособРасчета
		|ИЗ
		|	ВТДействующиеДокументы КАК ВТДействующиеДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК ИсполнительныйЛист
		|		ПО ВТДействующиеДокументы.Документ = ИсполнительныйЛист.Ссылка
		|ГДЕ
		|	ИсполнительныйЛист.Проведен
		|	И НЕ ИсполнительныйЛист.ПометкаУдаления
		|	И (&ВсеОрганизации
		|			ИЛИ " + ВыражениеПоля(МетаДокумент, "Организация", "ИсполнительныйЛист.Организация = &Организация", "ИСТИНА") + ")
		|	И " + ВыражениеПоля(МетаДокумент, "ДатаНачала", "ИсполнительныйЛист.ДатаНачала <= &ДатаПереноса", "ИСТИНА") + "
		|	И " + ВыражениеПоля(МетаДокумент, "ДатаОкончания",
			"(ИсполнительныйЛист.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ ИсполнительныйЛист.ДатаОкончания >= &ДатаПереноса)", "ИСТИНА") + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	" + ВыражениеПоля(МетаДокумент, "Сотрудник", "ИсполнительныйЛист.Сотрудник.Наименование,", "") + "
		|	ИсполнительныйЛист.Дата,
		|	ИсполнительныйЛист.Номер";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаПереноса", НачалоДня(ДатаПереноса));
	Запрос.УстановитьПараметр("ГраницаПереноса", КонецДня(ДатаПереноса));
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат Запрос;
	
КонецФункции

Функция ВыражениеПоля(МетаОбъект, ИмяПоля, Выражение, ВыражениеЕслиНет)
	Возврат ?(ЕстьПоле(МетаОбъект, ИмяПоля), Выражение, ВыражениеЕслиНет);
КонецФункции

Функция НомерДокументаСтрокой(Номер)
	
	Если ТипЗнч(Номер) = Тип("Число") Тогда
		Возврат Формат(Номер, "ЧГ=0");
	КонецЕсли;
	
	Возврат СокрЛП(Номер);
	
КонецФункции

Процедура ЗаписатьДокумент(Запись, ДокументСсылка)
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	МетаДокумент = ДокументОбъект.Метаданные();
	
	Запись.ЗаписатьНачалоЭлемента("Документ");
	Запись.ЗаписатьАтрибут("Тип", МетаДокумент.ПолноеИмя());
	Запись.ЗаписатьАтрибут("УникальныйИдентификатор", XMLСтрока(ДокументСсылка.УникальныйИдентификатор()));
	Запись.ЗаписатьАтрибут("Номер", НомерДокументаСтрокой(ДокументОбъект.Номер));
	Запись.ЗаписатьАтрибут("Дата", XMLСтрока(ДокументОбъект.Дата));
	Запись.ЗаписатьАтрибут("Проведен", XMLСтрока(ДокументОбъект.Проведен));
	Запись.ЗаписатьАтрибут("Представление", Строка(ДокументСсылка));
	
	Для Каждого МетаРеквизит Из МетаДокумент.Реквизиты Цикл
		Если ИсключаемыеРеквизиты().Найти(МетаРеквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьЗначение(Запись, "Реквизит", МетаРеквизит.Имя, ДокументОбъект[МетаРеквизит.Имя], 0);
	КонецЦикла;
	
	Для Каждого МетаТабличнаяЧасть Из МетаДокумент.ТабличныеЧасти Цикл
		Запись.ЗаписатьНачалоЭлемента("ТабличнаяЧасть");
		Запись.ЗаписатьАтрибут("Имя", МетаТабличнаяЧасть.Имя);
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект[МетаТабличнаяЧасть.Имя] Цикл
			Запись.ЗаписатьНачалоЭлемента("Строка");
			Для Каждого МетаРеквизит Из МетаТабличнаяЧасть.Реквизиты Цикл
				ЗаписатьЗначение(Запись, "Реквизит", МетаРеквизит.Имя, СтрокаТабличнойЧасти[МетаРеквизит.Имя], 0);
			КонецЦикла;
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

// Записывает значение реквизита (или ключевого поля ссылки) в XML.
// Для ссылочных значений, помимо идентификатора, записываются ключевые поля,
// по которым объект будет искаться в базе-приемнике. Глубина вложенности ограничена,
// чтобы не выгружать лишние данные (ссылки в ключевых полях ключевых полей).
//
Процедура ЗаписатьЗначение(Запись, ИмяЭлемента, Имя, Значение, Уровень)
	
	Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	Запись.ЗаписатьАтрибут("Имя", Имя);
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено Или Значение = NULL Тогда
		Запись.ЗаписатьАтрибут("Тип", "Неопределено");
		
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Запись.ЗаписатьАтрибут("Тип", "Строка");
		Запись.ЗаписатьТекст(Значение);
		
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Запись.ЗаписатьАтрибут("Тип", "Число");
		Запись.ЗаписатьТекст(XMLСтрока(Значение));
		
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Запись.ЗаписатьАтрибут("Тип", "Дата");
		Запись.ЗаписатьТекст(XMLСтрока(Значение));
		
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Запись.ЗаписатьАтрибут("Тип", "Булево");
		Запись.ЗаписатьТекст(XMLСтрока(Значение));
		
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Запись.ЗаписатьАтрибут("Тип", "УникальныйИдентификатор");
		Запись.ЗаписатьТекст(XMLСтрока(Значение));
		
	ИначеЕсли ЭтоСсылочныйТип(ТипЗначения) Тогда
		МетаОбъект = Значение.Метаданные();
		ПолноеИмя = МетаОбъект.ПолноеИмя();
		Запись.ЗаписатьАтрибут("Тип", ПолноеИмя);
		
		Если Метаданные.Перечисления.Содержит(МетаОбъект) Тогда
			Если ЗначениеЗаполнено(Значение) Тогда
				Индекс = Перечисления[МетаОбъект.Имя].Индекс(Значение);
				Запись.ЗаписатьАтрибут("Значение", МетаОбъект.ЗначенияПеречисления[Индекс].Имя);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Запись.ЗаписатьАтрибут("УникальныйИдентификатор", XMLСтрока(Значение.УникальныйИдентификатор()));
			Запись.ЗаписатьАтрибут("Представление", Строка(Значение));
			
			ИмяПредопределенного = ИмяПредопределенногоЭлемента(Значение, МетаОбъект);
			Если Не ПустаяСтрока(ИмяПредопределенного) Тогда
				Запись.ЗаписатьАтрибут("ПредопределенноеИмя", ИмяПредопределенного);
			КонецЕсли;
			
			Если Уровень < 2 Тогда
				Для Каждого ИмяПоля Из КлючевыеПоля(МетаОбъект) Цикл
					ЗаписатьЗначение(Запись, "Ключ", ИмяПоля, Значение[ИмяПоля], Уровень + 1);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		// ХранилищеЗначения и прочие типы, не имеющие смысла в базе-приемнике.
		Запись.ЗаписатьАтрибут("Тип", "НеПоддерживается");
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ИмяПредопределенногоЭлемента(Ссылка, МетаОбъект)
	
	ПоддерживаетПредопределенные = Метаданные.Справочники.Содержит(МетаОбъект)
		Или Метаданные.ПланыВидовРасчета.Содержит(МетаОбъект)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(МетаОбъект)
		Или Метаданные.ПланыСчетов.Содержит(МетаОбъект);
	
	Если Не ПоддерживаетПредопределенные Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
		|ИЗ
		|	" + МетаОбъект.ПолноеИмя() + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка
		|	И Таблица.Предопределенный";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ИмяПредопределенныхДанных);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Поля ссылочного объекта, выгружаемые для поиска соответствия в базе-приемнике.
Функция КлючевыеПоля(МетаОбъект)
	
	ПолноеИмя = МетаОбъект.ПолноеИмя();
	
	Если ПолноеИмя = "Справочник.Организации" Тогда
		Кандидаты = "ИНН,КПП,Наименование,НаименованиеПолное,Код";
	ИначеЕсли ПолноеИмя = "Справочник.Контрагенты" Тогда
		Кандидаты = "ИНН,КПП,Наименование,НаименованиеПолное,ЮридическоеФизическоеЛицо,Код";
	ИначеЕсли ПолноеИмя = "Справочник.ФизическиеЛица" Тогда
		Кандидаты = "Фамилия,Имя,Отчество,ДатаРождения,ИНН,СтраховойНомерПФР,Наименование,Код";
	ИначеЕсли ПолноеИмя = "Справочник.Сотрудники" Тогда
		Кандидаты = "Код,Наименование,ФизическоеЛицо,ГоловнаяОрганизация";
	ИначеЕсли ПолноеИмя = "Справочник.Пользователи" Тогда
		Кандидаты = "Наименование";
	Иначе
		Кандидаты = "Код,Наименование";
	КонецЕсли;
	
	Результат = Новый Массив;
	Для Каждого ИмяПоля Из СтрРазделить(Кандидаты, ",") Цикл
		Если ЕстьПоле(МетаОбъект, ИмяПоля) Тогда
			Результат.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Загрузка

Процедура ЗагрузитьДокумент(УзелДокумента, КэшСсылок, Итоги)
	
	СтрокаРезультата = РезультатЗагрузки.Добавить();
	СтрокаРезультата.НомерИсточника = Атрибут(УзелДокумента, "Номер");
	СтрокаРезультата.ДатаИсточника = ДатаИзXML(Атрибут(УзелДокумента, "Дата"));
	СтрокаРезультата.Представление = Атрибут(УзелДокумента, "Представление");
	
	ИдентификаторСтрокой = Атрибут(УзелДокумента, "УникальныйИдентификатор");
	Если ПустаяСтрока(ИдентификаторСтрокой) Тогда
		СтрокаРезультата.Статус = НСтр("ru = 'Ошибка'");
		СтрокаРезультата.Сообщение = НСтр("ru = 'В файле не указан уникальный идентификатор документа.'");
		Итоги.Ошибок = Итоги.Ошибок + 1;
		Возврат;
	КонецЕсли;
	
	МенеджерДокумента = Документы[ИмяДокумента()];
	Ссылка = МенеджерДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторСтрокой));
	Существует = СсылкаСуществует(Ссылка);
	
	Если Существует И Не ОбновлятьСуществующие Тогда
		СтрокаРезультата.Документ = Ссылка;
		СтрокаРезультата.Статус = НСтр("ru = 'Пропущен'");
		СтрокаРезультата.Сообщение = НСтр("ru = 'Документ уже существует в базе. Для перезаполнения установите флаг ""Обновлять существующие документы"".'");
		Итоги.Пропущено = Итоги.Пропущено + 1;
		Возврат;
	КонецЕсли;
	
	Предупреждения = Новый Массив;
	
	// Явная транзакция намеренно не используется: создание отсутствующих получателей (контрагентов)
	// должно сохраняться независимо от результата записи документа, иначе в кэше ссылок
	// останутся ссылки на откатившиеся объекты. Запись документа сама по себе транзакционна.
	Попытка
		
		Если Существует Тогда
			ДокументОбъект = Ссылка.ПолучитьОбъект();
		Иначе
			ДокументОбъект = МенеджерДокумента.СоздатьДокумент();
			ДокументОбъект.УстановитьСсылкуНового(Ссылка);
			// Заполнение значениями по умолчанию (ответственный, организация и т.п.) средствами конфигурации.
			Попытка
				ДокументОбъект.Заполнить(Неопределено);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ЗаполнитьДокумент(ДокументОбъект, УзелДокумента, КэшСсылок, Предупреждения);
		
		ПроводитьДокумент = ПроводитьДокументы И Атрибут(УзелДокумента, "Проведен") = "true";
		Если ПроводитьДокумент Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		СтрокаРезультата.Документ = ДокументОбъект.Ссылка;
		Если Существует Тогда
			СтрокаРезультата.Статус = НСтр("ru = 'Обновлен'");
			Итоги.Обновлено = Итоги.Обновлено + 1;
		Иначе
			СтрокаРезультата.Статус = НСтр("ru = 'Создан'");
			Итоги.Создано = Итоги.Создано + 1;
		КонецЕсли;
		СтрокаРезультата.Сообщение = СтрСоединить(Предупреждения, Символы.ПС);
		
	Исключение
		Предупреждения.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		СтрокаРезультата.Статус = НСтр("ru = 'Ошибка'");
		СтрокаРезультата.Сообщение = СтрСоединить(Предупреждения, Символы.ПС);
		Итоги.Ошибок = Итоги.Ошибок + 1;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьДокумент(ДокументОбъект, УзелДокумента, КэшСсылок, Предупреждения)
	
	МетаДокумент = ДокументОбъект.Метаданные();
	
	ДатаДокумента = ДатаИзXML(Атрибут(УзелДокумента, "Дата"));
	Если СохранятьДатыДокументов И ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДокументОбъект.Дата = ДатаДокумента;
	ИначеЕсли Не ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ДатаПереноса), ДатаПереноса, ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ПереноситьНомера Тогда
		ДокументОбъект.Номер = Атрибут(УзелДокумента, "Номер");
	КонецЕсли;
	
	Для Каждого Узел Из УзелДокумента.ДочерниеУзлы Цикл
		
		Если Узел.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		
		Если Узел.ИмяУзла = "Реквизит" Тогда
			ЗаполнитьРеквизит(ДокументОбъект, МетаДокумент, Узел, КэшСсылок, Предупреждения, Истина);
			
		ИначеЕсли Узел.ИмяУзла = "ТабличнаяЧасть" Тогда
			ИмяТабличнойЧасти = Атрибут(Узел, "Имя");
			МетаТабличнаяЧасть = МетаДокумент.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
			Если МетаТабличнаяЧасть = Неопределено Тогда
				Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Табличная часть ""%1"" отсутствует в базе-приемнике, пропущена.'"),
					ИмяТабличнойЧасти));
				Продолжить;
			КонецЕсли;
			
			ТабличнаяЧасть = ДокументОбъект[ИмяТабличнойЧасти];
			ТабличнаяЧасть.Очистить();
			Для Каждого УзелСтроки Из Узел.ДочерниеУзлы Цикл
				Если УзелСтроки.ТипУзла <> ТипУзлаDOM.Элемент Или УзелСтроки.ИмяУзла <> "Строка" Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = ТабличнаяЧасть.Добавить();
				Для Каждого УзелРеквизита Из УзелСтроки.ДочерниеУзлы Цикл
					Если УзелРеквизита.ТипУзла = ТипУзлаDOM.Элемент И УзелРеквизита.ИмяУзла = "Реквизит" Тогда
						ЗаполнитьРеквизит(НоваяСтрока, МетаТабличнаяЧасть, УзелРеквизита, КэшСсылок, Предупреждения, Ложь);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьОтветственного(ДокументОбъект, МетаДокумент);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизит(Приемник, МетаПриемника, Узел, КэшСсылок, Предупреждения, ЭтоШапка)
	
	ИмяРеквизита = Атрибут(Узел, "Имя");
	
	Если МетаПриемника.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		// Отсутствие реквизита в приемнике важно только тогда, когда в источнике он был заполнен.
		Если Не ЗначениеУзлаПустое(Узел) Тогда
			Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Реквизит ""%1"" отсутствует в базе-приемнике, значение ""%2"" не перенесено.'"),
				ИмяРеквизита, ЗначениеУзлаДляСообщения(Узел)));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ИмяТипа = Атрибут(Узел, "Тип");
	Если ИмяТипа = "Неопределено" Или ИмяТипа = "НеПоддерживается" Тогда
		Возврат;
	КонецЕсли;
	
	Значение = ЗначениеИзУзла(Узел, КэшСсылок, Предупреждения);
	
	Если Значение = Неопределено Тогда
		// Ссылка не сопоставлена: для ключевых реквизитов шапки документ создавать нельзя.
		Если ЭтоШапка И ОбязательныеРеквизиты().Найти(ИмяРеквизита) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось сопоставить значение обязательного реквизита ""%1"": %2'"),
				ИмяРеквизита, ЗначениеУзлаДляСообщения(Узел));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Приемник[ИмяРеквизита] = Значение;
	
КонецПроцедуры

Функция ЗначениеУзлаПустое(Узел)
	
	ИмяТипа = Атрибут(Узел, "Тип");
	
	Если ИмяТипа = "Неопределено" Или ИмяТипа = "НеПоддерживается" Или ПустаяСтрока(ИмяТипа) Тогда
		Возврат Истина;
	ИначеЕсли ИмяТипа = "Строка" Тогда
		Возврат ПустаяСтрока(Узел.ТекстовоеСодержимое);
	ИначеЕсли ИмяТипа = "Число" Тогда
		Возврат ПустаяСтрока(Узел.ТекстовоеСодержимое) Или СокрЛП(Узел.ТекстовоеСодержимое) = "0";
	ИначеЕсли ИмяТипа = "Булево" Тогда
		Возврат СокрЛП(Узел.ТекстовоеСодержимое) <> "true";
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Возврат Не ЗначениеЗаполнено(ДатаИзXML(Узел.ТекстовоеСодержимое));
	ИначеЕсли ИмяТипа = "УникальныйИдентификатор" Тогда
		Возврат ПустаяСтрока(Узел.ТекстовоеСодержимое);
	КонецЕсли;
	
	// Ссылочные типы: перечисление без значения или ссылка без идентификатора.
	Возврат ПустаяСтрока(Атрибут(Узел, "Значение")) И ПустаяСтрока(Атрибут(Узел, "УникальныйИдентификатор"));
	
КонецФункции

Функция ЗначениеУзлаДляСообщения(Узел)
	
	Представление = Атрибут(Узел, "Представление");
	Если Не ПустаяСтрока(Представление) Тогда
		Возврат Представление;
	КонецЕсли;
	
	ЗначениеПеречисления = Атрибут(Узел, "Значение");
	Если Не ПустаяСтрока(ЗначениеПеречисления) Тогда
		Возврат ЗначениеПеречисления;
	КонецЕсли;
	
	Возврат СокрЛП(Узел.ТекстовоеСодержимое);
	
КонецФункции

Процедура ЗаполнитьОтветственного(ДокументОбъект, МетаДокумент)
	
	Если Не ЕстьПоле(МетаДокумент, "Ответственный") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Возврат;
	КонецЕсли;
	
	// Общий модуль "Пользователи" входит в Библиотеку стандартных подсистем (есть и в ЗУП, и в ERP),
	// но обращение через Вычислить() позволяет обработке работать и без него.
	Если Метаданные.ОбщиеМодули.Найти("Пользователи") <> Неопределено Тогда
		Попытка
			ДокументОбъект.Ответственный = Вычислить("Пользователи.ТекущийПользователь()");
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Преобразует узел XML в значение. Для ссылочных типов выполняется поиск в текущей базе.
//
// Возвращаемое значение:
//   Произвольный - значение реквизита; Неопределено - если ссылку сопоставить не удалось.
//
Функция ЗначениеИзУзла(Узел, КэшСсылок, Предупреждения)
	
	ИмяТипа = Атрибут(Узел, "Тип");
	Текст = Узел.ТекстовоеСодержимое;
	
	Если ИмяТипа = "Строка" Тогда
		Возврат Текст;
	ИначеЕсли ИмяТипа = "Число" Тогда
		Возврат XMLЗначение(Тип("Число"), ?(ПустаяСтрока(Текст), "0", Текст));
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Возврат ДатаИзXML(Текст);
	ИначеЕсли ИмяТипа = "Булево" Тогда
		Возврат XMLЗначение(Тип("Булево"), ?(ПустаяСтрока(Текст), "false", Текст));
	ИначеЕсли ИмяТипа = "УникальныйИдентификатор" Тогда
		Возврат Новый УникальныйИдентификатор(Текст);
	ИначеЕсли ИмяТипа = "Неопределено" Или ИмяТипа = "НеПоддерживается" Или ПустаяСтрока(ИмяТипа) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НайтиСсылку(Узел, КэшСсылок, Предупреждения);
	
КонецФункции

Функция НайтиСсылку(Узел, КэшСсылок, Предупреждения)
	
	ПолноеИмя = Атрибут(Узел, "Тип");
	Представление = Атрибут(Узел, "Представление");
	
	МетаОбъект = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Менеджер = ?(МетаОбъект = Неопределено, Неопределено, МенеджерПоПолномуИмени(ПолноеИмя));
	Если Менеджер = Неопределено Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Объект метаданных ""%1"" отсутствует в базе-приемнике (значение ""%2"").'"),
			ПолноеИмя, Представление));
		Возврат Неопределено;
	КонецЕсли;
	
	// Перечисления сопоставляются по имени значения.
	Если Метаданные.Перечисления.Содержит(МетаОбъект) Тогда
		ИмяЗначения = Атрибут(Узел, "Значение");
		Если ПустаяСтрока(ИмяЗначения) Тогда
			Возврат Менеджер.ПустаяСсылка();
		КонецЕсли;
		Если МетаОбъект.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
			Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Значение ""%1"" отсутствует в перечислении ""%2"".'"),
				ИмяЗначения, ПолноеИмя));
			Возврат Неопределено;
		КонецЕсли;
		Возврат Менеджер[ИмяЗначения];
	КонецЕсли;
	
	ИдентификаторСтрокой = Атрибут(Узел, "УникальныйИдентификатор");
	Если ПустаяСтрока(ИдентификаторСтрокой) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	
	КлючКэша = ПолноеИмя + ":" + ИдентификаторСтрокой;
	Ссылка = КэшСсылок[КлючКэша];
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	// 1. Предопределенный элемент.
	ИмяПредопределенного = Атрибут(Узел, "ПредопределенноеИмя");
	Если Не ПустаяСтрока(ИмяПредопределенного) Тогда
		Попытка
			Ссылка = Менеджер[ИмяПредопределенного];
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	// 2. Тот же уникальный идентификатор (данные ранее переносились с сохранением идентификаторов).
	Если Ссылка = Неопределено Тогда
		СсылкаПоИдентификатору = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторСтрокой));
		Если СсылкаСуществует(СсылкаПоИдентификатору) Тогда
			Ссылка = СсылкаПоИдентификатору;
		КонецЕсли;
	КонецЕсли;
	
	// 3. Поиск по ключевым полям.
	Ключи = Неопределено;
	Если Ссылка = Неопределено Тогда
		Ключи = ПрочитатьКлючи(Узел, КэшСсылок, Предупреждения);
		Ссылка = НайтиПоКлючам(ПолноеИмя, МетаОбъект, Ключи);
	КонецЕсли;
	
	// 4. Создание получателя (контрагента), если разрешено.
	Если Ссылка = Неопределено И ПолноеИмя = "Справочник.Контрагенты" И СоздаватьПолучателей Тогда
		Ссылка = СоздатьКонтрагента(МетаОбъект, Ключи, Представление, Предупреждения);
	КонецЕсли;
	
	Если Ссылка = Неопределено Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Не найден объект ""%1"" (%2).'"), Представление, ПолноеИмя));
		Возврат Неопределено;
	КонецЕсли;
	
	КэшСсылок.Вставить(КлючКэша, Ссылка);
	Возврат Ссылка;
	
КонецФункции

Функция ПрочитатьКлючи(Узел, КэшСсылок, Предупреждения)
	
	Ключи = Новый Соответствие;
	
	Для Каждого УзелКлюча Из Узел.ДочерниеУзлы Цикл
		Если УзелКлюча.ТипУзла <> ТипУзлаDOM.Элемент Или УзелКлюча.ИмяУзла <> "Ключ" Тогда
			Продолжить;
		КонецЕсли;
		ПредупрежденияКлюча = Новый Массив; // несопоставленные ключевые поля не являются ошибкой
		Ключи.Вставить(Атрибут(УзелКлюча, "Имя"), ЗначениеИзУзла(УзелКлюча, КэшСсылок, ПредупрежденияКлюча));
	КонецЦикла;
	
	Возврат Ключи;
	
КонецФункции

// Наборы полей для поиска объекта в базе-приемнике в порядке убывания надежности.
Функция СтратегииПоиска(ПолноеИмя)
	
	Стратегии = Новый Массив;
	
	Если ПолноеИмя = "Справочник.Организации" Или ПолноеИмя = "Справочник.Контрагенты" Тогда
		Стратегии.Добавить("ИНН,КПП");
		Стратегии.Добавить("ИНН");
		Стратегии.Добавить("Наименование");
		Стратегии.Добавить("НаименованиеПолное");
		
	ИначеЕсли ПолноеИмя = "Справочник.ФизическиеЛица" Тогда
		Стратегии.Добавить("СтраховойНомерПФР");
		Стратегии.Добавить("ИНН");
		Стратегии.Добавить("Фамилия,Имя,Отчество,ДатаРождения");
		Стратегии.Добавить("Наименование,ДатаРождения");
		Стратегии.Добавить("Наименование");
		
	ИначеЕсли ПолноеИмя = "Справочник.Сотрудники" Тогда
		Стратегии.Добавить("ФизическоеЛицо,ГоловнаяОрганизация,Код");
		Стратегии.Добавить("ФизическоеЛицо,ГоловнаяОрганизация");
		Стратегии.Добавить("ФизическоеЛицо,Код");
		Стратегии.Добавить("ФизическоеЛицо");
		Стратегии.Добавить("Код");
		Стратегии.Добавить("Наименование");
		
	Иначе
		Стратегии.Добавить("Код");
		Стратегии.Добавить("Наименование");
	КонецЕсли;
	
	Возврат Стратегии;
	
КонецФункции

Функция НайтиПоКлючам(ПолноеИмя, МетаОбъект, Ключи)
	
	Для Каждого Стратегия Из СтратегииПоиска(ПолноеИмя) Цикл
		Ссылка = НайтиПоНаборуПолей(ПолноеИмя, МетаОбъект, СтрРазделить(Стратегия, ","), Ключи);
		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиПоНаборуПолей(ПолноеИмя, МетаОбъект, Поля, Ключи)
	
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	
	Для Каждого ИмяПоля Из Поля Цикл
		Если Не ЕстьПоле(МетаОбъект, ИмяПоля) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЗначениеПоля = Ключи[ИмяПоля];
		// Пустое значение ключа (например, незаполненный ИНН) не должно давать ложных совпадений.
		Если ЗначениеПоля = Неопределено Или Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Условия.Добавить("Таблица." + ИмяПоля + " = &" + ИмяПоля);
		Запрос.УстановитьПараметр(ИмяПоля, ЗначениеПоля);
	КонецЦикла;
	
	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	" + ПолноеИмя + " КАК Таблица
		|ГДЕ
		|	" + СтрСоединить(Условия, "
		|	И ");
	
	Если ЕстьПоле(МетаОбъект, "ЭтоГруппа") Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И НЕ Таблица.ЭтоГруппа";
	КонецЕсли;
	
	Если ЕстьПоле(МетаОбъект, "ПометкаУдаления") Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Таблица.ПометкаУдаления";
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Создает контрагента-получателя по ключевым полям из файла. В ERP контрагент обязан быть
// связан с партнером, поэтому при необходимости создается и партнер.
Функция СоздатьКонтрагента(МетаКонтрагенты, Ключи, Представление, Предупреждения)
	
	Наименование = СокрЛП(ЗначениеКлюча(Ключи, "Наименование"));
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Представление;
	КонецЕсли;
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаименованиеПолное = СокрЛП(ЗначениеКлюча(Ключи, "НаименованиеПолное"));
	Если ПустаяСтрока(НаименованиеПолное) Тогда
		НаименованиеПолное = Наименование;
	КонецЕсли;
	
	ИНН = СокрЛП(ЗначениеКлюча(Ключи, "ИНН"));
	КПП = СокрЛП(ЗначениеКлюча(Ключи, "КПП"));
	
	Попытка
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		Попытка
			КонтрагентОбъект.Заполнить(Неопределено);
		Исключение
		КонецПопытки;
		
		УстановитьРеквизитЕслиЕсть(КонтрагентОбъект, МетаКонтрагенты, "Наименование", Наименование);
		УстановитьРеквизитЕслиЕсть(КонтрагентОбъект, МетаКонтрагенты, "НаименованиеПолное", НаименованиеПолное);
		УстановитьРеквизитЕслиЕсть(КонтрагентОбъект, МетаКонтрагенты, "ИНН", ИНН);
		УстановитьРеквизитЕслиЕсть(КонтрагентОбъект, МетаКонтрагенты, "КПП", КПП);
		
		ЮридическоеФизическоеЛицо = ЗначениеКлюча(Ключи, "ЮридическоеФизическоеЛицо");
		Если Не ЗначениеЗаполнено(ЮридическоеФизическоеЛицо)
			И Метаданные.Перечисления.Найти("ЮридическоеФизическоеЛицо") <> Неопределено Тогда
			// Если признак не передан, определяем его по длине ИНН: 12 знаков - физическое лицо.
			ИмяЗначения = ?(СтрДлина(ИНН) = 12, "ФизическоеЛицо", "ЮридическоеЛицо");
			Если Метаданные.Перечисления.ЮридическоеФизическоеЛицо.ЗначенияПеречисления.Найти(ИмяЗначения) <> Неопределено Тогда
				ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо[ИмяЗначения];
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЮридическоеФизическоеЛицо) Тогда
			УстановитьРеквизитЕслиЕсть(КонтрагентОбъект, МетаКонтрагенты, "ЮридическоеФизическоеЛицо", ЮридическоеФизическоеЛицо);
		КонецЕсли;
		
		Если ЕстьПоле(МетаКонтрагенты, "Партнер") И Метаданные.Справочники.Найти("Партнеры") <> Неопределено Тогда
			КонтрагентОбъект.Партнер = НайтиИлиСоздатьПартнера(Наименование, НаименованиеПолное);
		КонецЕсли;
		
		КонтрагентОбъект.Записать();
		
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Создан получатель ""%1"" (ИНН %2, КПП %3). Проверьте его реквизиты.'"),
			Наименование, ИНН, КПП));
		
		Возврат КонтрагентОбъект.Ссылка;
		
	Исключение
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Не удалось создать получателя ""%1"": %2'"),
			Наименование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция НайтиИлиСоздатьПартнера(Наименование, НаименованиеПолное)
	
	МетаПартнеры = Метаданные.Справочники.Партнеры;
	
	Ключи = Новый Соответствие;
	Ключи.Вставить("Наименование", Наименование);
	Партнер = НайтиПоНаборуПолей("Справочник.Партнеры", МетаПартнеры, СтрРазделить("Наименование", ","), Ключи);
	Если Партнер <> Неопределено Тогда
		Возврат Партнер;
	КонецЕсли;
	
	ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
	Попытка
		ПартнерОбъект.Заполнить(Неопределено);
	Исключение
	КонецПопытки;
	
	УстановитьРеквизитЕслиЕсть(ПартнерОбъект, МетаПартнеры, "Наименование", Наименование);
	УстановитьРеквизитЕслиЕсть(ПартнерОбъект, МетаПартнеры, "НаименованиеПолное", НаименованиеПолное);
	УстановитьРеквизитЕслиЕсть(ПартнерОбъект, МетаПартнеры, "ПрочиеОтношения", Истина);
	ПартнерОбъект.Записать();
	
	Возврат ПартнерОбъект.Ссылка;
	
КонецФункции

Функция ЗначениеКлюча(Ключи, ИмяКлюча)
	
	Если Ключи = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ключи[ИмяКлюча];
	
КонецФункции

Процедура УстановитьРеквизитЕслиЕсть(Объект, МетаОбъект, ИмяРеквизита, Значение)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьПоле(МетаОбъект, ИмяРеквизита) Тогда
		Объект[ИмяРеквизита] = Значение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
