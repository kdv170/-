// Перенос документов ИсполнительныйЛист из 1С:ЗУП в 1С:ERP.
//
// Обработка запускается в обеих конфигурациях:
//  - в ЗУП документы отбираются по регистру сведений ПлановыеУдержания (записи, действующие
//    на дату переноса) и выгружаются в XML-файл;
//  - в ERP файл загружается: ссылки на справочные данные (организации, физические лица,
//    сотрудники, контрагенты, виды удержаний и т.п.) сопоставляются по ключевым реквизитам,
//    после чего создаются (или обновляются) документы ИсполнительныйЛист.
//
// Формат файла - стандартная XML-сериализация платформы (Структура / Массив / примитивы),
// ссылки передаются в виде описателей с ключевыми реквизитами объекта.

Перем Протокол;
Перем КэшСсылок;
Перем КэшОписаний;
Перем ПараметрыЗагрузки;
Перем ПропущенныеПоля;

#Область ПрограммныйИнтерфейс

// Возвращает документы ИсполнительныйЛист, по которым в регистре сведений ПлановыеУдержания
// есть действующие на указанную дату записи.
//
// Параметры:
//  ДатаПереноса - Дата - дата, на которую определяется действие удержаний (включая весь день).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Ссылка, Номер, Дата, Проведен, Представление.
//
Функция ПолучитьСписокДокументов(ДатаПереноса) Экспорт
	
	МетаДокумент = Метаданные.Документы.Найти(ИмяДокумента());
	Если МетаДокумент = Неопределено Тогда
		ВызватьИсключение "В конфигурации отсутствует документ " + ИмяДокумента() + ".";
	КонецЕсли;
	
	МетаРегистр = Метаданные.РегистрыСведений.Найти("ПлановыеУдержания");
	Если МетаРегистр = Неопределено Тогда
		ВызватьИсключение "В конфигурации отсутствует регистр сведений ПлановыеУдержания. "
			+ "Выгрузку необходимо выполнять в конфигурации 1С:Зарплата и управление персоналом.";
	КонецЕсли;
	
	ПолеДокумента = НайтиПолеДокумента(МетаРегистр, МетаДокумент);
	Если ПолеДокумента = Неопределено Тогда
		ВызватьИсключение "В регистре сведений ПлановыеУдержания не найдено поле, "
			+ "содержащее ссылку на документ " + МетаДокумент.Имя + ".";
	КонецЕсли;
	
	ПолеДействия = ?(ЕстьПолеРегистра(МетаРегистр, "Действие"), "Действие", Неопределено);
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег." + ПолеДокумента + " КАК Документ";
	Если ПолеДействия <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|	Рег." + ПолеДействия + " КАК Действие";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(&Дата, ) КАК Рег
	|ГДЕ
	|	Рег." + ПолеДокумента + " ССЫЛКА Документ." + МетаДокумент.Имя;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаПереноса));
	
	ТипСсылкиДокумента = Тип("ДокументСсылка." + МетаДокумент.Имя);
	Активные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Документ) <> ТипСсылкиДокумента ИЛИ Выборка.Документ.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеДействия <> Неопределено И ДействиеПрекращено(Выборка.Действие) Тогда
			Продолжить;
		КонецЕсли;
		Активные.Вставить(Выборка.Документ, Истина);
	КонецЦикла;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Номер");
	Результат.Колонки.Добавить("Дата");
	Результат.Колонки.Добавить("Проведен");
	Результат.Колонки.Добавить("Представление");
	
	Если Активные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Активные Цикл
		Ссылки.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	ПоляПредставления = Новый Массив;
	Для Каждого ИмяПоля Из СтрРазделить("Организация,Сотрудник,ФизическоеЛицо", ",") Цикл
		Если ЕстьРеквизит(МетаДокумент, ИмяПоля) Тогда
			ПоляПредставления.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Проведен КАК Проведен";
	Для Каждого ИмяПоля Из ПоляПредставления Цикл
		ТекстЗапроса = ТекстЗапроса + ",
		|	Док." + ИмяПоля + " КАК " + ИмяПоля;
	КонецЦикла;
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|	Документ." + МетаДокумент.Имя + " КАК Док
	|ГДЕ
	|	Док.Ссылка В (&Ссылки)
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.Ссылка = Выборка.Ссылка;
		СтрокаРезультата.Номер = Выборка.Номер;
		СтрокаРезультата.Дата = Выборка.Дата;
		СтрокаРезультата.Проведен = Выборка.Проведен;
		Части = Новый Массив;
		Для Каждого ИмяПоля Из ПоляПредставления Цикл
			Части.Добавить(Строка(Выборка[ИмяПоля]));
		КонецЦикла;
		СтрокаРезультата.Представление = СтрСоединить(Части, ", ");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует пакет переноса из указанных документов.
//
// Параметры:
//  МассивСсылок - Массив - ссылки на документы ИсполнительныйЛист.
//  ДатаПереноса - Дата - дата переноса (сохраняется в пакете для информации).
//
// Возвращаемое значение:
//  Структура - пакет, пригодный для записи через ЗаписатьXML.
//
Функция СформироватьПакет(МассивСсылок, ДатаПереноса) Экспорт
	
	КэшОписаний = Новый Соответствие;
	МетаДокумент = Метаданные.Документы.Найти(ИмяДокумента());
	
	Документы = Новый Массив;
	Для Каждого Ссылка Из МассивСсылок Цикл
		Попытка
			Документы.Добавить(ДокументВСтруктуру(Ссылка, МетаДокумент));
		Исключение
			ДобавитьВПротокол("Ошибка выгрузки документа " + Строка(Ссылка) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Пакет = Новый Структура;
	Пакет.Вставить("Формат", ИдентификаторФормата());
	Пакет.Вставить("Версия", 1);
	Пакет.Вставить("ДатаПереноса", ДатаПереноса);
	Пакет.Вставить("ДатаВыгрузки", ТекущаяДатаСеанса());
	Пакет.Вставить("Конфигурация", Метаданные.Имя + " " + Метаданные.Версия);
	Пакет.Вставить("Документы", Документы);
	
	ДобавитьВПротокол("Выгружено документов: " + Документы.Количество() + " из " + МассивСсылок.Количество() + ".");
	
	Возврат Пакет;
	
КонецФункции

// Сериализует пакет в двоичные данные (XML, UTF-8).
Функция ПакетВДвоичныеДанные(Пакет) Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Попытка
		ЗаписатьXML(Запись, Пакет);
	Исключение
		Запись.Закрыть();
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
	
	Данные = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	Возврат Данные;
	
КонецФункции

// Восстанавливает пакет из двоичных данных XML-файла.
Функция ПакетИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяФайла);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	Попытка
		Пакет = ПрочитатьXML(Чтение);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Чтение.Закрыть();
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение "Не удалось прочитать файл переноса: " + ТекстОшибки;
	КонецПопытки;
	Чтение.Закрыть();
	УдалитьФайлы(ИмяФайла);
	
	ПроверитьПакет(Пакет);
	Возврат Пакет;
	
КонецФункции

// Возвращает краткое описание документов пакета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ИД, Номер, Дата, Представление.
//
Функция ОписаниеДокументовПакета(Пакет) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИД");
	Результат.Колонки.Добавить("Номер");
	Результат.Колонки.Добавить("Дата");
	Результат.Колонки.Добавить("Представление");
	
	Для Каждого Данные Из Пакет.Документы Цикл
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.ИД = Данные.ИД;
		СтрокаРезультата.Номер = Данные.Номер;
		СтрокаРезультата.Дата = Данные.Дата;
		Части = Новый Массив;
		Для Каждого ИмяПоля Из СтрРазделить("Организация,Сотрудник,ФизическоеЛицо", ",") Цикл
			Если Данные.Реквизиты.Свойство(ИмяПоля) И ТипЗнч(Данные.Реквизиты[ИмяПоля]) = Тип("Структура") Тогда
				Части.Добавить(Данные.Реквизиты[ИмяПоля].Представление);
			КонецЕсли;
		КонецЦикла;
		СтрокаРезультата.Представление = СтрСоединить(Части, ", ");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Загружает документы пакета в текущую информационную базу (ERP).
//
// Параметры:
//  Пакет - Структура - пакет, полученный из ПакетИзДвоичныхДанных.
//  ОтобранныеИД - Массив, Неопределено - идентификаторы загружаемых документов (Неопределено - все).
//  Параметры - Структура - ОбновлятьСуществующие, ПроводитьДокументы,
//      ПропускатьСНеразрешеннымиСсылками, БратьПервыйПриНеоднозначности, ТолькоПроверка.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ИД, Результат, Описание.
//
Функция ЗагрузитьПакет(Пакет, ОтобранныеИД, Параметры) Экспорт
	
	ПараметрыЗагрузки = Параметры;
	КэшСсылок = Новый Соответствие;
	ПропущенныеПоля = Новый Соответствие;
	ПроверитьПакет(Пакет);
	
	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("ИД");
	Результаты.Колонки.Добавить("Результат");
	Результаты.Колонки.Добавить("Описание");
	
	Счетчики = Новый Соответствие;
	
	Для Каждого Данные Из Пакет.Документы Цикл
		
		Если ОтобранныеИД <> Неопределено И ОтобранныеИД.Найти(Данные.ИД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультата = Результаты.Добавить();
		СтрокаРезультата.ИД = Данные.ИД;
		Попытка
			Итог = ЗагрузитьДокумент(Данные);
			СтрокаРезультата.Результат = Итог.Результат;
			СтрокаРезультата.Описание = Итог.Описание;
		Исключение
			СтрокаРезультата.Результат = "Ошибка";
			СтрокаРезультата.Описание = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Счетчики.Вставить(СтрокаРезультата.Результат, ?(Счетчики.Получить(СтрокаРезультата.Результат) = Неопределено, 0,
			Счетчики.Получить(СтрокаРезультата.Результат)) + 1);
		
		ТекстСообщения = "Исполнительный лист № " + Данные.Номер + " от " + Формат(Данные.Дата, "ДЛФ=D")
			+ ": " + СтрокаРезультата.Результат;
		Если ЗначениеЗаполнено(СтрокаРезультата.Описание) Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + "    " + СтрЗаменить(СтрокаРезультата.Описание, Символы.ПС, Символы.ПС + "    ");
		КонецЕсли;
		ДобавитьВПротокол(ТекстСообщения);
		
	КонецЦикла;
	
	Для Каждого Элемент Из ПропущенныеПоля Цикл
		ДобавитьВПротокол("Предупреждение: в конфигурации-приемнике нет поля, оно не перенесено: " + Элемент.Ключ);
	КонецЦикла;
	
	Итоги = Новый Массив;
	Для Каждого Элемент Из Счетчики Цикл
		Итоги.Добавить(Элемент.Ключ + " - " + Элемент.Значение);
	КонецЦикла;
	ДобавитьВПротокол("Итого: " + ?(Итоги.Количество() = 0, "документы не обработаны", СтрСоединить(Итоги, "; ")) + ".");
	
	Возврат Результаты;
	
КонецФункции

// Возвращает накопленный протокол работы.
Функция ТекстПротокола() Экспорт
	
	Если Протокол = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ВыгрузкаВПакет

Функция ДокументВСтруктуру(Ссылка, МетаДокумент)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "документ не найден в информационной базе";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИД", Строка(Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("Номер", Объект.Номер);
	Результат.Вставить("Дата", Объект.Дата);
	Результат.Вставить("Проведен", Объект.Проведен);
	
	Реквизиты = Новый Структура;
	Для Каждого МетаРеквизит Из МетаДокумент.Реквизиты Цикл
		Реквизиты.Вставить(МетаРеквизит.Имя, ЗначениеВПакет(Объект[МетаРеквизит.Имя], 0));
	КонецЦикла;
	Результат.Вставить("Реквизиты", Реквизиты);
	
	ТабличныеЧасти = Новый Структура;
	Для Каждого МетаТЧ Из МетаДокумент.ТабличныеЧасти Цикл
		Строки = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект[МетаТЧ.Имя] Цикл
			ДанныеСтроки = Новый Структура;
			Для Каждого МетаРеквизит Из МетаТЧ.Реквизиты Цикл
				ДанныеСтроки.Вставить(МетаРеквизит.Имя, ЗначениеВПакет(СтрокаТЧ[МетаРеквизит.Имя], 0));
			КонецЦикла;
			Строки.Добавить(ДанныеСтроки);
		КонецЦикла;
		ТабличныеЧасти.Вставить(МетаТЧ.Имя, Строки);
	КонецЦикла;
	Результат.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеВПакет(Значение, Глубина)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено ИЛИ ТипЗначения = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	
	МетаОбъект = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаОбъект = Неопределено Тогда
		ДобавитьВПротокол("Предупреждение: значение типа " + Строка(ТипЗначения) + " не поддерживается и не выгружено.");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписатьСсылку(Значение, МетаОбъект, Глубина);
	
КонецФункции

Функция ОписатьСсылку(Ссылка, МетаОбъект, Глубина)
	
	Если Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторКэша = Строка(Ссылка.УникальныйИдентификатор()) + "/" + Формат(Глубина, "ЧГ=0");
	Описание = КэшОписаний.Получить(ИдентификаторКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	Класс = КлассОбъектаМетаданных(МетаОбъект);
	Если Класс = Неопределено Тогда
		ДобавитьВПротокол("Предупреждение: ссылка на объект " + МетаОбъект.ПолноеИмя() + " не поддерживается и не выгружена.");
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", Класс + "." + МетаОбъект.Имя);
	Описание.Вставить("ИД", Строка(Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("Представление", Строка(Ссылка));
	
	Если Класс = "Перечисление" Тогда
		Описание.Вставить("Имя", ИмяЗначенияПеречисления(Ссылка));
		КэшОписаний.Вставить(ИдентификаторКэша, Описание);
		Возврат Описание;
	КонецЕсли;
	
	Описание.Вставить("ИмяПредопределенного", "");
	Описание.Вставить("Поля", Новый Структура);
	
	Для Каждого Поле Из ПрочитатьПоляСсылки(Ссылка, МетаОбъект, Класс) Цикл
		Если Поле.Ключ = "ИмяПредопределенного" Тогда
			Описание.ИмяПредопределенного = ?(Поле.Значение = Неопределено, "", Строка(Поле.Значение));
			Продолжить;
		КонецЕсли;
		
		Значение = Поле.Значение;
		ЭтоСсылка = Метаданные.НайтиПоТипу(ТипЗнч(Значение)) <> Неопределено;
		Если ЭтоСсылка И Глубина >= МаксимальнаяГлубинаОписания() Тогда
			Продолжить;
		КонецЕсли;
		Описание.Поля.Вставить(Поле.Ключ, ЗначениеВПакет(Значение, Глубина + 1));
	КонецЦикла;
	
	КэшОписаний.Вставить(ИдентификаторКэша, Описание);
	Возврат Описание;
	
КонецФункции

Функция ПрочитатьПоляСсылки(Ссылка, МетаОбъект, Класс)
	
	Имена = ИменаПолейОписания(МетаОбъект, Класс);
	Если Класс <> "Документ" Тогда
		Имена.Добавить("ИмяПредопределенного");
	КонецЕсли;
	
	Результат = Новый Структура;
	Если Имена.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выражения = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Выражения.Добавить("Т." + Имя + " КАК " + Имя);
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ " + СтрСоединить(Выражения, ", ")
		+ " ИЗ " + Класс + "." + МетаОбъект.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Для Каждого Имя Из Имена Цикл
			Результат.Вставить(Имя, Выборка[Имя]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИменаПолейОписания(МетаОбъект, Класс)
	
	Результат = Новый Массив;
	
	Если Класс = "Документ" Тогда
		Результат.Добавить("Номер");
		Результат.Добавить("Дата");
		Если ЕстьРеквизит(МетаОбъект, "Организация") Тогда
			Результат.Добавить("Организация");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если МетаОбъект.ДлинаКода > 0 Тогда
		Результат.Добавить("Код");
	КонецЕсли;
	Если МетаОбъект.ДлинаНаименования > 0 Тогда
		Результат.Добавить("Наименование");
	КонецЕсли;
	Если Класс = "Справочник" И МетаОбъект.Владельцы.Количество() > 0 Тогда
		Результат.Добавить("Владелец");
	КонецЕсли;
	
	Для Каждого Имя Из СтрРазделить("ИНН,КПП,СНИЛС,ДатаРождения,НомерСчета,ФизическоеЛицо,ГоловнаяОрганизация", ",") Цикл
		Если ЕстьРеквизит(МетаОбъект, Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция МаксимальнаяГлубинаОписания()
	Возврат 3;
КонецФункции

#КонецОбласти

#Область ЗагрузкаИзПакета

Функция ЗагрузитьДокумент(Данные)
	
	МетаДокумент = Метаданные.Документы.Найти(ИмяДокумента());
	Если МетаДокумент = Неопределено Тогда
		ВызватьИсключение "В конфигурации отсутствует документ " + ИмяДокумента() + ".";
	КонецЕсли;
	
	Проблемы = Новый Массив;
	Предупреждения = Новый Массив;
	
	Реквизиты = Новый Структура;
	Для Каждого Элемент Из Данные.Реквизиты Цикл
		Имя = Элемент.Ключ;
		Если МетаДокумент.Реквизиты.Найти(Имя) = Неопределено Тогда
			ЗапомнитьПропущенноеПоле("реквизит " + Имя);
			Продолжить;
		КонецЕсли;
		КоличествоПроблем = Проблемы.Количество();
		Значение = ЗначениеИзПакета(Элемент.Значение, Проблемы, "Реквизит " + Имя);
		Если Проблемы.Количество() = КоличествоПроблем Тогда
			Реквизиты.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	
	ТабличныеЧасти = Новый Структура;
	Для Каждого ЭлементТЧ Из Данные.ТабличныеЧасти Цикл
		МетаТЧ = МетаДокумент.ТабличныеЧасти.Найти(ЭлементТЧ.Ключ);
		Если МетаТЧ = Неопределено Тогда
			ЗапомнитьПропущенноеПоле("табличная часть " + ЭлементТЧ.Ключ);
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЭлементТЧ.Значение) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		
		Строки = Новый Массив;
		НомерСтроки = 0;
		Для Каждого СтрокаДанных Из ЭлементТЧ.Значение Цикл
			НомерСтроки = НомерСтроки + 1;
			НоваяСтрока = Новый Структура;
			Для Каждого Поле Из СтрокаДанных Цикл
				Если МетаТЧ.Реквизиты.Найти(Поле.Ключ) = Неопределено Тогда
					ЗапомнитьПропущенноеПоле("реквизит " + Поле.Ключ + " табличной части " + ЭлементТЧ.Ключ);
					Продолжить;
				КонецЕсли;
				КоличествоПроблем = Проблемы.Количество();
				Значение = ЗначениеИзПакета(Поле.Значение, Проблемы,
					"Табличная часть " + ЭлементТЧ.Ключ + ", строка " + НомерСтроки + ", " + Поле.Ключ);
				Если Проблемы.Количество() = КоличествоПроблем Тогда
					НоваяСтрока.Вставить(Поле.Ключ, Значение);
				КонецЕсли;
			КонецЦикла;
			Строки.Добавить(НоваяСтрока);
		КонецЦикла;
		ТабличныеЧасти.Вставить(ЭлементТЧ.Ключ, Строки);
	КонецЦикла;
	
	Если Проблемы.Количество() > 0 И ПараметрыЗагрузки.ПропускатьСНеразрешеннымиСсылками Тогда
		Возврат РезультатЗагрузки("Пропущен (не сопоставлены ссылки)", СтрСоединить(Проблемы, Символы.ПС));
	КонецЕсли;
	
	Организация = Неопределено;
	Если Реквизиты.Свойство("Организация") Тогда
		Организация = Реквизиты.Организация;
	КонецЕсли;
	Найденный = НайтиДокумент(МетаДокумент.Имя, Данные.Номер, Данные.Дата, Организация);
	
	Если Найденный <> Неопределено И НЕ ПараметрыЗагрузки.ОбновлятьСуществующие Тогда
		Возврат РезультатЗагрузки("Пропущен (уже есть в ERP)", "");
	КонецЕсли;
	
	Если ПараметрыЗагрузки.ТолькоПроверка Тогда
		ОписаниеПроверки = СтрСоединить(Проблемы, Символы.ПС);
		Возврат РезультатЗагрузки(?(Найденный = Неопределено, "Проверен (будет создан)", "Проверен (будет обновлен)"),
			ОписаниеПроверки);
	КонецЕсли;
	
	Если Найденный = Неопределено Тогда
		Объект = Документы[МетаДокумент.Имя].СоздатьДокумент();
		Объект.Дата = Данные.Дата;
		Объект.Номер = Данные.Номер;
	Иначе
		Объект = Найденный.ПолучитьОбъект();
	КонецЕсли;
	
	Для Каждого Элемент Из Реквизиты Цикл
		Попытка
			Объект[Элемент.Ключ] = Элемент.Значение;
			Если Элемент.Значение <> Неопределено И Объект[Элемент.Ключ] <> Элемент.Значение Тогда
				Предупреждения.Добавить("Реквизит " + Элемент.Ключ + ": значение не принято приемником (несовместимый тип).");
			КонецЕсли;
		Исключение
			Предупреждения.Добавить("Реквизит " + Элемент.Ключ + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Для Каждого ЭлементТЧ Из ТабличныеЧасти Цикл
		Объект[ЭлементТЧ.Ключ].Очистить();
		Для Каждого ДанныеСтроки Из ЭлементТЧ.Значение Цикл
			НоваяСтрока = Объект[ЭлементТЧ.Ключ].Добавить();
			Для Каждого Поле Из ДанныеСтроки Цикл
				Попытка
					НоваяСтрока[Поле.Ключ] = Поле.Значение;
				Исключение
					Предупреждения.Добавить("Табличная часть " + ЭлементТЧ.Ключ + ", " + Поле.Ключ + ": "
						+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ЭтоНовый = Объект.ЭтоНовый();
	
	Если Данные.Проведен И ПараметрыЗагрузки.ПроводитьДокументы Тогда
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Предупреждения.Добавить("Документ записан, но не проведен: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписатьБезПроведения(Объект);
		КонецПопытки;
	Иначе
		ЗаписатьБезПроведения(Объект);
	КонецЕсли;
	
	Описание = СтрСоединить(СоединитьМассивы(Проблемы, Предупреждения), Символы.ПС);
	Возврат РезультатЗагрузки(?(ЭтоНовый, "Создан", "Обновлен"), Описание);
	
КонецФункции

Процедура ЗаписатьБезПроведения(Объект)
	
	Если Объект.ЭтоНовый() Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
КонецПроцедуры

Функция РезультатЗагрузки(Результат, Описание)
	Возврат Новый Структура("Результат, Описание", Результат, Описание);
КонецФункции

Функция СоединитьМассивы(Массив1, Массив2)
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Массив1 Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Массив2 Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура ЗапомнитьПропущенноеПоле(Описание)
	ПропущенныеПоля.Вставить(Описание, Истина);
КонецПроцедуры

Функция НайтиДокумент(ИмяДокумента, Номер, Дата, Организация)
	
	МетаДокумент = Метаданные.Документы[ИмяДокумента];
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	Док.Номер = &Номер
	|	И Док.Дата = &Дата
	|	И НЕ Док.ПометкаУдаления";
	
	ОтборПоОрганизации = ЗначениеЗаполнено(Организация) И ЕстьРеквизит(МетаДокумент, "Организация");
	Если ОтборПоОрганизации Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И Док.Организация = &Организация";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Дата", Дата);
	Если ОтборПоОрганизации Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Преобразует значение пакета в значение информационной базы.
// Описатели ссылок разрешаются поиском объекта; нерешенные ссылки попадают в Проблемы.
Функция ЗначениеИзПакета(Значение, Проблемы, Контекст)
	
	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Результат = КэшСсылок.Получить(Значение.ИД);
	Если Результат = Неопределено Тогда
		Результат = РазрешитьСсылку(Значение);
		КэшСсылок.Вставить(Значение.ИД, Результат);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Проблемы.Добавить(Контекст + ": " + Результат.Ошибка);
	КонецЕсли;
	
	Возврат Результат.Ссылка;
	
КонецФункции

Функция РазрешитьСсылку(Описание)
	
	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");
	
	Вид = Описание.Вид;
	ПозицияТочки = СтрНайти(Вид, ".");
	Класс = Лев(Вид, ПозицияТочки - 1);
	
	МетаОбъект = Метаданные.НайтиПоПолномуИмени(Вид);
	Если МетаОбъект = Неопределено Тогда
		Результат.Ошибка = "в конфигурации нет объекта " + Вид + " (""" + Описание.Представление + """)";
		Возврат Результат;
	КонецЕсли;
	
	Если Класс = "Перечисление" Тогда
		Попытка
			Результат.Ссылка = ПредопределенноеЗначение(Вид + "." + Описание.Имя);
		Исключение
			Результат.Ошибка = "в перечислении " + Вид + " нет значения " + Описание.Имя;
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Описание.ИмяПредопределенного) Тогда
		Попытка
			Предопределенный = ПредопределенноеЗначение(Вид + "." + Описание.ИмяПредопределенного);
			Если ЗначениеЗаполнено(Предопределенный) Тогда
				Результат.Ссылка = Предопределенный;
				Возврат Результат;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Класс = "Документ" Тогда
		Организация = Неопределено;
		Если Описание.Поля.Свойство("Организация") Тогда
			Организация = ЗначениеИзПакета(Описание.Поля.Организация, Новый Массив, "");
		КонецЕсли;
		Результат.Ссылка = НайтиДокумент(МетаОбъект.Имя, Описание.Поля.Номер, Описание.Поля.Дата, Организация);
		Если Результат.Ссылка = Неопределено Тогда
			Результат.Ошибка = "не найден документ " + Вид + " (""" + Описание.Представление + """)";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	НайтиЭлемент(Описание, Класс, МетаОбъект, Результат);
	Возврат Результат;
	
КонецФункции

Процедура НайтиЭлемент(Описание, Класс, МетаОбъект, Результат)
	
	Поля = Описание.Поля;
	ДоступныеПоля = ИменаПолейОписания(МетаОбъект, Класс);
	ЕстьДатаРождения = Поля.Свойство("ДатаРождения") И ЗначениеЗаполнено(Поля.ДатаРождения);
	
	Для Каждого Стратегия Из СтратегииПоиска() Цикл
		
		Если Стратегия.Количество() = 1 И Стратегия[0] = "Наименование" И ЕстьДатаРождения Тогда
			Продолжить;
		КонецЕсли;
		
		Условия = Новый Массив;
		Запрос = Новый Запрос;
		Применима = Истина;
		
		Для Каждого ИмяПоля Из Стратегия Цикл
			
			Если ДоступныеПоля.Найти(ИмяПоля) = Неопределено ИЛИ НЕ Поля.Свойство(ИмяПоля) Тогда
				Применима = Ложь;
				Прервать;
			КонецЕсли;
			
			Значение = Поля[ИмяПоля];
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
				ПроблемыВложенных = Новый Массив;
				Значение = ЗначениеИзПакета(Значение, ПроблемыВложенных, ИмяПоля);
				Если ПроблемыВложенных.Количество() > 0 Тогда
					Результат.Ошибка = "не найден " + Описание.Вид + " (""" + Описание.Представление + """): "
						+ СтрСоединить(ПроблемыВложенных, "; ");
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				Применима = Ложь;
				Прервать;
			КонецЕсли;
			
			ИмяПараметра = "П" + Формат(Условия.Количество(), "ЧГ=0");
			Условия.Добавить("Т." + ИмяПоля + " = &" + ИмяПараметра);
			Запрос.УстановитьПараметр(ИмяПараметра, Значение);
			
		КонецЦикла;
		
		Если НЕ Применима ИЛИ Условия.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ " + Класс + "." + МетаОбъект.Имя
			+ " КАК Т ГДЕ НЕ Т.ПометкаУдаления И " + СтрСоединить(Условия, " И ");
		Таблица = Запрос.Выполнить().Выгрузить();
		
		Если Таблица.Количество() = 1 Тогда
			Результат.Ссылка = Таблица[0].Ссылка;
			Возврат;
		ИначеЕсли Таблица.Количество() > 1 Тогда
			Если ПараметрыЗагрузки.БратьПервыйПриНеоднозначности Тогда
				Результат.Ссылка = Таблица[0].Ссылка;
			Иначе
				Результат.Ошибка = "найдено несколько объектов " + Описание.Вид + " (""" + Описание.Представление
					+ """) по признаку: " + СтрСоединить(Стратегия, " + ");
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Ошибка = "не найден " + Описание.Вид + " (""" + Описание.Представление + """)";
	
КонецПроцедуры

// Наборы реквизитов, по которым ищется соответствующий объект; применяются по порядку.
Функция СтратегииПоиска()
	
	Результат = Новый Массив;
	Для Каждого Набор Из СтрРазделить(
		"СНИЛС;ИНН,КПП;ИНН;ФизическоеЛицо,ГоловнаяОрганизация;Владелец,НомерСчета;"
		+ "Владелец,Наименование;Наименование,ДатаРождения;Код,Наименование;Наименование", ";") Цикл
		Результат.Добавить(СтрРазделить(Набор, ","));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьПакет(Пакет)
	
	Если ТипЗнч(Пакет) <> Тип("Структура") ИЛИ НЕ Пакет.Свойство("Формат")
		ИЛИ Пакет.Формат <> ИдентификаторФормата() ИЛИ НЕ Пакет.Свойство("Документы") Тогда
		ВызватьИсключение "Файл не является пакетом переноса исполнительных листов.";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция ИмяДокумента()
	Возврат "ИсполнительныйЛист";
КонецФункции

Функция ИдентификаторФормата()
	Возврат "ПереносИсполнительныхЛистов";
КонецФункции

Процедура ДобавитьВПротокол(Текст)
	
	Если Протокол = Неопределено Тогда
		Протокол = Новый Массив;
	КонецЕсли;
	Протокол.Добавить(Текст);
	
КонецПроцедуры

Функция ЕстьРеквизит(МетаОбъект, Имя)
	Возврат МетаОбъект.Реквизиты.Найти(Имя) <> Неопределено;
КонецФункции

Функция ЕстьПолеРегистра(МетаРегистр, Имя)
	
	Возврат МетаРегистр.Измерения.Найти(Имя) <> Неопределено
		ИЛИ МетаРегистр.Ресурсы.Найти(Имя) <> Неопределено
		ИЛИ МетаРегистр.Реквизиты.Найти(Имя) <> Неопределено;
	
КонецФункции

// Ищет в регистре поле, тип которого допускает ссылку на документ. Если такого поля нет,
// а регистр подчинен регистратору, документом считается регистратор.
Функция НайтиПолеДокумента(МетаРегистр, МетаДокумент)
	
	ТипСсылки = Тип("ДокументСсылка." + МетаДокумент.Имя);
	
	Коллекции = Новый Массив;
	Коллекции.Добавить(МетаРегистр.Измерения);
	Коллекции.Добавить(МетаРегистр.Ресурсы);
	Коллекции.Добавить(МетаРегистр.Реквизиты);
	
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Поле Из Коллекция Цикл
			Если Поле.Тип.СодержитТип(ТипСсылки) Тогда
				Возврат Поле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если МетаРегистр.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Возврат "Регистратор";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДействиеПрекращено(Действие)
	
	Если Действие = Неопределено ИЛИ Метаданные.НайтиПоТипу(ТипЗнч(Действие)) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ИмяЗначенияПеречисления(Действие) = "Прекратить";
	
КонецФункции

Функция ИмяЗначенияПеречисления(Значение)
	
	МетаПеречисление = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если МетаПеречисление = Неопределено ИЛИ НЕ Метаданные.Перечисления.Содержит(МетаПеречисление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Индекс = Перечисления[МетаПеречисление.Имя].Индекс(Значение);
	Если Индекс < 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат МетаПеречисление.ЗначенияПеречисления[Индекс].Имя;
	
КонецФункции

Функция КлассОбъектаМетаданных(МетаОбъект)
	
	Если Метаданные.Справочники.Содержит(МетаОбъект) Тогда
		Возврат "Справочник";
	ИначеЕсли Метаданные.Документы.Содержит(МетаОбъект) Тогда
		Возврат "Документ";
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаОбъект) Тогда
		Возврат "Перечисление";
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МетаОбъект) Тогда
		Возврат "ПланВидовРасчета";
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МетаОбъект) Тогда
		Возврат "ПланВидовХарактеристик";
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МетаОбъект) Тогда
		Возврат "ПланСчетов";
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти
