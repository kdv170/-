// ============================================================================
// Модуль управляемой формы "ФормаЗагрузки" внешней обработки
// "Загрузка данных для НДФЛ из ЗУП через COM".
//
// Реквизиты и команды формы — см. FormDescription.md. Имена обязаны совпадать.
//
// Работает только в тонком/толстом клиенте Windows: используется COMObject.
// В веб-клиенте кнопки заблокированы (проверка в ПриСозданииНаСервере +
// предупреждение в обработчиках команд).
//
// Схема работы:
//   ПодключитьсяИПолучитьДанные  -> COMConnector.Connect(строка) ->
//     чтение метаданных регистра ЗУП -> построение запроса -> выборка ->
//     заполнение ТЗ ДанныеЗУП на форме + первичное сопоставление физлиц
//     (серверный вызов НайтиФизЛицо) ->
//   СоздатьОперациюУчетаНДФЛ    -> серверный вызов модуля объекта.
//
// Имя регистра по умолчанию: УчетДоходовДляИсчисленияНДФЛ.
// Поддерживается также РасчетыНалогоплательщиковСБюджетомПоНДФЛ и любой
// другой регистр накопления (универсальный режим).
// ============================================================================

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("АвтоТест") Тогда
		// Значения по умолчанию для первого открытия.
		Если НЕ ЗначениеЗаполнено(Объект.ВариантИБЗУП) Тогда
			Объект.ВариантИБЗУП = "Файловая";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.COMОбъект) Тогда
			Объект.COMОбъект = "V83.COMConnector";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ИмяРегистраЗУП) Тогда
			Объект.ИмяРегистраЗУП = "УчетДоходовДляИсчисленияНДФЛ";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
			Объект.НачалоПериода = НачалоМесяца(ТекущаяДата() - 30 * 24 * 3600);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда
			Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

// Главная кнопка: подключиться к ЗУП и заполнить таблицу данными регистра.
//
&НаКлиенте
Процедура ПодключитьсяИПолучитьДанные(Команда)

	#Если ВебКлиент Тогда
		ПоказатьПредупреждение(, "COM-соединение недоступно в веб-клиенте. "
			+ "Откройте обработку в тонком клиенте 1С на Windows.");
		Возврат;
	#КонецЕсли

	Если НЕ ПроверитьЗаполнениеПараметров() Тогда
		Возврат;
	КонецЕсли;

	Состояние("Подключение к ЗУП…");

	COMСоединение = Неопределено;
	Попытка
		COMСоединение = ПодключитьсяЧерезCOM();
	Исключение
		ПоказатьПредупреждение(, "Не удалось подключиться к ЗУП: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		Состояние("Чтение данных регистра «" + Объект.ИмяРегистраЗУП + "»…");
		ТаблицаИзЗУП = ВыполнитьЗапросКЗУП(COMСоединение);
		Состояние("Сопоставление физических лиц…");
		ЗаполнитьДанныеФормы(ТаблицаИзЗУП);
		ПоказатьОповещениеПользователя("Готово",
			, "Получено строк из ЗУП: " + Формат(Объект.ДанныеЗУП.Количество(), "ЧГ=0"));
	Исключение
		ПоказатьПредупреждение(, "Ошибка получения данных из ЗУП: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// COM-соединение закрывается освобождением переменной.
	COMСоединение = Неопределено;

КонецПроцедуры

// Кнопка: создать в ERP документ ОперацияУчетаНДФЛ по отмеченным строкам.
//
&НаКлиенте
Процедура СоздатьОперациюУчетаНДФЛ(Команда)

	Если Объект.ДанныеЗУП.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица данных пуста. Сначала получите данные из ЗУП.");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ПоказатьПредупреждение(, "Выберите организацию ERP для шапки документа.");
		Возврат;
	КонецЕсли;

	Отмечено = 0;
	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		Если Стр.Включать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, "Ни одна строка не отмечена флагом «Включать».");
		Возврат;
	КонецЕсли;

	Состояние("Создание документа Операция учета НДФЛ…");
	ТЗДляДокумента = ДанныеФормыВТаблицуЗначений();
	Результат = СоздатьОперациюНаСервере(ТЗДляДокумента);

	Если Результат.Создан Тогда
		Текст = Результат.Сообщение;
		Если ЗначениеЗаполнено(Результат.Ссылка) Тогда
			ПоказатьОповещениеПользователя("Документ создан", Результат.Ссылка, Текст);
			// Предлагаем открыть созданный документ.
			Оповещение = Новый ОписаниеОповещения("ПослеВопросаОткрытьДокумент", ЭтотОбъект,
				Новый Структура("Ссылка", Результат.Ссылка));
			ПоказатьВопрос(Оповещение, "Открыть созданный документ?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ПоказатьПредупреждение(, Текст);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОткрытьДокумент(Ответ, Параметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьЗначение(, Параметры.Ссылка);
	КонецЕсли;

КонецПроцедуры

// Служебная: отметить/снять флаг «Включать» у всех строк.
//
&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		Стр.Включать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОтметки(Команда)
	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		Стр.Включать = Ложь;
	КонецЦикла;
КонецПроцедуры

// Оставить только строки с проблемами сопоставления (удобно для разбора).
//
&НаКлиенте
Процедура ПоказатьТолькоПроблемные(Команда)
	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		Стр.Включать = НЕ ЗначениеЗаполнено(Стр.ФизЛицоERP);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область COMПодключение

// Проверяет обязательные параметры перед подключением.
//
&НаКлиенте
Функция ПроверитьЗаполнениеПараметров()

	Если Объект.ВариантИБЗУП = "Файловая" И ПустаяСтрока(СокрЛП(Объект.ПутьКБазеЗУП)) Тогда
		ПоказатьПредупреждение(, "Укажите каталог файловой базы ЗУП (например, C:\Bases\ZUP).");
		Возврат Ложь;
	КонецЕсли;

	Если Объект.ВариантИБЗУП = "Клиент-серверная"
		И (ПустаяСтрока(СокрЛП(Объект.СерверЗУП)) ИЛИ ПустаяСтрока(СокрЛП(Объект.ИмяБазыЗУП))) Тогда
		ПоказатьПредупреждение(, "Укажите сервер и имя информационной базы ЗУП.");
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		ПоказатьПредупреждение(, "Укажите период выгрузки.");
		Возврат Ложь;
	КонецЕсли;

	Если Объект.НачалоПериода > Объект.КонецПериода Тогда
		ПоказатьПредупреждение(, "Начало периода позже конца периода.");
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Объект.ИмяРегистраЗУП)) Тогда
		ПоказатьПредупреждение(, "Укажите имя регистра ЗУП (например, УчетДоходовДляИсчисленияНДФЛ).");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Строит строку соединения и подключается через COMConnector.
//
&НаКлиенте
Функция ПодключитьсяЧерезCOM()

	СтрокаСоединения = ПостроитьСтрокуСоединения();

	Попытка
		COMКоннектор = Новый COMObject(СокрЛП(Объект.COMОбъект));
	Исключение
		// Запасной вариант для старых платформ.
		COMКоннектор = Новый COMObject("V82.COMConnector");
	КонецПопытки;

	// Второй параметр Connect не используем (уровень совместимости по умолчанию).
	COMСоединение = COMКоннектор.Connect(СтрокаСоединения);
	Возврат COMСоединение;

КонецФункции

// Формирует строку соединения COMConnector.
//
&НаКлиенте
Функция ПостроитьСтрокуСоединения()

	Пользователь = СокрЛП(Объект.ПользовательЗУП);
	Пароль = Объект.ПарольЗУП; // пароль не обрезаем — в нем могут быть пробелы.

	Если Объект.ВариантИБЗУП = "Файловая" Тогда
		Шаблон = "File=""%1""; Usr=""%2""; Pwd=""%3"";";
		СтрокаСоединения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			Шаблон, СокрЛП(Объект.ПутьКБазеЗУП), Пользователь, Пароль);
	Иначе
		Шаблон = "Srvr=""%1""; Ref=""%2""; Usr=""%3""; Pwd=""%4"";";
		СтрокаСоединения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			Шаблон, СокрЛП(Объект.СерверЗУП), СокрЛП(Объект.ИмяБазыЗУП), Пользователь, Пароль);
	КонецЕсли;

	Возврат СтрокаСоединения;

КонецФункции

#КонецОбласти

#Область ЗапросКЗУП

// Выполняет запрос к регистру ЗУП и возвращает ТаблицаЗначений
// с колонками-приемниками документа ERP + служебными колонками.
// Состав полей запроса строится ПО МЕТАДАННЫМ базы ЗУП через COM,
// поэтому обработка устойчива к переименованию измерений между релизами.
//
&НаКлиенте
Функция ВыполнитьЗапросКЗУП(COMСоединение)

	ИмяРегистра = СокрЛП(Объект.ИмяРегистраЗУП);

	МетаРегистра = COMСоединение.Метаданные.РегистрыНакопления[ИмяРегистра];
	Если МетаРегистра = Неопределено Тогда
		ВызватьИсключение "В базе ЗУП не найден регистр накопления «" + ИмяРегистра + "». "
			+ "Проверьте имя (обычно: УчетДоходовДляИсчисленияНДФЛ).";
	КонецЕсли;

	// Собираем списки полей из метаданных ЗУП.
	ПоляИзмерений = Новый Массив;
	Для Каждого Измерение Из МетаРегистра.Измерения Цикл
		ПоляИзмерений.Добавить(Измерение.Имя);
	КонецЦикла;
	ПоляРесурсов = Новый Массив;
	Для Каждого Ресурс Из МетаРегистра.Ресурсы Цикл
		ПоляРесурсов.Добавить(Ресурс.Имя);
	КонецЦикла;
	ПоляРеквизитов = Новый Массив;
	Для Каждого Реквизит Из МетаРегистра.Реквизиты Цикл
		ПоляРеквизитов.Добавить(Реквизит.Имя);
	КонецЦикла;

	ЕстьОрганизация = ПоляИзмерений.Найти("ГоловнаяОрганизация") <> Неопределено
		ИЛИ ПоляИзмерений.Найти("Организация") <> Неопределено;
	ИмяПоляОрг = ?(ПоляИзмерений.Найти("ГоловнаяОрганизация") <> Неопределено,
		"ГоловнаяОрганизация", "Организация");

	// Текст запроса к таблице движений регистра (поддерживает Период/Регистратор).
	ТекстЗапроса = "ВЫБРАТЬ" + Символы.ПС;
	ТекстЗапроса = ТекстЗапроса + "	Таблица.Период КАК Период," + Символы.ПС;
	Для Каждого ИмяПоля Из ПоляИзмерений Цикл
		ТекстЗапроса = ТекстЗапроса + "	Таблица." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
		// Для ссылочных измерений сразу тянем расшифровку физлица/организации.
		Если ИмяПоля = "ФизическоеЛицо" Тогда
			ТекстЗапроса = ТекстЗапроса
				+ "	Таблица.ФизическоеЛицо.Наименование КАК ФизЛицоНаименование," + Символы.ПС
				+ "	Таблица.ФизическоеЛицо.ДатаРождения КАК ФизЛицоДатаРождения," + Символы.ПС;
			// ИНН может отсутствовать в старых релизах — проверим ниже по факту выборки.
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяПоля Из ПоляРесурсов Цикл
		ТекстЗапроса = ТекстЗапроса + "	Таблица." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
	КонецЦикла;
	Для Каждого ИмяПоля Из ПоляРеквизитов Цикл
		ТекстЗапроса = ТекстЗапроса + "	Таблица." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
	КонецЦикла;
	// Убираем последнюю запятую.
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 2) + Символы.ПС;
	ТекстЗапроса = ТекстЗапроса + "ИЗ" + Символы.ПС
		+ "	РегистрНакопления." + ИмяРегистра + " КАК Таблица" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ "	Таблица.Период МЕЖДУ &НачалоПериода И &КонецПериода" + Символы.ПС;

	ОтборПоОрганизации = ЗначениеЗаполнено(Объект.Организация) И ЕстьОрганизация;
	Если ОтборПоОрганизации Тогда
		ТекстЗапроса = ТекстЗапроса
			+ "	И Таблица." + ИмяПоляОрг + ".Наименование = &ОрганизацияНаименование" + Символы.ПС;
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "УПОРЯДОЧИТЬ ПО Период, ФизЛицоНаименование";

	Запрос = COMСоединение.NewObject("Запрос");
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));
	Если ОтборПоОрганизации Тогда
		Запрос.УстановитьПараметр("ОрганизацияНаименование", Строка(Объект.Организация));
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// Переносим выборку COM в локальную ТЗ с нормализованными именами колонок.
	ТЗ = Новая ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Включать", Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить("ФизЛицоНаименование", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ФизЛицоИНН", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ФизЛицоДатаРождения", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("ФизЛицоERP", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТЗ.Колонки.Добавить("ДатаПолученияДохода", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("МесяцНалоговогоПериода", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("КодДохода", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("КодВычета", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("СуммаДохода", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("СуммаВычета", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("СуммаНалога", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("ОрганизацияЗУП", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Проблема", Новый ОписаниеТипов("Строка"));

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Включать = Истина;

		Попытка
			НоваяСтрока.ФизЛицоНаименование = СокрЛП(Строка(Выборка.ФизЛицоНаименование));
		Исключение
			Попытка
				НоваяСтрока.ФизЛицоНаименование = СокрЛП(Строка(Выборка.ФизическоеЛицо));
			Исключение
			КонецПопытки;
		КонецПопытки;

		// ИНН физлица: пробуем три способа (поле выборки -> реквизит ссылки -> пусто).
		Попытка
			НоваяСтрока.ФизЛицоИНН = СокрЛП(Строка(Выборка.ФизическоеЛицо.ИНН));
		Исключение
			Попытка
				НоваяСтрока.ФизЛицоИНН = СокрЛП(Строка(Выборка.ИНН));
			Исключение
			КонецПопытки;
		КонецПопытки;

		Попытка
			НоваяСтрока.ФизЛицоДатаРождения = Выборка.ФизЛицоДатаРождения;
		Исключение
		КонецПопытки;

		// Даты.
		Попытка
			НоваяСтрока.ДатаПолученияДохода = Выборка.ДатаПолученияДохода;
		Исключение
			Попытка
				НоваяСтрока.ДатаПолученияДохода = Выборка.Период;
			Исключение
			КонецПопытки;
		КонецПопытки;
		Попытка
			НоваяСтрока.МесяцНалоговогоПериода = НачалоМесяца(Выборка.МесяцНалоговогоПериода);
		Исключение
			Попытка
				НоваяСтрока.МесяцНалоговогоПериода = НачалоМесяца(Выборка.Период);
			Исключение
			КонецПопытки;
		КонецПопытки;

		// Коды и суммы — только если такие поля есть в выборке.
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "КодДохода");
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "КодВычета");
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "СуммаДохода");
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "СуммаВычета");
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "СуммаНалога");
		// В регистре расчетов поле налога может называться иначе:
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "СуммаНалога", "Налог");
		ЗаполнитьПолеВыборки(Выборка, НоваяСтрока, "СуммаНалога", "СуммаНДФЛ");

		Попытка
			НоваяСтрока.ОрганизацияЗУП = СокрЛП(Строка(Выборка[ИмяПоляОрг]));
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

// Копирует поле из COM-выборки в строку ТЗ, если поле существует.
//
&НаКлиенте
Процедура ЗаполнитьПолеВыборки(Выборка, СтрокаТЗ, ИмяПоляТЗ, ИмяПоляВыборки = "")

	ИмяИсточника = ?(ПустаяСтрока(ИмяПоляВыборки), ИмяПоляТЗ, ИмяПоляВыборки);
	Попытка
		Значение = Выборка[ИмяИсточника];
	Исключение
		Возврат;
	КонецПопытки;

	Попытка
		// Ссылочные значения (КодДохода как справочник) приводим к строке кода.
		Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
			Попытка
				СтрокаТЗ[ИмяПоляТЗ] = СокрЛП(Строка(Значение.Код));
				Возврат;
			Исключение
			КонецПопытки;
			Попытка
				СтрокаТЗ[ИмяПоляТЗ] = СокрЛП(Строка(Значение));
				Возврат;
			Исключение
				Возврат;
			КонецПопытки;
		Иначе
			СтрокаТЗ[ИмяПоляТЗ] = Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеФормы

// Переносит ТЗ из ЗУП в реквизит формы ДанныеЗУП и выполняет
// первичное сопоставление физлиц на сервере ERP.
//
&НаКлиенте
Процедура ЗаполнитьДанныеФормы(ТаблицаИзЗУП)

	Объект.ДанныеЗУП.Очистить();

	Для Каждого СтрИсточник Из ТаблицаИзЗУП Цикл
		НоваяСтрока = Объект.ДанныеЗУП.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрИсточник);
	КонецЦикла;

	// Сопоставление — на сервере (там доступен справочник ФизическиеЛица).
	СопоставитьФизЛицНаСервере();

	// Помечаем проблемные строки.
	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		Если НЕ ЗначениеЗаполнено(Стр.ФизЛицоERP) Тогда
			Стр.Проблема = "Физлицо не сопоставлено";
			Если НЕ Объект.СоздаватьНеНайденныхФизлиц Тогда
				Стр.Включать = Ложь;
			КонецЕсли;
		Иначе
			Стр.Проблема = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Серверный проход сопоставления: для каждой строки ищем ссылку ERP.
//
&НаСервере
Процедура СопоставитьФизЛицНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		// Используем функцию из модуля объекта (там же — создание при загрузке).
		Найденный = ОбработкаОбъект.НайтиФизЛицо(
			Стр.ФизЛицоИНН, Стр.ФизЛицоНаименование, Стр.ФизЛицоДатаРождения);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Стр.ФизЛицоERP = Найденный;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Готовит ТЗ для передачи на сервер (ДанныеФормыКоллекция -> ТаблицаЗначений).
//
&НаКлиенте
Функция ДанныеФормыВТаблицуЗначений()

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Включать", Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить("ФизЛицоНаименование", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ФизЛицоИНН", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ФизЛицоДатаРождения", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("ФизЛицоERP", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТЗ.Колонки.Добавить("ДатаПолученияДохода", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("МесяцНалоговогоПериода", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("КодДохода", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("КодВычета", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("СуммаДохода", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("СуммаВычета", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("СуммаНалога", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("ОрганизацияЗУП", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Проблема", Новый ОписаниеТипов("Строка"));

	Для Каждого Стр Из Объект.ДанныеЗУП Цикл
		Новая = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Стр);
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

// Вызывает серверное создание документа из модуля объекта.
//
&НаСервере
Функция СоздатьОперациюНаСервере(ТЗДляДокумента)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	МесяцПериода = ?(ЗначениеЗаполнено(Объект.НачалоПериода),
		НачалоМесяца(Объект.НачалоПериода), НачалоМесяца(ТекущаяДата()));

	Комментарий = "Загружено из ЗУП через COM "
		+ Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'");

	Возврат ОбработкаОбъект.СоздатьОперациюУчетаНДФЛ(
		Объект.Организация, МесяцПериода, ТЗДляДокумента,
		Объект.СоздаватьНеНайденныхФизлиц, Комментарий);

КонецФункции

#КонецОбласти
