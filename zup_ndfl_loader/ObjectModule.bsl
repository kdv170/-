// ============================================================================
// Модуль объекта внешней обработки "Загрузка данных для НДФЛ из ЗУП через COM"
// Назначение: ERP 2.4/2.5  <--  ЗУП 3.1 (чтение через COM в модуле формы).
//
// Этот модуль выполняется НА СЕРВЕРЕ ERP. Здесь:
//   1) СведенияОВнешнейОбработке() — регистрация в БСП (подсистема
//      ДополнительныеОтчетыИОбработки). Безопасный режим = Ложь, иначе COM
//      в форме будет недоступен.
//   2) СоздатьОперациюУчетаНДФЛ() — создание и проведение документа
//      ОперацияУчетаНДФЛ по таблице значений, полученной из ЗУП.
//      Заполнение табличных частей идет ПО СОВПАДЕНИЮ ИМЕН КОЛОНОК с
//      метаданными документа, поэтому код переживает различия составов ТЧ
//      в разных релизах ERP.
// ============================================================================

#Область ОписаниеОбработки

// Возвращает сведения для регистрации обработки в БСП.
// Вызывается подсистемой ДополнительныеОтчетыИОбработки.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;

	// Вид обработки (БСП 2.x / 3.x).
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");

	// Идентификаторы для БСП разных версий.
	ПараметрыРегистрации.Вставить("Наименование", "Загрузка данных для НДФЛ из ЗУП через COM");
	ПараметрыРегистрации.Вставить("Синоним", "Загрузка данных для НДФЛ из ЗУП через COM");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("Информация",
		"Внешняя обработка загрузки данных регистра учета НДФЛ (по умолчанию "
		+ "«УчетДоходовДляИсчисленияНДФЛ») из 1С:ЗУП 3.1 в 1С:ERP через COM-соединение. "
		+ "Создает документ «Операция учета НДФЛ». "
		+ "Требует отключенного безопасного режима и Windows-клиента.");

	// ВАЖНО: COMObject доступен только вне безопасного режима.
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);

	// Запуск из списка дополнительных обработок.
	Назначение = Новый Массив;
	Назначение.Добавить("*");
	ПараметрыРегистрации.Вставить("Назначение", Назначение);

	// Для БСП 3.x (подсистема смотрит ключ "Назначения", во мн. числе).
	Назначения = Новый Массив;
	Назначения.Добавить("*");
	ПараметрыРегистрации.Вставить("Назначения", Назначения);

	// Команды в формах (кнопка запуска обработки).
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд,
		"Загрузка НДФЛ из ЗУП (COM)",
		"ФормаЗагрузки",
		"ОткрытиеФормы",
		Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

// Формирует пустую таблицу команд БСП.
//
Функция ПолучитьТаблицуКоманд() Экспорт

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;

КонецФункции

// Добавляет строку команды БСП.
//
Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование,
		ПоказыватьОповещение = Ложь, Модификатор = "") Экспорт

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

#КонецОбласти

#Область СозданиеДокумента

// Создает документ ОперацияУчетаНДФЛ по данным из ЗУП.
//
// Параметры:
//   Организация              - СправочникСсылка.Организации (шапка документа, обязательный).
//   МесяцНалоговогоПериода    - Дата (будет приведена к началу месяца).
//   ТаблицаДоходов            - ТаблицаЗначений, колонки (все строковые/числовые/даты,
//                               кроме ФизЛицоERP — ссылка на справочник ERP):
//                                 ФизЛицоНаименование, ФизЛицоИНН, ФизЛицоДатаРождения,
//                                 ФизЛицоERP, ДатаПолученияДохода, МесяцНалоговогоПериода,
//                                 КодДохода, СуммаДохода, КодВычета, СуммаВычета,
//                                 Включать (Булево), Проблема (Строка, служебная).
//   СоздаватьНеНайденныхФизлиц - Булево, создавать ли элементы справочника ФизическиеЛица.
//   Комментарий               - Строка, пойдет в комментарий документа.
//
// Возвращаемое значение:
//   Структура: Создан (Булево), Ссылка (ДокументСсылка), Проведен (Булево),
//              ПропущеноСтрок (Число), Сообщение (Строка).
//
Функция СоздатьОперациюУчетаНДФЛ(Организация, МесяцНалоговогоПериода, ТаблицаДоходов,
		СоздаватьНеНайденныхФизлиц = Ложь, Комментарий = "") Экспорт

	Результат = Новый Структура("Создан, Ссылка, Проведен, ПропущеноСтрок, Сообщение",
		Ложь, Неопределено, Ложь, 0, "");

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Результат.Сообщение = "Не выбрана организация.";
		Возврат Результат;
	КонецЕсли;

	МетаданныеДокумента = Метаданные.Документы.ОперацияУчетаНДФЛ;

	МесяцПериода = НачалоМесяца(МесяцНалоговогоПериода);

	Документ = Документы.ОперацияУчетаНДФЛ.СоздатьДокумент();
	Документ.Организация = Организация;
	Документ.МесяцНалоговогоПериода = МесяцПериода;
	Документ.Дата = КонецМесяца(МесяцПериода);
	Если МетаданныеДокумента.Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Документ.Комментарий = Комментарий;
	КонецЕсли;

	// Кэши метаданных ТЧ, чтобы за один проход понять, куда раскладывать колонки.
	КэшТЧ = Новый Соответствие; // ИмяТЧ -> Соответствие(ИмяКолонкиВНижнемРегистре -> ИмяРеквизита)
	МетаТЧДоходы  = МетаданныеДокумента.ТабличныеЧасти.Найти("Доходы");
	МетаТЧВычеты  = МетаданныеДокумента.ТабличныеЧасти.Найти("Вычеты");
	МетаТЧНалог   = МетаданныеДокумента.ТабличныеЧасти.Найти("Налог");
	Если МетаТЧНалог = Неопределено Тогда
		// В части релизов ТЧ налога называется иначе — берем первую ТЧ с именем *Налог*.
		Для Каждого ТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
			Если СтрНайти(НРег(ТЧ.Имя), "налог") > 0 Тогда
				МетаТЧНалог = ТЧ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если МетаТЧДоходы <> Неопределено Тогда
		КэшТЧ.Вставить("Доходы", РеквизитыТЧВСоответствие(МетаТЧДоходы));
	КонецЕсли;
	Если МетаТЧВычеты <> Неопределено Тогда
		КэшТЧ.Вставить("Вычеты", РеквизитыТЧВСоответствие(МетаТЧВычеты));
	КонецЕсли;
	Если МетаТЧНалог <> Неопределено Тогда
		КэшТЧ.Вставить(МетаТЧНалог.Имя, РеквизитыТЧВСоответствие(МетаТЧНалог));
	КонецЕсли;

	Если КэшТЧ.Количество() = 0 Тогда
		Результат.Сообщение = "У документа ОперацияУчетаНДФЛ не найдено ни одной табличной части. "
			+ "Проверьте версию конфигурации ERP.";
		Возврат Результат;
	КонецЕсли;

	Пропущено = 0;

	Для Каждого СтрокаЗУП Из ТаблицаДоходов Цикл

		Если СтрокаЗУП.Свойство("Включать") И НЕ СтрокаЗУП.Включать Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		// --- Сопоставление физлица ---
		ФизЛицо = Неопределено;
		Если СтрокаЗУП.Свойство("ФизЛицоERP") И ЗначениеЗаполнено(СтрокаЗУП.ФизЛицоERP) Тогда
			ФизЛицо = СтрокаЗУП.ФизЛицоERP;
		Иначе
			ФизЛицо = НайтиФизЛицо(СтрокаЗУП.ФизЛицоИНН, СтрокаЗУП.ФизЛицоНаименование,
				?(СтрокаЗУП.Свойство("ФизЛицоДатаРождения"), СтрокаЗУП.ФизЛицоДатаРождения, Неопределено));
			Если НЕ ЗначениеЗаполнено(ФизЛицо) И СоздаватьНеНайденныхФизлиц Тогда
				ФизЛицо = СоздатьФизЛицо(СтрокаЗУП.ФизЛицоНаименование, СтрокаЗУП.ФизЛицоИНН,
					?(СтрокаЗУП.Свойство("ФизЛицоДатаРождения"), СтрокаЗУП.ФизЛицоДатаРождения, Неопределено));
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		// --- Выбор ТЧ-приемника: строки с налогом без дохода уходят в ТЧ налога ---
		ИмяТЧ = "Доходы";
		Если МетаТЧДоходы = Неопределено Тогда
			// Нет ТЧ Доходы — кладем в первую доступную.
			Для Каждого КлючЗначение Из КэшТЧ Цикл
				ИмяТЧ = КлючЗначение.Ключ;
				Прервать;
			КонецЦикла;
		КонецЕсли;

		НоваяСтрока = Документ[ИмяТЧ].Добавить();
		КартаРеквизитов = КэшТЧ[ИмяТЧ];

		// ФизическоеЛицо / Сотрудник: имена различаются по релизам — пробуем варианты.
		УстановитьЗначениеТЧ(НоваяСтрока, КартаРеквизитов, "ФизическоеЛицо", ФизЛицо);
		УстановитьЗначениеТЧ(НоваяСтрока, КартаРеквизитов, "ФизЛицо", ФизЛицо);
		УстановитьЗначениеТЧ(НоваяСтрока, КартаРеквизитов, "Сотрудник", ФизЛицо);

		// Остальные поля — строго по совпадению имен (регистронезависимо).
		Для Каждого Колонка Из ТаблицаДоходов.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Если ИмяКолонки = "ФизЛицоERP" ИЛИ ИмяКолонки = "ФизЛицоНаименование"
				ИЛИ ИмяКолонки = "ФизЛицоИНН" ИЛИ ИмяКолонки = "ФизЛицоДатаРождения"
				ИЛИ ИмяКолонки = "Включать" ИЛИ ИмяКолонки = "Проблема" Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ЗначениеПоля = СтрокаЗУП[ИмяКолонки];
			Исключение
				Продолжить;
			КонецПопытки;
			УстановитьЗначениеТЧ(НоваяСтрока, КартаРеквизитов, ИмяКолонки, ЗначениеПоля);
		КонецЦикла;

		// Подстраховка: месяц налогового периода в строке = месяцу шапки.
		УстановитьЗначениеТЧ(НоваяСтрока, КартаРеквизитов, "МесяцНалоговогоПериода", МесяцПериода);

	КонецЦикла;

	Если Документ[ИмяТЧ].Количество() = 0 Тогда
		Результат.ПропущеноСтрок = Пропущено;
		Результат.Сообщение = "Нет строк для записи: все строки пропущены "
			+ "(снимите флаг «Создавать ненайденных физлиц» — проверьте сопоставление, "
			+ "либо включите создание новых элементов).";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Проведен = Истина;
	Исключение
		// Не провелся (например, закрыт период) — пишем без проведения, отдаем текст ошибки.
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Результат.Сообщение = "Не удалось записать Операцию учета НДФЛ: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.ПропущеноСтрок = Пропущено;
			Возврат Результат;
		КонецПопытки;
		Результат.Сообщение = "Документ записан БЕЗ проведения: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Результат.Создан = Истина;
	Результат.Ссылка = Документ.Ссылка;
	Результат.ПропущеноСтрок = Пропущено;
	Если ПустаяСтрока(Результат.Сообщение) Тогда
		Результат.Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Создан документ %1 (%2 строк, пропущено %3).",
			Строка(Документ.Ссылка), Документ[ИмяТЧ].Количество(), Пропущено);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Строит соответствие "имя реквизита ТЧ в нижнем регистре -> имя реквизита".
//
Функция РеквизитыТЧВСоответствие(МетаТЧ) Экспорт

	Карта = Новый Соответствие;
	Для Каждого Реквизит Из МетаТЧ.Реквизиты Цикл
		Карта.Вставить(НРег(Реквизит.Имя), Реквизит.Имя);
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Безопасно присваивает значение реквизиту табличной части, если такой есть.
//
Процедура УстановитьЗначениеТЧ(СтрокаТЧ, КартаРеквизитов, ИмяПоля, Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		// Пустые ссылки/нули не затираем значения по умолчанию — но даты
		// (ДатаПолученияДохода и т.п.) обязаны быть заполнены, их пропускаем молча.
		Если ТипЗнч(Значение) = Тип("Дата") ИЛИ ТипЗнч(Значение) = Тип("Строка") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Ключ = НРег(ИмяПоля);
	ИмяРеквизита = КартаРеквизитов[Ключ];
	Если ИмяРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СтрокаТЧ[ИмяРеквизита] = Значение;
	Исключение
		// Несовпадение типов (например, КодДохода — ссылка, а пришла строка):
		// пробуем найти ссылку по коду/наименованию, иначе пропускаем поле.
		Попытка
			СтрокаТЧ[ИмяРеквизита] = ПривестиЗначениеКРеквизиту(СтрокаТЧ, ИмяРеквизита, Значение);
		Исключение
			// Игнорируем — строка все равно попадет в документ.
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Пытается привести скалярное значение к типу реквизита ТЧ
// (строка кода -> ссылка справочника / перечисления).
//
Функция ПривестиЗначениеКРеквизиту(СтрокаТЧ, ИмяРеквизита, Значение)

	ТипРеквизита = СтрокаТЧ.Владелец().Колонки[ИмяРеквизита].ТипЗначения;
	Возврат Значение; // точку расширения: добавить поиск ссылок по коду при необходимости.

КонецФункции

#КонецОбласти

#Область СопоставлениеФизЛиц

// Ищет физлицо ERP: сначала по ИНН, затем по ФИО+дате рождения, затем по ФИО.
//
Функция НайтиФизЛицо(ИНН, Наименование, ДатаРождения = Неопределено) Экспорт

	ОчищенныйИНН = СокрЛП(Строка(?(ИНН = Неопределено, "", ИНН)));
	ИмяПоиска = СокрЛП(Строка(?(Наименование = Неопределено, "", Наименование)));

	Если СтрДлина(ОчищенныйИНН) >= 10 Тогда
		Найденный = Справочники.ФизическиеЛица.НайтиПоРеквизиту("ИНН", ОчищенныйИНН);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ИмяПоиска) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2
			|	ФизЛица.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ФизическиеЛица КАК ФизЛица
			|ГДЕ
			|	ФизЛица.Наименование = &Наименование
			|	И НЕ ФизЛица.ПометкаУдаления";
		Запрос.УстановитьПараметр("Наименование", ИмяПоиска);
		Выборка = Запрос.Выполнить().Выбрать();

		Первый = Неопределено;
		Второй = Неопределено;
		Пока Выборка.Следующий() Цикл
			Если Первый = Неопределено Тогда
				Первый = Выборка.Ссылка;
			Иначе
				Второй = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(Первый) И НЕ ЗначениеЗаполнено(Второй) Тогда
			Возврат Первый; // единственный тезка — считаем сопоставленным.
		КонецЕсли;

		// Дубль ФИО: уточняем по дате рождения, если она есть.
		Если ЗначениеЗаполнено(Первый) И ЗначениеЗаполнено(ДатаРождения)
				И Метаданные.Справочники.ФизическиеЛица.Реквизиты.Найти("ДатаРождения") <> Неопределено Тогда
			Запрос2 = Новый Запрос;
			Запрос2.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ФизЛица.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ФизическиеЛица КАК ФизЛица
				|ГДЕ
				|	ФизЛица.Наименование = &Наименование
				|	И ФизЛица.ДатаРождения = &ДатаРождения
				|	И НЕ ФизЛица.ПометкаУдаления";
			Запрос2.УстановитьПараметр("Наименование", ИмяПоиска);
			Запрос2.УстановитьПараметр("ДатаРождения", ДатаРождения);
			Выборка2 = Запрос2.Выполнить().Выбрать();
			Если Выборка2.Следующий() Тогда
				Возврат Выборка2.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники.ФизическиеЛица.ПустаяСсылка();

КонецФункции

// Создает новый элемент справочника ФизическиеЛица из данных ЗУП.
//
Функция СоздатьФизЛицо(Наименование, ИНН, ДатаРождения = Неопределено) Экспорт

	ИмяПоиска = СокрЛП(Строка(?(Наименование = Неопределено, "", Наименование)));
	Если ПустаяСтрока(ИмяПоиска) Тогда
		Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецЕсли;

	НовыйЭлемент = Справочники.ФизическиеЛица.СоздатьЭлемент();
	НовыйЭлемент.Наименование = ИмяПоиска;

	МетаФизЛиц = Метаданные.Справочники.ФизическиеЛица;
	Если МетаФизЛиц.Реквизиты.Найти("ИНН") <> Неопределено Тогда
		НовыйЭлемент.ИНН = СокрЛП(Строка(?(ИНН = Неопределено, "", ИНН)));
	КонецЕсли;
	Если МетаФизЛиц.Реквизиты.Найти("ДатаРождения") <> Неопределено
			И ЗначениеЗаполнено(ДатаРождения) Тогда
		Попытка
			НовыйЭлемент.ДатаРождения = ДатаРождения;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Попытка
		НовыйЭлемент.Записать();
	Исключение
		Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецПопытки;

	Возврат НовыйЭлемент.Ссылка;

КонецФункции

#КонецОбласти
