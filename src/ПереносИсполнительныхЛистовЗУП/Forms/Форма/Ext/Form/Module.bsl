КонецФункции

&НаКлиенте
Функция ИерархическийМетаCOM(Мета, Среда)
	
	Попытка
		Значение = СвойствоCOM(Мета, "Иерархический", "Hierarchical", Среда.Английский);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат БулевоCOM(Значение);
	
КонецФункции

&НаКлиенте
Функция ЭтоГруппаCOM(Ссылка, Среда)
	
	Чтение = ЧтениеСвойстваCOM(Ссылка, ?(Среда.Английский, "IsFolder", "ЭтоГруппа"));
	Если Не Чтение.Успех Тогда
		Чтение = ЧтениеСвойстваCOM(Ссылка, ?(Среда.Английский, "ЭтоГруппа", "IsFolder"));
	КонецЕсли;
	Если Чтение.Успех Тогда
		Возврат БулевоCOM(Чтение.Значение);
	КонецЕсли;
	Попытка
		Если Среда.Английский Тогда
			Возврат БулевоCOM(Ссылка.IsFolder());
		КонецЕсли;
		Возврат БулевоCOM(Ссылка.ЭтоГруппа());
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция БулевоCOM(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ОписаниеПусто()
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Пусто");
	Описание.Вставить("Представление", "");
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция ОписаниеПримитива(Тип, Данные, Представление)
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Примитив");
	Описание.Вставить("Тип", Тип);
	Описание.Вставить("Данные", Данные);
	Описание.Вставить("Представление", Представление);
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция ОписаниеНеподдерживаемого(ИмяТипа)
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Неподдерживаемый");
	Описание.Вставить("Тип", ИмяТипа);
	Описание.Вставить("Представление", "");
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция ИмяПредопределенныхCOM(Ссылка, Среда)
	
	Чтение = ЧтениеСвойстваCOM(Ссылка, ?(Среда.Английский, "PredefinedDataName", "ИмяПредопределенныхДанных"));
	Если Не Чтение.Успех Тогда
		Чтение = ЧтениеСвойстваCOM(Ссылка, ?(Среда.Английский, "ИмяПредопределенныхДанных", "PredefinedDataName"));
	КонецЕсли;
	Если Не Чтение.Успех Или Чтение.Значение = Неопределено Или Чтение.Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Чтение.Значение);
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьОшибкуЧтения(Результат)
	
	Результат.Успех = Ложь;
	ВставитьИсточник(Результат.Журнал, Результат.Источник, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьИсточник(СтрокиЖурнала, Источник, Позиция)
	
	Текст = ТекстИсточника(Источник);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	СтрокиЖурнала.Вставить(Позиция, Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекстИсточника(Строки, Источник)
	
	Текст = ТекстИсточника(Источник);
	Если ЗначениеЗаполнено(Текст) Тогда
		Строки.Добавить(Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстИсточника(Источник)
	
	Синоним = Источник.СинонимКонфигурации;
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Источник.Конфигурация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Источник: " + Синоним + ", версия " + Источник.ВерсияКонфигурации;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьЖурнал(СтрокиЖурнала, Текст)
	
	СтрокиЖурнала.Добавить(СкрытьСекрет(Текст));
	
КонецПроцедуры

&НаКлиенте
Функция СкрытьСекрет(Текст)
	
	Результат = СкрытьПараметрСоединения(Строка(Текст), "Pwd");
	Если ЗначениеЗаполнено(ПарольЗУП) Тогда
		Результат = СтрЗаменить(Результат, ПарольЗУП, "***");
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СкрытьПараметрСоединения(Текст, ИмяПараметра)
	
	Результат = Текст;
	Маркер = НРег(ИмяПараметра) + "=";
	ПоискС = 1;
	Позиция = СтрНайти(НРег(Результат), Маркер, , ПоискС);
	Пока Позиция > 0 Цикл
		НачалоЗначения = Позиция + СтрДлина(Маркер);
		Если Сред(Результат, НачалоЗначения, 1) = """" Тогда
			КонецЗначения = КонецКавычки(Результат, НачалоЗначения);
			Результат = Лев(Результат, НачалоЗначения) + "***" + Сред(Результат, КонецЗначения);
			ПоискС = НачалоЗначения + 3;
		Иначе
			КонецЗначения = СтрНайти(Результат, ";", , НачалоЗначения);
			Если КонецЗначения = 0 Тогда
				КонецЗначения = СтрДлина(Результат) + 1;
			КонецЕсли;
			Результат = Лев(Результат, НачалоЗначения - 1) + "***" + Сред(Результат, КонецЗначения);
			ПоискС = НачалоЗначения + 3;
		КонецЕсли;
		Позиция = СтрНайти(НРег(Результат), Маркер, , ПоискС);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КонецКавычки(Текст, ПозицияОткрывающей)
	
	Индекс = ПозицияОткрывающей + 1;
	Длина = СтрДлина(Текст);
	Пока Индекс <= Длина Цикл
		Если Сред(Текст, Индекс, 1) = """" Тогда
			Если Индекс < Длина И Сред(Текст, Индекс + 1, 1) = """" Тогда
				Индекс = Индекс + 2;
				Продолжить;
			КонецЕсли;
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Длина + 1;
	
КонецФункции

