&НаКлиенте
Функция ДатаВXML(Значение, Среда)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат XMLСтрока(Дата(1, 1, 1));
	КонецЕсли;
	
	Попытка
		Текст = XMLСтрокаCOM(Среда, Значение);
	Исключение
		Текст = "";
	КонецПопытки;
	Если ЭтоXMLДата(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат XMLСтрока(Дата(1, 1, 1));
	
КонецФункции

&НаКлиенте
Функция ЭтоXMLДата(Текст)
	
	Возврат СтрДлина(Текст) >= 19
		И Сред(Текст, 5, 1) = "-"
		И Сред(Текст, 8, 1) = "-"
		И Сред(Текст, 11, 1) = "T";
	
