#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаПереноса = НачалоДня(ТекущаяДатаСеанса());
	ПроводитьДокументы = Истина;
	ОбновлятьСуществующие = Истина;
	СоздаватьЭлементыСправочников = Истина;
	СоздаватьСотрудников = Ложь;
	ПредставлениеБазы = СтрШаблон("Текущая база: %1", Строка(Метаданные.Синоним));
	УстановитьВидимостьПодключенияНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоРегистру(Команда)
	
	#Если ВебКлиент Или МобильныйКлиент Тогда
		Журнал = "COM-соединение с базой ЗУП доступно в тонком или толстом клиенте Windows.";
		Возврат;
	#Иначе
		Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
			Журнал = "Не заполнена дата переноса.";
			Возврат;
		КонецЕсли;
		Если Не ПодключениеЗаполнено() Тогда
			Возврат;
		КонецЕсли;
		
		КлючОрганизации = КлючОрганизацииНаСервере();
		Если Не КлючОрганизации.Успех Тогда
			Журнал = КлючОрганизации.Сообщение;
			Возврат;
		КонецЕсли;
		
		Состояние("Подключение к базе ЗУП...");
		Результат = ПрочитатьДокументыИсточника(КлючОрганизации);
		Если Не Результат.Успех Тогда
			Журнал = СтрСоединить(Результат.Журнал, Символы.ПС);
			Возврат;
		КонецЕсли;
		
		ПринятьДокументыНаСервере(Результат.ДокументыФайла, Результат.Журнал, Результат.Источник);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ФайловаяБазаПриИзменении(Элемент)
	
	УстановитьВидимостьПодключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталог(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог файловой базы ЗУП";
	Если ЗначениеЗаполнено(КаталогБазы) Тогда
		Диалог.Каталог = КаталогБазы;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораКаталога", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКаталога(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КаталогБазы = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Результат = ПодготовитьФайлВыгрузкиНаСервере();
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПолучениеФайлаССервера(
		Новый ОписаниеОповещения("ПослеСохраненияФайла", ЭтотОбъект),
		Результат.Адрес,
		Результат.ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияФайла(ПолученныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПолученныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Файл переноса исполнительных листов";
	ПараметрыДиалога.Фильтр = "Файлы переноса (*.json)|*.json|Все файлы (*.*)|*.*";
	НачатьПомещениеФайлаНаСервер(
		Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект),
		,
		,
		,
		ПараметрыДиалога,
		УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьПомещенныйФайлНаСервере(ОписаниеПомещенногоФайла.Адрес);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВБазу(Команда)
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ЗагрузитьПослеПодтверждения", ЭтотОбъект),
		"Загрузить отмеченные исполнительные листы в текущую базу?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьПометку(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьПометку(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПометку(Пометка)
	
	Для Каждого СтрокаТаблицы Из Документы Цикл
		СтрокаТаблицы.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПодключенияНаСервере()
	
	Элементы.ГруппаПутьБазы.Видимость = ФайловаяБаза;
	Элементы.ГруппаСервер.Видимость = Не ФайловаяБаза;
	
КонецПроцедуры

&НаСервере
Функция КлючОрганизацииНаСервере()
	
	Результат = Новый Структура("Успех, Отбирать, ИНН, КПП, Сообщение", Истина, Ложь, "", "", "");
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Отбирать = Истина;
	МетаОрганизация = Организация.Метаданные();
	Если МетаОрганизация.Реквизиты.Найти("ИНН") = Неопределено Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = "У организации в текущей базе нет реквизита ИНН, сопоставить её с ЗУП нельзя.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.ИНН = СокрЛП(Организация.ИНН);
	Если Не ЗначениеЗаполнено(Результат.ИНН) Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = "У выбранной организации не заполнен ИНН. Организация в ЗУП ищется по ИНН и КПП.";
		Возврат Результат;
	КонецЕсли;
	Если МетаОрганизация.Реквизиты.Найти("КПП") <> Неопределено Тогда
		Результат.КПП = СокрЛП(Организация.КПП);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПринятьДокументыНаСервере(ДокументыФайла, СтрокиЖурнала, ОписаниеИсточника)
	
	Документы.Очистить();
	АдресДанных = "";
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаДанных Из Обработка.СтрокиПредпросмотра(ДокументыФайла, "К загрузке") Цикл
		ЗаполнитьЗначенияСвойств(Документы.Добавить(), СтрокаДанных);
	КонецЦикла;
	СохранитьДокументы(ДокументыФайла, ОписаниеИсточника);
	
	Если ТипЗнч(СтрокиЖурнала) = Тип("Массив") Тогда
		Журнал = СтрСоединить(СтрокиЖурнала, Символы.ПС);
	Иначе
		Журнал = Строка(СтрокиЖурнала);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьФайлВыгрузкиНаСервере()
	
	Результат = Новый Структура("Успех, Адрес, ИмяФайла", Ложь, "", "");
	ДокументыФайла = ОтобранныеДокументыФайла();
	Если ДокументыФайла = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ДокументыФайла.Количество() = 0 Тогда
		Журнал = "Отметьте документы, которые нужно выгрузить.";
		Возврат Результат;
	КонецЕсли;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Пакет = Обработка.СформироватьПакет(ДокументыФайла, ДатаПереноса);
	СохраненныйПакет = ПолучитьИзВременногоХранилища(АдресДанных);
	СкопироватьИсточникПакета(Пакет, СохраненныйПакет);
	Текст = Обработка.JSONПакета(Пакет);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
	
	Результат.Успех = Истина;
	Результат.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	Результат.ИмяФайла = "ИсполнительныеЛисты_" + Формат(ДатаПереноса, "ДФ=yyyyMMdd") + ".json";
	Журнал = СтрШаблон("Подготовлено к выгрузке документов: %1.", ДокументыФайла.Количество());
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПрочитатьПомещенныйФайлНаСервере(АдресФайла)
	
	Документы.Очистить();
	АдресДанных = "";
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Обработка = РеквизитФормыВЗначение("Объект");
	Чтение = Обработка.ПакетИзJSON(Текст);
	
	СтрокиЖурнала = Новый Массив;
	Если ЗначениеЗаполнено(Чтение.Предупреждение) Тогда
		СтрокиЖурнала.Добавить(Чтение.Предупреждение);
	КонецЕсли;
	СтрокиЖурнала.Добавить(Чтение.Сообщение);
	Если Не Чтение.Успех Тогда
		Журнал = СтрСоединить(СтрокиЖурнала, Символы.ПС);
		Возврат;
	КонецЕсли;
	
	Пакет = Чтение.Пакет;
	Если Пакет.Свойство("СинонимКонфигурации") И ЗначениеЗаполнено(Пакет.СинонимКонфигурации) Тогда
		СтрокиЖурнала.Добавить("Источник: " + Строка(Пакет.СинонимКонфигурации)
			+ ", версия " + Строка(СвойствоПакета(Пакет, "ВерсияКонфигурации")));
	КонецЕсли;
	Если Пакет.Свойство("ДатаПереноса") И ЗначениеЗаполнено(Пакет.ДатаПереноса) Тогда
		Попытка
			ДатаПереноса = НачалоДня(XMLЗначение(Тип("Дата"), Пакет.ДатаПереноса));
		Исключение
			// В файле некорректная дата, на форме остаётся прежнее значение.
		КонецПопытки;
		СтрокиЖурнала.Добавить("Дата переноса в файле: " + Формат(ДатаПереноса, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Обработка.СтрокиПредпросмотра(Пакет.Документы, "К загрузке") Цикл
		ЗаполнитьЗначенияСвойств(Документы.Добавить(), СтрокаДанных);
	КонецЦикла;
	ОписаниеИсточника = Новый Структура;
	ОписаниеИсточника.Вставить("Конфигурация", СвойствоПакета(Пакет, "Конфигурация"));
	ОписаниеИсточника.Вставить("ВерсияКонфигурации", СвойствоПакета(Пакет, "ВерсияКонфигурации"));
	ОписаниеИсточника.Вставить("СинонимКонфигурации", СвойствоПакета(Пакет, "СинонимКонфигурации"));
	СохранитьДокументы(Пакет.Документы, ОписаниеИсточника);
	Журнал = СтрСоединить(СтрокиЖурнала, Символы.ПС);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	ДокументыФайла = ОтобранныеДокументыФайла();
	Если ДокументыФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ДокументыФайла.Количество() = 0 Тогда
		Журнал = "Отметьте документы, которые нужно загрузить.";
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Соответствие;
	Для Каждого ДанныеДокумента Из ДокументыФайла Цикл
		Отбор.Вставить(ДанныеДокумента.УИД, Истина);
	КонецЦикла;
	
	Пакет = ПолучитьИзВременногоХранилища(АдресДанных);
	Обработка = РеквизитФормыВЗначение("Объект");
	Итог = Обработка.ЗагрузитьПакет(Пакет, ПараметрыЗагрузкиФормы(), Отбор);
	Журнал = СтрСоединить(Итог.Журнал, Символы.ПС);
	
	Для Каждого ИтогДокумента Из Итог.ПоДокументам Цикл
		Для Каждого СтрокаТаблицы Из Документы Цикл
			Если СтрокаТаблицы.УИД = ИтогДокумента.УИД Тогда
				СтрокаТаблицы.Состояние = Обработка.ПредставлениеСостояния(ИтогДокумента.Состояние);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОтобранныеДокументыФайла()
	
	Если Не ЭтоАдресВременногоХранилища(АдресДанных) Тогда
		Журнал = "Сначала заполните список из ЗУП или прочитайте файл переноса.";
		Возврат Неопределено;
	КонецЕсли;
	
	Пакет = ПолучитьИзВременногоХранилища(АдресДанных);
	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("Документы") Тогда
		Журнал = "Данные списка устарели. Заполните его заново.";
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Документы Цикл
		Если СтрокаТаблицы.Пометка И ЗначениеЗаполнено(СтрокаТаблицы.УИД) Тогда
			Отбор.Вставить(СтрокаТаблицы.УИД, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Отобранные = Новый Массив;
	Для Каждого ДанныеДокумента Из Пакет.Документы Цикл
		Если Отбор[ДанныеДокумента.УИД] <> Неопределено Тогда
			Отобранные.Добавить(ДанныеДокумента);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;
	
КонецФункции

&НаСервере
Процедура СохранитьДокументы(ДокументыФайла, ОписаниеИсточника = Неопределено)
	
	Пакет = Новый Структура;
	Пакет.Вставить("ВерсияФормата", "1.0");
	Пакет.Вставить("ВидДанных", "ИсполнительныеЛисты");
	Пакет.Вставить("ДатаПереноса", XMLСтрока(НачалоДня(ДатаПереноса)));
	Пакет.Вставить("Документы", ДокументыФайла);
	Если ТипЗнч(ОписаниеИсточника) = Тип("Структура") Тогда
		Для Каждого ИмяПоля Из СтрРазделить("Конфигурация,ВерсияКонфигурации,СинонимКонфигурации", ",", Ложь) Цикл
			ЗначениеИсточника = "";
			Если ОписаниеИсточника.Свойство(ИмяПоля, ЗначениеИсточника) И ЗначениеЗаполнено(ЗначениеИсточника) Тогда
				Пакет.Вставить(ИмяПоля, Строка(ЗначениеИсточника));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресДанных) Тогда
		АдресДанных = ПоместитьВоВременноеХранилище(Пакет, АдресДанных);
	Иначе
		АдресДанных = ПоместитьВоВременноеХранилище(Пакет, УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыЗагрузкиФормы()
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	ПараметрыЗагрузки.Вставить("ОбновлятьСуществующие", ОбновлятьСуществующие);
	ПараметрыЗагрузки.Вставить("СоздаватьЭлементыСправочников", СоздаватьЭлементыСправочников);
	ПараметрыЗагрузки.Вставить("СоздаватьСотрудников", СоздаватьСотрудников);
	Возврат ПараметрыЗагрузки;
	
КонецФункции

&НаСервере
Процедура СкопироватьИсточникПакета(Пакет, СохраненныйПакет)
	
	Если ТипЗнч(СохраненныйПакет) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("Конфигурация,ВерсияКонфигурации,СинонимКонфигурации", ",", Ложь) Цикл
		ЗначениеИсточника = СвойствоПакета(СохраненныйПакет, ИмяПоля);
		Если ЗначениеЗаполнено(ЗначениеИсточника) Тогда
			Пакет.Вставить(ИмяПоля, ЗначениеИсточника);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СвойствоПакета(Пакет, Имя)
	
	Значение = Неопределено;
	Если Пакет.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьПодключения()
	
	Элементы.ГруппаПутьБазы.Видимость = ФайловаяБаза;
	Элементы.ГруппаСервер.Видимость = Не ФайловаяБаза;
	
КонецПроцедуры

&НаКлиенте
Функция ПодключениеЗаполнено()
	
	Если ФайловаяБаза Тогда
		Если Не ЗначениеЗаполнено(СокрЛП(КаталогБазы)) Тогда
			Журнал = "Укажите каталог файловой базы ЗУП.";
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(СерверЗУП)) Или Не ЗначениеЗаполнено(СокрЛП(ИмяБазыЗУП)) Тогда
		Журнал = "Укажите сервер и имя базы ЗУП.";
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

#Если Не ВебКлиент И Не МобильныйКлиент Тогда

#Область ЧтениеИсточникаCOM

&НаКлиенте
Функция ПрочитатьДокументыИсточника(КлючОрганизации)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ДокументыФайла", Новый Массив);
	Результат.Вставить("Журнал", Новый Массив);
	Результат.Вставить("Источник", Новый Структура("Конфигурация, ВерсияКонфигурации, СинонимКонфигурации", "", "", ""));
	
	Соединение = Неопределено;
	Среда = Неопределено;
	Попытка
		Соединение = ОткрытьСоединениеИсточника(Результат.Журнал);
		Если Соединение <> Неопределено Тогда
			Среда = НоваяСредаCOM(Соединение);
			ПрочитатьДокументыВСоединении(Среда, КлючОрганизации, Результат);
		КонецЕсли;
	Исключение
		ДобавитьЖурнал(Результат.Журнал, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗавершитьОшибкуЧтения(Результат);
		Результат.Успех = Ложь;
	КонецПопытки;
	
	Если Среда <> Неопределено Тогда
		Среда.Соединение = Неопределено;
	КонецЕсли;
	Среда = Неопределено;
	Соединение = Неопределено;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОткрытьСоединениеИсточника(СтрокиЖурнала)
	
	Попытка
		Коннектор = Новый COMОбъект("V83.COMConnector");
	Исключение
		ДобавитьЖурнал(СтрокиЖурнала, "Не удалось создать V83.COMConnector. Запустите обработку в тонком или толстом клиенте Windows той же разрядности, что и COM-коннектор платформы 1С. Если включена защита от опасных действий, разрешите их для этой обработки.");
		Возврат Неопределено;
	КонецПопытки;
	
	СтрокаСоединения = СтрокаСоединенияCOM();
	Попытка
		Соединение = Коннектор.Connect(СтрокаСоединения);
	Исключение
		ДобавитьЖурнал(СтрокиЖурнала, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		СтрокаСоединения = "";
		Возврат Неопределено;
	КонецПопытки;
	
	СтрокаСоединения = "";
	Коннектор = Неопределено;
	Возврат Соединение;
	
КонецФункции

&НаКлиенте
Функция СтрокаСоединенияCOM()
	
	Если ФайловаяБаза Тогда
		ОписаниеБазы = "File=""" + ЭкранироватьКавычки(СокрЛП(КаталогБазы)) + """;";
	Иначе
		ОписаниеБазы = "Srvr=""" + ЭкранироватьКавычки(СокрЛП(СерверЗУП)) + """;Ref="""
			+ ЭкранироватьКавычки(СокрЛП(ИмяБазыЗУП)) + """;";
	КонецЕсли;
	
	Возврат ОписаниеБазы
		+ "Usr=""" + ЭкранироватьКавычки(СокрЛП(ПользовательЗУП)) + """;"
		+ "Pwd=""" + ЭкранироватьКавычки(ПарольЗУП) + """;";
	
КонецФункции

&НаКлиенте
Функция ЭкранироватьКавычки(Значение)
	
	Возврат СтрЗаменить(Строка(Значение), """", """""");
	
КонецФункции

&НаКлиенте
Функция НоваяСредаCOM(Соединение)
	
	Среда = Новый Структура;
	Среда.Вставить("Соединение", Соединение);
	Среда.Вставить("Английский", Ложь);
	Среда.Вставить("МетодСоздания", "NewObject");
	ОпределитьИнтерфейсCOM(Среда);
	Возврат Среда;
	
КонецФункции

&НаКлиенте
Процедура ОпределитьИнтерфейсCOM(Среда)
	
	Соединение = Среда.Соединение;
	Если СоздаетсяОбъектCOM(Соединение, "NewObject", "Query") Тогда
		Среда.Английский = Истина;
		Среда.МетодСоздания = "NewObject";
		Возврат;
	КонецЕсли;
	Если СоздаетсяОбъектCOM(Соединение, "NewObject", "Запрос") Тогда
		Среда.Английский = Ложь;
		Среда.МетодСоздания = "NewObject";
		Возврат;
	КонецЕсли;
	Если СоздаетсяОбъектCOM(Соединение, "НовыйОбъект", "Запрос") Тогда
		Среда.Английский = Ложь;
		Среда.МетодСоздания = "НовыйОбъект";
		Возврат;
	КонецЕсли;
	Если СоздаетсяОбъектCOM(Соединение, "НовыйОбъект", "Query") Тогда
		Среда.Английский = Истина;
		Среда.МетодСоздания = "НовыйОбъект";
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение "COM-соединение не создаёт объект запроса. Проверьте версию платформы базы ЗУП.";
	
КонецПроцедуры

&НаКлиенте
Функция СоздаетсяОбъектCOM(Соединение, Метод, ИмяТипа)
	
	Попытка
		Если Метод = "NewObject" Тогда
			Соединение.NewObject(ИмяТипа);
		Иначе
			Соединение.НовыйОбъект(ИмяТипа);
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция НовыйОбъектCOM(Среда, ИмяРус, ИмяАнгл)
	
	ИмяТипа = ?(Среда.Английский, ИмяАнгл, ИмяРус);
	Если Среда.МетодСоздания = "НовыйОбъект" Тогда
		Возврат Среда.Соединение.НовыйОбъект(ИмяТипа);
	КонецЕсли;
	Возврат Среда.Соединение.NewObject(ИмяТипа);
	
КонецФункции

&НаКлиенте
Процедура ПрочитатьДокументыВСоединении(Среда, КлючОрганизации, Результат)
	
	ЗаполнитьИсточник(Среда, Результат);
	Состояние("Чтение регистра ПлановыеУдержания...");
	
	ОписаниеЗапроса = ОписаниеЗапросаИсточника(Среда, КлючОрганизации.Отбирать);
	Если Не ЗначениеЗаполнено(ОписаниеЗапроса.Текст) Тогда
		ДобавитьЖурнал(Результат.Журнал, ОписаниеЗапроса.ТекстОшибки);
		ЗавершитьОшибкуЧтения(Результат);
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МоментСреза", КонецДня(ДатаПереноса));
	ПараметрыЗапроса.Вставить("ДатаПереноса", НачалоДня(ДатаПереноса));
	Если КлючОрганизации.Отбирать Тогда
		ПоискОрганизации = ОрганизацияИсточника(Среда, КлючОрганизации, Результат.Журнал);
		Если Не ПоискОрганизации.Успех Тогда
			ЗавершитьОшибкуЧтения(Результат);
			Возврат;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("Организация", ПоискОрганизации.Ссылка);
	КонецЕсли;
	
	Строки = ПрочитатьВыборкуCOM(Среда, ОписаниеЗапроса.Текст, ПараметрыЗапроса, ОписаниеЗапроса.Поля, Результат.Журнал);
	Если Строки = Неопределено Тогда
		ЗавершитьОшибкуЧтения(Результат);
		Возврат;
	КонецЕсли;
	
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрокаВыборки Из Строки Цикл
		УИД = УИДСсылкиCOM(СтрокаВыборки.ДокументОснование, Среда);
		Если ЭтоПустойУИД(УИД) Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы[УИД];
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Ссылка, Строки", СтрокаВыборки.ДокументОснование, Новый Массив);
			Группы.Вставить(УИД, Группа);
			Порядок.Добавить(УИД);
		КонецЕсли;
		Группа.Строки.Добавить(СтрокаРегистраCOM(СтрокаВыборки, ОписаниеЗапроса.Поля, Среда));
	КонецЦикла;
	Строки = Неопределено;
	
	НомерДокумента = 0;
	Для Каждого УИД Из Порядок Цикл
		НомерДокумента = НомерДокумента + 1;
		Состояние(СтрШаблон("Чтение документов ЗУП: %1", Формат(НомерДокумента, "ЧГ=0")));
		ОбработкаПрерыванияПользователя();
		
		Группа = Группы[УИД];
		Попытка
			ДокОбъект = ОбъектПоСсылкеCOM(Группа.Ссылка, Среда);
		Исключение
			ДобавитьЖурнал(Результат.Журнал, "Не прочитан документ " + УИД + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если ДокОбъект = Неопределено Или ДокОбъект = Null Тогда
			ДобавитьЖурнал(Результат.Журнал, "Не найден объект документа " + УИД);
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДанныеДокумента = СериализоватьДокументCOM(ДокОбъект, Группа.Строки, УИД, Среда);
		Исключение
			ДобавитьЖурнал(Результат.Журнал, "Не прочитан документ " + УИД + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ДокОбъект = Неопределено;
			Группа.Ссылка = Неопределено;
			Продолжить;
		КонецПопытки;
		
		Результат.ДокументыФайла.Добавить(ДанныеДокумента);
		ДокОбъект = Неопределено;
		Группа.Ссылка = Неопределено;
	КонецЦикла;
	Группы = Неопределено;
	
	ДеньПереноса = НачалоДня(ДатаПереноса);
	МоментСреза = КонецДня(ДатаПереноса);
	Шапка = Новый Массив;
	Шапка.Добавить(СтрШаблон(
		"На %1 действующих исполнительных листов: %2.",
		Формат(ДеньПереноса, "ДФ=dd.MM.yyyy"),
		Результат.ДокументыФайла.Количество()));
	ДобавитьТекстИсточника(Шапка, Результат.Источник);
	Шапка.Добавить(СтрШаблон(
		"Срез регистра ПлановыеУдержания на %1.",
		Формат(МоментСреза, "ДФ=dd.MM.yyyy ЧЧ:мм:сс")));
	Для ИндексШапки = 0 По Шапка.ВГраница() Цикл
		Результат.Журнал.Вставить(ИндексШапки, Шапка[ИндексШапки]);
	КонецЦикла;
	Если Не ОписаниеЗапроса.ЕстьИспользуется Тогда
		ДобавитьЖурнал(Результат.Журнал, "У регистра нет ресурса Используется: в выборку попали все записи среза по исполнительным листам.");
	КонецЕсли;
	Результат.Успех = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИсточник(Среда, Результат)
	
	Мета = МетаданныеСоединения(Среда);
	Результат.Источник.Конфигурация = Строка(СвойствоCOM(Мета, "Имя", "Name", Среда.Английский));
	Результат.Источник.ВерсияКонфигурации = Строка(СвойствоCOM(Мета, "Версия", "Version", Среда.Английский));
	Попытка
		Результат.Источник.СинонимКонфигурации = Строка(СвойствоCOM(Мета, "Синоним", "Synonym", Среда.Английский));
	Исключение
		Результат.Источник.СинонимКонфигурации = Результат.Источник.Конфигурация;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеЗапросаИсточника(Среда, ОтбиратьОрганизацию)
	
	Описание = Новый Структура("Текст, Поля, ЕстьИспользуется, ТекстОшибки", "", Новый Массив, Ложь, "");
	Мета = МетаданныеСоединения(Среда);
	МетаРегистр = НайтиМетаCOM(КоллекцияМетаCOM(Мета, "РегистрыСведений", "InformationRegisters", Среда), "ПлановыеУдержания", Среда);
	Если МетаРегистр = Неопределено Тогда
		Описание.ТекстОшибки = "В базе ЗУП нет регистра сведений ПлановыеУдержания.";
		Возврат Описание;
	КонецЕсли;
	МетаДокумент = НайтиМетаCOM(КоллекцияМетаCOM(Мета, "Документы", "Documents", Среда), "ИсполнительныйЛист", Среда);
	Если МетаДокумент = Неопределено Тогда
		Описание.ТекстОшибки = "В базе ЗУП нет документа ИсполнительныйЛист.";
		Возврат Описание;
	КонецЕсли;
	Если РегистрНепериодический(МетаРегистр, Среда) Тогда
		Описание.ТекстОшибки = "Регистр ПлановыеУдержания в базе ЗУП непериодический, срез на дату построить нельзя.";
		Возврат Описание;
	КонецЕсли;
	Если Не ПолеРегистраCOM(МетаРегистр, "ДокументОснование", Среда) Тогда
		Описание.ТекстОшибки = "У регистра ПлановыеУдержания в базе ЗУП нет измерения ДокументОснование.";
		Возврат Описание;
	КонецЕсли;
	Если ОтбиратьОрганизацию И Не РеквизитМетаСуществует(МетаДокумент, "Организация", Среда) Тогда
		Описание.ТекстОшибки = "У документа ИсполнительныйЛист в базе ЗУП нет реквизита Организация, отбор по организации невозможен.";
		Возврат Описание;
	КонецЕсли;
	
	ПоляЗапроса = Новый Массив;
	ПоляЗапроса.Добавить("Срез.ДокументОснование КАК ДокументОснование");
	Описание.Поля.Добавить("ДокументОснование");
	ПоляЗапроса.Добавить("Срез.Период КАК ПериодЗаписи");
	Описание.Поля.Добавить("ПериодЗаписи");
	Для Каждого ИмяПоля Из СтрРазделить("Сотрудник,ФизическоеЛицо,Организация,ГоловнаяОрганизация,Удержание,Размер,Используется,ДействуетДо", ",", Ложь) Цикл
		Если ПолеРегистраCOM(МетаРегистр, ИмяПоля, Среда) Тогда
			ПоляЗапроса.Добавить("Срез." + ИмяПоля + " КАК " + ИмяПоля);
			Описание.Поля.Добавить(ИмяПоля);
			Если ИмяПоля = "Используется" Тогда
				Описание.ЕстьИспользуется = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Условия = Новый Массив;
	Условия.Добавить("Док.Проведен");
	Условия.Добавить("НЕ Док.ПометкаУдаления");
	Условия.Добавить("Срез.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИсполнительныйЛист.ПустаяСсылка)");
	Если Описание.ЕстьИспользуется Тогда
		Условия.Добавить("Срез.Используется");
	КонецЕсли;
	Если ПолеРегистраCOM(МетаРегистр, "ДействуетДо", Среда) Тогда
		Условия.Добавить("(Срез.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Срез.ДействуетДо >= &ДатаПереноса)");
	КонецЕсли;
	Если РеквизитМетаСуществует(МетаДокумент, "ДатаОкончания", Среда) Тогда
		Условия.Добавить("(Док.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Док.ДатаОкончания >= &ДатаПереноса)");
	КонецЕсли;
	Если ОтбиратьОрганизацию Тогда
		Условия.Добавить("Док.Организация = &Организация");
	КонецЕсли;
	
	Описание.Текст =
	"ВЫБРАТЬ
	|	" + СтрСоединить(ПоляЗапроса, "," + Символы.ПС + Символы.Таб) + "
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(
	|			&МоментСреза,
	|			ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист) КАК Срез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК Док
	|		ПО Срез.ДокументОснование = Док.Ссылка
	|ГДЕ
	|	" + СтрСоединить(Условия, Символы.ПС + Символы.Таб + "И ") + "
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция РегистрНепериодический(МетаРегистр, Среда)
	
	Попытка
		Значение = СвойствоCOM(МетаРегистр, "ПериодичностьРегистраСведений", "InformationRegisterPeriodicity", Среда.Английский);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Текст = НРег(Строка(Значение));
	Возврат СтрНайти(Текст, "непериод") > 0 Или СтрНайти(Текст, "nonperiod") > 0;
	
КонецФункции

&НаКлиенте
