#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаПереноса = НачалоДня(ТекущаяДатаСеанса());
	ПроводитьДокументы = Истина;
	ОбновлятьСуществующие = Истина;
	СоздаватьЭлементыСправочников = Истина;
	СоздаватьСотрудников = Ложь;
	ПредставлениеБазы = СтрШаблон("Текущая база: %1", Строка(Метаданные.Синоним));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоРегистру(Команда)
	
	ЗаполнитьПоРегиструНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Результат = ПодготовитьФайлВыгрузкиНаСервере();
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПолучениеФайлаССервера(
		Новый ОписаниеОповещения("ПослеСохраненияФайла", ЭтотОбъект),
		Результат.Адрес,
		Результат.ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияФайла(ПолученныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПолученныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Файл переноса исполнительных листов";
	ПараметрыДиалога.Фильтр = "Файлы переноса (*.json)|*.json|Все файлы (*.*)|*.*";
	НачатьПомещениеФайлаНаСервер(
		Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект),
		,
		,
		,
		ПараметрыДиалога,
		УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьПомещенныйФайлНаСервере(ОписаниеПомещенногоФайла.Адрес);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВБазу(Команда)
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ЗагрузитьПослеПодтверждения", ЭтотОбъект),
		"Загрузить отмеченные исполнительные листы в текущую базу?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьПометку(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьПометку(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПометку(Пометка)
	
	Для Каждого СтрокаТаблицы Из Документы Цикл
		СтрокаТаблицы.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоРегиструНаСервере()
	
	Документы.Очистить();
	АдресДанных = "";
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ВыбратьДействующиеДокументы(ДатаПереноса, Организация);
	Журнал = СтрСоединить(Результат.Журнал, Символы.ПС);
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Результат.Строки Цикл
		ЗаполнитьЗначенияСвойств(Документы.Добавить(), СтрокаДанных);
	КонецЦикла;
	СохранитьДокументы(Результат.ДокументыФайла);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьФайлВыгрузкиНаСервере()
	
	Результат = Новый Структура("Успех, Адрес, ИмяФайла", Ложь, "", "");
	ДокументыФайла = ОтобранныеДокументыФайла();
	Если ДокументыФайла = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ДокументыФайла.Количество() = 0 Тогда
		Журнал = "Отметьте документы, которые нужно выгрузить.";
		Возврат Результат;
	КонецЕсли;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Пакет = Обработка.СформироватьПакет(ДокументыФайла, ДатаПереноса);
	Текст = Обработка.JSONПакета(Пакет);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
	
	Результат.Успех = Истина;
	Результат.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	Результат.ИмяФайла = "ИсполнительныеЛисты_" + Формат(ДатаПереноса, "ДФ=yyyyMMdd") + ".json";
	Журнал = СтрШаблон("Подготовлено к выгрузке документов: %1.", ДокументыФайла.Количество());
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПрочитатьПомещенныйФайлНаСервере(АдресФайла)
	
	Документы.Очистить();
	АдресДанных = "";
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Обработка = РеквизитФормыВЗначение("Объект");
	Чтение = Обработка.ПакетИзJSON(Текст);
	
	СтрокиЖурнала = Новый Массив;
	Если ЗначениеЗаполнено(Чтение.Предупреждение) Тогда
		СтрокиЖурнала.Добавить(Чтение.Предупреждение);
	КонецЕсли;
	СтрокиЖурнала.Добавить(Чтение.Сообщение);
	Если Не Чтение.Успех Тогда
		Журнал = СтрСоединить(СтрокиЖурнала, Символы.ПС);
		Возврат;
	КонецЕсли;
	
	Пакет = Чтение.Пакет;
	Если Пакет.Свойство("СинонимКонфигурации") И ЗначениеЗаполнено(Пакет.СинонимКонфигурации) Тогда
		СтрокиЖурнала.Добавить("Источник: " + Строка(Пакет.СинонимКонфигурации)
			+ ", версия " + Строка(СвойствоПакета(Пакет, "ВерсияКонфигурации")));
	КонецЕсли;
	Если Пакет.Свойство("ДатаПереноса") И ЗначениеЗаполнено(Пакет.ДатаПереноса) Тогда
		Попытка
			ДатаПереноса = НачалоДня(XMLЗначение(Тип("Дата"), Пакет.ДатаПереноса));
		Исключение
			// В файле некорректная дата, на форме остаётся прежнее значение.
		КонецПопытки;
		СтрокиЖурнала.Добавить("Дата переноса в файле: " + Формат(ДатаПереноса, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Обработка.СтрокиПредпросмотра(Пакет.Документы, "К загрузке") Цикл
		ЗаполнитьЗначенияСвойств(Документы.Добавить(), СтрокаДанных);
	КонецЦикла;
	СохранитьДокументы(Пакет.Документы);
	Журнал = СтрСоединить(СтрокиЖурнала, Символы.ПС);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	ДокументыФайла = ОтобранныеДокументыФайла();
	Если ДокументыФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ДокументыФайла.Количество() = 0 Тогда
		Журнал = "Отметьте документы, которые нужно загрузить.";
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Соответствие;
	Для Каждого ДанныеДокумента Из ДокументыФайла Цикл
		Отбор.Вставить(ДанныеДокумента.УИД, Истина);
	КонецЦикла;
	
	Пакет = ПолучитьИзВременногоХранилища(АдресДанных);
	Обработка = РеквизитФормыВЗначение("Объект");
	Итог = Обработка.ЗагрузитьПакет(Пакет, ПараметрыЗагрузкиФормы(), Отбор);
	Журнал = СтрСоединить(Итог.Журнал, Символы.ПС);
	
	Для Каждого ИтогДокумента Из Итог.ПоДокументам Цикл
		Для Каждого СтрокаТаблицы Из Документы Цикл
			Если СтрокаТаблицы.УИД = ИтогДокумента.УИД Тогда
				СтрокаТаблицы.Состояние = Обработка.ПредставлениеСостояния(ИтогДокумента.Состояние);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОтобранныеДокументыФайла()
	
	Если Не ЭтоАдресВременногоХранилища(АдресДанных) Тогда
		Журнал = "Сначала заполните список по регистру или прочитайте файл переноса.";
		Возврат Неопределено;
	КонецЕсли;
	
	Пакет = ПолучитьИзВременногоХранилища(АдресДанных);
	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("Документы") Тогда
		Журнал = "Данные списка устарели. Заполните его заново.";
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Документы Цикл
		Если СтрокаТаблицы.Пометка И ЗначениеЗаполнено(СтрокаТаблицы.УИД) Тогда
			Отбор.Вставить(СтрокаТаблицы.УИД, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Отобранные = Новый Массив;
	Для Каждого ДанныеДокумента Из Пакет.Документы Цикл
		Если Отбор[ДанныеДокумента.УИД] <> Неопределено Тогда
			Отобранные.Добавить(ДанныеДокумента);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;
	
КонецФункции

&НаСервере
Процедура СохранитьДокументы(ДокументыФайла)
	
	Пакет = Новый Структура;
	Пакет.Вставить("ВерсияФормата", "1.0");
	Пакет.Вставить("ВидДанных", "ИсполнительныеЛисты");
	Пакет.Вставить("ДатаПереноса", XMLСтрока(НачалоДня(ДатаПереноса)));
	Пакет.Вставить("Документы", ДокументыФайла);
	
	Если ЭтоАдресВременногоХранилища(АдресДанных) Тогда
		АдресДанных = ПоместитьВоВременноеХранилище(Пакет, АдресДанных);
	Иначе
		АдресДанных = ПоместитьВоВременноеХранилище(Пакет, УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыЗагрузкиФормы()
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	ПараметрыЗагрузки.Вставить("ОбновлятьСуществующие", ОбновлятьСуществующие);
	ПараметрыЗагрузки.Вставить("СоздаватьЭлементыСправочников", СоздаватьЭлементыСправочников);
	ПараметрыЗагрузки.Вставить("СоздаватьСотрудников", СоздаватьСотрудников);
	Возврат ПараметрыЗагрузки;
	
КонецФункции

&НаСервере
Функция СвойствоПакета(Пакет, Имя)
	
	Значение = Неопределено;
	Если Пакет.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
	
КонецФункции

#КонецОбласти
