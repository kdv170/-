&НаКлиенте
Функция ТипXMLCOM(Среда, Значение)
	
	Соединение = Среда.Соединение;
	Попытка
		Если Среда.Английский Тогда
			Возврат Соединение.XMLTypeOf(Значение);
		КонецЕсли;
		Возврат Соединение.XMLТипЗнч(Значение);
	Исключение
		// Ниже запасной способ, если первого метода нет.
	КонецПопытки;
	
	Если Среда.Английский Тогда
		Возврат Соединение.XMLType(Соединение.TypeOf(Значение));
	КонецЕсли;
	Возврат Соединение.XMLТип(Соединение.ТипЗнч(Значение));
	
