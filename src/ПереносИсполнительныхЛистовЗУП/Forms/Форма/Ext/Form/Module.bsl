&НаКлиенте
Функция ЧтениеСвойстваCOM(Объект, Имя)
	
	Чтение = Новый Структура("Успех, Значение", Ложь, Неопределено);
	Если Не ИмяСвойстваДопустимо(Имя) Тогда
		Возврат Чтение;
	КонецЕсли;
	Попытка
		Чтение.Значение = Объект[Имя];
		Чтение.Успех = Истина;
		Возврат Чтение;
	Исключение
		// Имя свойства может быть доступно только прямым обращением.
	КонецПопытки;
	Попытка
		Чтение.Значение = Вычислить("Объект." + Имя);
		Чтение.Успех = Истина;
	Исключение
		Чтение.Успех = Ложь;
		Чтение.Значение = Неопределено;
	КонецПопытки;
	Возврат Чтение;
	
КонецФункции

&НаКлиенте
Функция ИмяСвойстваДопустимо(Имя)
	
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Первый = Лев(Имя, 1);
	Если Первый >= "0" И Первый <= "9" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		СимволИмени = Сред(Имя, Индекс, 1);
		Если СимволИмени = "_" Тогда
			Продолжить;
		КонецЕсли;
		Если СимволИмени >= "0" И СимволИмени <= "9" Тогда
			Продолжить;
		КонецЕсли;
		Если СимволИмени >= "A" И СимволИмени <= "Z" Тогда
			Продолжить;
		КонецЕсли;
		Если СимволИмени >= "a" И СимволИмени <= "z" Тогда
			Продолжить;
		КонецЕсли;
		Код = КодСимвола(СимволИмени);
		Если (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105 Тогда
			Продолжить;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

