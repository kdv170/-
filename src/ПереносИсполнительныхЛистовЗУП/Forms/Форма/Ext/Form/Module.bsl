&НаКлиенте
Функция ОписаниеПеречисленияCOM(Значение, ТекстXML, Среда)
	
	ИмяЗначения = СокрЛП(ТекстXML);
	Если Не ЭтоИмяЗначенияПеречисления(ИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяПеречисления = "";
	Попытка
		ИмяПеречисления = ИмяПеречисленияИзТипаXML(ИмяТипаXMLCOM(Среда, Значение));
	Исключение
		ИмяПеречисления = "";
	КонецПопытки;
	Если Не ИмяСвойстваДопустимо(ИмяПеречисления) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Представление = ИмяЗначения;
	Попытка
		Представление = Строка(Значение);
	Исключение
		Представление = ИмяЗначения;
	КонецПопытки;
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Перечисление");
	Описание.Вставить("Имя", ИмяПеречисления);
	Описание.Вставить("Значение", ИмяЗначения);
