	Если НайтиМетаCOM(КоллекцияМетаCOM(МетаРегистр, "Измерения", "Dimensions", Среда), ИмяПоля, Среда) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если НайтиМетаCOM(КоллекцияМетаCOM(МетаРегистр, "Ресурсы", "Resources", Среда), ИмяПоля, Среда) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат НайтиМетаCOM(КоллекцияМетаCOM(МетаРегистр, "Реквизиты", "Attributes", Среда), ИмяПоля, Среда) <> Неопределено;
	
КонецФункции

&НаКлиенте
Функция РеквизитМетаСуществует(Мета, ИмяРеквизита, Среда)
	
