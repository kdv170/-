КонецФункции

&НаКлиенте
Функция ОрганизацияИсточника(Среда, КлючОрганизации, СтрокиЖурнала)
	
	Результат = Новый Структура("Успех, Ссылка", Ложь, Неопределено);
	Мета = МетаданныеСоединения(Среда);
	МетаОрганизации = НайтиМетаCOM(КоллекцияМетаCOM(Мета, "Справочники", "Catalogs", Среда), "Организации", Среда);
	Если МетаОрганизации = Неопределено Тогда
		ДобавитьЖурнал(СтрокиЖурнала, "В базе ЗУП нет справочника Организации.");
		Возврат Результат;
	КонецЕсли;
	Если Не РеквизитМетаСуществует(МетаОрганизации, "ИНН", Среда) Тогда
		ДобавитьЖурнал(СтрокиЖурнала, "В базе ЗУП у справочника Организации нет реквизита ИНН.");
		Возврат Результат;
	КонецЕсли;
	
	ОтборКПП = ЗначениеЗаполнено(КлючОрганизации.КПП) И РеквизитМетаСуществует(МетаОрганизации, "КПП", Среда);
	Если ЗначениеЗаполнено(КлючОрганизации.КПП) И Не ОтборКПП Тогда
		ДобавитьЖурнал(СтрокиЖурнала, "В базе ЗУП у организации нет КПП, поиск выполнен только по ИНН.");
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|	И НЕ Организации.ПометкаУдаления";
	Если ИерархическийМетаCOM(МетаОрганизации, Среда) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И НЕ Организации.ЭтоГруппа";
	КонецЕсли;
	ПараметрыЗапроса = Новый Структура("ИНН", КлючОрганизации.ИНН);
	Если ОтборКПП Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И Организации.КПП = &КПП";
		ПараметрыЗапроса.Вставить("КПП", КлючОрганизации.КПП);
	КонецЕсли;
	
	Строки = ПрочитатьВыборкуCOM(Среда, ТекстЗапроса, ПараметрыЗапроса, СписокПолей("Ссылка"), СтрокиЖурнала);
	Если Строки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Если ОтборКПП Тогда
			ДобавитьЖурнал(СтрокиЖурнала, СтрШаблон(
				"В базе ЗУП не найдена организация с ИНН %1 и КПП %2.", КлючОрганизации.ИНН, КлючОрганизации.КПП));
		Иначе
			ДобавитьЖурнал(СтрокиЖурнала, СтрШаблон(
				"В базе ЗУП не найдена организация с ИНН %1.", КлючОрганизации.ИНН));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Если Строки.Количество() > 1 Тогда
		Если ОтборКПП Тогда
			ДобавитьЖурнал(СтрокиЖурнала, СтрШаблон(
				"В базе ЗУП несколько организаций с ИНН %1 и КПП %2.", КлючОрганизации.ИНН, КлючОрганизации.КПП));
		Иначе
			ДобавитьЖурнал(СтрокиЖурнала, СтрШаблон(
				"В базе ЗУП несколько организаций с ИНН %1. Укажите организацию с заполненным КПП.", КлючОрганизации.ИНН));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Ссылка = Строки[0].Ссылка;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СписокПолей(Имена)
	
	Возврат СтрРазделить(Имена, ",", Ложь);
	
КонецФункции

&НаКлиенте
Функция ПрочитатьВыборкуCOM(Среда, ТекстЗапроса, ПараметрыЗапроса, ИменаПолей, СтрокиЖурнала)
	
	Строки = Новый Массив;
	Запрос = Неопределено;
	Выборка = Неопределено;
	Попытка
		Запрос = НовыйОбъектCOM(Среда, "Запрос", "Query");
		Если Среда.Английский Тогда
			Запрос.Text = ТекстЗапроса;
		Иначе
			Запрос.Текст = ТекстЗапроса;
		КонецЕсли;
		УстановитьПараметрыЗапросаCOM(Запрос, ПараметрыЗапроса, Среда);
		Если Среда.Английский Тогда
			Выборка = Запрос.Execute().Choose();
		Иначе
			Выборка = Запрос.Выполнить().Выбрать();
		КонецЕсли;
		Пока СледующаяЗаписьCOM(Выборка, Среда) Цикл
			СтрокаДанных = Новый Структура;
			Для Каждого ИмяПоля Из ИменаПолей Цикл
				СтрокаДанных.Вставить(ИмяПоля, ПолеВыборкиCOM(Выборка, ИмяПоля));
			КонецЦикла;
			Строки.Добавить(СтрокаДанных);
			Если Строки.Количество() % 50 = 0 Тогда
				ОбработкаПрерыванияПользователя();
			КонецЕсли;
		КонецЦикла;
	Исключение
		ДобавитьЖурнал(СтрокиЖурнала, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДобавитьЖурнал(СтрокиЖурнала, ТекстЗапроса);
		Выборка = Неопределено;
		Запрос = Неопределено;
		Возврат Неопределено;
	КонецПопытки;
	
	Выборка = Неопределено;
	Запрос = Неопределено;
	Возврат Строки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПараметрыЗапросаCOM(Запрос, ПараметрыЗапроса, Среда)
	
	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Если Среда.Английский Тогда
			Запрос.SetParameter(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		Иначе
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СледующаяЗаписьCOM(Выборка, Среда)
	
	Если Среда.Английский Тогда
		Возврат БулевоCOM(Выборка.Next());
	КонецЕсли;
	Возврат БулевоCOM(Выборка.Следующий());
	
КонецФункции

&НаКлиенте
Функция ПолеВыборкиCOM(Выборка, ИмяПоля)
	
	Если ИмяПоля = "ДокументОснование" Тогда
		Возврат Выборка.ДокументОснование;
	ИначеЕсли ИмяПоля = "ПериодЗаписи" Тогда
		Возврат Выборка.ПериодЗаписи;
	ИначеЕсли ИмяПоля = "Сотрудник" Тогда
		Возврат Выборка.Сотрудник;
	ИначеЕсли ИмяПоля = "ФизическоеЛицо" Тогда
		Возврат Выборка.ФизическоеЛицо;
	ИначеЕсли ИмяПоля = "Организация" Тогда
		Возврат Выборка.Организация;
	ИначеЕсли ИмяПоля = "ГоловнаяОрганизация" Тогда
		Возврат Выборка.ГоловнаяОрганизация;
	ИначеЕсли ИмяПоля = "Удержание" Тогда
		Возврат Выборка.Удержание;
	ИначеЕсли ИмяПоля = "Размер" Тогда
		Возврат Выборка.Размер;
	ИначеЕсли ИмяПоля = "Используется" Тогда
		Возврат Выборка.Используется;
	ИначеЕсли ИмяПоля = "ДействуетДо" Тогда
		Возврат Выборка.ДействуетДо;
	ИначеЕсли ИмяПоля = "Ссылка" Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Неизвестное поле выборки: " + ИмяПоля;
	
КонецФункции

&НаКлиенте
Функция СериализоватьДокументCOM(ДокОбъект, СтрокиРегистра, УИДГруппы, Среда)
	
	Ссылка = РеквизитШапкиCOM(ДокОбъект, "Ссылка", "Ref", Среда);
	УИД = УИДСсылкиCOM(Ссылка, Среда);
	Если ЭтоПустойУИД(УИД) Тогда
		УИД = УИДГруппы;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("УИД", УИД);
	Данные.Вставить("Номер", СокрЛП(Строка(РеквизитШапкиCOM(ДокОбъект, "Номер", "Number", Среда))));
	Данные.Вставить("Дата", ДатаВXML(РеквизитШапкиCOM(ДокОбъект, "Дата", "Date", Среда), Среда));
	Данные.Вставить("Реквизиты", Новый Массив);
	Данные.Вставить("ТабличныеЧасти", Новый Массив);
	Данные.Вставить("ОснованиеОтбора", СтрокиРегистра);
	
	Мета = МетаданныеОбъекта(ДокОбъект, Среда);
	Стек = Новый Соответствие;
	Прочитано = 0;
	Реквизиты = КоллекцияМетаCOM(Мета, "Реквизиты", "Attributes", Среда);
	Количество = КоличествоCOM(Реквизиты, Среда);
	Для Индекс = 0 По Количество - 1 Цикл
		Реквизит = ПолучитьЭлементCOM(Реквизиты, Индекс, Среда);
		Имя = ИмяМетаCOM(Реквизит, Среда);
		Чтение = ЧтениеСвойстваCOM(ДокОбъект, Имя);
		Если Чтение.Успех Тогда
			Прочитано = Прочитано + 1;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", Имя);
		Элемент.Вставить("Значение", ОписаниеЗначенияCOM(Чтение.Значение, Стек, Среда));
		Данные.Реквизиты.Добавить(Элемент);
	КонецЦикла;
	Если Количество > 0 И Прочитано = 0 Тогда
		ВызватьИсключение "COM-соединение не отдаёт реквизиты документа.";
	КонецЕсли;
	
	ТабличныеЧасти = КоллекцияМетаCOM(Мета, "ТабличныеЧасти", "TabularSections", Среда);
	КоличествоТЧ = КоличествоCOM(ТабличныеЧасти, Среда);
	Для ИндексТЧ = 0 По КоличествоТЧ - 1 Цикл
		ТабличнаяЧасть = ПолучитьЭлементCOM(ТабличныеЧасти, ИндексТЧ, Среда);
		ИмяТЧ = ИмяМетаCOM(ТабличнаяЧасть, Среда);
		Если ИмяТЧ = "ДополнительныеРеквизиты" Тогда
			Продолжить;
		КонецЕсли;
		ЧтениеТаблицы = ЧтениеСвойстваCOM(ДокОбъект, ИмяТЧ);
		Если Не ЧтениеТаблицы.Успех Тогда
			ВызватьИсключение "Не прочитана табличная часть " + ИмяТЧ + ".";
		КонецЕсли;
		ОписаниеТЧ = Новый Структура("Имя, Строки", ИмяТЧ, Новый Массив);
		КоличествоСтрок = КоличествоCOM(ЧтениеТаблицы.Значение, Среда);
		РеквизитыТЧ = КоллекцияМетаCOM(ТабличнаяЧасть, "Реквизиты", "Attributes", Среда);
		КоличествоРеквизитов = КоличествоCOM(РеквизитыТЧ, Среда);
		Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
			СтрокаТЧ = ПолучитьЭлементCOM(ЧтениеТаблицы.Значение, ИндексСтроки, Среда);
			ОписаниеСтроки = Новый Структура("Реквизиты", Новый Массив);
			Для ИндексРеквизита = 0 По КоличествоРеквизитов - 1 Цикл
				РеквизитТЧ = ПолучитьЭлементCOM(РеквизитыТЧ, ИндексРеквизита, Среда);
				ИмяРеквизита = ИмяМетаCOM(РеквизитТЧ, Среда);
				ЧтениеРеквизита = ЧтениеСвойстваCOM(СтрокаТЧ, ИмяРеквизита);
				Элемент = Новый Структура;
				Элемент.Вставить("Имя", ИмяРеквизита);
				Элемент.Вставить("Значение", ОписаниеЗначенияCOM(ЧтениеРеквизита.Значение, Стек, Среда));
				ОписаниеСтроки.Реквизиты.Добавить(Элемент);
			КонецЦикла;
			ОписаниеТЧ.Строки.Добавить(ОписаниеСтроки);
		КонецЦикла;
		Данные.ТабличныеЧасти.Добавить(ОписаниеТЧ);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

&НаКлиенте
Функция СтрокаРегистраCOM(СтрокаВыборки, ИменаПолей, Среда)
	
	Выбранные = Новый Соответствие;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Выбранные.Вставить(ИмяПоля, Истина);
	КонецЦикла;
	
	Стек = Новый Соответствие;
	Описание = Новый Структура;
	Если Выбранные["ПериодЗаписи"] = Неопределено Тогда
		Описание.Вставить("Период", ОписаниеПусто());
	Иначе
		Описание.Вставить("Период", ОписаниеЗначенияCOM(СтрокаВыборки.ПериодЗаписи, Стек, Среда));
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("Сотрудник,ФизическоеЛицо,Организация,ГоловнаяОрганизация,Удержание,Размер,Используется,ДействуетДо", ",", Ложь) Цикл
		Если Выбранные[ИмяПоля] = Неопределено Тогда
			Описание.Вставить(ИмяПоля, ОписаниеПусто());
		Иначе
			Описание.Вставить(ИмяПоля, ОписаниеЗначенияCOM(СтрокаВыборки[ИмяПоля], Стек, Среда));
		КонецЕсли;
	КонецЦикла;
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция ОписаниеЗначенияCOM(Значение, Стек, Среда)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат ОписаниеПусто();
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат ОписаниеПримитива("Строка", Значение, Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ОписаниеПримитива("Число", Значение, Формат(Значение, "ЧГ=0"));
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ОписаниеПримитива("Булево", Значение, Формат(Значение, "БЛ=Нет; БИ=Да"));
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат ОписаниеПусто();
		КонецЕсли;
		Возврат ОписаниеПримитива("Дата", XMLСтрока(Значение), Формат(Значение, "ДФ=dd.MM.yyyy"));
	ИначеЕсли ТипЗначения <> Тип("COMОбъект") Тогда
		Возврат ОписаниеНеподдерживаемого(Строка(ТипЗначения));
	КонецЕсли;
	
	УИД = УИДСсылкиCOM(Значение, Среда);
	Если ЗначениеЗаполнено(УИД) Тогда
		Если ЭтоПустойУИД(УИД) Тогда
			Возврат ОписаниеПусто();
		КонецЕсли;
		Возврат ОписатьСсылкуCOM(Значение, УИД, Стек, Среда);
	КонецЕсли;
	
	ТекстXML = "";
	Попытка
		ТекстXML = XMLСтрокаCOM(Среда, Значение);
	Исключение
		ТекстXML = "";
	КонецПопытки;
	Если ЭтоXMLДата(ТекстXML) Тогда
		ДатаЗначения = XMLЗначение(Тип("Дата"), ТекстXML);
		Если Не ЗначениеЗаполнено(ДатаЗначения) Тогда
			Возврат ОписаниеПусто();
		КонецЕсли;
		Возврат ОписаниеПримитива("Дата", ТекстXML, Формат(ДатаЗначения, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	ОписаниеПеречисления = ОписаниеПеречисленияCOM(Значение, ТекстXML, Среда);
	Если ОписаниеПеречисления <> Неопределено Тогда
		Возврат ОписаниеПеречисления;
	КонецЕсли;
	Возврат ОписаниеНеподдерживаемого("COMОбъект");
	
КонецФункции

&НаКлиенте
Функция ОписатьСсылкуCOM(Ссылка, УИД, Стек, Среда)
	
	Мета = МетаданныеОбъекта(Ссылка, Среда);
	ПолноеИмя = НормализоватьПолноеИмя(ПолноеИмяМетаCOM(Мета, Среда));
	Представление = УИД;
	Попытка
		Представление = Строка(Ссылка);
	Исключение
		Представление = УИД;
	КонецПопытки;
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Ссылка");
	Описание.Вставить("ПолноеИмя", ПолноеИмя);
	Описание.Вставить("УИД", УИД);
	Описание.Вставить("Наименование", "");
	Описание.Вставить("Код", "");
	Описание.Вставить("Представление", Представление);
	Описание.Вставить("ИмяПредопределенныхДанных", ИмяПредопределенныхCOM(Ссылка, Среда));
	Описание.Вставить("ЭтоГруппа", Ложь);
	Описание.Вставить("Ключи", Новый Массив);
	
	Если Стек[УИД] <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	Стек.Вставить(УИД, Истина);
	
	Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
		Описание.Вставить("Номер", СокрЛП(Строка(РеквизитШапкиCOM(Ссылка, "Номер", "Number", Среда))));
		Описание.Вставить("Дата", ДатаВXML(РеквизитШапкиCOM(Ссылка, "Дата", "Date", Среда), Среда));
	Иначе
		ЗаполнитьКодИНаименованиеCOM(Описание, Ссылка, Мета, Среда);
	КонецЕсли;
	
	ИменаКлючей = ИменаКлючейСсылкиCOM(ПолноеИмя);
	Если ЗначениеЗаполнено(ИменаКлючей) Тогда
		Для Каждого ИмяКлюча Из СтрРазделить(ИменаКлючей, ",", Ложь) Цикл
			ДобавитьКлючСсылкиCOM(Описание.Ключи, Ссылка, Мета, СокрЛП(ИмяКлюча), Стек, Среда);
		КонецЦикла;
	КонецЕсли;
	Если СтрНачинаетсяС(ПолноеИмя, "Справочник.") Тогда
		Попытка
			Владельцы = СвойствоCOM(Мета, "Владельцы", "Owners", Среда.Английский);
			Если КоличествоCOM(Владельцы, Среда) > 0 Тогда
				ДобавитьКлючСсылкиCOM(Описание.Ключи, Ссылка, Мета, "Владелец", Стек, Среда);
			КонецЕсли;
		Исключение
			// У объекта нет коллекции владельцев.
		КонецПопытки;
	КонецЕсли;
	
	Стек.Удалить(УИД);
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьКодИНаименованиеCOM(Описание, Ссылка, Мета, Среда)
	
	Попытка
		Если ЧислоСвойстваCOM(Мета, "ДлинаНаименования", "DescriptionLength", Среда) > 0 Тогда
			Описание.Наименование = Строка(РеквизитШапкиCOM(Ссылка, "Наименование", "Description", Среда));
		КонецЕсли;
	Исключение
		Описание.Наименование = Строка(Ссылка);
	КонецПопытки;
	
	Попытка
		Если ЧислоСвойстваCOM(Мета, "ДлинаКода", "CodeLength", Среда) > 0 Тогда
			Описание.Код = СокрЛП(Строка(РеквизитШапкиCOM(Ссылка, "Код", "Code", Среда)));
		КонецЕсли;
	Исключение
		Описание.Код = "";
	КонецПопытки;
	
	Попытка
		Если ИерархическийМетаCOM(Мета, Среда) Тогда
			Описание.ЭтоГруппа = ЭтоГруппаCOM(Ссылка, Среда);
		КонецЕсли;
	Исключение
		Описание.ЭтоГруппа = Ложь;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКлючСсылкиCOM(Ключи, Ссылка, Мета, Имя, Стек, Среда)
	
	Если Имя = "Владелец" Тогда
		Значение = РеквизитШапкиCOM(Ссылка, "Владелец", "Owner", Среда);
	ИначеЕсли Не РеквизитМетаСуществует(Мета, Имя, Среда) Тогда
		Возврат;
	Иначе
		Чтение = ЧтениеСвойстваCOM(Ссылка, Имя);
		Если Не Чтение.Успех Тогда
			Возврат;
		КонецЕсли;
		Значение = Чтение.Значение;
	КонецЕсли;
	
	ОписаниеЗначения = ОписаниеЗначенияCOM(Значение, Стек, Среда);
	Если ОписаниеЗначения.Вид = "Пусто" Тогда
		Возврат;
	КонецЕсли;
	
	Ключ = Новый Структура;
	Ключ.Вставить("Имя", Имя);
	Ключ.Вставить("Значение", ОписаниеЗначения);
	Ключи.Добавить(Ключ);
	
КонецПроцедуры

&НаКлиенте
Функция ИменаКлючейСсылкиCOM(ПолноеИмя)
	
	Ключи = Новый Соответствие;
