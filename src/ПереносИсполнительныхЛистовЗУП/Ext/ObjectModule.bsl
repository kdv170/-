#Область ПрограммныйИнтерфейс

// Параметры загрузки документов в ERP.
//
// Возвращаемое значение:
//  Структура:
//   * ПроводитьДокументы - Булево - проводить после записи.
//   * ОбновлятьСуществующие - Булево - перезаполнять уже загруженные документы.
//   * СоздаватьЭлементыСправочников - Булево - создавать физлица, контрагентов, банки и счета.
//   * СоздаватьСотрудников - Булево - создавать карточки сотрудников без кадровой истории.
//
Функция ПараметрыЗагрузкиПоУмолчанию() Экспорт
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ПроводитьДокументы", Истина);
	ПараметрыЗагрузки.Вставить("ОбновлятьСуществующие", Истина);
	ПараметрыЗагрузки.Вставить("СоздаватьЭлементыСправочников", Истина);
	ПараметрыЗагрузки.Вставить("СоздаватьСотрудников", Ложь);
	Возврат ПараметрыЗагрузки;
	
КонецФункции

// Действующие на дату переноса документы ИсполнительныйЛист.
// Документ попадает в выборку, если на конец этой даты срез регистра
// ПлановыеУдержания содержит запись с основанием-исполнительным листом,
// ресурс Используется включен, а ДействуетДо пустая или не раньше даты.
// Документ должен быть проведен и не помечен на удаление. Заполненная
// дата окончания документа тоже должна покрывать дату переноса.
//
// Параметры:
//  ДатаПереноса - Дата - календарная дата, день включается целиком.
//  Организация - СправочникСсылка.Организации - необязательный отбор.
//
// Возвращаемое значение:
//  Структура - Успех, Сообщение, Журнал, Строки, ДокументыФайла.
//
Функция ВыбратьДействующиеДокументы(ДатаПереноса, Организация = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Журнал", Новый Массив);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ДокументыФайла", Новый Массив);
	
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		Результат.Сообщение = "Не заполнена дата переноса.";
		Результат.Журнал.Добавить(Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	ТекстЗапроса = ТекстЗапросаДействующихЛистов(ЗначениеЗаполнено(Организация), ТекстОшибки);
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Результат.Сообщение = ТекстОшибки;
		Результат.Журнал.Добавить(ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	МоментСреза = КонецДня(ДатаПереноса);
	ДеньПереноса = НачалоДня(ДатаПереноса);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МоментСреза", МоментСреза);
	Запрос.УстановитьПараметр("ДатаПереноса", ДеньПереноса);
	Если СтрНайти(ТекстЗапроса, "&Организация") > 0 Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	
	Попытка
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		Результат.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Журнал.Добавить(Результат.Сообщение);
		Результат.Журнал.Добавить(ТекстЗапроса);
		Возврат Результат;
	КонецПопытки;
	
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ссылка = СтрокаТаблицы.ДокументОснование;
		СтрокиРегистра = Группы[Ссылка];
		Если СтрокиРегистра = Неопределено Тогда
			СтрокиРегистра = Новый Массив;
			Группы.Вставить(Ссылка, СтрокиРегистра);
			Порядок.Добавить(Ссылка);
		КонецЕсли;
		СтрокиРегистра.Добавить(СтрокаРегистраИзТаблицы(СтрокаТаблицы));
	КонецЦикла;
	
	Для Каждого Ссылка Из Порядок Цикл
		Попытка
			ДокОбъект = Ссылка.ПолучитьОбъект();
		Исключение
			Результат.Журнал.Добавить("Не прочитан " + Строка(Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если ДокОбъект = Неопределено Тогда
			Результат.Журнал.Добавить("Не найден объект документа " + Строка(Ссылка));
			Продолжить;
		КонецЕсли;
		
		ДанныеДокумента = СериализоватьДокумент(ДокОбъект, Группы[Ссылка]);
		Результат.ДокументыФайла.Добавить(ДанныеДокумента);
		Результат.Строки.Добавить(СтрокаПредпросмотра(ДанныеДокумента, "К выгрузке"));
	КонецЦикла;
	
	Результат.Успех = Истина;
	Результат.Сообщение = СтрШаблон(
		"На %1 действующих исполнительных листов: %2.",
		Формат(ДеньПереноса, "ДФ=dd.MM.yyyy"),
		Результат.ДокументыФайла.Количество());
	Результат.Журнал.Вставить(0, Результат.Сообщение);
	Результат.Журнал.Вставить(1, СтрШаблон(
		"Срез регистра ПлановыеУдержания на %1.",
		Формат(МоментСреза, "ДФ=dd.MM.yyyy ЧЧ:мм:сс")));
	Если Не ПолеРегистраСуществует(Метаданные.РегистрыСведений.ПлановыеУдержания, "Используется") Тогда
		Результат.Журнал.Добавить("У регистра нет ресурса Используется: в выборку попали все записи среза по исполнительным листам.");
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Пакет обмена формата 1.0.
Функция СформироватьПакет(ДокументыФайла, ДатаПереноса) Экспорт
	
	Пакет = Новый Структура;
	Пакет.Вставить("ВерсияФормата", ВерсияФормата());
	Пакет.Вставить("ВидДанных", "ИсполнительныеЛисты");
	Пакет.Вставить("ДатаПереноса", XMLСтрока(НачалоДня(ДатаПереноса)));
	Пакет.Вставить("ДатаВыгрузки", XMLСтрока(ТекущаяДатаСеанса()));
	Пакет.Вставить("Конфигурация", Метаданные.Имя);
	Пакет.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Пакет.Вставить("СинонимКонфигурации", Строка(Метаданные.Синоним));
	Пакет.Вставить("Документы", ДокументыФайла);
	Возврат Пакет;
	
КонецФункции

Функция JSONПакета(Пакет) Экспорт
	
	Запись = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Пакет);
	Возврат Запись.Закрыть();
	
КонецФункции

// Читает пакет, записанный JSONПакета.
//
// Возвращаемое значение:
//  Структура - Успех, Сообщение, Предупреждение, Пакет.
//
Функция ПакетИзJSON(Текст) Экспорт
	
	Результат = Новый Структура("Успех, Сообщение, Предупреждение, Пакет", Ложь, "", "", Неопределено);
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Документы") Тогда
		Результат.Сообщение = "Файл не является пакетом переноса исполнительных листов.";
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Данные.Документы) <> Тип("Массив") Тогда
		Результат.Сообщение = "В файле нет списка документов.";
		Возврат Результат;
	КонецЕсли;
	Если Данные.Свойство("ВидДанных") И Данные.ВидДанных <> "ИсполнительныеЛисты" Тогда
		Результат.Сообщение = "В файле указан другой вид данных.";
		Возврат Результат;
	КонецЕсли;
	Если Данные.Свойство("ВерсияФормата") И Данные.ВерсияФормата <> ВерсияФормата() Тогда
		Результат.Предупреждение = "Версия формата файла " + Строка(Данные.ВерсияФормата)
			+ " отличается от " + ВерсияФормата() + ".";
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Пакет = Данные;
	Результат.Сообщение = СтрШаблон("В файле документов: %1.", Данные.Документы.Количество());
	Возврат Результат;
	
КонецФункции

// Строки таблицы формы по уже сериализованным документам.
Функция СтрокиПредпросмотра(ДокументыФайла, Состояние) Экспорт
	
	Строки = Новый Массив;
	Если ТипЗнч(ДокументыФайла) <> Тип("Массив") Тогда
		Возврат Строки;
	КонецЕсли;
	Для Каждого ДанныеДокумента Из ДокументыФайла Цикл
		Строки.Добавить(СтрокаПредпросмотра(ДанныеДокумента, Состояние));
	КонецЦикла;
	Возврат Строки;
	
КонецФункции

// Создает или обновляет документы ИсполнительныйЛист в текущей базе.
// Движения регистра ПлановыеУдержания формирует проведение документа.
//
// Параметры:
//  Пакет - Структура - результат СформироватьПакет или ПакетИзJSON.
//  ПереданныеПараметры - Структура - см. ПараметрыЗагрузкиПоУмолчанию.
//  ОтборУИД - Соответствие, Массив, Неопределено - какие УИД загружать.
//             Неопределено загружает все документы пакета.
//
// Возвращаемое значение:
//  Структура - счетчики, Журнал, ПоДокументам.
//
Функция ЗагрузитьПакет(Пакет, ПереданныеПараметры = Неопределено, ОтборУИД = Неопределено) Экспорт
	
	ПараметрыЗагрузки = ПрименитьПараметрыЗагрузки(ПереданныеПараметры);
	Итог = Новый Структура;
	Итог.Вставить("Успех", Истина);
	Итог.Вставить("Проведено", 0);
	Итог.Вставить("Записано", 0);
	Итог.Вставить("ЗаписаноБезПроведения", 0);
	Итог.Вставить("Пропущено", 0);
	Итог.Вставить("Ошибок", 0);
	Итог.Вставить("Журнал", Новый Массив);
	Итог.Вставить("ПоДокументам", Новый Массив);
	
	Если Метаданные.Документы.Найти("ИсполнительныйЛист") = Неопределено Тогда
		Итог.Успех = Ложь;
		Итог.Журнал.Добавить("В текущей базе нет документа ИсполнительныйЛист.");
		Возврат Итог;
	КонецЕсли;
	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("Документы") Тогда
		Итог.Успех = Ложь;
		Итог.Журнал.Добавить("Пакет переноса пуст.");
		Возврат Итог;
	КонецЕсли;
	
	Контекст = НовыйКонтекстЗагрузки(ПараметрыЗагрузки);
	КЗагрузке = 0;
	
	Для Каждого ДанныеДокумента Из Пакет.Документы Цикл
		УИД = СвойствоСтруктуры(ДанныеДокумента, "УИД", "");
		Если Не УИДРазрешен(ОтборУИД, УИД) Тогда
			Продолжить;
		КонецЕсли;
		КЗагрузке = КЗагрузке + 1;
		
		Попытка
			ИтогДокумента = ЗагрузитьОдинДокумент(ДанныеДокумента, Контекст);
		Исключение
			ИтогДокумента = РезультатДокумента(УИД, "Ошибка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		Итог.ПоДокументам.Добавить(ИтогДокумента);
		УвеличитьСчетчик(Итог, ИтогДокумента.Состояние);
		Итог.Журнал.Добавить("[" + ПредставлениеСостояния(ИтогДокумента.Состояние) + "] " + ИтогДокумента.Сообщение);
	КонецЦикла;
	
	Итог.Журнал.Вставить(0, СтрШаблон(
		"Загрузка в ""%1"". В пакете: %2, отмечено: %3.",
		Строка(Метаданные.Синоним),
		Пакет.Документы.Количество(),
		КЗагрузке));
	Итог.Журнал.Добавить(СтрШаблон(
		"Итог: проведено %1, записано %2, записано без проведения %3, пропущено %4, ошибок %5.",
		Итог.Проведено,
		Итог.Записано,
		Итог.ЗаписаноБезПроведения,
		Итог.Пропущено,
		Итог.Ошибок));
	
	Если Не ПараметрыЗагрузки.ПроводитьДокументы Тогда
		Итог.Журнал.Добавить("Проведение выключено. Регистр ПлановыеУдержания заполнится при проведении документов.");
	КонецЕсли;
	Если Контекст.ПропущенныеРеквизиты.Количество() > 0 Тогда
		Итог.Журнал.Добавить("В текущей базе нет реквизитов, они пропущены: " + КлючиСоответствия(Контекст.ПропущенныеРеквизиты));
	КонецЕсли;
	Если Контекст.ПропущенныеТабличныеЧасти.Количество() > 0 Тогда
		Итог.Журнал.Добавить("В текущей базе нет табличных частей, они пропущены: " + КлючиСоответствия(Контекст.ПропущенныеТабличныеЧасти));
	КонецЕсли;
	
	Итог.Успех = Итог.Ошибок = 0;
	Возврат Итог;
	
КонецФункции

Функция ПредставлениеСостояния(КодСостояния) Экспорт
	
	Если КодСостояния = "Проведен" Тогда
		Возврат "Проведен";
	ИначеЕсли КодСостояния = "Записан" Тогда
		Возврат "Записан";
	ИначеЕсли КодСостояния = "ЗаписанБезПроведения" Тогда
		Возврат "Записан без проведения";
	ИначеЕсли КодСостояния = "Пропущен" Тогда
		Возврат "Пропущен";
	ИначеЕсли КодСостояния = "Ошибка" Тогда
		Возврат "Ошибка";
	КонецЕсли;
	Возврат Строка(КодСостояния);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВерсияФормата()
	
	Возврат "1.0";
	
КонецФункции

Функция ПрименитьПараметрыЗагрузки(ПереданныеПараметры)
	
	ПараметрыЗагрузки = ПараметрыЗагрузкиПоУмолчанию();
	Если ТипЗнч(ПереданныеПараметры) <> Тип("Структура") Тогда
		Возврат ПараметрыЗагрузки;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из ПараметрыЗагрузки Цикл
		Значение = Неопределено;
		Если ПереданныеПараметры.Свойство(КлючИЗначение.Ключ, Значение) Тогда
			ПараметрыЗагрузки[КлючИЗначение.Ключ] = Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат ПараметрыЗагрузки;
	
КонецФункции

Функция ТекстЗапросаДействующихЛистов(ОтбиратьОрганизацию, ТекстОшибки)
	
	МетаРегистр = Метаданные.РегистрыСведений.Найти("ПлановыеУдержания");
	Если МетаРегистр = Неопределено Тогда
		ТекстОшибки = "В конфигурации нет регистра сведений ПлановыеУдержания. Откройте обработку в базе ЗУП.";
		Возврат "";
	КонецЕсли;
	Если Метаданные.Документы.Найти("ИсполнительныйЛист") = Неопределено Тогда
		ТекстОшибки = "В конфигурации нет документа ИсполнительныйЛист.";
		Возврат "";
	КонецЕсли;
	Если МетаРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		ТекстОшибки = "Регистр ПлановыеУдержания непериодический, срез на дату построить нельзя.";
		Возврат "";
	КонецЕсли;
	Если Не ПолеРегистраСуществует(МетаРегистр, "ДокументОснование") Тогда
		ТекстОшибки = "У регистра ПлановыеУдержания нет измерения ДокументОснование.";
		Возврат "";
	КонецЕсли;
	Если ОтбиратьОрганизацию И Не РеквизитДокументаСуществует("Организация") Тогда
		ТекстОшибки = "У документа ИсполнительныйЛист нет реквизита Организация, отбор по организации невозможен.";
		Возврат "";
	КонецЕсли;
	
	Поля = Новый Массив;
	Поля.Добавить("Срез.ДокументОснование КАК ДокументОснование");
	Поля.Добавить("Срез.Период КАК ПериодЗаписи");
	Для Каждого ИмяПоля Из СтрРазделить("Сотрудник,ФизическоеЛицо,Организация,ГоловнаяОрганизация,Удержание,Размер,Используется,ДействуетДо", ",", Ложь) Цикл
		Если ПолеРегистраСуществует(МетаРегистр, ИмяПоля) Тогда
			Поля.Добавить("Срез." + ИмяПоля + " КАК " + ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Условия = Новый Массив;
	Условия.Добавить("Док.Проведен");
	Условия.Добавить("НЕ Док.ПометкаУдаления");
	Условия.Добавить("Срез.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИсполнительныйЛист.ПустаяСсылка)");
	Если ПолеРегистраСуществует(МетаРегистр, "Используется") Тогда
		Условия.Добавить("Срез.Используется");
	КонецЕсли;
	Если ПолеРегистраСуществует(МетаРегистр, "ДействуетДо") Тогда
		Условия.Добавить("(Срез.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Срез.ДействуетДо >= &ДатаПереноса)");
	КонецЕсли;
	Если РеквизитДокументаСуществует("ДатаОкончания") Тогда
		Условия.Добавить("(Док.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Док.ДатаОкончания >= &ДатаПереноса)");
	КонецЕсли;
	Если ОтбиратьОрганизацию Тогда
		Условия.Добавить("Док.Организация = &Организация");
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	" + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб) + "
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(
	|			&МоментСреза,
	|			ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист) КАК Срез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК Док
	|		ПО Срез.ДокументОснование = Док.Ссылка
	|ГДЕ
	|	" + СтрСоединить(Условия, Символы.ПС + Символы.Таб + "И ") + "
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолеРегистраСуществует(МетаРегистр, ИмяПоля)
	
	Возврат МетаРегистр.Измерения.Найти(ИмяПоля) <> Неопределено
		Или МетаРегистр.Ресурсы.Найти(ИмяПоля) <> Неопределено
		Или МетаРегистр.Реквизиты.Найти(ИмяПоля) <> Неопределено;
	
КонецФункции

Функция РеквизитДокументаСуществует(ИмяРеквизита)
	
	Возврат Метаданные.Документы.ИсполнительныйЛист.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
КонецФункции

Функция РеквизитСуществует(ПолноеИмя, ИмяРеквизита)
	
	Мета = МетаданныеПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Мета.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
КонецФункции

Функция СтрокаРегистраИзТаблицы(СтрокаТаблицы)
	
	Описание = Новый Структура;
	Описание.Вставить("Период", ОписатьЗначение(СтрокаТаблицы.ПериодЗаписи, Новый Соответствие));
	Для Каждого ИмяПоля Из СтрРазделить("Сотрудник,ФизическоеЛицо,Организация,ГоловнаяОрганизация,Удержание,Размер,Используется,ДействуетДо", ",", Ложь) Цикл
		Описание.Вставить(ИмяПоля, ОписатьЗначение(ЗначениеКолонки(СтрокаТаблицы, ИмяПоля), Новый Соответствие));
	КонецЦикла;
	Возврат Описание;
	
КонецФункции

Функция ЗначениеКолонки(СтрокаТаблицы, ИмяКолонки)
	
	Если СтрокаТаблицы.Владелец().Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрокаТаблицы[ИмяКолонки];
	
КонецФункции

Функция СериализоватьДокумент(ДокОбъект, СтрокиРегистра)
	
	Данные = Новый Структура;
	Данные.Вставить("УИД", Строка(ДокОбъект.Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Номер", СокрЛП(ДокОбъект.Номер));
	Данные.Вставить("Дата", XMLСтрока(ДокОбъект.Дата));
	Данные.Вставить("Реквизиты", Новый Массив);
	Данные.Вставить("ТабличныеЧасти", Новый Массив);
	Данные.Вставить("ОснованиеОтбора", СтрокиРегистра);
	
	Стек = Новый Соответствие;
	Для Каждого Реквизит Из ДокОбъект.Метаданные().Реквизиты Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", Реквизит.Имя);
		Элемент.Вставить("Значение", ОписатьЗначение(ДокОбъект[Реквизит.Имя], Стек));
		Данные.Реквизиты.Добавить(Элемент);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из ДокОбъект.Метаданные().ТабличныеЧасти Цикл
		Если СлужебнаяТабличнаяЧасть(ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеТЧ = Новый Структура;
		ОписаниеТЧ.Вставить("Имя", ТабличнаяЧасть.Имя);
		ОписаниеТЧ.Вставить("Строки", Новый Массив);
		Для Каждого СтрокаТЧ Из ДокОбъект[ТабличнаяЧасть.Имя] Цикл
			ОписаниеСтроки = Новый Структура("Реквизиты", Новый Массив);
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				Элемент = Новый Структура;
				Элемент.Вставить("Имя", Реквизит.Имя);
				Элемент.Вставить("Значение", ОписатьЗначение(СтрокаТЧ[Реквизит.Имя], Стек));
				ОписаниеСтроки.Реквизиты.Добавить(Элемент);
			КонецЦикла;
			ОписаниеТЧ.Строки.Добавить(ОписаниеСтроки);
		КонецЦикла;
		Данные.ТабличныеЧасти.Добавить(ОписаниеТЧ);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция СлужебнаяТабличнаяЧасть(ИмяТабличнойЧасти)
	
	Возврат ИмяТабличнойЧасти = "ДополнительныеРеквизиты";
	
КонецФункции

Функция ОписатьЗначение(Значение, Стек)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат ОписаниеПусто();
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат ОписаниеПримитива("Строка", Значение, Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ОписаниеПримитива("Число", Значение, Формат(Значение, "ЧГ=0"));
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ОписаниеПримитива("Булево", Значение, Формат(Значение, "БЛ=Нет; БИ=Да"));
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат ОписаниеПусто();
		КонецЕсли;
		Возврат ОписаниеПримитива("Дата", XMLСтрока(Значение), Формат(Значение, "ДФ=dd.MM.yyyy"));
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат ОписаниеПусто();
		КонецЕсли;
		Возврат ОписатьПеречисление(Значение);
	ИначеЕсли ЭтоСсылочныйТип(ТипЗначения) Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат ОписаниеПусто();
		КонецЕсли;
		Возврат ОписатьСсылку(Значение, Стек);
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Неподдерживаемый");
	Описание.Вставить("Тип", Строка(ТипЗначения));
	Описание.Вставить("Представление", "");
	Возврат Описание;
	
КонецФункции

Функция ЭтоСсылочныйТип(ТипЗначения)
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения);
	
КонецФункции

Функция ОписаниеПусто()
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Пусто");
	Описание.Вставить("Представление", "");
	Возврат Описание;
	
КонецФункции

Функция ОписаниеПримитива(Тип, Данные, Представление)
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Примитив");
	Описание.Вставить("Тип", Тип);
	Описание.Вставить("Данные", Данные);
	Описание.Вставить("Представление", Представление);
	Возврат Описание;
	
КонецФункции

Функция ОписатьПеречисление(Значение)
	
	Мета = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Индекс = Перечисления[Мета.Имя].Индекс(Значение);
	ИмяЗначения = Мета.ЗначенияПеречисления.Получить(Индекс).Имя;
	
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Перечисление");
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Значение", ИмяЗначения);
	Описание.Вставить("Представление", Строка(Значение));
	Возврат Описание;
	
КонецФункции

Функция ОписатьСсылку(Ссылка, Стек)
	
	Мета = Ссылка.Метаданные();
	УИД = Строка(Ссылка.УникальныйИдентификатор());
	Описание = Новый Структура;
	Описание.Вставить("Вид", "Ссылка");
	Описание.Вставить("ПолноеИмя", Мета.ПолноеИмя());
	Описание.Вставить("УИД", УИД);
	Описание.Вставить("Наименование", "");
	Описание.Вставить("Код", "");
	Описание.Вставить("Представление", Строка(Ссылка));
	Описание.Вставить("ИмяПредопределенныхДанных", ИмяПредопределенныхДанныхСсылки(Ссылка));
	Описание.Вставить("ЭтоГруппа", Ложь);
	Описание.Вставить("Ключи", Новый Массив);
	
	Если Стек[УИД] <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	Стек.Вставить(УИД, Истина);
	
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)) Тогда
		Описание.Вставить("Номер", СокрЛП(Ссылка.Номер));
		Описание.Вставить("Дата", XMLСтрока(Ссылка.Дата));
	Иначе
		ЗаполнитьКодИНаименованиеСсылки(Описание, Ссылка, Мета);
	КонецЕсли;
	
	ИменаКлючей = ИменаКлючейСсылки(Мета.ПолноеИмя());
	Если ЗначениеЗаполнено(ИменаКлючей) Тогда
		Для Каждого ИмяКлюча Из СтрРазделить(ИменаКлючей, ",", Ложь) Цикл
			ДобавитьКлючСсылки(Описание.Ключи, Ссылка, Мета, СокрЛП(ИмяКлюча), Стек);
		КонецЦикла;
	КонецЕсли;
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)) И Мета.Владельцы.Количество() > 0 Тогда
		ДобавитьКлючСсылки(Описание.Ключи, Ссылка, Мета, "Владелец", Стек);
	КонецЕсли;
	
	Стек.Удалить(УИД);
	Возврат Описание;
	
КонецФункции

Процедура ЗаполнитьКодИНаименованиеСсылки(Описание, Ссылка, Мета)
	
	Попытка
		Если Мета.ДлинаНаименования > 0 Тогда
			Описание.Наименование = Ссылка.Наименование;
		КонецЕсли;
	Исключение
		Описание.Наименование = Строка(Ссылка);
	КонецПопытки;
	
	Попытка
		Если Мета.ДлинаКода > 0 Тогда
			Описание.Код = СокрЛП(Ссылка.Код);
		КонецЕсли;
	Исключение
		Описание.Код = "";
	КонецПопытки;
	
	Попытка
		Если Мета.Иерархический Тогда
			Описание.ЭтоГруппа = Ссылка.ЭтоГруппа;
		КонецЕсли;
	Исключение
		Описание.ЭтоГруппа = Ложь;
	КонецПопытки;
	
КонецПроцедуры

Функция ИмяПредопределенныхДанныхСсылки(Ссылка)
	
	Попытка
		Возврат Ссылка.ИмяПредопределенныхДанных;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ИменаКлючейСсылки(ПолноеИмя)
	
	Ключи = Новый Соответствие;
	Ключи.Вставить("Справочник.Организации", "ИНН,КПП,ОГРН,НаименованиеПолное,НаименованиеСокращенное");
	Ключи.Вставить("Справочник.ФизическиеЛица", "Фамилия,Имя,Отчество,ИНН,СтраховойНомерПФР,ДатаРождения,Пол");
	Ключи.Вставить("Справочник.Сотрудники", "ФизическоеЛицо,ГоловнаяОрганизация");
	Ключи.Вставить("Справочник.Контрагенты", "ИНН,КПП,НаименованиеПолное,ЮридическоеФизическоеЛицо");
	Ключи.Вставить("Справочник.Удержания", "КатегорияУдержания");
	Ключи.Вставить("ПланВидовРасчета.Удержания", "КатегорияУдержания");
	Ключи.Вставить("Справочник.КлассификаторБанков", "КоррСчет,СВИФТБИК,Город");
	Ключи.Вставить("Справочник.БанковскиеСчетаКонтрагентов", "НомерСчета,Банк,ВалютаДенежныхСредств");
	Ключи.Вставить("Справочник.БанковскиеСчета", "НомерСчета,Банк,ВалютаДенежныхСредств");
	Ключи.Вставить("Справочник.Валюты", "НаименованиеПолное");
	Возврат Ключи[ПолноеИмя];
	
КонецФункции

Процедура ДобавитьКлючСсылки(Ключи, Ссылка, Мета, Имя, Стек)
	
	Если Имя = "Владелец" Тогда
		Значение = Ссылка.Владелец;
	ИначеЕсли Мета.Реквизиты.Найти(Имя) = Неопределено Тогда
		Возврат;
	Иначе
		Значение = Ссылка[Имя];
	КонецЕсли;
	
	ОписаниеЗначения = ОписатьЗначение(Значение, Стек);
	Если ОписаниеЗначения.Вид = "Пусто" Тогда
		Возврат;
	КонецЕсли;
	
	Ключ = Новый Структура;
	Ключ.Вставить("Имя", Имя);
	Ключ.Вставить("Значение", ОписаниеЗначения);
	Ключи.Добавить(Ключ);
	
КонецПроцедуры

Функция СтрокаПредпросмотра(ДанныеДокумента, Состояние)
	
	Процент = ЧислоРеквизита(ДанныеДокумента, "Процент");
	Сумма = ЧислоРеквизита(ДанныеДокумента, "Сумма");
	РазмерРеквизита = ЧислоРеквизита(ДанныеДокумента, "Размер");
	Числитель = ЧислоРеквизита(ДанныеДокумента, "Числитель");
	Знаменатель = ЧислоРеквизита(ДанныеДокумента, "Знаменатель");
	
	Способ = ПредставлениеРеквизита(ДанныеДокумента, "СпособРасчета");
	Если Числитель <> 0 И Знаменатель <> 0 Тогда
		Способ = СокрЛП(Способ + " " + Формат(Числитель, "ЧГ=0") + "/" + Формат(Знаменатель, "ЧГ=0"));
	КонецЕсли;
	
	Если Процент <> 0 Тогда
		Размер = Процент;
	ИначеЕсли Сумма <> 0 Тогда
		Размер = Сумма;
	ИначеЕсли РазмерРеквизита <> 0 Тогда
		Размер = РазмерРеквизита;
	Иначе
		Размер = РазмерИзРегистра(ДанныеДокумента);
	КонецЕсли;
	
	Сотрудник = ПредставлениеРеквизита(ДанныеДокумента, "Сотрудник");
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Сотрудник = ПредставленияСтрокРегистра(ДанныеДокумента, "Сотрудник");
	КонецЕсли;
	
	СтрокаФормы = Новый Структура;
	СтрокаФормы.Вставить("Пометка", Истина);
	СтрокаФормы.Вставить("УИД", СвойствоСтруктуры(ДанныеДокумента, "УИД", ""));
	СтрокаФормы.Вставить("Номер", СвойствоСтруктуры(ДанныеДокумента, "Номер", ""));
	СтрокаФормы.Вставить("Дата", ДатаИзСтрокиXML(СвойствоСтруктуры(ДанныеДокумента, "Дата", "")));
	СтрокаФормы.Вставить("Организация", ПредставлениеРеквизита(ДанныеДокумента, "Организация"));
	СтрокаФормы.Вставить("Сотрудник", Сотрудник);
	СтрокаФормы.Вставить("ФизическоеЛицо", ПредставлениеРеквизита(ДанныеДокумента, "ФизическоеЛицо"));
	СтрокаФормы.Вставить("Удержание", ПредставлениеРеквизита(ДанныеДокумента, "Удержание"));
	СтрокаФормы.Вставить("СпособРасчета", Способ);
	СтрокаФормы.Вставить("Размер", Размер);
	СтрокаФормы.Вставить("ДатаНачала", ДатаРеквизита(ДанныеДокумента, "ДатаДействия,ДатаНачала,ДатаНачалаДействия"));
	СтрокаФормы.Вставить("ДатаОкончания", ДатаРеквизита(ДанныеДокумента, "ДатаОкончания,ДействуетДо"));
	СтрокаФормы.Вставить("Получатель", ПредставлениеРеквизита(ДанныеДокумента, "Получатель"));
	СтрокаФормы.Вставить("Состояние", Состояние);
	Возврат СтрокаФормы;
	
КонецФункции

Функция ПредставлениеРеквизита(ДанныеДокумента, Имена)
	
	Описание = ПервоеОписаниеРеквизита(ДанныеДокумента, Имена);
	Возврат ПредставлениеОписания(Описание);
	
КонецФункции

Функция ПредставлениеОписания(Описание)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(СвойствоСтруктуры(Описание, "Представление", ""));
	
КонецФункции

Функция ПервоеОписаниеРеквизита(ДанныеДокумента, Имена)
	
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Описание = НайтиОписаниеРеквизита(ДанныеДокумента, СокрЛП(Имя));
		Если ОписаниеЗаполнено(Описание) Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Функция НайтиОписаниеРеквизита(ДанныеДокумента, Имя)
	
	Реквизиты = СвойствоСтруктуры(ДанныеДокумента, "Реквизиты", Новый Массив);
	Для Каждого Реквизит Из Реквизиты Цикл
		Если СвойствоСтруктуры(Реквизит, "Имя", "") = Имя Тогда
			Возврат СвойствоСтруктуры(Реквизит, "Значение", Неопределено);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Функция ОписаниеЗаполнено(Описание)
	
	Возврат ТипЗнч(Описание) = Тип("Структура")
		И СвойствоСтруктуры(Описание, "Вид", "Пусто") <> "Пусто";
	
КонецФункции

Функция ЧислоРеквизита(ДанныеДокумента, Имя)
	
	Возврат ЧислоИзОписания(НайтиОписаниеРеквизита(ДанныеДокумента, Имя));
	
КонецФункции

Функция ЧислоИзОписания(Описание)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;
	Если СвойствоСтруктуры(Описание, "Вид", "") <> "Примитив" Или СвойствоСтруктуры(Описание, "Тип", "") <> "Число" Тогда
		Возврат 0;
	КонецЕсли;
	Данные = СвойствоСтруктуры(Описание, "Данные", 0);
	Если ТипЗнч(Данные) = Тип("Число") Тогда
		Возврат Данные;
	КонецЕсли;
	Попытка
		Возврат Число(Данные);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

Функция ДатаРеквизита(ДанныеДокумента, Имена)
	
	Описание = ПервоеОписаниеРеквизита(ДанныеДокумента, Имена);
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Если СвойствоСтруктуры(Описание, "Вид", "") <> "Примитив" Или СвойствоСтруктуры(Описание, "Тип", "") <> "Дата" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат ДатаИзСтрокиXML(СвойствоСтруктуры(Описание, "Данные", ""));
	
КонецФункции

Функция РазмерИзРегистра(ДанныеДокумента)
	
	СтрокиРегистра = СвойствоСтруктуры(ДанныеДокумента, "ОснованиеОтбора", Новый Массив);
	Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл
		Размер = ЧислоИзОписания(СвойствоСтруктуры(СтрокаРегистра, "Размер", Неопределено));
		Если Размер <> 0 Тогда
			Возврат Размер;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
	
КонецФункции

Функция ПредставленияСтрокРегистра(ДанныеДокумента, ИмяПоля)
	
	Тексты = Новый Массив;
	УжеЕсть = Новый Соответствие;
	СтрокиРегистра = СвойствоСтруктуры(ДанныеДокумента, "ОснованиеОтбора", Новый Массив);
	Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл
		Текст = ПредставлениеОписания(СвойствоСтруктуры(СтрокаРегистра, ИмяПоля, Неопределено));
		Если Не ЗначениеЗаполнено(Текст) Или УжеЕсть[Текст] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть.Вставить(Текст, Истина);
		Тексты.Добавить(Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, ", ");
	
КонецФункции

Функция НовыйКонтекстЗагрузки(ПараметрыЗагрузки)
	
	Контекст = Новый Структура;
	Контекст.Вставить("Параметры", ПараметрыЗагрузки);
	Контекст.Вставить("Кэш", Новый Соответствие);
	Контекст.Вставить("Стек", Новый Соответствие);
	Контекст.Вставить("ЖесткиеОшибки", Новый Массив);
	Контекст.Вставить("Предупреждения", Новый Массив);
	Контекст.Вставить("Созданные", Новый Массив);
	Контекст.Вставить("ПропущенныеРеквизиты", Новый Соответствие);
	Контекст.Вставить("ПропущенныеТабличныеЧасти", Новый Соответствие);
	Возврат Контекст;
	
КонецФункции

Процедура СброситьСообщенияДокумента(Контекст)
	
	Контекст.ЖесткиеОшибки = Новый Массив;
	Контекст.Предупреждения = Новый Массив;
	Контекст.Созданные = Новый Массив;
	
КонецПроцедуры

Функция ЗагрузитьОдинДокумент(ДанныеДокумента, Контекст)
	
	СброситьСообщенияДокумента(Контекст);
	УИД = СвойствоСтруктуры(ДанныеДокумента, "УИД", "");
	МетаДок = Метаданные.Документы.ИсполнительныйЛист;
	ЗначенияРеквизитов = Новый Соответствие;
	
	Для Каждого ОписаниеРеквизита Из СвойствоСтруктуры(ДанныеДокумента, "Реквизиты", Новый Массив) Цикл
		Имя = СвойствоСтруктуры(ОписаниеРеквизита, "Имя", "");
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;
		МетаРеквизит = МетаДок.Реквизиты.Найти(Имя);
		Если МетаРеквизит = Неопределено Тогда
			Контекст.ПропущенныеРеквизиты.Вставить(Имя, Истина);
			Продолжить;
		КонецЕсли;
		
		РезультатЗначения = ВосстановитьЗначение(
			СвойствоСтруктуры(ОписаниеРеквизита, "Значение", Неопределено),
			Имя,
			МетаРеквизит.Тип,
			Контекст,
			ДанныеДокумента);
		Если РезультатЗначения.Жесткая Тогда
			Контекст.ЖесткиеОшибки.Добавить(РезультатЗначения.Сообщение);
		Иначе
			ЗначенияРеквизитов.Вставить(Имя, РезультатЗначения.Значение);
			Если ЗначениеЗаполнено(РезультатЗначения.Сообщение) Тогда
				Контекст.Предупреждения.Добавить(РезультатЗначения.Сообщение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Контекст.ЖесткиеОшибки.Количество() > 0 Тогда
		Возврат РезультатДокумента(УИД, "Ошибка", ТекстСообщенияДокумента(ДанныеДокумента, Контекст, ""));
	КонецЕсли;
	
	Ссылка = НайтиСуществующийДокумент(ДанныеДокумента, ЗначенияРеквизитов, Контекст);
	Если Контекст.ЖесткиеОшибки.Количество() > 0 Тогда
		Возврат РезультатДокумента(УИД, "Ошибка", ТекстСообщенияДокумента(ДанныеДокумента, Контекст, ""));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И Не Контекст.Параметры.ОбновлятьСуществующие Тогда
		Возврат РезультатДокумента(УИД, "Пропущен", ТекстСообщенияДокумента(ДанныеДокумента, Контекст, "Документ уже есть в базе"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ДокОбъект = Ссылка.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = Ложь;
	Иначе
		ДокОбъект = Документы.ИсполнительныйЛист.СоздатьДокумент();
		УстановитьУИДНового(ДокОбъект, УИД);
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из ЗначенияРеквизитов Цикл
		Попытка
			ДокОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		Исключение
			Контекст.ЖесткиеОшибки.Добавить("Реквизит " + КлючИЗначение.Ключ + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	ЗаполнитьТабличныеЧасти(ДокОбъект, ДанныеДокумента, Контекст);
	
	Если Контекст.ЖесткиеОшибки.Количество() > 0 Тогда
		Возврат РезультатДокумента(УИД, "Ошибка", ТекстСообщенияДокумента(ДанныеДокумента, Контекст, ""));
	КонецЕсли;
	
	УстановитьНомерИДату(ДокОбъект, ДанныеДокумента);
	УстановитьМаркер(ДокОбъект, УИД);
	УстановитьОтветственного(ДокОбъект);
	
	ИтогЗаписи = ЗаписатьДокументВБазу(ДокОбъект, Контекст);
	Если ЗначениеЗаполнено(ИтогЗаписи.Сообщение) Тогда
		Контекст.Предупреждения.Добавить(ИтогЗаписи.Сообщение);
	КонецЕсли;
	Возврат РезультатДокумента(УИД, ИтогЗаписи.Состояние, ТекстСообщенияДокумента(ДанныеДокумента, Контекст, ""));
	
КонецФункции

Функция РезультатДокумента(УИД, Состояние, Сообщение)
	
	Возврат Новый Структура("УИД, Состояние, Сообщение", УИД, Состояние, Сообщение);
	
КонецФункции

Функция ТекстСообщенияДокумента(ДанныеДокумента, Контекст, Дополнительно)
	
	Части = Новый Массив;
	Части.Добавить(ПредставлениеДокумента(ДанныеДокумента));
	Если ЗначениеЗаполнено(Дополнительно) Тогда
		Части.Добавить(Дополнительно);
	КонецЕсли;
	Для Каждого ТекстОшибки Из Контекст.ЖесткиеОшибки Цикл
		Части.Добавить(ТекстОшибки);
	КонецЦикла;
	Для Каждого Предупреждение Из Контекст.Предупреждения Цикл
		Части.Добавить(Предупреждение);
	КонецЦикла;
	Для Каждого Созданный Из Контекст.Созданные Цикл
		Части.Добавить("Создан: " + Созданный);
	КонецЦикла;
	Возврат СтрСоединить(Части, ". ");
	
КонецФункции

Функция ПредставлениеДокумента(ДанныеДокумента)
	
	Номер = СвойствоСтруктуры(ДанныеДокумента, "Номер", "");
	ДатаДокумента = ДатаИзСтрокиXML(СвойствоСтруктуры(ДанныеДокумента, "Дата", ""));
	Лицо = ПредставлениеРеквизита(ДанныеДокумента, "ФизическоеЛицо");
	Если Не ЗначениеЗаполнено(Лицо) Тогда
		Лицо = ПредставлениеРеквизита(ДанныеДокумента, "Сотрудник");
	КонецЕсли;
	Текст = "№ " + Номер + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
	Если ЗначениеЗаполнено(Лицо) Тогда
		Текст = Текст + ", " + Лицо;
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

Функция ВосстановитьЗначение(Описание, ИмяРеквизита, ОписаниеТипа, Контекст, ДанныеДокумента)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Возврат РезультатЗначения(ОписаниеТипа.ПривестиЗначение(Неопределено));
	КонецЕсли;
	
	Вид = СвойствоСтруктуры(Описание, "Вид", "Пусто");
	Если Вид = "Пусто" Тогда
		Возврат РезультатЗначения(ОписаниеТипа.ПривестиЗначение(Неопределено));
	ИначеЕсли Вид = "Примитив" Тогда
		Значение = ПримитивИзОписания(Описание);
		Если Не ОписаниеТипа.СодержитТип(ТипЗнч(Значение)) Тогда
			Значение = ОписаниеТипа.ПривестиЗначение(Значение);
		КонецЕсли;
		Возврат РезультатЗначения(Значение);
	ИначеЕсли Вид = "Перечисление" Тогда
		Значение = ПеречислениеИзОписания(Описание);
		Если Значение = Неопределено Тогда
			Сообщение = "Не найдено значение перечисления "
				+ СвойствоСтруктуры(Описание, "Имя", "") + "." + СвойствоСтруктуры(Описание, "Значение", "");
			Жесткая = РеквизитОбязательный(ИмяРеквизита, ДанныеДокумента);
			Пустое = ОписаниеТипа.ПривестиЗначение(Неопределено);
			Возврат РезультатЗначения(Пустое, Жесткая, Сообщение);
		КонецЕсли;
		Если Не ОписаниеТипа.СодержитТип(ТипЗнч(Значение)) Тогда
			Возврат РезультатЗначения(
				ОписаниеТипа.ПривестиЗначение(Неопределено),
				РеквизитОбязательный(ИмяРеквизита, ДанныеДокумента),
				"Тип перечисления не подходит для реквизита " + ИмяРеквизита);
		КонецЕсли;
		Возврат РезультатЗначения(Значение);
	ИначеЕсли Вид = "Ссылка" Тогда
		Возврат ВосстановитьСсылку(Описание, ИмяРеквизита, ОписаниеТипа, Контекст, ДанныеДокумента);
	КонецЕсли;
	
	Возврат РезультатЗначения(
		ОписаниеТипа.ПривестиЗначение(Неопределено),
		Ложь,
		"Пропущено неподдерживаемое значение реквизита " + ИмяРеквизита);
	
КонецФункции

Функция РезультатЗначения(Значение, Жесткая = Ложь, Сообщение = "")
	
	Возврат Новый Структура("Значение, Жесткая, Сообщение", Значение, Жесткая, Сообщение);
	
КонецФункции

Функция ПримитивИзОписания(Описание)
	
	Тип = СвойствоСтруктуры(Описание, "Тип", "Строка");
	Данные = СвойствоСтруктуры(Описание, "Данные", "");
	Если Тип = "Число" Тогда
		Если ТипЗнч(Данные) = Тип("Число") Тогда
			Возврат Данные;
		КонецЕсли;
		Возврат Число(СтрЗаменить(Строка(Данные), " ", ""));
	ИначеЕсли Тип = "Булево" Тогда
		Если ТипЗнч(Данные) = Тип("Булево") Тогда
			Возврат Данные;
		КонецЕсли;
		Текст = ВРег(СокрЛП(Строка(Данные)));
		Возврат Текст = "TRUE" Или Текст = "ИСТИНА" Или Текст = "ДА";
	ИначеЕсли Тип = "Дата" Тогда
		Возврат ДатаИзСтрокиXML(Данные);
	КонецЕсли;
	Возврат Строка(Данные);
	
КонецФункции

Функция ПеречислениеИзОписания(Описание)
	
	ИмяПеречисления = СвойствоСтруктуры(Описание, "Имя", "");
	ИмяЗначения = СвойствоСтруктуры(Описание, "Значение", "");
	Мета = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если Мета = Неопределено Или Мета.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
	
КонецФункции

Функция ВосстановитьСсылку(Описание, ИмяРеквизита, ОписаниеТипа, Контекст, ДанныеДокумента)
	
	РезультатПоиска = НайтиИлиСоздатьСсылку(Описание, Контекст);
	Если ЗначениеЗаполнено(РезультатПоиска.Ссылка) Тогда
		Если ОписаниеТипа.СодержитТип(ТипЗнч(РезультатПоиска.Ссылка)) Тогда
			Возврат РезультатЗначения(РезультатПоиска.Ссылка, Ложь, РезультатПоиска.Сообщение);
		КонецЕсли;
		Возврат РезультатЗначения(
			ОписаниеТипа.ПривестиЗначение(Неопределено),
			Не СсылкаМягкая(ИмяРеквизита, Описание, ДанныеДокумента),
			"Тип " + СвойствоСтруктуры(Описание, "ПолноеИмя", "") + " не подходит для реквизита " + ИмяРеквизита);
	КонецЕсли;
	
	Сообщение = РезультатПоиска.Сообщение;
	Если Не ЗначениеЗаполнено(Сообщение) Тогда
		Сообщение = ТекстНеНайдено(Описание);
	КонецЕсли;
	Если СсылкаМягкая(ИмяРеквизита, Описание, ДанныеДокумента) Тогда
		Возврат РезультатЗначения(ОписаниеТипа.ПривестиЗначение(Неопределено), Ложь, Сообщение);
	КонецЕсли;
	Возврат РезультатЗначения(ОписаниеТипа.ПривестиЗначение(Неопределено), Истина, Сообщение);
	
КонецФункции

Функция СсылкаМягкая(ИмяРеквизита, Описание, ДанныеДокумента)
	
	Если ИмяМягкое(ИмяРеквизита) Тогда
		Возврат Истина;
	КонецЕсли;
	Если РеквизитОбязательный(ИмяРеквизита, ДанныеДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолноеИмя = СвойствоСтруктуры(Описание, "ПолноеИмя", "");
	Если СтрНачинаетсяС(ПолноеИмя, "Документ.")
		Или ПолноеИмя = "Справочник.Пользователи"
		Или ПолноеИмя = "Справочник.ГруппыПользователей"
		Или ПолноеИмя = "Справочник.ВнешниеПользователи"
		Или ПолноеИмя = "Справочник.Валюты" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Не ТипОбязательный(ПолноеИмя);
	
КонецФункции

Функция ИмяМягкое(ИмяРеквизита)
	
	Возврат ИмяРеквизита = "Ответственный"
		Или ИмяРеквизита = "Бухгалтер"
		Или ИмяРеквизита = "Автор"
		Или ИмяРеквизита = "Подразделение"
		Или ИмяРеквизита = "СтатьяРасходов"
		Или ИмяРеквизита = "СтатьяФинансирования"
		Или ИмяРеквизита = "РегистрацияВНалоговомОргане"
		Или ИмяРеквизита = "ДокументОснование"
		Или ИмяРеквизита = "ИсправленныйДокумент"
		Или ИмяРеквизита = "СторнируемыйДокумент"
		Или ИмяРеквизита = "ИсправительныйДокумент";
	
КонецФункции

Функция РеквизитОбязательный(ИмяРеквизита, ДанныеДокумента)
	
	Если ИмяРеквизита = "Организация"
		Или ИмяРеквизита = "ФизическоеЛицо"
		Или ИмяРеквизита = "Удержание"
		Или ИмяРеквизита = "Получатель"
		Или ИмяРеквизита = "ПлатежныйАгент"
		Или ИмяРеквизита = "СпособРасчета" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ИмяРеквизита = "Сотрудник" Тогда
		Возврат Не ОписаниеЗаполнено(НайтиОписаниеРеквизита(ДанныеДокумента, "ФизическоеЛицо"));
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция ТипОбязательный(ПолноеИмя)
	
	Возврат ПолноеИмя = "Справочник.Организации"
		Или ПолноеИмя = "Справочник.ФизическиеЛица"
		Или ПолноеИмя = "Справочник.Удержания"
		Или ПолноеИмя = "ПланВидовРасчета.Удержания"
		Или ПолноеИмя = "Справочник.Контрагенты"
		Или ПолноеИмя = "Справочник.КлассификаторБанков"
		Или ПолноеИмя = "Справочник.БанковскиеСчетаКонтрагентов"
		Или ПолноеИмя = "Справочник.БанковскиеСчета";
	
КонецФункции

Функция НайтиИлиСоздатьСсылку(Описание, Контекст)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Или СвойствоСтруктуры(Описание, "Вид", "") <> "Ссылка" Тогда
		Возврат РезультатСсылки(Неопределено, "Пустое значение ссылки");
	КонецЕсли;
	
	ПолноеИмя = СвойствоСтруктуры(Описание, "ПолноеИмя", "");
	УИД = СвойствоСтруктуры(Описание, "УИД", "");
	КлючКэша = ПолноеИмя + "|" + УИД;
	Если ЗначениеЗаполнено(УИД) И Контекст.Кэш[КлючКэша] <> Неопределено Тогда
		Возврат Контекст.Кэш[КлючКэша];
	КонецЕсли;
	Если ЗначениеЗаполнено(УИД) И Контекст.Стек[КлючКэша] <> Неопределено Тогда
		Возврат РезультатСсылки(Неопределено, "Цикл ссылок: " + ПолноеИмя);
	КонецЕсли;
	
	Менеджер = МенеджерПоПолномуИмени(ПолноеИмя);
	Если Менеджер = Неопределено Тогда
		Возврат РезультатСсылки(Неопределено, "В базе нет типа " + ПолноеИмя
			+ " (" + СвойствоСтруктуры(Описание, "Представление", "") + ")");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УИД) Тогда
		Контекст.Стек.Вставить(КлючКэша, Истина);
	КонецЕсли;
	
	Результат = НайтиСсылкуПоКлючам(Описание, Менеджер, Контекст);
	Если Не ЗначениеЗаполнено(Результат.Ссылка) И Не ЗначениеЗаполнено(Результат.Сообщение) Тогда
		Если МожноСоздавать(ПолноеИмя, Контекст) И Не СвойствоСтруктуры(Описание, "ЭтоГруппа", Ложь) Тогда
			Результат = СоздатьЭлемент(Описание, Менеджер, Контекст);
		Иначе
			Результат = РезультатСсылки(Неопределено, ТекстНеНайдено(Описание));
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УИД) Тогда
		Контекст.Стек.Удалить(КлючКэша);
		Если ЗначениеЗаполнено(Результат.Ссылка) Тогда
			Контекст.Кэш.Вставить(КлючКэша, Результат);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция МожноСоздавать(ПолноеИмя, Контекст)
	
	Если ПолноеИмя = "Справочник.Сотрудники" Тогда
		Возврат Контекст.Параметры.СоздаватьСотрудников;
	КонецЕсли;
	Если Не Контекст.Параметры.СоздаватьЭлементыСправочников Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПолноеИмя = "Справочник.ФизическиеЛица"
		Или ПолноеИмя = "Справочник.Контрагенты"
		Или ПолноеИмя = "Справочник.КлассификаторБанков"
		Или ПолноеИмя = "Справочник.БанковскиеСчетаКонтрагентов"
		Или ПолноеИмя = "Справочник.БанковскиеСчета";
	
КонецФункции

Функция НайтиСсылкуПоКлючам(Описание, Менеджер, Контекст)
	
	ПолноеИмя = СвойствоСтруктуры(Описание, "ПолноеИмя", "");
	Если ПолноеИмя = "Справочник.Организации" Тогда
		Возврат НайтиОрганизацию(Описание);
	ИначеЕсли ПолноеИмя = "Справочник.ФизическиеЛица" Тогда
		Возврат НайтиФизическоеЛицо(Описание);
	ИначеЕсли ПолноеИмя = "Справочник.Сотрудники" Тогда
		Возврат НайтиСотрудника(Описание, Контекст);
	ИначеЕсли ПолноеИмя = "Справочник.Контрагенты" Тогда
		Возврат НайтиКонтрагента(Описание);
	ИначеЕсли ПолноеИмя = "Справочник.Удержания" Или ПолноеИмя = "ПланВидовРасчета.Удержания" Тогда
		Возврат НайтиУдержание(Описание, Менеджер);
	ИначеЕсли ПолноеИмя = "Справочник.КлассификаторБанков" Тогда
		Возврат НайтиБанк(Описание, Менеджер);
	ИначеЕсли ПолноеИмя = "Справочник.БанковскиеСчетаКонтрагентов" Или ПолноеИмя = "Справочник.БанковскиеСчета" Тогда
		Возврат НайтиБанковскийСчет(Описание, Контекст);
	ИначеЕсли СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
		Возврат НайтиДокументПоОписанию(Описание, Менеджер);
	ИначеЕсли ПолноеИмя = "Справочник.Валюты" Тогда
		Возврат НайтиВалюту(Описание, Менеджер);
	КонецЕсли;
	Возврат НайтиПоКодуИлиНаименованию(Описание, Менеджер);
	
КонецФункции

Функция РезультатСсылки(Ссылка, Сообщение = "", Создана = Ложь)
	
	Возврат Новый Структура("Ссылка, Создана, Сообщение", Ссылка, Создана, Сообщение);
	
КонецФункции

Функция РезультатПоМассиву(Найденные, ТекстМножества)
	
	Если Найденные.Количество() = 1 Тогда
		Возврат РезультатСсылки(Найденные[0]);
	КонецЕсли;
	Если Найденные.Количество() > 1 Тогда
		Возврат РезультатСсылки(Неопределено, ТекстМножества);
	КонецЕсли;
	Возврат РезультатСсылки(Неопределено);
	
КонецФункции

Функция ТекстНеНайдено(Описание)
	
	Возврат "Не найдено: " + СвойствоСтруктуры(Описание, "ПолноеИмя", "")
		+ " " + СвойствоСтруктуры(Описание, "Представление", "")
		+ КлючиДляСообщения(Описание);
	
КонецФункции

Функция КлючиДляСообщения(Описание)
	
	Части = Новый Массив;
	ИНН = СтрокаКлюча(Описание, "ИНН");
	КПП = СтрокаКлюча(Описание, "КПП");
	СНИЛС = СтрокаКлюча(Описание, "СтраховойНомерПФР");
	Код = СокрЛП(СвойствоСтруктуры(Описание, "Код", ""));
	Если ЗначениеЗаполнено(ИНН) Тогда
		Части.Добавить("ИНН " + ИНН);
	КонецЕсли;
	Если ЗначениеЗаполнено(КПП) Тогда
		Части.Добавить("КПП " + КПП);
	КонецЕсли;
	Если ЗначениеЗаполнено(СНИЛС) Тогда
		Части.Добавить("СНИЛС " + СНИЛС);
	КонецЕсли;
	Если ЗначениеЗаполнено(Код) Тогда
		Части.Добавить("код " + Код);
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат " (" + СтрСоединить(Части, ", ") + ")";
	
КонецФункции

Функция НайтиОрганизацию(Описание)
	
	ИНН = СтрокаКлюча(Описание, "ИНН");
	КПП = СтрокаКлюча(Описание, "КПП");
	Наименование = СокрЛП(СвойствоСтруктуры(Описание, "Наименование", ""));
	
	Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) И РеквизитСуществует("Справочник.Организации", "ИНН") Тогда
		Найденные = НайтиЭлементы("Справочник.Организации",
			УсловияРавенства("ИНН,КПП"),
			ПараметрыЗапроса("ИНН,КПП", ИНН, КПП));
		Если Найденные.Количество() > 0 Тогда
			Возврат РезультатПоМассиву(Найденные, "Несколько организаций с ИНН " + ИНН + " и КПП " + КПП);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) И РеквизитСуществует("Справочник.Организации", "ИНН") Тогда
		Найденные = НайтиЭлементы("Справочник.Организации",
			УсловияРавенства("ИНН"),
			ПараметрыЗапроса("ИНН", ИНН));
		Если Найденные.Количество() = 1 Тогда
			Возврат РезультатСсылки(Найденные[0]);
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Возврат РезультатСсылки(Неопределено, "Несколько организаций с ИНН " + ИНН);
		КонецЕсли;
		Возврат РезультатСсылки(Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Найденные = НайтиЭлементы("Справочник.Организации",
			УсловияРавенства("Наименование"),
			ПараметрыЗапроса("Наименование", Наименование));
		Возврат РезультатПоМассиву(Найденные, "Несколько организаций с наименованием " + Наименование);
	КонецЕсли;
	Возврат РезультатСсылки(Неопределено);
	
КонецФункции

Функция НайтиФизическоеЛицо(Описание)
	
	СНИЛС = СтрокаКлюча(Описание, "СтраховойНомерПФР");
	Если ЗначениеЗаполнено(СНИЛС) И РеквизитСуществует("Справочник.ФизическиеЛица", "СтраховойНомерПФР") Тогда
		Для Каждого Вариант Из ВариантыСНИЛС(СНИЛС) Цикл
			Найденные = НайтиЭлементы("Справочник.ФизическиеЛица",
				УсловияРавенства("СтраховойНомерПФР"),
				ПараметрыЗапроса("СтраховойНомерПФР", Вариант));
			Если Найденные.Количество() = 1 Тогда
				Возврат РезультатСсылки(Найденные[0]);
			КонецЕсли;
			Если Найденные.Количество() > 1 Тогда
				Возврат РезультатСсылки(Неопределено, "Несколько физических лиц со СНИЛС " + СНИЛС);
			КонецЕсли;
		КонецЦикла;
		Возврат РезультатСсылки(Неопределено);
	КонецЕсли;
	
	ИНН = СтрокаКлюча(Описание, "ИНН");
	Если ЗначениеЗаполнено(ИНН) И РеквизитСуществует("Справочник.ФизическиеЛица", "ИНН") Тогда
		Найденные = НайтиЭлементы("Справочник.ФизическиеЛица",
			УсловияРавенства("ИНН"),
			ПараметрыЗапроса("ИНН", ИНН));
		Если Найденные.Количество() = 1 Тогда
			Возврат РезультатСсылки(Найденные[0]);
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Возврат РезультатСсылки(Неопределено, "Несколько физических лиц с ИНН " + ИНН);
		КонецЕсли;
		Возврат РезультатСсылки(Неопределено);
	КонецЕсли;
	
	Фамилия = СтрокаКлюча(Описание, "Фамилия");
	Имя = СтрокаКлюча(Описание, "Имя");
	Отчество = СтрокаКлюча(Описание, "Отчество");
	ДатаРождения = ДатаКлюча(Описание, "ДатаРождения");
	Если ЗначениеЗаполнено(Фамилия) И ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(ДатаРождения)
		И РеквизитСуществует("Справочник.ФизическиеЛица", "Фамилия")
		И РеквизитСуществует("Справочник.ФизическиеЛица", "ДатаРождения") Тогда
		Имена = "Фамилия,Имя,ДатаРождения";
		Условия = УсловияРавенства(Имена);
		ПараметрыПоиска = ПараметрыЗапроса(Имена, Фамилия, Имя, ДатаРождения);
		Если ЗначениеЗаполнено(Отчество) И РеквизитСуществует("Справочник.ФизическиеЛица", "Отчество") Тогда
			Условия.Добавить("Таблица.Отчество = &Отчество");
			ПараметрыПоиска.Вставить("Отчество", Отчество);
		КонецЕсли;
		Найденные = НайтиЭлементы("Справочник.ФизическиеЛица", Условия, ПараметрыПоиска);
		Возврат РезультатПоМассиву(Найденные, "Несколько физических лиц " + Фамилия + " " + Имя + " с одной датой рождения");
	КонецЕсли;
	
	Возврат РезультатСсылки(Неопределено);
	
КонецФункции

Функция НайтиСотрудника(Описание, Контекст)
	
	Код = СокрЛП(СвойствоСтруктуры(Описание, "Код", ""));
	Физлицо = ПустаяСсылкаМенеджера("Справочник.ФизическиеЛица");
	Организация = ПустаяСсылкаМенеджера("Справочник.Организации");
	
	ОписаниеФизлица = ЗначениеКлюча(Описание, "ФизическоеЛицо");
	Если ТипЗнч(ОписаниеФизлица) = Тип("Структура") И СвойствоСтруктуры(ОписаниеФизлица, "Вид", "") = "Ссылка" Тогда
		РезультатФизлица = НайтиИлиСоздатьСсылку(ОписаниеФизлица, Контекст);
		Если ЗначениеЗаполнено(РезультатФизлица.Ссылка) Тогда
			Физлицо = РезультатФизлица.Ссылка;
		ИначеЕсли ЗначениеЗаполнено(РезультатФизлица.Сообщение) Тогда
			Возврат РезультатСсылки(Неопределено, РезультатФизлица.Сообщение);
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеОрганизации = ЗначениеКлюча(Описание, "ГоловнаяОрганизация");
	Если ТипЗнч(ОписаниеОрганизации) = Тип("Структура") И СвойствоСтруктуры(ОписаниеОрганизации, "Вид", "") = "Ссылка" Тогда
		РезультатОрганизации = НайтиИлиСоздатьСсылку(ОписаниеОрганизации, Контекст);
		Если ЗначениеЗаполнено(РезультатОрганизации.Ссылка) Тогда
			Организация = РезультатОрганизации.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьФизлицо = РеквизитСуществует("Справочник.Сотрудники", "ФизическоеЛицо") И ЗначениеЗаполнено(Физлицо);
	ЕстьОрганизация = РеквизитСуществует("Справочник.Сотрудники", "ГоловнаяОрганизация") И ЗначениеЗаполнено(Организация);
	ЕстьКод = ЗначениеЗаполнено(Код);
	
	Варианты = Новый Массив;
	Если ЕстьКод И ЕстьФизлицо И ЕстьОрганизация Тогда
		Варианты.Добавить(Новый Структура("Код,Физлицо,Организация", Истина, Истина, Истина));
	КонецЕсли;
	Если ЕстьКод И ЕстьФизлицо Тогда
		Варианты.Добавить(Новый Структура("Код,Физлицо,Организация", Истина, Истина, Ложь));
	КонецЕсли;
	Если ЕстьКод И ЕстьОрганизация Тогда
		Варианты.Добавить(Новый Структура("Код,Физлицо,Организация", Истина, Ложь, Истина));
	КонецЕсли;
	Если ЕстьФизлицо И ЕстьОрганизация Тогда
		Варианты.Добавить(Новый Структура("Код,Физлицо,Организация", Ложь, Истина, Истина));
	КонецЕсли;
	Если ЕстьКод Тогда
		Варианты.Добавить(Новый Структура("Код,Физлицо,Организация", Истина, Ложь, Ложь));
	КонецЕсли;
	
	Для Каждого Вариант Из Варианты Цикл
		Условия = Новый Массив;
		Условия.Добавить("НЕ Таблица.ПометкаУдаления");
		ПараметрыПоиска = Новый Структура;
		Если Вариант.Код Тогда
			Условия.Добавить("СОКРЛП(Таблица.Код) = &Код");
			ПараметрыПоиска.Вставить("Код", Код);
		КонецЕсли;
		Если Вариант.Физлицо Тогда
			Условия.Добавить("Таблица.ФизическоеЛицо = &ФизическоеЛицо");
			ПараметрыПоиска.Вставить("ФизическоеЛицо", Физлицо);
		КонецЕсли;
		Если Вариант.Организация Тогда
			Условия.Добавить("Таблица.ГоловнаяОрганизация = &Организация");
			ПараметрыПоиска.Вставить("Организация", Организация);
		КонецЕсли;
		Найденные = НайтиЭлементы("Справочник.Сотрудники", Условия, ПараметрыПоиска);
		Если Найденные.Количество() = 1 Тогда
			Возврат РезультатСсылки(Найденные[0]);
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Возврат РезультатСсылки(Неопределено, "Найдено несколько сотрудников, уточните табельный номер и организацию");
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатСсылки(Неопределено);
	
КонецФункции

Функция НайтиКонтрагента(Описание)
	
	ИНН = СтрокаКлюча(Описание, "ИНН");
	КПП = СтрокаКлюча(Описание, "КПП");
	Наименование = СокрЛП(СвойствоСтруктуры(Описание, "Наименование", ""));
	ЕстьИНН = РеквизитСуществует("Справочник.Контрагенты", "ИНН");
	
	Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) И ЕстьИНН И РеквизитСуществует("Справочник.Контрагенты", "КПП") Тогда
		Найденные = НайтиЭлементы("Справочник.Контрагенты",
			УсловияРавенства("ИНН,КПП"),
			ПараметрыЗапроса("ИНН,КПП", ИНН, КПП));
		Если Найденные.Количество() > 0 Тогда
			Возврат РезультатПоМассиву(Найденные, "Несколько контрагентов с ИНН " + ИНН + " и КПП " + КПП);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) И ЕстьИНН Тогда
		Найденные = НайтиЭлементы("Справочник.Контрагенты",
			УсловияРавенства("ИНН"),
			ПараметрыЗапроса("ИНН", ИНН));
		Если Найденные.Количество() = 1 Тогда
			Возврат РезультатСсылки(Найденные[0]);
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Возврат РезультатСсылки(Неопределено, "Несколько контрагентов с ИНН " + ИНН);
		КонецЕсли;
		Возврат РезультатСсылки(Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Найденные = НайтиЭлементы("Справочник.Контрагенты",
			УсловияРавенства("Наименование"),
			ПараметрыЗапроса("Наименование", Наименование));
		Возврат РезультатПоМассиву(Найденные, "Несколько контрагентов с наименованием " + Наименование);
	КонецЕсли;
	Возврат РезультатСсылки(Неопределено);
	
КонецФункции

Функция НайтиУдержание(Описание, Менеджер)
	
