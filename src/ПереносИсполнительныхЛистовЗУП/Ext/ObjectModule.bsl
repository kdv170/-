Функция СоздатьЭлемент(Описание, Менеджер, Контекст)
	
	ПолноеИмя = СвойствоСтруктуры(Описание, "ПолноеИмя", "");
	Мета = МетаданныеПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Или Не СтрНачинаетсяС(ПолноеИмя, "Справочник.") Тогда
		Возврат РезультатСсылки(Неопределено, "Создание " + ПолноеИмя + " не поддерживается");
	КонецЕсли;
	
	СправочникОбъект = Менеджер.СоздатьЭлемент();
	Если Мета.Владельцы.Количество() > 0 Тогда
		ОписаниеВладельца = ЗначениеКлюча(Описание, "Владелец");
		Если ТипЗнч(ОписаниеВладельца) <> Тип("Структура") Тогда
			Возврат РезультатСсылки(Неопределено, "Не указан владелец для " + СвойствоСтруктуры(Описание, "Представление", ""));
		КонецЕсли;
		РезультатВладельца = НайтиИлиСоздатьСсылку(ОписаниеВладельца, Контекст);
		Если Не ЗначениеЗаполнено(РезультатВладельца.Ссылка) Тогда
			Сообщение = РезультатВладельца.Сообщение;
			Если Не ЗначениеЗаполнено(Сообщение) Тогда
				Сообщение = ТекстНеНайдено(ОписаниеВладельца);
			КонецЕсли;
			Возврат РезультатСсылки(Неопределено, Сообщение);
		КонецЕсли;
		СправочникОбъект.Владелец = РезультатВладельца.Ссылка;
	КонецЕсли;
	
	ЗаполнитьЭлементКлючами(СправочникОбъект, Мета, Описание, Контекст);
	
	Если Мета.ДлинаНаименования > 0 И Не ЗначениеЗаполнено(СправочникОбъект.Наименование) Тогда
		СправочникОбъект.Наименование = СвойствоСтруктуры(Описание, "Наименование", "");
	КонецЕсли;
	Если ПолноеИмя = "Справочник.ФизическиеЛица" И Не ЗначениеЗаполнено(СправочникОбъект.Наименование) Тогда
		СправочникОбъект.Наименование = СокрЛП(СтрокаКлюча(Описание, "Фамилия") + " "
			+ СтрокаКлюча(Описание, "Имя") + " " + СтрокаКлюча(Описание, "Отчество"));
	КонецЕсли;
	
	СохранятьКод = ПолноеИмя = "Справочник.Сотрудники" Или ПолноеИмя = "Справочник.КлассификаторБанков";
	Код = СокрЛП(СвойствоСтруктуры(Описание, "Код", ""));
	Если Мета.ДлинаКода > 0 И ЗначениеЗаполнено(Код) Тогда
		СправочникОбъект.Код = Код;
	ИначеЕсли Мета.ДлинаКода > 0 И Не СохранятьКод Тогда
		СправочникОбъект.УстановитьНовыйКод();
	КонецЕсли;
	
	ТекстОшибки = ЗаписатьСправочник(СправочникОбъект, СохранятьКод);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат РезультатСсылки(Неопределено, "Не удалось создать " + ПолноеИмя
			+ " " + СвойствоСтруктуры(Описание, "Представление", "") + ": " + ТекстОшибки);
	КонецЕсли;
	
	Контекст.Созданные.Добавить(ПолноеИмя + " " + Строка(СправочникОбъект.Ссылка));
	Если ПолноеИмя = "Справочник.Сотрудники" Тогда
		Контекст.Предупреждения.Добавить("Создан сотрудник " + Строка(СправочникОбъект.Ссылка)
			+ " без кадровой истории и приема на работу");
	КонецЕсли;
	Возврат РезультатСсылки(СправочникОбъект.Ссылка, "", Истина);
	
КонецФункции

Процедура ЗаполнитьЭлементКлючами(СправочникОбъект, Мета, Описание, Контекст)
	
	Для Каждого Ключ Из СвойствоСтруктуры(Описание, "Ключи", Новый Массив) Цикл
		Имя = СвойствоСтруктуры(Ключ, "Имя", "");
		Если Имя = "Владелец" Или Мета.Реквизиты.Найти(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеКлючаДляЗаполнения(СвойствоСтруктуры(Ключ, "Значение", Неопределено), Мета.Реквизиты[Имя].Тип, Контекст);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			СправочникОбъект[Имя] = Значение;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗначениеКлючаДляЗаполнения(Описание, ОписаниеТипа, Контекст)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вид = СвойствоСтруктуры(Описание, "Вид", "Пусто");
	Если Вид = "Пусто" Тогда
		Возврат Неопределено;
	ИначеЕсли Вид = "Примитив" Тогда
		Возврат ПримитивИзОписания(Описание);
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат ПеречислениеИзОписания(Описание);
	ИначеЕсли Вид = "Ссылка" Тогда
		Результат = НайтиИлиСоздатьСсылку(Описание, Контекст);
		Если ЗначениеЗаполнено(Результат.Ссылка) И ОписаниеТипа.СодержитТип(ТипЗнч(Результат.Ссылка)) Тогда
			Возврат Результат.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция ЗаписатьСправочник(СправочникОбъект, СохранятьКод)
	
	Попытка
		СправочникОбъект.Записать();
		Возврат "";
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не СохранятьКод Тогда
		Попытка
			СправочникОбъект.УстановитьНовыйКод();
			СправочникОбъект.Записать();
			Возврат "";
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		СправочникОбъект.ОбменДанными.Загрузка = Истина;
		СправочникОбъект.Записать();
		Возврат "";
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

Функция НайтиСуществующийДокумент(ДанныеДокумента, ЗначенияРеквизитов, Контекст)
	
	ПустаяСсылка = Документы.ИсполнительныйЛист.ПустаяСсылка();
	УИД = СвойствоСтруктуры(ДанныеДокумента, "УИД", "");
	Ссылка = НайтиДокументИсполнительныйЛистПоУИД(УИД);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Если РеквизитДокументаСуществует("Комментарий") И ЗначениеЗаполнено(УИД) Тогда
		Условия = Новый Массив;
		Условия.Добавить("Таблица.Комментарий ПОДОБНО &Маска");
		Найденные = НайтиЭлементы("Документ.ИсполнительныйЛист", Условия,
			ПараметрыЗапроса("Маска", "%ПереносЗУП:" + УИД + "%"));
		Если Найденные.Количество() = 1 Тогда
			Возврат Найденные[0];
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Контекст.ЖесткиеОшибки.Добавить("Несколько документов с маркером переноса " + УИД);
			Возврат ПустаяСсылка;
		КонецЕсли;
	КонецЕсли;
	
	Номер = СокрЛП(СвойствоСтруктуры(ДанныеДокумента, "Номер", ""));
	ДатаДокумента = ДатаИзСтрокиXML(СвойствоСтруктуры(ДанныеДокумента, "Дата", ""));
	Если ЗначениеЗаполнено(Номер) И ЗначениеЗаполнено(ДатаДокумента) Тогда
		Условия = Новый Массив;
		Условия.Добавить("СОКРЛП(Таблица.Номер) = &Номер");
		Условия.Добавить("Таблица.Дата >= &НачалоДня");
		Условия.Добавить("Таблица.Дата <= &КонецДня");
		ПараметрыПоиска = Новый Структура("Номер, НачалоДня, КонецДня", Номер, НачалоДня(ДатаДокумента), КонецДня(ДатаДокумента));
		Найденные = НайтиЭлементы("Документ.ИсполнительныйЛист", Условия, ПараметрыПоиска);
		Если Найденные.Количество() = 1 Тогда
			Если ДокументСовпадаетПоКлючу(Найденные[0], ЗначенияРеквизитов) Тогда
				Возврат Найденные[0];
			КонецЕсли;
			Контекст.ЖесткиеОшибки.Добавить("Номер " + Номер + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")
				+ " уже занят другим исполнительным листом");
			Возврат ПустаяСсылка;
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			Контекст.ЖесткиеОшибки.Добавить("Несколько документов с номером " + Номер);
			Возврат ПустаяСсылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайтиПоБизнесКлючу(ЗначенияРеквизитов, Контекст);
	
КонецФункции

Функция НайтиДокументИсполнительныйЛистПоУИД(УИД)
	
	Если Не ЗначениеЗаполнено(УИД) Тогда
		Возврат Документы.ИсполнительныйЛист.ПустаяСсылка();
	КонецЕсли;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(УИД);
	Исключение
		Возврат Документы.ИсполнительныйЛист.ПустаяСсылка();
	КонецПопытки;
	Ссылка = Документы.ИсполнительныйЛист.ПолучитьСсылку(Идентификатор);
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Документы.ИсполнительныйЛист.ПустаяСсылка();
	КонецЕсли;
	Возврат Ссылка;
	
КонецФункции

Функция ДокументСовпадаетПоКлючу(Ссылка, ЗначенияРеквизитов)
	
	Для Каждого Имя Из СтрРазделить("Организация,ФизическоеЛицо,Удержание,Сотрудник", ",", Ложь) Цикл
		Если Не РеквизитДокументаСуществует(Имя) Тогда
			Продолжить;
		КонецЕсли;
		НовоеЗначение = ЗначенияРеквизитов[Имя];
		Если Не ЗначениеЗаполнено(НовоеЗначение) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка[Имя]) И Ссылка[Имя] <> НовоеЗначение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция НайтиПоБизнесКлючу(ЗначенияРеквизитов, Контекст)
	
	ПустаяСсылка = Документы.ИсполнительныйЛист.ПустаяСсылка();
	Условия = Новый Массив;
	ПараметрыПоиска = Новый Структура;
	ЕстьЯкорь = Ложь;
	
	Для Каждого Имя Из СтрРазделить("Организация,ФизическоеЛицо,Удержание,Сотрудник", ",", Ложь) Цикл
		Если Не РеквизитДокументаСуществует(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначенияРеквизитов[Имя];
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Условия.Добавить("Таблица." + Имя + " = &" + Имя);
		ПараметрыПоиска.Вставить(Имя, Значение);
		Если Имя = "ФизическоеЛицо" Или Имя = "Сотрудник" Тогда
			ЕстьЯкорь = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ДатаНачала = ПервоеЗаполненноеЗначение(ЗначенияРеквизитов, "ДатаДействия,ДатаНачала,ДатаНачалаДействия");
	Если ДатаНачала <> Неопределено И РеквизитДокументаСуществует(ДатаНачала.Имя) Тогда
		Условия.Добавить("Таблица." + ДатаНачала.Имя + " = &ДатаНачала");
		ПараметрыПоиска.Вставить("ДатаНачала", ДатаНачала.Значение);
	КонецЕсли;
	
	РеквизитыЛиста = ПервоеЗаполненноеЗначение(ЗначенияРеквизитов, "РеквизитыИсполнительногоДокумента,НомерИсполнительногоДокумента");
	Если РеквизитыЛиста <> Неопределено И РеквизитДокументаСуществует(РеквизитыЛиста.Имя) Тогда
		Условия.Добавить("Таблица." + РеквизитыЛиста.Имя + " = &РеквизитыЛиста");
		ПараметрыПоиска.Вставить("РеквизитыЛиста", РеквизитыЛиста.Значение);
	КонецЕсли;
	
	Если Не ЕстьЯкорь Или Условия.Количество() < 2 Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	Найденные = НайтиЭлементы("Документ.ИсполнительныйЛист", Условия, ПараметрыПоиска);
	Если Найденные.Количество() > 1 Тогда
		Контекст.ЖесткиеОшибки.Добавить("Найдено несколько исполнительных листов с теми же сотрудником, удержанием и датой начала");
		Возврат ПустаяСсылка;
	КонецЕсли;
	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;
	Возврат ПустаяСсылка;
	
КонецФункции

Функция ПервоеЗаполненноеЗначение(ЗначенияРеквизитов, Имена)
	
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		ИмяРеквизита = СокрЛП(Имя);
		Значение = ЗначенияРеквизитов[ИмяРеквизита];
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Новый Структура("Имя, Значение", ИмяРеквизита, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьУИДНового(ДокОбъект, УИД)
	
	Если Не ЗначениеЗаполнено(УИД) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Ссылка = Документы.ИсполнительныйЛист.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		ДокОбъект.УстановитьСсылкуНового(Ссылка);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьНомерИДату(ДокОбъект, ДанныеДокумента)
	
	ДатаДокумента = ДатаИзСтрокиXML(СвойствоСтруктуры(ДанныеДокумента, "Дата", ""));
	Если ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДокОбъект.Дата = ДатаДокумента;
	КонецЕсли;
	
	Номер = СокрЛП(СвойствоСтруктуры(ДанныеДокумента, "Номер", ""));
	Если ЗначениеЗаполнено(Номер) Тогда
		ДокОбъект.Номер = Номер;
	ИначеЕсли ДокОбъект.ЭтоНовый() Тогда
		ДокОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьМаркер(ДокОбъект, УИД)
	
	Если Не РеквизитДокументаСуществует("Комментарий") Или Не ЗначениеЗаполнено(УИД) Тогда
		Возврат;
	КонецЕсли;
	
	Маркер = "ПереносЗУП:" + УИД;
	Комментарий = Строка(ДокОбъект.Комментарий);
	Если СтрНайти(Комментарий, Маркер) > 0 Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Комментарий = Комментарий + Символы.ПС + Маркер;
	Иначе
		Комментарий = Маркер;
	КонецЕсли;
	
	Длина = 0;
	Попытка
		Длина = Метаданные.Документы.ИсполнительныйЛист.Реквизиты.Комментарий.Тип.КвалификаторыСтроки.Длина;
	Исключение
		Длина = 0;
	КонецПопытки;
	Если Длина > 0 И СтрДлина(Комментарий) > Длина Тогда
		Комментарий = Лев(Маркер, Длина);
	КонецЕсли;
	ДокОбъект.Комментарий = Комментарий;
	
КонецПроцедуры

Процедура УстановитьОтветственного(ДокОбъект)
	
	Если Не РеквизитДокументаСуществует("Ответственный") Или ЗначениеЗаполнено(ДокОбъект.Ответственный) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныеЧасти(ДокОбъект, ДанныеДокумента, Контекст)
	
	МетаДок = ДокОбъект.Метаданные();
	Для Каждого ОписаниеТЧ Из СвойствоСтруктуры(ДанныеДокумента, "ТабличныеЧасти", Новый Массив) Цикл
		ИмяТЧ = СвойствоСтруктуры(ОписаниеТЧ, "Имя", "");
		МетаТЧ = МетаДок.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаТЧ = Неопределено Тогда
			Если ЗначениеЗаполнено(ИмяТЧ) Тогда
				Контекст.ПропущенныеТабличныеЧасти.Вставить(ИмяТЧ, Истина);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Таблица = ДокОбъект[ИмяТЧ];
		Таблица.Очистить();
		Для Каждого ОписаниеСтроки Из СвойствоСтруктуры(ОписаниеТЧ, "Строки", Новый Массив) Цикл
			НоваяСтрока = Таблица.Добавить();
			Для Каждого ОписаниеРеквизита Из СвойствоСтруктуры(ОписаниеСтроки, "Реквизиты", Новый Массив) Цикл
				Имя = СвойствоСтруктуры(ОписаниеРеквизита, "Имя", "");
				МетаРеквизит = МетаТЧ.Реквизиты.Найти(Имя);
				Если МетаРеквизит = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				РезультатЗначения = ВосстановитьЗначение(
					СвойствоСтруктуры(ОписаниеРеквизита, "Значение", Неопределено),
					Имя,
					МетаРеквизит.Тип,
					Контекст,
					ДанныеДокумента);
				Если РезультатЗначения.Жесткая Тогда
					Контекст.ЖесткиеОшибки.Добавить(ИмяТЧ + "." + РезультатЗначения.Сообщение);
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(РезультатЗначения.Сообщение) Тогда
					Контекст.Предупреждения.Добавить(ИмяТЧ + "." + РезультатЗначения.Сообщение);
				КонецЕсли;
				Попытка
					НоваяСтрока[Имя] = РезультатЗначения.Значение;
				Исключение
					Контекст.ЖесткиеОшибки.Добавить(ИмяТЧ + "." + Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаписатьДокументВБазу(ДокОбъект, Контекст)
	
	БылПроведен = ДокОбъект.Проведен И Не ДокОбъект.ЭтоНовый();
	НужноПровести = Контекст.Параметры.ПроводитьДокументы Или БылПроведен;
	
	Если НужноПровести Тогда
		НачатьТранзакцию();
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			ЗафиксироватьТранзакцию();
			Возврат Новый Структура("Состояние, Сообщение", "Проведен", "");
		Исключение
			ТекстПроведения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОтменитьТранзакциюЕслиАктивна();
		КонецПопытки;
		
		Если БылПроведен Тогда
			Возврат Новый Структура(
				"Состояние, Сообщение",
				"Ошибка",
				"Перепроведение не выполнено, прежняя проведенная версия не изменена: " + ТекстПроведения);
		КонецЕсли;
		
		Попытка
			ЗаписатьБезПроведения(ДокОбъект);
		Исключение
			Возврат Новый Структура(
				"Состояние, Сообщение",
				"Ошибка",
				"Проведение не выполнено: " + ТекстПроведения
					+ ". Запись без проведения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Возврат Новый Структура(
			"Состояние, Сообщение",
			"ЗаписанБезПроведения",
			"Проведение не выполнено: " + ТекстПроведения);
	КонецЕсли;
	
	ЗаписатьБезПроведения(ДокОбъект);
	Возврат Новый Структура("Состояние, Сообщение", "Записан", "");
	
КонецФункции

Процедура ЗаписатьБезПроведения(ДокОбъект)
	
	НачатьТранзакцию();
	Попытка
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтменитьТранзакциюЕслиАктивна();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтменитьТранзакциюЕслиАктивна()
	
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

Функция УсловияРавенства(Имена)
	
	Условия = Новый Массив;
	Условия.Добавить("НЕ Таблица.ПометкаУдаления");
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(Имя);
		Условия.Добавить("Таблица." + ИмяПоля + " = &" + ИмяПоля);
	КонецЦикла;
	Возврат Условия;
	
КонецФункции

Функция НайтиЭлементы(ПолноеИмя, Условия, ПараметрыПоиска)
	
	Мета = МетаданныеПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Части = СтрРазделить(Мета.ПолноеИмя(), ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	УсловияЗапроса = Новый Массив;
	Для Каждого Условие Из Условия Цикл
		УсловияЗапроса.Добавить(Условие);
	КонецЦикла;
	Попытка
		Если Мета.Иерархический Тогда
			УсловияЗапроса.Добавить("НЕ Таблица.ЭтоГруппа");
		КонецЕсли;
	Исключение
		// У документов и части планов видов расчета иерархии нет.
	КонецПопытки;
	
	Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	" + Части[0] + "." + Мета.Имя + " КАК Таблица
	|ГДЕ
	|	" + СтрСоединить(УсловияЗапроса, Символы.ПС + Символы.Таб + "И ");
	Возврат ВыбратьСсылки(Текст, ПараметрыПоиска);
	
КонецФункции

Функция ВыбратьСсылки(ТекстЗапроса, ПараметрыПоиска)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Если ТипЗнч(ПараметрыПоиска) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ПараметрыПоиска Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ПараметрыЗапроса(Имена, Значение1, Значение2 = Неопределено, Значение3 = Неопределено, Значение4 = Неопределено)
	
	ПараметрыПоиска = Новый Структура;
	Индекс = 0;
	Значения = Новый Массив;
	Значения.Добавить(Значение1);
	Значения.Добавить(Значение2);
	Значения.Добавить(Значение3);
	Значения.Добавить(Значение4);
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		ПараметрыПоиска.Вставить(СокрЛП(Имя), Значения[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция МенеджерПоПолномуИмени(ПолноеИмя)
	
	Мета = МетаданныеПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(Мета.ПолноеИмя(), ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Имя = Мета.Имя;
	Если Части[0] = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Части[0] = "Документ" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Части[0] = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Части[0] = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Части[0] = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя];
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция МетаданныеПоПолномуИмени(ПолноеИмя)
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПустаяСсылкаМенеджера(ПолноеИмя)
	
	Менеджер = МенеджерПоПолномуИмени(ПолноеИмя);
	Если Менеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Менеджер.ПустаяСсылка();
	
КонецФункции

Функция ЗначениеКлюча(Описание, Имя)
	
	Ключ = НайтиКлюч(Описание, Имя);
	Если Ключ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СвойствоСтруктуры(Ключ, "Значение", Неопределено);
	
КонецФункции

Функция НайтиКлюч(Описание, Имя)
	
	Для Каждого Ключ Из СвойствоСтруктуры(Описание, "Ключи", Новый Массив) Цикл
		Если СвойствоСтруктуры(Ключ, "Имя", "") = Имя Тогда
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Функция СтрокаКлюча(Описание, Имя)
	
	ОписаниеЗначения = ЗначениеКлюча(Описание, Имя);
	Если ТипЗнч(ОписаниеЗначения) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если СвойствоСтруктуры(ОписаниеЗначения, "Вид", "") <> "Примитив" Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(СвойствоСтруктуры(ОписаниеЗначения, "Данные", "")));
	
КонецФункции

Функция ДатаКлюча(Описание, Имя)
	
	ОписаниеЗначения = ЗначениеКлюча(Описание, Имя);
	Если ТипЗнч(ОписаниеЗначения) <> Тип("Структура") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Если СвойствоСтруктуры(ОписаниеЗначения, "Вид", "") <> "Примитив"
		Или СвойствоСтруктуры(ОписаниеЗначения, "Тип", "") <> "Дата" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат ДатаИзСтрокиXML(СвойствоСтруктуры(ОписаниеЗначения, "Данные", ""));
	
КонецФункции

Функция ВариантыСНИЛС(Значение)
	
	Варианты = Новый Массив;
	Исходный = СокрЛП(Строка(Значение));
	Варианты.Добавить(Исходный);
	Цифры = ТолькоЦифры(Исходный);
	Форматированный = ФорматСНИЛС(Цифры);
	Если ЗначениеЗаполнено(Форматированный) И Варианты.Найти(Форматированный) = Неопределено Тогда
		Варианты.Добавить(Форматированный);
	КонецЕсли;
	Если ЗначениеЗаполнено(Цифры) И Варианты.Найти(Цифры) = Неопределено Тогда
		Варианты.Добавить(Цифры);
	КонецЕсли;
	Возврат Варианты;
	
КонецФункции

Функция ФорматСНИЛС(Цифры)
	
	Если СтрДлина(Цифры) <> 11 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Цифры, 1, 3) + "-" + Сред(Цифры, 4, 3) + "-" + Сред(Цифры, 7, 3) + " " + Сред(Цифры, 10, 2);
	
КонецФункции

Функция ТолькоЦифры(Значение)
	
	Результат = "";
	Текст = Строка(Значение);
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		ТекущийСимвол = Сред(Текст, Индекс, 1);
		Если ТекущийСимвол >= "0" И ТекущийСимвол <= "9" Тогда
			Результат = Результат + ТекущийСимвол;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ДатаИзСтрокиXML(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), СокрЛП(Строка(Значение)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция СвойствоСтруктуры(Структура, Имя, ПоУмолчанию)
	
	Если ТипЗнч(Структура) <> Тип("Структура") И ТипЗнч(Структура) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Структура.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Структура.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

Функция УИДРазрешен(ОтборУИД, УИД)
	
	Если ОтборУИД = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(ОтборУИД) = Тип("Соответствие") Тогда
		Возврат ОтборУИД[УИД] <> Неопределено;
	КонецЕсли;
	Если ТипЗнч(ОтборУИД) = Тип("Массив") Тогда
		Возврат ОтборУИД.Найти(УИД) <> Неопределено;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

Процедура УвеличитьСчетчик(Итог, Состояние)
	
	Если Состояние = "Проведен" Тогда
		Итог.Проведено = Итог.Проведено + 1;
	ИначеЕсли Состояние = "Записан" Тогда
		Итог.Записано = Итог.Записано + 1;
	ИначеЕсли Состояние = "ЗаписанБезПроведения" Тогда
		Итог.ЗаписаноБезПроведения = Итог.ЗаписаноБезПроведения + 1;
	ИначеЕсли Состояние = "Пропущен" Тогда
		Итог.Пропущено = Итог.Пропущено + 1;
	Иначе
		Итог.Ошибок = Итог.Ошибок + 1;
	КонецЕсли;
	
КонецПроцедуры

Функция КлючиСоответствия(Соответствие)
	
	Ключи = Новый Массив;
	Для Каждого КлючИЗначение Из Соответствие Цикл
		Ключи.Добавить(Строка(КлючИЗначение.Ключ));
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ", ");
	
КонецФункции

#КонецОбласти
