Функция НайтиБанковскийСчет(Описание, Контекст)
	
	ОписаниеВладельца = ЗначениеКлюча(Описание, "Владелец");
	Если ТипЗнч(ОписаниеВладельца) <> Тип("Структура") Или СвойствоСтруктуры(ОписаниеВладельца, "Вид", "") <> "Ссылка" Тогда
		Возврат РезультатСсылки(Неопределено, "У банковского счета не указан владелец");
	КонецЕсли;
	
	РезультатВладельца = НайтиИлиСоздатьСсылку(ОписаниеВладельца, Контекст);
	Если Не ЗначениеЗаполнено(РезультатВладельца.Ссылка) Тогда
		Сообщение = РезультатВладельца.Сообщение;
		Если Не ЗначениеЗаполнено(Сообщение) Тогда
			Сообщение = ТекстНеНайдено(ОписаниеВладельца);
		КонецЕсли;
		Возврат РезультатСсылки(Неопределено, "Владелец банковского счета: " + Сообщение);
	КонецЕсли;
	
	НомерСчета = СтрокаКлюча(Описание, "НомерСчета");
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		НомерСчета = СокрЛП(СвойствоСтруктуры(Описание, "Код", ""));
	КонецЕсли;
	ПолноеИмя = СвойствоСтруктуры(Описание, "ПолноеИмя", "");
	ИмяНомера = "НомерСчета";
	Если Не РеквизитСуществует(ПолноеИмя, "НомерСчета") Тогда
		ИмяНомера = "Код";
	КонецЕсли;
	
	Условия = Новый Массив;
	Условия.Добавить("НЕ Таблица.ПометкаУдаления");
	Условия.Добавить("Таблица.Владелец = &Владелец");
	Условия.Добавить("Таблица." + ИмяНомера + " = &НомерСчета");
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Владелец", РезультатВладельца.Ссылка);
	ПараметрыПоиска.Вставить("НомерСчета", НомерСчета);
	Найденные = НайтиЭлементы(ПолноеИмя, Условия, ПараметрыПоиска);
	Возврат РезультатПоМассиву(Найденные, "Несколько банковских счетов " + НомерСчета);
	
КонецФункции

Функция НайтиДокументПоОписанию(Описание, Менеджер)
	
	УИД = СвойствоСтруктуры(Описание, "УИД", "");
	Если ЗначениеЗаполнено(УИД) Тогда
		Попытка
			Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(Ссылка) И Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат РезультатСсылки(Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Номер = СокрЛП(СвойствоСтруктуры(Описание, "Номер", ""));
	ДатаДокумента = ДатаИзСтрокиXML(СвойствоСтруктуры(Описание, "Дата", ""));
	ПолноеИмя = СвойствоСтруктуры(Описание, "ПолноеИмя", "");
	Если ЗначениеЗаполнено(Номер) И ЗначениеЗаполнено(ДатаДокумента) Тогда
		Условия = Новый Массив;
		Условия.Добавить("СОКРЛП(Таблица.Номер) = &Номер");
		Условия.Добавить("Таблица.Дата >= &НачалоДня");
		Условия.Добавить("Таблица.Дата <= &КонецДня");
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Номер", Номер);
		ПараметрыПоиска.Вставить("НачалоДня", НачалоДня(ДатаДокумента));
		ПараметрыПоиска.Вставить("КонецДня", КонецДня(ДатаДокумента));
		Найденные = НайтиЭлементы(ПолноеИмя, Условия, ПараметрыПоиска);
		Возврат РезультатПоМассиву(Найденные, "Несколько документов " + ПолноеИмя + " № " + Номер);
	КонецЕсли;
	Возврат РезультатСсылки(Неопределено);
	
