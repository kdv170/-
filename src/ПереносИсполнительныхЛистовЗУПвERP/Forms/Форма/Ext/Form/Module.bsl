#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ДатаПереноса = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ПроводитьДокументы = Истина;
	ПерезаписыватьСуществующие = Ложь;
	ПереноситьОстатокПредела = Истина;
	СоздаватьКонтрагентов = Истина;
	ВариантИнформационнойБазы = "Файл";
	
	ОпределитьРежимРаботыПоУмолчанию();
	ЗаполнитьСпискиВыбора();
	НастроитьФормуПоРежиму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантИнформационнойБазыПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(?(РежимРаботы = "ЗагрузкаВERP",
		РежимДиалогаВыбораФайла.Открытие,
		РежимДиалогаВыбораФайла.Сохранение));
	Диалог.Фильтр = НСтр("ru = 'Файлы переноса исполнительных листов'") + " (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Диалог.ПолноеИмяФайла = ИмяФайла;
	Диалог.МножественныйВыбор = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ИмяФайлаЗавершениеВыбора", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗавершениеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Каталог информационной базы ЗУП'");
	Диалог.Каталог = КаталогИБ;
	
	Оповещение = Новый ОписаниеОповещения("КаталогИБЗавершениеВыбора", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогИБЗавершениеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КаталогИБ = ВыбранныеФайлы[0];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату переноса.'"));
		Возврат;
	КонецЕсли;
	
	Если РежимРаботы = "ЗагрузкаВERP" Тогда
		Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Укажите файл выгрузки.'"));
			Возврат;
		КонецЕсли;
		ЗаполнитьИзФайлаНаСервере();
	ИначеЕсли РежимРаботы = "ПрямойПереносCOM" Тогда
		Если Не ПараметрыCOMЗаполнены() Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Заполните параметры подключения к информационной базе ЗУП.'"));
			Возврат;
		КонецЕсли;
		ЗаполнитьЧерезCOMНаСервере();
	Иначе
		ЗаполнитьИзТекущейБазыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите файл выгрузки.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьОтмеченныеДокументы() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте документы для выгрузки.'"));
		Возврат;
	КонецЕсли;
	
	ВыгрузитьВФайлНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВERP(Команда)
	
	Если РежимРаботы = "ЗагрузкаВERP" И Не ЗначениеЗаполнено(АдресДанныхДокументов) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала прочитайте файл выгрузки командой «Заполнить».'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьОтмеченныеДокументы() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте документы для загрузки.'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьВERPПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		НСтр("ru = 'Загрузить отмеченные исполнительные листы в текущую информационную базу?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВERPПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьВERPНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиЧерезCOM(Команда)
	
	Если Не ПараметрыCOMЗаполнены() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните параметры подключения к информационной базе ЗУП.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьОтмеченныеДокументы() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала заполните таблицу и отметьте документы для переноса.'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПеренестиЧерезCOMПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		НСтр("ru = 'Перенести отмеченные исполнительные листы из ЗУП в текущую базу через COM?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиЧерезCOMПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПеренестиЧерезCOMНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	Для Каждого СтрокаДокумента Из ДокументыКПереносу Цикл
		СтрокаДокумента.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	Для Каждого СтрокаДокумента Из ДокументыКПереносу Цикл
		СтрокаДокумента.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОпределитьРежимРаботыПоУмолчанию()
	
	ИмяКонфигурации = ВРег(Метаданные.Имя);
	
	Если СтрНайти(ИмяКонфигурации, "ЗАРПЛАТА") > 0 Или СтрНайти(ИмяКонфигурации, "ЗУП") > 0 Тогда
		РежимРаботы = "ВыгрузкаИзЗУП";
	Иначе
		РежимРаботы = "ЗагрузкаВERP";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	Элементы.РежимРаботы.СписокВыбора.Очистить();
	Элементы.РежимРаботы.СписокВыбора.Добавить("ВыгрузкаИзЗУП", НСтр("ru = 'Выгрузка из ЗУП в файл'"));
	Элементы.РежимРаботы.СписокВыбора.Добавить("ЗагрузкаВERP", НСтр("ru = 'Загрузка в ERP из файла'"));
	Элементы.РежимРаботы.СписокВыбора.Добавить("ПрямойПереносCOM", НСтр("ru = 'Прямой перенос через COM'"));
	
	Элементы.ВариантИнформационнойБазы.СписокВыбора.Очистить();
	Элементы.ВариантИнформационнойБазы.СписокВыбора.Добавить("Файл", НСтр("ru = 'Файловая ИБ'"));
	Элементы.ВариантИнформационнойБазы.СписокВыбора.Добавить("Сервер", НСтр("ru = 'Клиент-серверная ИБ'"));
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоРежиму()
	
	Элементы.Организация.Видимость = Метаданные.Справочники.Найти("Организации") <> Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	ЭтоВыгрузка = (РежимРаботы = "ВыгрузкаИзЗУП");
	ЭтоЗагрузка = (РежимРаботы = "ЗагрузкаВERP");
	ЭтоCOM = (РежимРаботы = "ПрямойПереносCOM");
	ЭтоФайл = (ВариантИнформационнойБазы = "Файл");
	
	Элементы.ГруппаФайл.Видимость = ЭтоВыгрузка Или ЭтоЗагрузка;
	Элементы.ГруппаCOM.Видимость = ЭтоCOM;
	Элементы.КаталогИБ.Видимость = ЭтоCOM И ЭтоФайл;
	Элементы.СерверИБ.Видимость = ЭтоCOM И Не ЭтоФайл;
	Элементы.ИмяИБ.Видимость = ЭтоCOM И Не ЭтоФайл;
	
	Элементы.ФормаВыгрузитьВФайл.Видимость = ЭтоВыгрузка;
	Элементы.ФормаЗагрузитьВERP.Видимость = ЭтоЗагрузка;
	Элементы.ФормаПеренестиЧерезCOM.Видимость = ЭтоCOM;
	
	Элементы.Организация.Видимость = ЭтоВыгрузка Или ЭтоCOM;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыCOMЗаполнены()
	
	Если ВариантИнформационнойБазы = "Файл" Тогда
		Возврат ЗначениеЗаполнено(КаталогИБ);
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(СерверИБ) И ЗначениеЗаполнено(ИмяИБ);
	
КонецФункции

&НаКлиенте
Функция ЕстьОтмеченныеДокументы()
	
	Для Каждого СтрокаДокумента Из ДокументыКПереносу Цикл
		Если СтрокаДокумента.Пометка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИзТекущейБазыНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаДокументов = ОбработкаОбъект.ПолучитьДействующиеИсполнительныеЛисты(ПараметрыПереноса());
	ЗаполнитьТаблицуДокументов(ТаблицаДокументов, Неопределено);
	ДобавитьВЖурнал(СтрШаблон(
		НСтр("ru = 'Отобрано действующих исполнительных листов на %1: %2'"),
		Формат(ДатаПереноса, "ДЛФ=D"),
		Формат(ДокументыКПереносу.Количество(), "ЧН=0; ЧГ=")));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзФайлаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатЧтения = ОбработкаОбъект.ПрочитатьФайлВыгрузки(ИмяФайла);
	Если Не РезультатЧтения.Выполнено Тогда
		ДобавитьВЖурнал(РезультатЧтения.Сообщение);
		ВызватьИсключение РезультатЧтения.Сообщение;
	КонецЕсли;
	
	АдресДанныхДокументов = ПоместитьВоВременноеХранилище(РезультатЧтения.Данные, УникальныйИдентификатор);
	ЗаполнитьТаблицуДокументовИзДанныхВыгрузки(РезультатЧтения.Данные);
	ДобавитьВЖурнал(РезультатЧтения.Сообщение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЧерезCOMНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатЗаполнения = ЗаполнитьДанныеЧерезCOM(ОбработкаОбъект, ПараметрыПереноса());
	Если Не РезультатЗаполнения.Выполнено Тогда
		ДобавитьВЖурнал(РезультатЗаполнения.Сообщение);
		ВызватьИсключение РезультатЗаполнения.Сообщение;
	КонецЕсли;
	
	АдресДанныхДокументов = ПоместитьВоВременноеХранилище(РезультатЗаполнения.Данные, УникальныйИдентификатор);
	ЗаполнитьТаблицуДокументовИзДанныхВыгрузки(РезультатЗаполнения.Данные);
	ДобавитьВЖурнал(РезультатЗаполнения.Сообщение);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеЧерезCOM(ОбработкаОбъект, ПараметрыОперации)
	
	Результат = Новый Структура("Выполнено, Сообщение, Данные", Ложь, "", Неопределено);
	
	Попытка
		СоединениеЗУП = Неопределено;
		КомОбъект = Новый COMОбъект("V83.COMConnector");
		СоединениеЗУП = КомОбъект.Connect(СтрокаСоединенияЗУП());
		ДанныеВыгрузки = ОбработкаОбъект.СформироватьДанныеВыгрузки(ПараметрыОперации, СоединениеЗУП);
		СоединениеЗУП = Неопределено;
	Исключение
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Не удалось прочитать данные из ЗУП: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	Если ДанныеВыгрузки = Неопределено Тогда
		Результат.Сообщение = НСтр("ru = 'В ЗУП не найдены действующие исполнительные листы на дату переноса.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	Результат.Данные = ДанныеВыгрузки;
	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Из ЗУП получено документов: %1'"),
		Формат(ДанныеВыгрузки.Документы.Количество(), "ЧН=0; ЧГ="));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтрокаСоединенияЗУП()
	
	Части = Новый Массив;
	Если ВариантИнформационнойБазы = "Сервер" Тогда
		Части.Добавить(СтрШаблон("Srvr=""%1""", СерверИБ));
		Части.Добавить(СтрШаблон("Ref=""%1""", ИмяИБ));
	Иначе
		Части.Добавить(СтрШаблон("File=""%1""", КаталогИБ));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПользовательИБ) Тогда
		Части.Добавить(СтрШаблон("Usr=""%1""", ПользовательИБ));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПарольИБ) Тогда
		Части.Добавить(СтрШаблон("Pwd=""%1""", ПарольИБ));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ";") + ";";
	
КонецФункции

&НаСервере
Процедура ВыгрузитьВФайлНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыОперации = ПараметрыПереноса();
	ПараметрыОперации.Вставить("ОтмеченныеУИДы", ОтмеченныеУИДы());
	Результат = ОбработкаОбъект.ВыгрузитьВФайл(ПараметрыОперации, ИмяФайла);
	ДобавитьВЖурнал(Результат.Сообщение);
	
	Если Не Результат.Выполнено Тогда
		ВызватьИсключение Результат.Сообщение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВERPНаСервере()
	
	Если Не ЗначениеЗаполнено(АдресДанныхДокументов) Тогда
		ВызватьИсключение НСтр("ru = 'Нет данных для загрузки.'");
	КонецЕсли;
	
	ДанныеВыгрузки = ПолучитьИзВременногоХранилища(АдресДанныхДокументов);
	ДанныеВыгрузки = ОтфильтроватьДанныеПоПометкам(ДанныеВыгрузки);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ЗагрузитьВПриемник(ДанныеВыгрузки, ПараметрыПереноса());
	ПрименитьРезультатыЗагрузки(Результат);
	ДобавитьВЖурнал(Результат.Сообщение);
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиЧерезCOMНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыОперации = ПараметрыПереноса();
	ПараметрыОперации.Вставить("ОтмеченныеУИДы", ОтмеченныеУИДы());
	
	Если ЗначениеЗаполнено(АдресДанныхДокументов) Тогда
		ДанныеВыгрузки = ОтфильтроватьДанныеПоПометкам(ПолучитьИзВременногоХранилища(АдресДанныхДокументов));
	Иначе
		КомОбъект = Новый COMОбъект("V83.COMConnector");
		СоединениеЗУП = КомОбъект.Connect(СтрокаСоединенияЗУП());
		РезультатПодготовки = Новый Структура("Выполнено, Сообщение, Ошибок", Ложь, "", 0);
		ДанныеВыгрузки = ОбработкаОбъект.СформироватьДанныеВыгрузки(ПараметрыОперации, СоединениеЗУП, РезультатПодготовки);
		СоединениеЗУП = Неопределено;
		Если ДанныеВыгрузки = Неопределено Тогда
			ДобавитьВЖурнал(РезультатПодготовки.Сообщение);
			ВызватьИсключение РезультатПодготовки.Сообщение;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ОбработкаОбъект.ЗагрузитьВПриемник(ДанныеВыгрузки, ПараметрыОперации);
	ПрименитьРезультатыЗагрузки(Результат);
	ДобавитьВЖурнал(Результат.Сообщение);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПереноса()
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ДатаПереноса", ДатаПереноса);
	ПараметрыОперации.Вставить("Организация", Организация);
	ПараметрыОперации.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	ПараметрыОперации.Вставить("ПерезаписыватьСуществующие", ПерезаписыватьСуществующие);
	ПараметрыОперации.Вставить("ПереноситьОстатокПредела", ПереноситьОстатокПредела);
	ПараметрыОперации.Вставить("СоздаватьКонтрагентов", СоздаватьКонтрагентов);
	ПараметрыОперации.Вставить("ВариантИнформационнойБазы", ВариантИнформационнойБазы);
	ПараметрыОперации.Вставить("КаталогИБ", КаталогИБ);
	ПараметрыОперации.Вставить("СерверИБ", СерверИБ);
	ПараметрыОперации.Вставить("ИмяИБ", ИмяИБ);
	ПараметрыОперации.Вставить("ПользовательИБ", ПользовательИБ);
	ПараметрыОперации.Вставить("ПарольИБ", ПарольИБ);
	
	Возврат ПараметрыОперации;
	
КонецФункции

&НаСервере
Функция ОтмеченныеУИДы()
	
	УИДы = Новый Массив;
	Для Каждого СтрокаДокумента Из ДокументыКПереносу Цикл
		Если СтрокаДокумента.Пометка И ЗначениеЗаполнено(СтрокаДокумента.УИД) Тогда
			УИДы.Добавить(СтрокаДокумента.УИД);
		КонецЕсли;
	КонецЦикла;
	
	Возврат УИДы;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуДокументов(ТаблицаДокументов, Источник)
	
	ДокументыКПереносу.Очистить();
	
	Для Каждого СтрокаИсточника Из ТаблицаДокументов Цикл
		
		НоваяСтрока = ДокументыКПереносу.Добавить();
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.Номер = СтрокаИсточника.Номер;
		НоваяСтрока.Дата = СтрокаИсточника.Дата;
		НоваяСтрока.ОрганизацияПредставление = СтрокаИсточника.ОрганизацияПредставление;
		НоваяСтрока.СотрудникПредставление = СтрокаИсточника.СотрудникПредставление;
		НоваяСтрока.ПолучательПредставление = СтрокаИсточника.ПолучательПредставление;
		НоваяСтрока.ДатаДействия = СтрокаИсточника.ДатаДействия;
		НоваяСтрока.ДатаОкончания = СтрокаИсточника.ДатаОкончания;
		НоваяСтрока.СпособРасчетаПредставление = СтрокаИсточника.СпособРасчетаПредставление;
		НоваяСтрока.РазмерПредставление = Строка(СтрокаИсточника.Размер);
		НоваяСтрока.Состояние = НСтр("ru = 'К переносу'");
		
		Попытка
			НоваяСтрока.УИД = XMLСтрока(СтрокаИсточника.ИсполнительныйЛист);
			НоваяСтрока.Документ = Документы.ИсполнительныйЛист.ПолучитьСсылку(Новый УникальныйИдентификатор(НоваяСтрока.УИД));
		Исключение
			НоваяСтрока.УИД = Строка(СтрокаИсточника.ИсполнительныйЛист);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДокументовИзДанныхВыгрузки(ДанныеВыгрузки)
	
	ДокументыКПереносу.Очистить();
	
	Для Каждого ДанныеДокумента Из ДанныеВыгрузки.Документы Цикл
		
		НоваяСтрока = ДокументыКПереносу.Добавить();
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.УИД = ДанныеДокумента.УИД;
		НоваяСтрока.Номер = ДанныеДокумента.Номер;
		НоваяСтрока.Дата = ДанныеДокумента.Дата;
		НоваяСтрока.Состояние = НСтр("ru = 'К переносу'");
		
		ЗаполнитьПредставленияИзРеквизитов(НоваяСтрока, ДанныеДокумента);
		
		Попытка
			СсылкаДокумента = Документы.ИсполнительныйЛист.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеДокумента.УИД));
			Если СсылкаСуществуетНаФорме(СсылкаДокумента) Тогда
				НоваяСтрока.Документ = СсылкаДокумента;
				НоваяСтрока.Состояние = НСтр("ru = 'Уже есть в базе'");
			КонецЕсли;
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставленияИзРеквизитов(СтрокаТаблицы, ДанныеДокумента)
	
	Для Каждого Реквизит Из ДанныеДокумента.Реквизиты Цикл
		
		Если Реквизит.Имя = "Организация" Тогда
			СтрокаТаблицы.ОрганизацияПредставление = Реквизит.Представление;
		ИначеЕсли Реквизит.Имя = "Сотрудник" Тогда
			СтрокаТаблицы.СотрудникПредставление = Реквизит.Представление;
		ИначеЕсли Реквизит.Имя = "Получатель" Тогда
			СтрокаТаблицы.ПолучательПредставление = Реквизит.Представление;
		ИначеЕсли Реквизит.Имя = "ДатаДействия" Тогда
			СтрокаТаблицы.ДатаДействия = Реквизит.Значение;
		ИначеЕсли Реквизит.Имя = "ДатаОкончания" Тогда
			СтрокаТаблицы.ДатаОкончания = Реквизит.Значение;
		ИначеЕсли Реквизит.Имя = "СпособРасчета" Тогда
			СтрокаТаблицы.СпособРасчетаПредставление = ?(ЗначениеЗаполнено(Реквизит.Представление),
				Реквизит.Представление,
				Реквизит.ИмяЗначения);
		ИначеЕсли Реквизит.Имя = "Сумма" И ЗначениеЗаполнено(Реквизит.Значение) Тогда
			СтрокаТаблицы.РазмерПредставление = Строка(Реквизит.Значение);
		ИначеЕсли Реквизит.Имя = "Процент" И ЗначениеЗаполнено(Реквизит.Значение) И Не ЗначениеЗаполнено(СтрокаТаблицы.РазмерПредставление) Тогда
			СтрокаТаблицы.РазмерПредставление = Строка(Реквизит.Значение) + " %";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОтфильтроватьДанныеПоПометкам(ДанныеВыгрузки)
	
	УИДы = ОтмеченныеУИДы();
	Отфильтрованные = Новый Структура;
	Для Каждого КлючИЗначение Из ДанныеВыгрузки Цикл
		Отфильтрованные.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	ДокументыКЗагрузке = Новый Массив;
	Для Каждого ДанныеДокумента Из ДанныеВыгрузки.Документы Цикл
		Если УИДы.Найти(ДанныеДокумента.УИД) <> Неопределено Тогда
			ДокументыКЗагрузке.Добавить(ДанныеДокумента);
		КонецЕсли;
	КонецЦикла;
	Отфильтрованные.Вставить("Документы", ДокументыКЗагрузке);
	
	Возврат Отфильтрованные;
	
КонецФункции

&НаСервере
Процедура ПрименитьРезультатыЗагрузки(Результат)
	
	Если Не Результат.Свойство("РезультатыПоДокументам") Тогда
		Возврат;
	КонецЕсли;
	
	РезультатыПоУИД = Новый Соответствие;
	Для Каждого РезультатДокумента Из Результат.РезультатыПоДокументам Цикл
		РезультатыПоУИД.Вставить(РезультатДокумента.УИД, РезультатДокумента);
	КонецЦикла;
	
	Для Каждого СтрокаДокумента Из ДокументыКПереносу Цикл
		
		РезультатДокумента = РезультатыПоУИД.Получить(СтрокаДокумента.УИД);
		Если РезультатДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДокумента.Состояние = РезультатДокумента.Статус;
		СтрокаДокумента.ОписаниеОшибки = РезультатДокумента.ОписаниеОшибки;
		Если РезультатДокумента.Ссылка <> Неопределено Тогда
			СтрокаДокумента.Документ = РезультатДокумента.Ссылка;
		КонецЕсли;
		
		Если Не ПустаяСтрока(РезультатДокумента.ОписаниеОшибки) Тогда
			ДобавитьВЖурнал(СтрШаблон("%1: %2", СтрокаДокумента.Номер, РезультатДокумента.ОписаниеОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СсылкаСуществуетНаФорме(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	Документ.ИсполнительныйЛист КАК ИсполнительныйЛист
	|ГДЕ
	|	ИсполнительныйЛист.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Процедура ДобавитьВЖурнал(Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Метка = Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");
	Журнал = Журнал + ?(ПустаяСтрока(Журнал), "", Символы.ПС) + Метка + " " + Текст;
	
КонецПроцедуры

#КонецОбласти
