Функция ЗначениеПараметраДляИсточника(Источник, Значение)
	
	Если Источник = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		МассивCOM = Источник.NewObject("Массив");
		Для Каждого Элемент Из Значение Цикл
			МассивCOM.Добавить(Элемент);
		КонецЦикла;
		Возврат МассивCOM;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоПримитивноеЗначение(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Попытка
		УИДCOM = Источник.NewObject("УникальныйИдентификатор", XMLСтрока(Значение));
		ИмяТипа = НормализоватьИмяТипаСсылки(XMLТипЗнч(Значение).ИмяТипа);
		ИмяОбъекта = ИмяОбъектаИзТипаСсылки(ИмяТипа);
		ВидОбъекта = ВидОбъектаИзТипаСсылки(ИмяТипа);
		Если ВидОбъекта = "Справочники" Тогда
			Возврат Источник.Справочники[ИмяОбъекта].ПолучитьСсылку(УИДCOM);
		ИначеЕсли ВидОбъекта = "Документы" Тогда
			Возврат Источник.Документы[ИмяОбъекта].ПолучитьСсылку(УИДCOM);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция ТаблицаЗначенийИзCOM(ТаблицаCOM)
	
	Таблица = Новый ТаблицаЗначений;
	
	КоличествоКолонок = ТаблицаCOM.Колонки.Количество();
	Для ИндексКолонки = 0 По КоличествоКолонок - 1 Цикл
		Колонка = ТаблицаCOM.Колонки.Получить(ИндексКолонки);
		Таблица.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	
	КоличествоСтрок = ТаблицаCOM.Количество();
	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
		СтрокаCOM = ТаблицаCOM.Получить(ИндексСтроки);
		НоваяСтрока = Таблица.Добавить();
		Для Каждого Колонка Из Таблица.Колонки Цикл
			НоваяСтрока[Колонка.Имя] = СтрокаCOM[Колонка.Имя];
		КонецЦикла;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

