Функция НовыйРезультатОперации()
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Ошибок", 0);
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьИмяТипаСсылки(ИмяТипа)
	
	Замены = Новый Соответствие;
	Замены.Вставить("CatalogRef.", "СправочникСсылка.");
	Замены.Вставить("DocumentRef.", "ДокументСсылка.");
	Замены.Вставить("EnumRef.", "ПеречислениеСсылка.");
	Замены.Вставить("ChartOfCalculationTypesRef.", "ПланВидовРасчетаСсылка.");
	Замены.Вставить("ChartOfCharacteristicTypesRef.", "ПланВидовХарактеристикСсылка.");
	Замены.Вставить("ChartOfAccountsRef.", "ПланСчетовСсылка.");
	Замены.Вставить("ExchangePlanRef.", "ПланОбменаСсылка.");
	
	Для Каждого КлючИЗначение Из Замены Цикл
		Если СтрНачинаетсяС(ИмяТипа, КлючИЗначение.Ключ) Тогда
			Возврат КлючИЗначение.Значение + Сред(ИмяТипа, СтрДлина(КлючИЗначение.Ключ) + 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИмяТипа;
	
КонецФункции

Функция СсылкаСуществуетВПриемнике(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.СсылкаСуществует(Ссылка);
	Исключение
	КонецПопытки;
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1
		|ИЗ
		|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

