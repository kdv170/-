Функция СтрокаУИД(Значение, Источник)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Если Источник = Неопределено Тогда
			Возврат XMLСтрока(Значение);
		КонецЕсли;
		Возврат Источник.XMLСтрока(Значение);
	Исключение
		Попытка
			Возврат Строка(Значение.УникальныйИдентификатор());
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

