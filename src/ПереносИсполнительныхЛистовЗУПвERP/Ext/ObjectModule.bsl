Функция ЭтоПримитивноеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево");
	
КонецФункции

Функция ИмяПримитивногоТипа(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "Булево";
	КонецЕсли;
	
	Возврат "Строка";
	
КонецФункции

Функция ИмяОбъектаИзТипаСсылки(ИмяТипа)
	
	Части = СтрРазделить(ИмяТипа, ".");
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Части[1];
	
КонецФункции

Функция ВидОбъектаИзТипаСсылки(ИмяТипа)
	
	Если СтрНачинаетсяС(ИмяТипа, "СправочникСсылка.") Тогда
		Возврат "Справочники";
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "ДокументСсылка.") Тогда
		Возврат "Документы";
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "ПланВидовРасчетаСсылка.") Тогда
		Возврат "ПланыВидовРасчета";
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "ПланВидовХарактеристикСсылка.") Тогда
		Возврат "ПланыВидовХарактеристик";
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "ПеречислениеСсылка.") Тогда
		Возврат "Перечисления";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция МенеджерОбъектаПоВиду(ВидОбъекта, ИмяОбъекта)
	
	Попытка
		Если ВидОбъекта = "Справочники" Тогда
			Если Метаданные.Справочники.Найти(ИмяОбъекта) = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат Справочники[ИмяОбъекта];
		ИначеЕсли ВидОбъекта = "Документы" Тогда
			Если Метаданные.Документы.Найти(ИмяОбъекта) = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат Документы[ИмяОбъекта];
		ИначеЕсли ВидОбъекта = "ПланыВидовРасчета" Тогда
			Если Метаданные.ПланыВидовРасчета.Найти(ИмяОбъекта) = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат ПланыВидовРасчета[ИмяОбъекта];
		ИначеЕсли ВидОбъекта = "ПланыВидовХарактеристик" Тогда
			Если Метаданные.ПланыВидовХарактеристик.Найти(ИмяОбъекта) = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат ПланыВидовХарактеристик[ИмяОбъекта];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗначениеКлюча(Поиск, ИмяКлюча)
	
	Значение = Неопределено;
	Если Поиск.Свойство(ИмяКлюча, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ЗаменитьПолеЕслиНетРеквизита(Текст, Источник, ИмяДокумента, ИмяРеквизита, ЧтоИскать, НаЧтоЗаменить, ЧтоИскать2 = "", НаЧтоЗаменить2 = "")
	
	Если ЕстьРеквизитДокументаИсточника(Источник, ИмяДокумента, ИмяРеквизита) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, ЧтоИскать, НаЧтоЗаменить);
	Если ЗначениеЗаполнено(ЧтоИскать2) Тогда
		Текст = СтрЗаменить(Текст, ЧтоИскать2, НаЧтоЗаменить2);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

