#Область ПрограммныйИнтерфейс

// Возвращает сведения о внешней обработке для подсистемы БСП.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Перенос исполнительных листов ЗУП → ERP'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Переносит документы «Исполнительный лист» из ЗУП в ERP.
		|Отбираются документы, по которым в регистре сведений «Плановые удержания» на дату переноса действует удержание.'");
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Перенос исполнительных листов ЗУП → ERP'");
	Команда.Идентификатор = "ПереносИсполнительныхЛистовЗУПвERP";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Возвращает таблицу действующих исполнительных листов на дату переноса.
// Документы отбираются по срезу регистра сведений ПлановыеУдержания.
//
Функция ПолучитьДействующиеИсполнительныеЛисты(ПараметрыПереноса, Источник = Неопределено) Экспорт
	
	ДатаСреза = КонецДня(ПараметрыПереноса.ДатаПереноса);
	
	Запрос = НовыйЗапросИсточника(Источник);
	Запрос.Текст = ТекстЗапросаДействующихИсполнительныхЛистов(Источник, ПараметрыПереноса);
	Запрос.УстановитьПараметр("ДатаПереноса", ДатаСреза);
	
	Если ПараметрыПереноса.Свойство("Организация") Тогда
		Запрос.УстановитьПараметр("Организация", ЗначениеПараметраДляИсточника(Источник, ПараметрыПереноса.Организация));
		Запрос.УстановитьПараметр("ОтборПоОрганизации", ЗначениеЗаполнено(ПараметрыПереноса.Организация));
	Иначе
		Запрос.УстановитьПараметр("Организация", Неопределено);
		Запрос.УстановитьПараметр("ОтборПоОрганизации", Ложь);
	КонецЕсли;
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	Если Источник <> Неопределено Тогда
		ТаблицаДокументов = ТаблицаЗначенийИзCOM(ТаблицаДокументов);
	КонецЕсли;
	
	Возврат ТаблицаДокументов;
	
КонецФункции

// Выгружает отмеченные исполнительные листы в XML-файл.
//
Функция ВыгрузитьВФайл(ПараметрыПереноса, ИмяФайла, Источник = Неопределено) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	ДанныеВыгрузки = СформироватьДанныеВыгрузки(ПараметрыПереноса, Источник, Результат);
	Если ДанныеВыгрузки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписатьДанныеВыгрузкиВXML(ЗаписьXML, ДанныеВыгрузки);
	ЗаписьXML.Закрыть();
	
	Результат.Выполнено = Истина;
	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Выгружено документов: %1. Файл: %2'"),
		Формат(ДанныеВыгрузки.Документы.Количество(), "ЧН=0; ЧГ="),
		ИмяФайла);
	
	Возврат Результат;
	
КонецФункции

// Читает XML-файл выгрузки и возвращает структуру данных.
//
Функция ПрочитатьФайлВыгрузки(ИмяФайла) Экспорт
	
	Результат = НовыйРезультатОперации();
	Результат.Вставить("Данные", Неопределено);
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
		ДанныеВыгрузки = ПрочитатьДанныеВыгрузкиИзXML(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		ЧтениеXML.Закрыть();
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Не удалось прочитать файл выгрузки: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	Результат.Выполнено = Истина;
	Результат.Данные = ДанныеВыгрузки;
	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Прочитано документов: %1'"),
		Формат(ДанныеВыгрузки.Документы.Количество(), "ЧН=0; ЧГ="));
	
	Возврат Результат;
	
КонецФункции

// Создаёт документы ИсполнительныйЛист в текущей информационной базе (ERP) по данным выгрузки.
//
Функция ЗагрузитьВПриемник(ДанныеВыгрузки, ПараметрыПереноса) Экспорт
	
	Результат = НовыйРезультатОперации();
	Результат.Вставить("РезультатыПоДокументам", Новый Массив);
	
	Если ДанныеВыгрузки = Неопределено Или ДанныеВыгрузки.Документы.Количество() = 0 Тогда
		Результат.Сообщение = НСтр("ru = 'Нет данных для загрузки.'");
		Возврат Результат;
	КонецЕсли;
	
	Если Метаданные.Документы.Найти("ИсполнительныйЛист") = Неопределено Тогда
		Результат.Сообщение = НСтр("ru = 'В текущей конфигурации нет документа «Исполнительный лист».'");
		Возврат Результат;
	КонецЕсли;
	
	КэшСсылок = Новый Соответствие;
	
	Для Каждого ДанныеДокумента Из ДанныеВыгрузки.Документы Цикл
		
		РезультатДокумента = ЗагрузитьОдинДокумент(ДанныеДокумента, ПараметрыПереноса, КэшСсылок);
		Результат.РезультатыПоДокументам.Добавить(РезультатДокумента);
		
		Если РезультатДокумента.Статус = "Ошибка" Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
		ИначеЕсли РезультатДокумента.Статус = "Пропущен" Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
		Иначе
			Результат.Обработано = Результат.Обработано + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Выполнено = (Результат.Ошибок = 0);
	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Загрузка завершена. Создано/обновлено: %1, пропущено: %2, ошибок: %3'"),
		Формат(Результат.Обработано, "ЧН=0; ЧГ="),
		Формат(Результат.Пропущено, "ЧН=0; ЧГ="),
		Формат(Результат.Ошибок, "ЧН=0; ЧГ="));
	
	Возврат Результат;
	
КонецФункции

// Переносит документы напрямую из ЗУП в текущую базу через COM-соединение.
//
Функция ПеренестиЧерезCOM(ПараметрыПереноса) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Соединение = Неопределено;
	Попытка
		Соединение = ПодключитьсяКЗУП(ПараметрыПереноса);
	Исключение
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Не удалось подключиться к информационной базе ЗУП: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	Попытка
		ДанныеВыгрузки = СформироватьДанныеВыгрузки(ПараметрыПереноса, Соединение, Результат);
		Если ДанныеВыгрузки = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		РезультатЗагрузки = ЗагрузитьВПриемник(ДанныеВыгрузки, ПараметрыПереноса);
		ЗаполнитьЗначенияСвойств(Результат, РезультатЗагрузки);
	Исключение
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Ошибка прямого переноса через COM: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Соединение = Неопределено;
	Возврат Результат;
	
КонецФункции

// Формирует структуру данных выгрузки по отмеченным документам.
//
Функция СформироватьДанныеВыгрузки(ПараметрыПереноса, Источник = Неопределено, Результат = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Результат = НовыйРезультатОперации();
	КонецЕсли;
	
	ТаблицаДокументов = ПолучитьДействующиеИсполнительныеЛисты(ПараметрыПереноса, Источник);
	ОтмеченныеУИДы = Неопределено;
	Если ПараметрыПереноса.Свойство("ОтмеченныеУИДы") Тогда
		ОтмеченныеУИДы = ПараметрыПереноса.ОтмеченныеУИДы;
	КонецЕсли;
	
	ДанныеВыгрузки = Новый Структура;
	ДанныеВыгрузки.Вставить("ВерсияФормата", "1.0");
	ДанныеВыгрузки.Вставить("ДатаПереноса", ПараметрыПереноса.ДатаПереноса);
	ДанныеВыгрузки.Вставить("ДатаВыгрузки", ТекущаяДатаСеанса());
	ДанныеВыгрузки.Вставить("Конфигурация", ИмяКонфигурацииИсточника(Источник));
	ДанныеВыгрузки.Вставить("ВерсияКонфигурации", ВерсияКонфигурацииИсточника(Источник));
	ДанныеВыгрузки.Вставить("Документы", Новый Массив);
	
	ОстаткиПределов = ОстаткиПределовПоДокументам(ТаблицаДокументов, ПараметрыПереноса.ДатаПереноса, Источник);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		
		УИДДокумента = СтрокаУИД(СтрокаДокумента.ИсполнительныйЛист, Источник);
		Если ОтмеченныеУИДы <> Неопределено И ОтмеченныеУИДы.Найти(УИДДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДанныеДокумента = ДанныеДокументаДляВыгрузки(
				СтрокаДокумента.ИсполнительныйЛист,
				ПараметрыПереноса.ДатаПереноса,
				ОстаткиПределов[УИДДокумента],
				Источник);
			ДанныеВыгрузки.Документы.Добавить(ДанныеДокумента);
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Сообщение = Результат.Сообщение
				+ ?(ПустаяСтрока(Результат.Сообщение), "", Символы.ПС)
				+ СтрШаблон(НСтр("ru = 'Не удалось выгрузить %1: %2'"),
					СтрокаДокумента.ИсполнительныйЛист,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Если ДанныеВыгрузки.Документы.Количество() = 0 Тогда
		Если ПустаяСтрока(Результат.Сообщение) Тогда
			Результат.Сообщение = НСтр("ru = 'Нет документов для выгрузки. Проверьте дату переноса, организацию и пометки в таблице.'");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеВыгрузки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтборПоПлановымУдержаниям

Функция ТекстЗапросаДействующихИсполнительныхЛистов(Источник, ПараметрыПереноса)
	
	ИмяРесурсаИспользования = ИмяРесурсаИспользованияПлановыхУдержаний(Источник);
	ЕстьДокументИзменения = ЕстьОбъектМетаданныхИсточника(Источник, "Документы", "ИзменениеУсловийИсполнительногоЛиста");
	ИмяРеквизитаИсполнительногоДокумента = "";
	
	Если ЕстьДокументИзменения Тогда
		ИмяРеквизитаИсполнительногоДокумента = ИмяРеквизитаОснованияИзмененияИЛ(Источник);
	КонецЕсли;
	
	Если ЕстьДокументИзменения И ЗначениеЗаполнено(ИмяРеквизитаИсполнительногоДокумента) Тогда
		ВыражениеДокумента =
			"ВЫБОР
			|		КОГДА ПлановыеУдержания.ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист
			|			ТОГДА ВЫРАЗИТЬ(ПлановыеУдержания.ДокументОснование КАК Документ.ИсполнительныйЛист)
			|		КОГДА ПлановыеУдержания.ДокументОснование ССЫЛКА Документ.ИзменениеУсловийИсполнительногоЛиста
			|			ТОГДА ВЫРАЗИТЬ(ПлановыеУдержания.ДокументОснование КАК Документ.ИзменениеУсловийИсполнительногоЛиста)."
			+ ИмяРеквизитаИсполнительногоДокумента + "
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ";
		УсловиеТипаОснования =
			"(ПлановыеУдержания.ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист
			|			ИЛИ ПлановыеУдержания.ДокументОснование ССЫЛКА Документ.ИзменениеУсловийИсполнительногоЛиста)";
	Иначе
		ВыражениеДокумента = "ВЫРАЗИТЬ(ПлановыеУдержания.ДокументОснование КАК Документ.ИсполнительныйЛист)";
		УсловиеТипаОснования = "ПлановыеУдержания.ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист";
	КонецЕсли;
	
	Если ИмяРесурсаИспользования = "Используется" Тогда
		УсловиеДействует = "ПлановыеУдержания.Используется";
	ИначеЕсли ИмяРесурсаИспользования = "Действие" Тогда
		УсловиеДействует =
			"(ПлановыеУдержания.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияСНачислениямиИУдержаниями.Утвердить)
			|			ИЛИ ПлановыеУдержания.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияСНачислениямиИУдержаниями.Изменить))";
	Иначе
		УсловиеДействует = "ИСТИНА";
	КонецЕсли;
	
	ЕстьРазмер = ЕстьРесурсРегистраИсточника(Источник, "ПлановыеУдержания", "Размер");
	ПолеРазмера = ?(ЕстьРазмер, "ПлановыеУдержания.Размер", "0");
	
	Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	" + ВыражениеДокумента + " КАК ИсполнительныйЛист,
	|	ПлановыеУдержания.Организация КАК Организация,
	|	ПлановыеУдержания.Сотрудник КАК Сотрудник,
	|	ПлановыеУдержания.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПлановыеУдержания.Удержание КАК Удержание,
	|	" + ПолеРазмера + " КАК Размер
	|ПОМЕСТИТЬ ВТДействующие
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(&ДатаПереноса, ) КАК ПлановыеУдержания
	|ГДЕ
	|	" + УсловиеДействует + "
	|	И " + УсловиеТипаОснования + "
	|	И (НЕ &ОтборПоОрганизации
	|			ИЛИ ПлановыеУдержания.Организация = &Организация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДействующие.ИсполнительныйЛист КАК ИсполнительныйЛист,
	|	ВТДействующие.ИсполнительныйЛист.Номер КАК Номер,
	|	ВТДействующие.ИсполнительныйЛист.Дата КАК Дата,
	|	ВТДействующие.Организация КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(ВТДействующие.Организация) КАК ОрганизацияПредставление,
	|	ВТДействующие.Сотрудник КАК Сотрудник,
	|	ПРЕДСТАВЛЕНИЕ(ВТДействующие.Сотрудник) КАК СотрудникПредставление,
	|	ВТДействующие.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПРЕДСТАВЛЕНИЕ(ВТДействующие.ФизическоеЛицо) КАК ФизическоеЛицоПредставление,
	|	ВТДействующие.ИсполнительныйЛист.Получатель КАК Получатель,
	|	ПРЕДСТАВЛЕНИЕ(ВТДействующие.ИсполнительныйЛист.Получатель) КАК ПолучательПредставление,
	|	ВТДействующие.Размер КАК Размер,
	|	ПРЕДСТАВЛЕНИЕ(ВТДействующие.ИсполнительныйЛист.СпособРасчета) КАК СпособРасчетаПредставление,
	|	ВТДействующие.ИсполнительныйЛист.ДатаДействия КАК ДатаДействия,
	|	ВТДействующие.ИсполнительныйЛист.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	ВТДействующие КАК ВТДействующие
	|ГДЕ
	|	ВТДействующие.ИсполнительныйЛист <> ЗНАЧЕНИЕ(Документ.ИсполнительныйЛист.ПустаяСсылка)
	|	И ВТДействующие.ИсполнительныйЛист ЕСТЬ НЕ NULL
	|	И НЕ ВТДействующие.ИсполнительныйЛист.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	
	Текст = ЗаменитьПолеЕслиНетРеквизита(Текст, Источник, "ИсполнительныйЛист", "Получатель",
		"ПРЕДСТАВЛЕНИЕ(ВТДействующие.ИсполнительныйЛист.Получатель)", """""",
		"ВТДействующие.ИсполнительныйЛист.Получатель", "НЕОПРЕДЕЛЕНО");
	Текст = ЗаменитьПолеЕслиНетРеквизита(Текст, Источник, "ИсполнительныйЛист", "СпособРасчета",
		"ПРЕДСТАВЛЕНИЕ(ВТДействующие.ИсполнительныйЛист.СпособРасчета)", """""");
	Текст = ЗаменитьПолеЕслиНетРеквизита(Текст, Источник, "ИсполнительныйЛист", "ДатаДействия",
		"ВТДействующие.ИсполнительныйЛист.ДатаДействия", "ДАТАВРЕМЯ(1, 1, 1)");
	Текст = ЗаменитьПолеЕслиНетРеквизита(Текст, Источник, "ИсполнительныйЛист", "ДатаОкончания",
		"ВТДействующие.ИсполнительныйЛист.ДатаОкончания", "ДАТАВРЕМЯ(1, 1, 1)");
	
	Возврат Текст;
	
КонецФункции

Функция ИмяРесурсаИспользованияПлановыхУдержаний(Источник)
	
	Если ЕстьРесурсРегистраИсточника(Источник, "ПлановыеУдержания", "Используется") Тогда
		Возврат "Используется";
	ИначеЕсли ЕстьРесурсРегистраИсточника(Источник, "ПлановыеУдержания", "Действие") Тогда
		Возврат "Действие";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ИмяРеквизитаОснованияИзмененияИЛ(Источник)
	
	Если ЕстьРеквизитДокументаИсточника(Источник, "ИзменениеУсловийИсполнительногоЛиста", "ИсполнительныйДокумент") Тогда
		Возврат "ИсполнительныйДокумент";
	ИначеЕсли ЕстьРеквизитДокументаИсточника(Источник, "ИзменениеУсловийИсполнительногоЛиста", "ДокументОснование") Тогда
		Возврат "ДокументОснование";
	ИначеЕсли ЕстьРеквизитДокументаИсточника(Источник, "ИзменениеУсловийИсполнительногоЛиста", "ИсполнительныйЛист") Тогда
		Возврат "ИсполнительныйЛист";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОстаткиПределовПоДокументам(ТаблицаДокументов, ДатаПереноса, Источник)
	
	Остатки = Новый Соответствие;
	Если Не ЕстьОбъектМетаданныхИсточника(Источник, "РегистрыНакопления", "УдержанияДоПределаПоСотрудникам") Тогда
		Возврат Остатки;
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		МассивДокументов.Добавить(СтрокаДокумента.ИсполнительныйЛист);
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат Остатки;
	КонецЕсли;
	
	Запрос = НовыйЗапросИсточника(Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ДокументОснование КАК ДокументОснование,
	|	Остатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УдержанияДоПределаПоСотрудникам.Остатки(&ДатаПереноса, ДокументОснование В (&Документы)) КАК Остатки";
	Запрос.УстановитьПараметр("ДатаПереноса", КонецДня(ДатаПереноса));
	Запрос.УстановитьПараметр("Документы", ЗначениеПараметраДляИсточника(Источник, МассивДокументов));
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Остатки.Вставить(СтрокаУИД(Выборка.ДокументОснование, Источник), Выборка.СуммаОстаток);
		КонецЦикла;
	Исключение
		// Регистр может отсутствовать или иметь другую структуру в конкретной версии.
	КонецПопытки;
	
	Возврат Остатки;
	
КонецФункции

#КонецОбласти

#Область СериализацияДокумента

Функция ДанныеДокументаДляВыгрузки(СсылкаДокумента, ДатаПереноса, ОстатокПредела, Источник)
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("УИД", СтрокаУИД(СсылкаДокумента, Источник));
	ДанныеДокумента.Вставить("Номер", ЗначениеРеквизитаИсточника(СсылкаДокумента, "Номер", Источник));
	ДанныеДокумента.Вставить("Дата", ЗначениеРеквизитаИсточника(СсылкаДокумента, "Дата", Источник));
	ДанныеДокумента.Вставить("Проведен", ЗначениеРеквизитаИсточника(СсылкаДокумента, "Проведен", Источник));
	ДанныеДокумента.Вставить("ОстатокПредела", ОстатокПредела);
	ДанныеДокумента.Вставить("Реквизиты", Новый Массив);
	
	ИменаРеквизитов = ИменаРеквизитовДокументаИсточника(Источник, "ИсполнительныйЛист");
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Значение = ЗначениеРеквизитаИсточника(СсылкаДокумента, ИмяРеквизита, Источник);
		ДанныеДокумента.Реквизиты.Добавить(ОписаниеЗначенияДляВыгрузки(ИмяРеквизита, Значение, Источник));
	КонецЦикла;
	
	ДополнитьАктуальнымиУсловиями(ДанныеДокумента, СсылкаДокумента, ДатаПереноса, Источник);
	
	Возврат ДанныеДокумента;
	
КонецФункции

Процедура ДополнитьАктуальнымиУсловиями(ДанныеДокумента, СсылкаДокумента, ДатаПереноса, Источник)
	
	Если Не ЕстьОбъектМетаданныхИсточника(Источник, "РегистрыСведений", "УсловияУдержанияПоИсполнительномуДокументу") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяИзмерения = ИмяИзмеренияИсполнительногоДокумента(Источник);
	Если Не ЗначениеЗаполнено(ИмяИзмерения) Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРесурсов = ИменаРесурсовРегистраИсточника(Источник, "УсловияУдержанияПоИсполнительномуДокументу");
	Если ИменаРесурсов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Поля = Новый Массив;
	Для Каждого ИмяРесурса Из ИменаРесурсов Цикл
		Поля.Добавить("Условия." + ИмяРесурса + " КАК " + ИмяРесурса);
	КонецЦикла;
	
	Запрос = НовыйЗапросИсточника(Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб) + "
	|ИЗ
	|	РегистрСведений.УсловияУдержанияПоИсполнительномуДокументу.СрезПоследних(&ДатаПереноса, "
		+ ИмяИзмерения + " = &Документ) КАК Условия";
	Запрос.УстановитьПараметр("ДатаПереноса", КонецДня(ДатаПереноса));
	Запрос.УстановитьПараметр("Документ", СсылкаДокумента);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПоИменам = Новый Соответствие;
	Для Каждого ОписаниеРеквизита Из ДанныеДокумента.Реквизиты Цикл
		РеквизитыПоИменам.Вставить(ОписаниеРеквизита.Имя, ОписаниеРеквизита);
	КонецЦикла;
	
	Для Каждого ИмяРесурса Из ИменаРесурсов Цикл
		Значение = Выборка[ИмяРесурса];
		ОписаниеРеквизита = ОписаниеЗначенияДляВыгрузки(ИмяРесурса, Значение, Источник);
		Если РеквизитыПоИменам[ИмяРесурса] = Неопределено Тогда
			ДанныеДокумента.Реквизиты.Добавить(ОписаниеРеквизита);
		Иначе
			Индекс = ДанныеДокумента.Реквизиты.Найти(РеквизитыПоИменам[ИмяРесурса]);
			ДанныеДокумента.Реквизиты[Индекс] = ОписаниеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяИзмеренияИсполнительногоДокумента(Источник)
	
	Имена = ИменаИзмеренийРегистраИсточника(Источник, "УсловияУдержанияПоИсполнительномуДокументу");
	Для Каждого ИмяИзмерения Из Имена Цикл
		Если ИмяИзмерения = "ИсполнительныйДокумент"
			Или ИмяИзмерения = "ИсполнительныйЛист"
			Или ИмяИзмерения = "ДокументОснование" Тогда
			Возврат ИмяИзмерения;
		КонецЕсли;
	КонецЦикла;
	
	Если Имена.Количество() = 1 Тогда
		Возврат Имена[0];
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОписаниеЗначенияДляВыгрузки(ИмяРеквизита, Значение, Источник)
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", ИмяРеквизита);
	Описание.Вставить("Тип", "");
	Описание.Вставить("УИД", "");
	Описание.Вставить("Значение", Неопределено);
	Описание.Вставить("ИмяЗначения", "");
	Описание.Вставить("Представление", "");
	Описание.Вставить("Поиск", Новый Структура);
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Описание.Тип = "Неопределено";
		Возврат Описание;
	КонецЕсли;
	
	Если ЭтоПримитивноеЗначение(Значение) Тогда
		Описание.Тип = ИмяПримитивногоТипа(Значение);
		Описание.Значение = Значение;
		Возврат Описание;
	КонецЕсли;
	
	Описание.Представление = Строка(Значение);
	Описание.УИД = СтрокаУИД(Значение, Источник);
	
	ИмяТипа = НормализоватьИмяТипаСсылки(ИмяТипаСсылки(Значение, Источник));
	Описание.Тип = ИмяТипа;
	
	Если СтрНачинаетсяС(ИмяТипа, "ПеречислениеСсылка.") Тогда
		Описание.ИмяЗначения = ИмяЗначенияПеречисления(Значение, Источник);
		Возврат Описание;
	КонецЕсли;
	
	Описание.Поиск = КлючиПоискаСсылки(Значение, ИмяТипа, Источник);
	Возврат Описание;
	
КонецФункции

Функция КлючиПоискаСсылки(Значение, ИмяТипа, Источник)
	
	Поиск = Новый Структура;
	
	ДобавитьКлючПоиска(Поиск, "Код", ЗначениеРеквизитаИсточника(Значение, "Код", Источник));
	ДобавитьКлючПоиска(Поиск, "Наименование", ЗначениеРеквизитаИсточника(Значение, "Наименование", Источник));
	ДобавитьКлючПоиска(Поиск, "ИНН", ЗначениеРеквизитаИсточника(Значение, "ИНН", Источник));
	ДобавитьКлючПоиска(Поиск, "КПП", ЗначениеРеквизитаИсточника(Значение, "КПП", Источник));
	ДобавитьКлючПоиска(Поиск, "СтраховойНомерПФР", ЗначениеРеквизитаИсточника(Значение, "СтраховойНомерПФР", Источник));
	ДобавитьКлючПоиска(Поиск, "ДатаРождения", ЗначениеРеквизитаИсточника(Значение, "ДатаРождения", Источник));
	ДобавитьКлючПоиска(Поиск, "Фамилия", ЗначениеРеквизитаИсточника(Значение, "Фамилия", Источник));
	ДобавитьКлючПоиска(Поиск, "Имя", ЗначениеРеквизитаИсточника(Значение, "Имя", Источник));
	ДобавитьКлючПоиска(Поиск, "Отчество", ЗначениеРеквизитаИсточника(Значение, "Отчество", Источник));
	ДобавитьКлючПоиска(Поиск, "НаименованиеПолное", ЗначениеРеквизитаИсточника(Значение, "НаименованиеПолное", Источник));
	ДобавитьКлючПоиска(Поиск, "НомерСчета", ЗначениеРеквизитаИсточника(Значение, "НомерСчета", Источник));
	
	Если СтрЗаканчиваетсяНа(ИмяТипа, ".Сотрудники") Тогда
		ФизЛицо = ЗначениеРеквизитаИсточника(Значение, "ФизическоеЛицо", Источник);
		ГоловнаяОрганизация = ЗначениеРеквизитаИсточника(Значение, "ГоловнаяОрганизация", Источник);
		Поиск.Вставить("ФизическоеЛицо", ОписаниеЗначенияДляВыгрузки("ФизическоеЛицо", ФизЛицо, Источник));
		Поиск.Вставить("ГоловнаяОрганизация", ОписаниеЗначенияДляВыгрузки("ГоловнаяОрганизация", ГоловнаяОрганизация, Источник));
	КонецЕсли;
	
	Если СтрНайти(ИмяТипа, "БанковскиеСчета") > 0 Тогда
		Владелец = ЗначениеРеквизитаИсточника(Значение, "Владелец", Источник);
		Банк = ЗначениеРеквизитаИсточника(Значение, "Банк", Источник);
		Поиск.Вставить("Владелец", ОписаниеЗначенияДляВыгрузки("Владелец", Владелец, Источник));
		Поиск.Вставить("Банк", ОписаниеЗначенияДляВыгрузки("Банк", Банк, Источник));
	КонецЕсли;
	
	Если СтрЗаканчиваетсяНа(ИмяТипа, ".Банки") Или СтрЗаканчиваетсяНа(ИмяТипа, ".КлассификаторБанков") Тогда
		ДобавитьКлючПоиска(Поиск, "Код", ЗначениеРеквизитаИсточника(Значение, "Код", Источник));
		ДобавитьКлючПоиска(Поиск, "КоррСчет", ЗначениеРеквизитаИсточника(Значение, "КоррСчет", Источник));
	КонецЕсли;
	
	Возврат Поиск;
	
КонецФункции

Процедура ДобавитьКлючПоиска(Поиск, ИмяКлюча, Значение)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Поиск.Вставить(ИмяКлюча, Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область XML

Процедура ЗаписатьДанныеВыгрузкиВXML(ЗаписьXML, ДанныеВыгрузки)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ПереносИсполнительныхЛистов");
	ЗаписьXML.ЗаписатьАтрибут("ВерсияФормата", ДанныеВыгрузки.ВерсияФормата);
	ЗаписьXML.ЗаписатьАтрибут("ДатаПереноса", XMLСтрока(ДанныеВыгрузки.ДатаПереноса));
	ЗаписьXML.ЗаписатьАтрибут("ДатаВыгрузки", XMLСтрока(ДанныеВыгрузки.ДатаВыгрузки));
	ЗаписьXML.ЗаписатьАтрибут("Конфигурация", Строка(ДанныеВыгрузки.Конфигурация));
	ЗаписьXML.ЗаписатьАтрибут("ВерсияКонфигурации", Строка(ДанныеВыгрузки.ВерсияКонфигурации));
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документы");
	Для Каждого ДанныеДокумента Из ДанныеВыгрузки.Документы Цикл
		ЗаписатьДокументВXML(ЗаписьXML, ДанныеДокумента);
	КонецЦикла;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьДокументВXML(ЗаписьXML, ДанныеДокумента)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");
	ЗаписатьЭлементXML(ЗаписьXML, "УИД", ДанныеДокумента.УИД);
	ЗаписатьЭлементXML(ЗаписьXML, "Номер", ДанныеДокумента.Номер);
	ЗаписатьЭлементXML(ЗаписьXML, "Дата", XMLСтрока(ДанныеДокумента.Дата));
	ЗаписатьЭлементXML(ЗаписьXML, "Проведен", XMLСтрока(ДанныеДокумента.Проведен));
	Если ДанныеДокумента.ОстатокПредела <> Неопределено Тогда
		ЗаписатьЭлементXML(ЗаписьXML, "ОстатокПредела", XMLСтрока(ДанныеДокумента.ОстатокПредела));
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Реквизиты");
	Для Каждого ОписаниеРеквизита Из ДанныеДокумента.Реквизиты Цикл
		ЗаписатьРеквизитВXML(ЗаписьXML, ОписаниеРеквизита);
	КонецЦикла;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьРеквизитВXML(ЗаписьXML, ОписаниеРеквизита, ИмяЭлемента = "Реквизит")
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	ЗаписьXML.ЗаписатьАтрибут("Имя", ОписаниеРеквизита.Имя);
	ЗаписьXML.ЗаписатьАтрибут("Тип", Строка(ОписаниеРеквизита.Тип));
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.УИД) Тогда
		ЗаписьXML.ЗаписатьАтрибут("УИД", ОписаниеРеквизита.УИД);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеРеквизита.ИмяЗначения) Тогда
		ЗаписьXML.ЗаписатьАтрибут("ИмяЗначения", ОписаниеРеквизита.ИмяЗначения);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеРеквизита.Представление) Тогда
		ЗаписьXML.ЗаписатьАтрибут("Представление", ОписаниеРеквизита.Представление);
	КонецЕсли;
	
	Если ОписаниеРеквизита.Значение <> Неопределено И ЭтоПримитивноеЗначение(ОписаниеРеквизита.Значение) Тогда
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(ОписаниеРеквизита.Значение));
	КонецЕсли;
	
	Если ОписаниеРеквизита.Поиск <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ОписаниеРеквизита.Поиск Цикл
			Если ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
				ЗаписатьРеквизитВXML(ЗаписьXML, КлючИЗначение.Значение, "Ключ");
			ИначеЕсли ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("Ключ");
				ЗаписьXML.ЗаписатьАтрибут("Имя", КлючИЗначение.Ключ);
				ЗаписьXML.ЗаписатьАтрибут("Тип", ИмяПримитивногоТипа(КлючИЗначение.Значение));
				ЗаписьXML.ЗаписатьТекст(XMLСтрока(КлючИЗначение.Значение));
				ЗаписьXML.ЗаписатьКонецЭлемента();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьЭлементXML(ЗаписьXML, ИмяЭлемента, Значение)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	ЗаписьXML.ЗаписатьТекст(Строка(Значение));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ПрочитатьДанныеВыгрузкиИзXML(ЧтениеXML)
	
	ДанныеВыгрузки = Новый Структура;
	ДанныеВыгрузки.Вставить("ВерсияФормата", "1.0");
	ДанныеВыгрузки.Вставить("ДатаПереноса", Дата(1, 1, 1));
	ДанныеВыгрузки.Вставить("ДатаВыгрузки", Дата(1, 1, 1));
	ДанныеВыгрузки.Вставить("Конфигурация", "");
	ДанныеВыгрузки.Вставить("ВерсияКонфигурации", "");
	ДанныеВыгрузки.Вставить("Документы", Новый Массив);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеXML.Имя = "ПереносИсполнительныхЛистов" Тогда
			ДанныеВыгрузки.ВерсияФормата = ЧтениеXML.ПолучитьАтрибут("ВерсияФормата");
			ДанныеВыгрузки.ДатаПереноса = XMLЗначение(Тип("Дата"), ЧтениеXML.ПолучитьАтрибут("ДатаПереноса"));
			ДанныеВыгрузки.ДатаВыгрузки = XMLЗначение(Тип("Дата"), ЧтениеXML.ПолучитьАтрибут("ДатаВыгрузки"));
			ДанныеВыгрузки.Конфигурация = ЧтениеXML.ПолучитьАтрибут("Конфигурация");
			ДанныеВыгрузки.ВерсияКонфигурации = ЧтениеXML.ПолучитьАтрибут("ВерсияКонфигурации");
		ИначеЕсли ЧтениеXML.Имя = "Документ" Тогда
			ДанныеВыгрузки.Документы.Добавить(ПрочитатьДокументИзXML(ЧтениеXML));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеВыгрузки;
	
КонецФункции

Функция ПрочитатьДокументИзXML(ЧтениеXML)
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("УИД", "");
	ДанныеДокумента.Вставить("Номер", "");
	ДанныеДокумента.Вставить("Дата", Дата(1, 1, 1));
	ДанныеДокумента.Вставить("Проведен", Ложь);
	ДанныеДокумента.Вставить("ОстатокПредела", Неопределено);
	ДанныеДокумента.Вставить("Реквизиты", Новый Массив);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Документ" Тогда
			Прервать;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеXML.Имя = "УИД" Тогда
			ДанныеДокумента.УИД = ПрочитатьТекстXML(ЧтениеXML);
		ИначеЕсли ЧтениеXML.Имя = "Номер" Тогда
			ДанныеДокумента.Номер = ПрочитатьТекстXML(ЧтениеXML);
		ИначеЕсли ЧтениеXML.Имя = "Дата" Тогда
			ДанныеДокумента.Дата = XMLЗначение(Тип("Дата"), ПрочитатьТекстXML(ЧтениеXML));
		ИначеЕсли ЧтениеXML.Имя = "Проведен" Тогда
			ДанныеДокумента.Проведен = XMLЗначение(Тип("Булево"), ПрочитатьТекстXML(ЧтениеXML));
		ИначеЕсли ЧтениеXML.Имя = "ОстатокПредела" Тогда
			ДанныеДокумента.ОстатокПредела = XMLЗначение(Тип("Число"), ПрочитатьТекстXML(ЧтениеXML));
		ИначеЕсли ЧтениеXML.Имя = "Реквизит" Тогда
			ДанныеДокумента.Реквизиты.Добавить(ПрочитатьРеквизитИзXML(ЧтениеXML));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеДокумента;
	
КонецФункции

Функция ПрочитатьРеквизитИзXML(ЧтениеXML)
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", ЧтениеXML.ПолучитьАтрибут("Имя"));
	Описание.Вставить("Тип", ЧтениеXML.ПолучитьАтрибут("Тип"));
	Описание.Вставить("УИД", ЧтениеXML.ПолучитьАтрибут("УИД"));
	Описание.Вставить("ИмяЗначения", ЧтениеXML.ПолучитьАтрибут("ИмяЗначения"));
	Описание.Вставить("Представление", ЧтениеXML.ПолучитьАтрибут("Представление"));
	Описание.Вставить("Значение", Неопределено);
	Описание.Вставить("Поиск", Новый Структура);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И (ЧтениеXML.Имя = "Реквизит" Или ЧтениеXML.Имя = "Ключ") Тогда
			Прервать;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Описание.Значение = ПривестиТекстКТипу(ЧтениеXML.Значение, Описание.Тип);
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Ключ" Тогда
			Ключ = ПрочитатьРеквизитИзXML(ЧтениеXML);
			Если СтрНачинаетсяС(Строка(Ключ.Тип), "Справочник") Или СтрНачинаетсяС(Строка(Ключ.Тип), "Документ") Тогда
				Описание.Поиск.Вставить(Ключ.Имя, Ключ);
			Иначе
				Описание.Поиск.Вставить(Ключ.Имя, Ключ.Значение);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Описание;
	
КонецФункции

Функция ПрочитатьТекстXML(ЧтениеXML)
	
	Если Не ЧтениеXML.Прочитать() Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
		Значение = ЧтениеXML.Значение;
		ЧтениеXML.Прочитать();
		Возврат Значение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПривестиТекстКТипу(Текст, ИмяТипа)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИмяТипа = "Число" Тогда
		Возврат XMLЗначение(Тип("Число"), Текст);
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Возврат XMLЗначение(Тип("Дата"), Текст);
	ИначеЕсли ИмяТипа = "Булево" Тогда
		Возврат XMLЗначение(Тип("Булево"), Текст);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаВПриемник

Функция ЗагрузитьОдинДокумент(ДанныеДокумента, ПараметрыПереноса, КэшСсылок)
	
	РезультатДокумента = Новый Структура;
	РезультатДокумента.Вставить("УИД", ДанныеДокумента.УИД);
	РезультатДокумента.Вставить("Номер", ДанныеДокумента.Номер);
	РезультатДокумента.Вставить("Статус", "Ошибка");
	РезультатДокумента.Вставить("ОписаниеОшибки", "");
	РезультатДокумента.Вставить("Ссылка", Неопределено);
	
	Попытка
		УникальныйИдентификаторДокумента = Новый УникальныйИдентификатор(ДанныеДокумента.УИД);
	Исключение
		РезультатДокумента.ОписаниеОшибки = НСтр("ru = 'Некорректный уникальный идентификатор документа.'");
		Возврат РезультатДокумента;
	КонецПопытки;
	
	СсылкаДокумента = Документы.ИсполнительныйЛист.ПолучитьСсылку(УникальныйИдентификаторДокумента);
	ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
	ЭтоНовый = (ОбъектДокумента = Неопределено);
	
	Если ЭтоНовый Тогда
		ОбъектДокумента = Документы.ИсполнительныйЛист.СоздатьДокумент();
		ОбъектДокумента.УстановитьСсылкуНового(СсылкаДокумента);
	ИначеЕсли Не ПараметрыПереноса.ПерезаписыватьСуществующие Тогда
		РезультатДокумента.Статус = "Пропущен";
		РезультатДокумента.Ссылка = СсылкаДокумента;
		РезультатДокумента.ОписаниеОшибки = НСтр("ru = 'Документ уже существует в базе-приёмнике.'");
		Возврат РезультатДокумента;
	ИначеЕсли ОбъектДокумента.Проведен Тогда
		ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ОбъектДокумента.Номер = ДанныеДокумента.Номер;
	ОбъектДокумента.Дата = ДанныеДокумента.Дата;
	ОбъектДокумента.ПометкаУдаления = Ложь;
	
	МетаданныеДокумента = ОбъектДокумента.Метаданные();
	
	Для Каждого ОписаниеРеквизита Из ДанныеДокумента.Реквизиты Цикл
		
		Если МетаданныеДокумента.Реквизиты.Найти(ОписаниеРеквизита.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбъектДокумента[ОписаниеРеквизита.Имя] = ВосстановитьЗначение(ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок);
		Исключение
			РезультатДокумента.ОписаниеОшибки = РезультатДокумента.ОписаниеОшибки
				+ ?(ПустаяСтрока(РезультатДокумента.ОписаниеОшибки), "", Символы.ПС)
				+ СтрШаблон(НСтр("ru = 'Реквизит %1: %2'"),
					ОписаниеРеквизита.Имя,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Если ПараметрыПереноса.ПереноситьОстатокПредела
		И ДанныеДокумента.ОстатокПредела <> Неопределено
		И МетаданныеДокумента.Реквизиты.Найти("Предел") <> Неопределено Тогда
		
		ОбъектДокумента.Предел = ДанныеДокумента.ОстатокПредела;
		Если МетаданныеДокумента.Реквизиты.Найти("ПрекратитьПоДостижениюПредела") <> Неопределено
			И ДанныеДокумента.ОстатокПредела > 0 Тогда
			ОбъектДокумента.ПрекратитьПоДостижениюПредела = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если МетаданныеДокумента.Реквизиты.Найти("Ответственный") <> Неопределено
		И Не ЗначениеЗаполнено(ОбъектДокумента.Ответственный) Тогда
		ОбъектДокумента.Ответственный = ТекущийПользовательПриемника();
	КонецЕсли;
	
	Если Не ПустаяСтрока(РезультатДокумента.ОписаниеОшибки)
		И СтрНайти(РезультатДокумента.ОписаниеОшибки, НСтр("ru = 'не найден'")) > 0 Тогда
		РезультатДокумента.Статус = "Ошибка";
		Возврат РезультатДокумента;
	КонецЕсли;
	
	Попытка
		Если ПараметрыПереноса.ПроводитьДокументы Тогда
			ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектДокумента.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		РезультатДокумента.Статус = ?(ЭтоНовый, "Создан", "Обновлён");
		РезультатДокумента.Ссылка = ОбъектДокумента.Ссылка;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			Если Не ЗначениеЗаполнено(ОбъектДокумента.Номер) Или СтрНайти(НРег(ТекстОшибки), "номер") > 0 Тогда
				ОбъектДокумента.Номер = "";
			КонецЕсли;
			ОбъектДокумента.Записать(РежимЗаписиДокумента.Запись);
			РезультатДокумента.Статус = "ЗаписанБезПроведения";
			РезультатДокумента.Ссылка = ОбъектДокумента.Ссылка;
			РезультатДокумента.ОписаниеОшибки = СтрШаблон(
				НСтр("ru = 'Документ записан без проведения: %1'"), ТекстОшибки);
		Исключение
			РезультатДокумента.ОписаниеОшибки = ТекстОшибки;
		КонецПопытки;
	КонецПопытки;
	
	Возврат РезультатДокумента;
	
КонецФункции

Функция ВосстановитьЗначение(ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок)
	
	Если Не ЗначениеЗаполнено(ОписаниеРеквизита.Тип) Или ОписаниеРеквизита.Тип = "Неопределено" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОписаниеРеквизита.Тип = "Строка" Или ОписаниеРеквизита.Тип = "Число"
		Или ОписаниеРеквизита.Тип = "Дата" Или ОписаниеРеквизита.Тип = "Булево" Тогда
		Возврат ОписаниеРеквизита.Значение;
	КонецЕсли;
	
	Если СтрНачинаетсяС(ОписаниеРеквизита.Тип, "ПеречислениеСсылка.") Тогда
		Возврат НайтиЗначениеПеречисления(ОписаниеРеквизита);
	КонецЕсли;
	
	Возврат НайтиСсылкуПриемника(ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок);
	
КонецФункции

Функция НайтиЗначениеПеречисления(ОписаниеРеквизита)
	
	ИмяПеречисления = СтрЗаменить(ОписаниеРеквизита.Тип, "ПеречислениеСсылка.", "");
	Если Метаданные.Перечисления.Найти(ИмяПеречисления) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = Перечисления[ИмяПеречисления];
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.УИД) Тогда
		Попытка
			ЗначениеПоУИД = XMLЗначение(Тип("ПеречислениеСсылка." + ИмяПеречисления), ОписаниеРеквизита.УИД);
			Если ЗначениеЗаполнено(ЗначениеПоУИД) Тогда
				Возврат ЗначениеПоУИД;
			КонецЕсли;
		Исключение
			// UUID значения перечисления может отличаться между релизами конфигураций.
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.ИмяЗначения) Тогда
		Попытка
			Возврат Менеджер[ОписаниеРеквизита.ИмяЗначения];
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.Представление) Тогда
		Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
			Если ЗначениеПеречисления.Синоним = ОписаниеРеквизита.Представление
				Или ЗначениеПеречисления.Имя = ОписаниеРеквизита.Представление Тогда
				Возврат Менеджер[ЗначениеПеречисления.Имя];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиСсылкуПриемника(ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок)
	
	КлючКэша = ОписаниеРеквизита.Тип + "#" + ОписаниеРеквизита.УИД;
	Кэшированное = КэшСсылок.Получить(КлючКэша);
	Если Кэшированное <> Неопределено Тогда
		Возврат Кэшированное;
	КонецЕсли;
	
	ИмяОбъекта = ИмяОбъектаИзТипаСсылки(ОписаниеРеквизита.Тип);
	ВидОбъекта = ВидОбъектаИзТипаСсылки(ОписаниеРеквизита.Тип);
	
	Если Не ЗначениеЗаполнено(ИмяОбъекта) Или Не ЗначениеЗаполнено(ВидОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = МенеджерОбъектаПоВиду(ВидОбъекта, ИмяОбъекта);
	Если Менеджер = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В приёмнике нет объекта %1'"), ОписаниеРеквизита.Тип);
	КонецЕсли;
	
	Ссылка = Неопределено;
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.УИД) Тогда
		Попытка
			СсылкаПоУИД = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ОписаниеРеквизита.УИД));
			Если СсылкаСуществуетВПриемнике(СсылкаПоУИД) Тогда
				Ссылка = СсылкаПоУИД;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Ссылка = Неопределено Тогда
		Ссылка = НайтиСсылкуПоКлючам(Менеджер, ВидОбъекта, ИмяОбъекта, ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок);
	КонецЕсли;
	
	Если Ссылка = Неопределено
		И ПараметрыПереноса.СоздаватьКонтрагентов
		И ВидОбъекта = "Справочники"
		И (ИмяОбъекта = "Контрагенты" Или ИмяОбъекта = "ТарифыПлатежныхАгентов") Тогда
		Ссылка = СоздатьЭлементСправочника(Менеджер, ИмяОбъекта, ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок);
	КонецЕсли;
	
	Если Ссылка = Неопределено И ЗначениеЗаполнено(ОписаниеРеквизита.УИД) Тогда
		Если ВидОбъекта = "Справочники"
			И (ИмяОбъекта = "Организации" Или ИмяОбъекта = "ФизическиеЛица" Или ИмяОбъекта = "Сотрудники") Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = '%1 «%2» не найден в базе-приёмнике. Сначала перенесите кадровую НСИ.'"),
				ИмяОбъекта,
				ОписаниеРеквизита.Представление);
		КонецЕсли;
	КонецЕсли;
	
	Если Ссылка <> Неопределено Тогда
		КэшСсылок.Вставить(КлючКэша, Ссылка);
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция НайтиСсылкуПоКлючам(Менеджер, ВидОбъекта, ИмяОбъекта, ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок)
	
	Поиск = ОписаниеРеквизита.Поиск;
	Если Поиск = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИмяОбъекта = "Организации" Тогда
		Возврат НайтиОрганизацию(Поиск);
	ИначеЕсли ИмяОбъекта = "ФизическиеЛица" Тогда
		Возврат НайтиФизическоеЛицо(Поиск);
	ИначеЕсли ИмяОбъекта = "Сотрудники" Тогда
		Возврат НайтиСотрудника(Поиск, ПараметрыПереноса, КэшСсылок);
	ИначеЕсли ИмяОбъекта = "Контрагенты" Тогда
		Возврат НайтиКонтрагента(Поиск);
	ИначеЕсли ИмяОбъекта = "ТарифыПлатежныхАгентов" Тогда
		Возврат НайтиПоНаименованию(Менеджер, Поиск);
	ИначеЕсли ИмяОбъекта = "Банки" Или ИмяОбъекта = "КлассификаторБанков" Тогда
		Возврат НайтиБанк(Менеджер, Поиск);
	ИначеЕсли СтрНайти(ИмяОбъекта, "БанковскиеСчета") > 0 Тогда
		Возврат НайтиБанковскийСчет(Менеджер, Поиск, ПараметрыПереноса, КэшСсылок);
	ИначеЕсли ВидОбъекта = "Справочники" Тогда
		Ссылка = НайтиПоНаименованию(Менеджер, Поиск);
		Если Ссылка = Неопределено Тогда
			Ссылка = НайтиПоКоду(Менеджер, Поиск);
		КонецЕсли;
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиОрганизацию(Поиск)
	
	Если ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "ИНН")) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И (Организации.КПП = &КПП
		|			ИЛИ &КПП = """")
		|	И НЕ Организации.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ЗначениеКлюча(Поиск, "ИНН"));
		Запрос.УстановитьПараметр("КПП", ЗначениеКлюча(Поиск, "КПП"));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайтиПоНаименованию(Справочники.Организации, Поиск);
	
КонецФункции

Функция НайтиФизическоеЛицо(Поиск)
	
	Если Метаданные.Справочники.Найти("ФизическиеЛица") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "СтраховойНомерПФР")) Тогда
		Ссылка = НайтиСправочникПоРеквизиту("ФизическиеЛица", "СтраховойНомерПФР", ЗначениеКлюча(Поиск, "СтраховойНомерПФР"));
		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "ИНН")) Тогда
		Ссылка = НайтиСправочникПоРеквизиту("ФизическиеЛица", "ИНН", ЗначениеКлюча(Поиск, "ИНН"));
		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "Фамилия")) И ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "Имя")) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ФизическиеЛица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	ФизическиеЛица.Наименование = &Наименование
		|	И (&ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ФизическиеЛица.ДатаРождения = &ДатаРождения)
		|	И НЕ ФизическиеЛица.ПометкаУдаления";
		Наименование = СокрЛП(ЗначениеКлюча(Поиск, "Фамилия") + " " + ЗначениеКлюча(Поиск, "Имя") + " " + ЗначениеКлюча(Поиск, "Отчество"));
		Запрос.УстановитьПараметр("Наименование", Наименование);
		ДатаРождения = ЗначениеКлюча(Поиск, "ДатаРождения");
		Запрос.УстановитьПараметр("ДатаРождения", ?(ТипЗнч(ДатаРождения) = Тип("Дата"), ДатаРождения, Дата(1, 1, 1)));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайтиПоНаименованию(Справочники.ФизическиеЛица, Поиск);
	
КонецФункции

Функция НайтиСотрудника(Поиск, ПараметрыПереноса, КэшСсылок)
	
	Если Метаданные.Справочники.Найти("Сотрудники") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФизическоеЛицо = Неопределено;
	Если Поиск.Свойство("ФизическоеЛицо") И ТипЗнч(Поиск.ФизическоеЛицо) = Тип("Структура") Тогда
		ФизическоеЛицо = НайтиСсылкуПриемника(Поиск.ФизическоеЛицо, ПараметрыПереноса, КэшСсылок);
	КонецЕсли;
	
	ГоловнаяОрганизация = Неопределено;
	Если Поиск.Свойство("ГоловнаяОрганизация") И ТипЗнч(Поиск.ГоловнаяОрганизация) = Тип("Структура") Тогда
		ГоловнаяОрганизация = НайтиСсылкуПриемника(Поиск.ГоловнаяОрганизация, ПараметрыПереноса, КэшСсылок);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И (&Код = """"
	|			ИЛИ Сотрудники.Код = &Код)
	|	И (&ФизическоеЛицо = НЕОПРЕДЕЛЕНО
	|			ИЛИ Сотрудники.ФизическоеЛицо = &ФизическоеЛицо)
	|	И (&ГоловнаяОрганизация = НЕОПРЕДЕЛЕНО
	|			ИЛИ Сотрудники.ГоловнаяОрганизация = &ГоловнаяОрганизация)";
	Запрос.УстановитьПараметр("Код", ЗначениеКлюча(Поиск, "Код"));
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", ГоловнаяОрганизация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

