		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И (Контрагенты.КПП = &КПП
		|			ИЛИ &КПП = """")
		|	И НЕ Контрагенты.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ЗначениеКлюча(Поиск, "ИНН"));
		Запрос.УстановитьПараметр("КПП", ЗначениеКлюча(Поиск, "КПП"));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайтиПоНаименованию(Справочники.Контрагенты, Поиск);
	
КонецФункции

Функция НайтиБанк(Менеджер, Поиск)
	
	Если ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "Код")) Тогда
		Ссылка = Менеджер.НайтиПоКоду(ЗначениеКлюча(Поиск, "Код"));
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайтиПоНаименованию(Менеджер, Поиск);
	
КонецФункции

Функция НайтиБанковскийСчет(Менеджер, Поиск, ПараметрыПереноса, КэшСсылок)
	
	НомерСчета = ЗначениеКлюча(Поиск, "НомерСчета");
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец = Неопределено;
	Если Поиск.Свойство("Владелец") И ТипЗнч(Поиск.Владелец) = Тип("Структура") Тогда
		Владелец = НайтиСсылкуПриемника(Поиск.Владелец, ПараметрыПереноса, КэшСсылок);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + Менеджер.ПустаяСсылка().Метаданные().Имя + " КАК Счета
	|ГДЕ
	|	Счета.НомерСчета = &НомерСчета
	|	И (&Владелец = НЕОПРЕДЕЛЕНО
	|			ИЛИ Счета.Владелец = &Владелец)
	|	И НЕ Счета.ПометкаУдаления";
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиПоНаименованию(Менеджер, Поиск)
	
	Наименование = ЗначениеКлюча(Поиск, "Наименование");
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиПоКоду(Менеджер, Поиск)
	
	Код = ЗначениеКлюча(Поиск, "Код");
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Ссылка = Менеджер.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиСправочникПоРеквизиту(ИмяСправочника, ИмяРеквизита, ЗначениеРеквизита)
	
	Если Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти(ИмяРеквизита) = Неопределено
		И ИмяРеквизита <> "Код" И ИмяРеквизита <> "Наименование" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Справочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Справочник
	|ГДЕ
	|	Справочник." + ИмяРеквизита + " = &Значение
	|	И НЕ Справочник.ПометкаУдаления";
	Запрос.УстановитьПараметр("Значение", ЗначениеРеквизита);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СоздатьЭлементСправочника(Менеджер, ИмяОбъекта, ОписаниеРеквизита, ПараметрыПереноса, КэшСсылок)
	
	Поиск = ОписаниеРеквизита.Поиск;
	Если Поиск = Неопределено Или Не ЗначениеЗаполнено(ЗначениеКлюча(Поиск, "Наименование")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйЭлемент = Менеджер.СоздатьЭлемент();
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.УИД) Тогда
		Попытка
			НовыйЭлемент.УстановитьСсылкуНового(Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ОписаниеРеквизита.УИД)));
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	НовыйЭлемент.Наименование = ЗначениеКлюча(Поиск, "Наименование");
	УстановитьРеквизитЕслиЕсть(НовыйЭлемент, "НаименованиеПолное", ЗначениеКлюча(Поиск, "НаименованиеПолное"));
	УстановитьРеквизитЕслиЕсть(НовыйЭлемент, "ИНН", ЗначениеКлюча(Поиск, "ИНН"));
	УстановитьРеквизитЕслиЕсть(НовыйЭлемент, "КПП", ЗначениеКлюча(Поиск, "КПП"));
	УстановитьРеквизитЕслиЕсть(НовыйЭлемент, "Код", ЗначениеКлюча(Поиск, "Код"));
	
	Попытка
		НовыйЭлемент.Записать();
		Возврат НовыйЭлемент.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура УстановитьРеквизитЕслиЕсть(Объект, ИмяРеквизита, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено
		И ИмяРеквизита <> "Код" И ИмяРеквизита <> "Наименование" Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область COMСоединение

Функция ПодключитьсяКЗУП(ПараметрыПереноса)
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазыЗУП(ПараметрыПереноса);
	
	Подключение = Неопределено;
	Попытка
		КомОбъект = Новый COMОбъект("V83.COMConnector");
		Подключение = КомОбъект.Connect(СтрокаСоединения);
	Исключение
		КомОбъект = Новый COMОбъект("V82.COMConnector");
		Подключение = КомОбъект.Connect(СтрокаСоединения);
	КонецПопытки;
	
	Возврат Подключение;
	
КонецФункции

Функция СтрокаСоединенияИнформационнойБазыЗУП(ПараметрыПереноса)
	
	Части = Новый Массив;
	
	Если ПараметрыПереноса.ВариантИнформационнойБазы = "Сервер" Тогда
		Части.Добавить(СтрШаблон("Srvr=""%1""", ПараметрыПереноса.СерверИБ));
		Части.Добавить(СтрШаблон("Ref=""%1""", ПараметрыПереноса.ИмяИБ));
	Иначе
		Части.Добавить(СтрШаблон("File=""%1""", ПараметрыПереноса.КаталогИБ));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПереноса.ПользовательИБ) Тогда
		Части.Добавить(СтрШаблон("Usr=""%1""", ПараметрыПереноса.ПользовательИБ));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыПереноса.ПарольИБ) Тогда
		Части.Добавить(СтрШаблон("Pwd=""%1""", ПараметрыПереноса.ПарольИБ));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ";") + ";";
	
КонецФункции

#КонецОбласти

#Область РаботаСМетаданнымиИсточника

Функция НовыйЗапросИсточника(Источник)
	
	Если Источник = Неопределено Тогда
		Возврат Новый Запрос;
	КонецЕсли;
	
