&НаСервереБезКонтекста
Функция ОписаниеПриемникаНаСервере(ТекстПользователя)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Имя", "");
	Результат.Вставить("Синоним", "");
	Результат.Вставить("ВидРегистра", "");
	Результат.Вставить("Поля", Новый Массив);
	Результат.Вставить("ПолеОтбораОрганизации", "");
	Результат.Вставить("ОписаниеБазы", СокрЛП(Метаданные.Синоним) + " " + СокрЛП(Метаданные.Версия));
	
	Регистр = НайтиРегистрПоПредставлению(Метаданные.РегистрыНакопления, ТекстПользователя);
	Если Регистр = Неопределено Тогда
		Результат.ТекстОшибки = "В ERP не найден регистр накопления «" + СокрЛП(ТекстПользователя) + "»."
			+ Символы.ПС + ТекстКандидатов(Метаданные.РегистрыНакопления);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Имя = Регистр.Имя;
	Результат.Синоним = Регистр.Синоним;
	Если Регистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
		Результат.ВидРегистра = "Обороты";
	ИначеЕсли Регистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		Результат.ВидРегистра = "Остатки";
	КонецЕсли;
	
	Если Метаданные.Документы.Найти("ПереносДанных") = Неопределено Тогда
		Результат.ТекстОшибки = "В ERP нет документа ПереносДанных.";
		Возврат Результат;
	КонецЕсли;
	Если Не РегистраторДоступен(Регистр, "ПереносДанных") Тогда
		Результат.ТекстОшибки = "Документ ПереносДанных не является регистратором регистра " + Регистр.Имя + ".";
		Возврат Результат;
	КонецЕсли;
	РеквизитКомментарий = Метаданные.Документы.ПереносДанных.Реквизиты.Найти("Комментарий");
	Если РеквизитКомментарий = Неопределено Тогда
		Результат.ТекстОшибки = "У документа ПереносДанных нет реквизита Комментарий. По нему обработка находит документ месяца.";
		Возврат Результат;
	КонецЕсли;
	ОбразецМаркера = МаркерМесяца(Регистр.Имя, Новый Структура("ИНН, КПП", "000000000000", "000000000"), Дата(2026, 1, 1));
	ДлинаКомментария = РеквизитКомментарий.Тип.КвалификаторыСтроки.Длина;
	Если ДлинаКомментария > 0 И ДлинаКомментария < СтрДлина(ОбразецМаркера) Тогда
		Результат.ТекстОшибки = "Реквизит Комментарий документа ПереносДанных короче маркера загрузки ("
			+ Формат(СтрДлина(ОбразецМаркера), "ЧГ=0") + " символов).";
		Возврат Результат;
	КонецЕсли;
	
	ДобавитьПоляКоллекции(Результат.Поля, Регистр.Измерения, "Измерение");
	ДобавитьПоляКоллекции(Результат.Поля, Регистр.Ресурсы, "Ресурс");
	ДобавитьПоляКоллекции(Результат.Поля, Регистр.Реквизиты, "Реквизит");
	Исключения = ИсключаемыеСтандартныеПоля();
	Для Каждого Реквизит Из Регистр.СтандартныеРеквизиты Цикл
		Если Исключения.Получить(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Типы = ОписаниеТиповЛокально(Реквизит.Тип);
		Категория = КатегорияТипов(Типы);
		Если Категория.Категория <> "Примитив" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Поля.Добавить(ОписаниеПоляПриемника(Реквизит.Имя, "Стандартный", Ложь, Типы, Категория));
	КонецЦикла;
	Результат.ПолеОтбораОрганизации = ПолеОтбораОрганизации(Результат.Поля);
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция КлючиОрганизацииНаСервере(Знач Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключи = Новый Структура("ИНН, КПП, Наименование");
	Ключи.ИНН = СокрЛП(Организация.ИНН);
	Ключи.КПП = СокрЛП(Организация.КПП);
	Ключи.Наименование = Организация.Наименование;
	Возврат Ключи;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьМесяцНаСервере(ИмяРегистра, Месяц, НачалоПериода, КонецПериода, КлючОрганизации, Замещать, ПропускатьЧужие)
	
	Маркер = МаркерМесяца(ИмяРегистра, КлючОрганизации, Месяц);
	ДокументыМесяца = НайтиДокументыМаркера(Маркер);
	Если ДокументыМесяца.Количество() > 0 И Не Замещать Тогда
		Первый = ДокументыМесяца[0];
		Возврат РешениеМесяца(Ложь, СтрШаблон(
			"уже есть документ Перенос данных № %1 от %2. Включите замещение, чтобы перезаписать его.",
			СокрЛП(Первый.Номер),
			Формат(Первый.Дата, "ДЛФ=D")));
	КонецЕсли;
	Если ПропускатьЧужие И ЕстьЧужиеДвижения(ИмяРегистра, НачалоПериода, КонецПериода, КлючОрганизации, Маркер) Тогда
		Возврат РешениеМесяца(Ложь, "в ERP уже есть другие движения регистра за этот месяц. Месяц пропущен, чтобы не задвоить обороты.");
	КонецЕсли;
	Возврат РешениеМесяца(Истина, "");
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьПорциюНаСервере(АдресНабора, АдресКэша, ИмяРегистра, Строки, Месяц, КлючОрганизации, УникальныйИдентификаторФормы)
	
	Ответ = Новый Структура("Успех, ТекстОшибки, АдресНабора, АдресКэша, Сообщения", Истина, "", АдресНабора, АдресКэша, Новый Массив);
	Попытка
		Если ЗначениеЗаполнено(АдресКэша) Тогда
			Кэш = ПолучитьИзВременногоХранилища(АдресКэша);
		Иначе
			Кэш = Новый Соответствие;
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресНабора) Тогда
			Буфер = ПолучитьИзВременногоХранилища(АдресНабора);
		Иначе
			Буфер = НовыйБуфер(ИмяРегистра);
			АдресНабора = ПоместитьВоВременноеХранилище(Буфер, УникальныйИдентификаторФормы);
			Ответ.АдресНабора = АдресНабора;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Буфер.Маркер) Тогда
			Буфер.Месяц = НачалоМесяца(Месяц);
			Буфер.Маркер = МаркерМесяца(Буфер.ИмяРегистра, КлючОрганизации, Буфер.Месяц);
		КонецЕсли;
		
		БылоПримеров = Буфер.Примеры.Количество();
		Для Каждого СтрокаДанных Из Строки Цикл
			ПринятьСтроку(Буфер, Кэш, СтрокаДанных);
		КонецЦикла;
		
		ПоместитьВоВременноеХранилище(Буфер, АдресНабора);
		Если ЗначениеЗаполнено(АдресКэша) Тогда
			ПоместитьВоВременноеХранилище(Кэш, АдресКэша);
		Иначе
			АдресКэша = ПоместитьВоВременноеХранилище(Кэш, УникальныйИдентификаторФормы);
		КонецЕсли;
		Ответ.АдресКэша = АдресКэша;
		Для Индекс = БылоПримеров По Буфер.Примеры.ВГраница() Цикл
			Ответ.Сообщения.Добавить(Буфер.Примеры[Индекс]);
		КонецЦикла;
	Исключение
		Ответ.Успех = Ложь;
		Ответ.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗавершитьМесяцНаСервере(АдресНабора, Организация, Замещать)
	
	Ответ = Новый Структура;
	Ответ.Вставить("Успех", Ложь);
	Ответ.Вставить("ТекстОшибки", "");
	Ответ.Вставить("Количество", 0);
	Ответ.Вставить("Пропущено", 0);
	Ответ.Вставить("СуммаДохода", 0);
	Ответ.Вставить("Представление", "");
	Ответ.Вставить("Сообщения", Новый Массив);
	
	Если Не ЗначениеЗаполнено(АдресНабора) Тогда
		Ответ.Успех = Истина;
		Возврат Ответ;
	КонецЕсли;
	
	Буфер = ПолучитьИзВременногоХранилища(АдресНабора);
	Ответ.Пропущено = Буфер.Пропущено;
	Ответ.Сообщения = СводкаСопоставления(Буфер);
	Если Буфер.Записи.Количество() = 0 Тогда
		Ответ.Успех = Истина;
		УдалитьИзВременногоХранилища(АдресНабора);
		Возврат Ответ;
	КонецЕсли;
	
	Попытка
		РезультатЗаписи = ЗаписатьДокументМесяца(Буфер, Организация, Замещать);
		Ответ.Успех = Истина;
		Ответ.Количество = РезультатЗаписи.Количество;
		Ответ.СуммаДохода = РезультатЗаписи.СуммаДохода;
		Ответ.Представление = РезультатЗаписи.Представление;
	Исключение
		Ответ.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УдалитьИзВременногоХранилища(АдресНабора);
	Возврат Ответ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьДокументМесяца(Буфер, Организация, Замещать)
	
	Если Не ЗначениеЗаполнено(Буфер.Маркер) Или Не ЗначениеЗаполнено(Буфер.Месяц) Тогда
		ВызватьИсключение "Не удалось определить месяц документа Перенос данных.";
	КонецЕсли;
	
	ДокументыМесяца = НайтиДокументыМаркера(Буфер.Маркер);
	Если ДокументыМесяца.Количество() > 0 И Не Замещать Тогда
		ВызватьИсключение "Документ месяца уже существует, замещение выключено.";
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Если ДокументыМесяца.Количество() = 0 Тогда
			ДокументОбъект = Документы.ПереносДанных.СоздатьДокумент();
		Иначе
			ДокументОбъект = ДокументыМесяца[0].Ссылка.ПолучитьОбъект();
		КонецЕсли;
		ДокументОбъект.Дата = КонецМесяца(Буфер.Месяц);
		ДокументОбъект.ПометкаУдаления = Ложь;
		ДокументОбъект.Проведен = Истина;
		ДокументОбъект.Комментарий = Буфер.Маркер;
		ОрганизацияДокумента = ОрганизацияДокумента(Буфер, Организация);
		Если ЗначениеЗаполнено(ОрганизацияДокумента) Тогда
			УстановитьРеквизитДокумента(ДокументОбъект, "Организация", ОрганизацияДокумента);
		КонецЕсли;
		УстановитьРеквизитДокумента(ДокументОбъект, "ПериодРегистрации", НачалоМесяца(Буфер.Месяц));
		Попытка
			УстановитьРеквизитДокумента(ДокументОбъект, "Ответственный", Пользователи.ТекущийПользователь());
		Исключение
			// В базе без БСП общий модуль Пользователи может отсутствовать.
		КонецПопытки;
		Если ДокументОбъект.ЭтоНовый() Тогда
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
		ДокументОбъект.Записать();
		
		Набор = РегистрыНакопления[Буфер.ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
		Для Каждого СтрокаНабора Из Буфер.Записи Цикл
			Движение = Набор.Добавить();
			Движение.Период = СтрокаНабора.Период;
			Движение.Активность = Истина;
			Если Буфер.ВидРегистра = "Остатки" И ЗначениеЗаполнено(СтрокаНабора.ВидДвижения) Тогда
				Если СтрокаНабора.ВидДвижения = "Приход" Тогда
					Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				ИначеЕсли СтрокаНабора.ВидДвижения = "Расход" Тогда
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				КонецЕсли;
			КонецЕсли;
			Для Каждого ЭлементЗначения Из СтрокаНабора.Значения Цикл
				Движение[ЭлементЗначения.Ключ] = ЭлементЗначения.Значение;
			КонецЦикла;
		КонецЦикла;
		Набор.Записать();
		
		Для Индекс = 1 По ДокументыМесяца.Количество() - 1 Цикл
			ЛишнийОбъект = ДокументыМесяца[Индекс].Ссылка.ПолучитьОбъект();
			ОчиститьДвиженияРегистратора(Буфер.ИмяРегистра, ЛишнийОбъект.Ссылка);
			ЛишнийОбъект.Проведен = Ложь;
			ЛишнийОбъект.ПометкаУдаления = Истина;
			ЛишнийОбъект.ОбменДанными.Загрузка = Истина;
			ЛишнийОбъект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
			ЛишнийОбъект.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("Количество", Буфер.Записи.Количество());
	Результат.Вставить("СуммаДохода", Буфер.СуммаДохода);
	Результат.Вставить("Представление", "№ " + СокрЛП(ДокументОбъект.Номер) + " от " + Формат(ДокументОбъект.Дата, "ДЛФ=D"));
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПринятьСтроку(Буфер, Кэш, СтрокаДанных)
	
	Период = ПривестиДату(СвойствоСтруктуры(СтрокаДанных, "Период", '00010101'));
	Если Не ЗначениеЗаполнено(Период) Тогда
		ОтметитьПропуск(Буфер, "Период", "Не заполнен период записи.", СвойствоСтруктуры(СтрокаДанных, "Представление", ""));
		Возврат;
	КонецЕсли;
	
	Значения = Новый Соответствие;
	ИндексПолей = Буфер.ИндексПолей;
	Для Каждого Поле Из СтрокаДанных.Поля Цикл
		ОписаниеПоля = ИндексПолей.Получить(Поле.Имя);
		Если ОписаниеПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РезультатПоля = РазрешитьПоле(Буфер, Кэш, Поле, ОписаниеПоля, СвойствоСтруктуры(СтрокаДанных, "Представление", ""));
		Если РезультатПоля.Пропустить Тогда
			Возврат;
		КонецЕсли;
		Если РезультатПоля.Записывать Тогда
			Значения.Вставить(Поле.Имя, РезультатПоля.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеПоля Из Буфер.Описание.Поля Цикл
		Если Не ОписаниеПоля.ЗапрещатьНезаполненные Тогда
			Продолжить;
		КонецЕсли;
		Если Значения.Получить(ОписаниеПоля.Имя) = Неопределено
			Или Не ЗначениеЗаполненоДляПоля(Значения.Получить(ОписаниеПоля.Имя), ОписаниеПоля) Тогда
			ОтметитьПропуск(Буфер, ОписаниеПоля.Имя, "Не заполнено обязательное поле " + ОписаниеПоля.Имя + ".",
				СвойствоСтруктуры(СтрокаДанных, "Представление", ""));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Запись = Новый Структура;
	Запись.Вставить("Период", Период);
	Запись.Вставить("ВидДвижения", СвойствоСтруктуры(СтрокаДанных, "ВидДвижения", ""));
	Запись.Вставить("Значения", Значения);
	Буфер.Записи.Добавить(Запись);
	
	Сумма = Значения.Получить("СуммаДохода");
	Если ТипЗнч(Сумма) = Тип("Число") Тогда
		Буфер.СуммаДохода = Буфер.СуммаДохода + Сумма;
	КонецЕсли;
	ЗапомнитьОрганизацию(Буфер, Значения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РазрешитьПоле(Буфер, Кэш, Поле, ОписаниеПоля, Представление)
	
	Результат = Новый Структура("Пропустить, Записывать, Значение", Ложь, Ложь, Неопределено);
	Вид = СвойствоСтруктуры(Поле, "Вид", "Пусто");
	
	Если Вид = "Пусто" Тогда
		Если ОписаниеПоля.ЗапрещатьНезаполненные Тогда
			ОтметитьПропуск(Буфер, ОписаниеПоля.Имя, "Пустое обязательное поле " + ОписаниеПоля.Имя + ".", Представление);
			Результат.Пропустить = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если Вид = "Примитив" Тогда
		Результат.Записывать = Истина;
		Результат.Значение = ПривестиЗначение(СвойствоСтруктуры(Поле, "Значение", Неопределено), ОписаниеПоля.Примитив);
		Возврат Результат;
	КонецЕсли;
	
	Если Вид = "Перечисление" Тогда
		ИмяТипа = СвойствоСтруктуры(Поле, "ИмяТипа", "");
		ИмяЗначения = СвойствоСтруктуры(Поле, "ИмяЗначения", "");
		Если ОписаниеПоля.Типы.Найти(ИмяТипа) = Неопределено Тогда
			Возврат РезультатНесопоставленногоПоля(Буфер, ОписаниеПоля, Представление, ИмяТипа + "." + ИмяЗначения);
		КонецЕсли;
		Значение = НайтиЗначениеПеречисления(ИмяТипа, ИмяЗначения);
		Если Значение = Неопределено Тогда
			Возврат РезультатНесопоставленногоПоля(Буфер, ОписаниеПоля, Представление, ИмяЗначения);
		КонецЕсли;
		Результат.Записывать = Истина;
		Результат.Значение = Значение;
		Возврат Результат;
	КонецЕсли;
	
	Если Вид <> "Ссылка" Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяТипа = СвойствоСтруктуры(Поле, "ИмяТипа", "");
	Если ОписаниеПоля.Типы.Найти(ИмяТипа) = Неопределено Тогда
		Возврат РезультатНесопоставленногоПоля(Буфер, ОписаниеПоля, Представление, ИмяТипа);
	КонецЕсли;
	Найденное = НайтиСсылку(Кэш, ИмяТипа, СвойствоСтруктуры(Поле, "Ключи", Неопределено));
	Если Найденное.Статус = "Найден" Тогда
		Результат.Записывать = Истина;
		Результат.Значение = Найденное.Ссылка;
		Возврат Результат;
	КонецЕсли;
	Возврат РезультатНесопоставленногоПоля(Буфер, ОписаниеПоля, Представление, Найденное.Статус + " " + ИмяТипа);
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатНесопоставленногоПоля(Буфер, ОписаниеПоля, Представление, Пояснение)
	
	Результат = Новый Структура("Пропустить, Записывать, Значение", Ложь, Ложь, Неопределено);
	УвеличитьСчетчик(Буфер.НеНайдено, ОписаниеПоля.Имя);
	Если ОписаниеПоля.ЗапрещатьНезаполненные Тогда
		ОтметитьПропуск(Буфер, ОписаниеПоля.Имя, "Не сопоставлено обязательное поле " + ОписаниеПоля.Имя + " (" + Пояснение + ").", Представление);
		Результат.Пропустить = Истина;
		Возврат Результат;
	КонецЕсли;
	ДобавитьПример(Буфер, "Пустая ссылка " + ОписаниеПоля.Имя + ": " + Представление + " (" + Пояснение + ").");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

