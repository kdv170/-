			Продолжить;
		КонецЕсли;
		Варианты.Добавить("КОГДА " + ВыражениеПоля + " ССЫЛКА " + ТипСсылки.ПолноеИмя
			+ " ТОГДА " + Кавычка + ТипСсылки.ПолноеИмя + Кавычка);
