&НаСервереБезКонтекста
Процедура ДобавитьПоляКоллекции(Поля, Коллекция, Роль)
	
	Для Каждого Реквизит Из Коллекция Цикл
		Типы = ОписаниеТиповЛокально(Реквизит.Тип);
		Категория = КатегорияТипов(Типы);
		Запрет = Ложь;
		Попытка
			Запрет = Реквизит.ЗапрещатьНезаполненныеЗначения;
		Исключение
			Запрет = Ложь;
		КонецПопытки;
		Поля.Добавить(ОписаниеПоляПриемника(Реквизит.Имя, Роль, Запрет, Типы, Категория));
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеПоляПриемника(Имя, Роль, Запрет, Типы, Категория)
	
	ИменаТипов = Новый Массив;
	Для Каждого ТипПоля Из Типы Цикл
		Если ТипПоля.ПолноеИмя <> "Неопределено" Тогда
			ИменаТипов.Добавить(ТипПоля.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Роль", Роль);
	Описание.Вставить("ЗапрещатьНезаполненные", Запрет);
	Описание.Вставить("Категория", Категория.Категория);
	Описание.Вставить("Примитив", Категория.Примитив);
	Описание.Вставить("Типы", ИменаТипов);
	Возврат Описание;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеТиповЛокально(ОписаниеТипов)
	
	Результат = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		Если Тип = Тип("Строка") Тогда
			Результат.Добавить(Новый Структура("Вид, ПолноеИмя", "Примитив", "Строка"));
		ИначеЕсли Тип = Тип("Число") Тогда
			Результат.Добавить(Новый Структура("Вид, ПолноеИмя", "Примитив", "Число"));
		ИначеЕсли Тип = Тип("Дата") Тогда
			Результат.Добавить(Новый Структура("Вид, ПолноеИмя", "Примитив", "Дата"));
		ИначеЕсли Тип = Тип("Булево") Тогда
			Результат.Добавить(Новый Структура("Вид, ПолноеИмя", "Примитив", "Булево"));
		ИначеЕсли Тип = Тип("Неопределено") Тогда
			Результат.Добавить(Новый Структура("Вид, ПолноеИмя", "Неопределено", "Неопределено"));
		Иначе
			МетаОбъект = Метаданные.НайтиПоТипу(Тип);
			Если МетаОбъект <> Неопределено Тогда
				ПолноеИмя = МетаОбъект.ПолноеИмя();
				Результат.Добавить(Новый Структура("Вид, ПолноеИмя", ВидПоПолномуИмени(ПолноеИмя), ПолноеИмя));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолеОтбораОрганизации(Поля)
	
