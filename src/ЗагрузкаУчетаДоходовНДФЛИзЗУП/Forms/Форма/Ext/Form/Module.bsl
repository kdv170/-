	Ключи.Вставить("Номер", "");
	Ключи.Вставить("Дата", '00010101');
	Ключи.Вставить("ВладелецИНН", "");
	Ключи.Вставить("ВладелецКПП", "");
	Ключи.Вставить("ВладелецНаименование", "");
	Ключи.Вставить("ФизическоеЛицоИНН", "");
	Ключи.Вставить("ФизическоеЛицоСНИЛС", "");
	Ключи.Вставить("ФизическоеЛицоНаименование", "");
	Ключи.Вставить("ФизическоеЛицоДатаРождения", '00010101');
	Ключи.Вставить("ФизическоеЛицоКод", "");
	Возврат Ключи;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьКлючи(Ключи)
	
	Нормализованные = НовыеКлючиСсылки();
	Имена = Новый Массив;
	Для Каждого Элемент Из Нормализованные Цикл
		Имена.Добавить(Элемент.Ключ);
	КонецЦикла;
	Для Каждого Имя Из Имена Цикл
		Значение = СвойствоСтруктуры(Ключи, Имя, Нормализованные[Имя]);
		Если ТипЗнч(Нормализованные[Имя]) = Тип("Дата") Тогда
			Нормализованные[Имя] = ПривестиДату(Значение);
		Иначе
			Нормализованные[Имя] = СокрЛП(СтрокаCOM(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Нормализованные;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КлючКэшаСсылки(Ключи)
	
	Возврат Ключи.ИНН + "|" + Ключи.КПП + "|" + Ключи.Код + "|" + Ключи.Наименование + "|" + Ключи.СНИЛС
		+ "|" + Формат(Ключи.ДатаРождения, "ДФ=yyyyMMdd")
		+ "|" + Ключи.Номер + "|" + Формат(Ключи.Дата, "ДФ=yyyyMMdd")
		+ "|" + Ключи.ВладелецИНН + "|" + Ключи.ВладелецКПП + "|" + Ключи.ВладелецНаименование
		+ "|" + Ключи.ФизическоеЛицоИНН + "|" + Ключи.ФизическоеЛицоСНИЛС + "|" + Ключи.ФизическоеЛицоНаименование
		+ "|" + Формат(Ключи.ФизическоеЛицоДатаРождения, "ДФ=yyyyMMdd")
		+ "|" + Ключи.ФизическоеЛицоКод;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазделитьПолноеИмя(ПолноеИмя)
	
	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ПроверитьИдентификатор(Части[0]) Или Не ПроверитьИдентификатор(Части[1]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вид, Имя", Части[0], Части[1]);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидПоПолномуИмени(ПолноеИмя)
	
	Позиция = СтрНайти(ПолноеИмя, ".");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Позиция - 1);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОбъекта(ПолноеИмя)
	
	Части = РазделитьПолноеИмя(ПолноеИмя);
	Если Части = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Части.Имя;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьИдентификатор(Имя)
	
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Первый = Сред(Имя, 1, 1);
	Если Первый >= "0" И Первый <= "9" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Если Не ЭтоСимволИдентификатора(Сред(Имя, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСимволИдентификатора(Символ)
	
	Если Символ = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Если (Символ >= "0" И Символ <= "9")
		Или (Символ >= "A" И Символ <= "Z")
		Или (Символ >= "a" И Символ <= "z")
		Или (Символ >= "А" И Символ <= "Я")
		Или (Символ >= "а" И Символ <= "я")
		Или Символ = "Ё"
		Или Символ = "ё" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЛитералПустого(Примитив)
	
	Если Примитив = "Число" Тогда
		Возврат "0";
	ИначеЕсли Примитив = "Булево" Тогда
		Возврат "ЛОЖЬ";
	ИначеЕсли Примитив = "Дата" Тогда
		Возврат "ДАТАВРЕМЯ(1, 1, 1)";
	КонецЕсли;
	Кавычка = """";
	Возврат Кавычка + Кавычка;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПривестиЗначение(Значение, Примитив)
	
	Если ЭтоПустоеЗначение(Значение) Тогда
		Если Примитив = "Число" Тогда
			Возврат 0;
		ИначеЕсли Примитив = "Булево" Тогда
			Возврат Ложь;
		ИначеЕсли Примитив = "Дата" Тогда
			Возврат '00010101';
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Если Примитив = "Строка" Тогда
		Возврат СтрокаCOM(Значение);
	ИначеЕсли Примитив = "Число" Тогда
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Число(Значение);
	ИначеЕсли Примитив = "Булево" Тогда
		Возврат БулевоCOM(Значение);
	ИначеЕсли Примитив = "Дата" Тогда
		Возврат ПривестиДату(Значение);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПривестиДату(Значение)
	
	Если ЭтоПустоеЗначение(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Дата(1899, 12, 30) + Цел(Значение * 86400);
	КонецЕсли;
	Попытка
		Возврат Дата(Значение);
	Исключение
		Возврат '00010101';
	КонецПопытки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция БулевоCOM(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	Текст = НРег(СокрЛП(СтрокаCOM(Значение)));
	Возврат Текст = "истина" Или Текст = "true" Или Текст = "да";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаCOM(Значение)
	
	Если ЭтоПустоеЗначение(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеКолонки(Выборка, ИмяКолонки)
	
	Попытка
		Возврат Выборка[ИмяКолонки];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПустоеЗначение(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Если Значение = NULL Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Имя, ПоУмолчанию)
	
	Если ТипЗнч(Структура) <> Тип("Структура") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = ПоУмолчанию;
	Если Структура.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеЗаполненоДляПоля(Значение, ОписаниеПоля)
	
	Если ОписаниеПоля.Категория = "Примитив" И (ОписаниеПоля.Примитив = "Число" Или ОписаниеПоля.Примитив = "Булево") Тогда
		Возврат Значение <> Неопределено;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Значение);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УвеличитьСчетчик(Счетчики, Ключ)
	
	Текущее = Счетчики.Получить(Ключ);
	Если Текущее = Неопределено Тогда
		Текущее = 0;
	КонецЕсли;
	Счетчики.Вставить(Ключ, Текущее + 1);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТолькоЦифры(Текст)
	
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КраткийТекст(Текст)
	
	Если СтрДлина(Текст) <= 4000 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, 2500) + Символы.ПС + "..." + Символы.ПС + Прав(Текст, 1000);
	
КонецФункции

&НаКлиенте
Функция ЭкранироватьПараметрСоединения(Текст)
	
	Возврат СтрЗаменить(Строка(Текст), """", """""");
	
КонецФункции

&НаКлиенте
Функция ТекстОшибки(Информация)
	
	Текст = ПодробноеПредставлениеОшибки(Информация);
	Если ЗначениеЗаполнено(Пароль) Тогда
		Текст = СтрЗаменить(Текст, Пароль, "***");
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

#КонецОбласти
