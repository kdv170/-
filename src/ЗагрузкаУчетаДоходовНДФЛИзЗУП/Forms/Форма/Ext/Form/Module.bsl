&НаСервереБезКонтекста
Функция НовыйБуфер(ИмяРегистра)
	
	Описание = ОписаниеПриемникаНаСервере(ИмяРегистра);
	Если Не Описание.Успех Тогда
		ВызватьИсключение Описание.ТекстОшибки;
	КонецЕсли;
	Буфер = Новый Структура;
	Буфер.Вставить("ИмяРегистра", Описание.Имя);
	Буфер.Вставить("ВидРегистра", Описание.ВидРегистра);
	Буфер.Вставить("Описание", Описание);
	Буфер.Вставить("ИндексПолей", ИндексПолей(Описание.Поля));
	Буфер.Вставить("Записи", Новый Массив);
	Буфер.Вставить("Пропущено", 0);
	Буфер.Вставить("СуммаДохода", 0);
	Буфер.Вставить("НеНайдено", Новый Соответствие);
	Буфер.Вставить("Примеры", Новый Массив);
	Буфер.Вставить("Организации", Новый Соответствие);
	Буфер.Вставить("ЕстьПолеОрганизация", ИндексПолей(Описание.Поля).Получить("Организация") <> Неопределено);
	Буфер.Вставить("Месяц", '00010101');
	Буфер.Вставить("Маркер", "");
	Возврат Буфер;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтметитьПропуск(Буфер, ИмяПоля, Причина, Представление)
	
	Буфер.Пропущено = Буфер.Пропущено + 1;
	УвеличитьСчетчик(Буфер.НеНайдено, "пропуск " + ИмяПоля);
	ДобавитьПример(Буфер, "Пропуск: " + Представление + " " + Причина);
	
