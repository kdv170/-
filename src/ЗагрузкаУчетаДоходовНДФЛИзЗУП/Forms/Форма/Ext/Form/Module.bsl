
&НаКлиенте
Перем СоединениеЗУП;

&НаКлиенте
Перем КонтекстЗагрузки;

&НаКлиенте
Перем ОстановитьЗагрузку;

&НаКлиенте
Перем ЗагрузкаВыполняется;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантПодключения = "Сервер";
	ИмяКоннектора = "V83.COMConnector";
	ИмяРегистра = "СведенияОДоходахНДФЛ";
	ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
	ДатаОкончания = НачалоДня(ТекущаяДатаСеанса());
	ЗамещатьЗагруженные = Истина;
	ПропускатьЕслиЕстьДвижения = Истина;
	Элементы.ВариантПодключения.СписокВыбора.Добавить("Сервер", "Серверная база");
	Элементы.ВариантПодключения.СписокВыбора.Добавить("Файл", "Файловая база");
	Элементы.Остановить.Доступность = Ложь;
	Элементы.КаталогБазы.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СоединениеЗУП = Неопределено;
	КонтекстЗагрузки = Неопределено;
	ОстановитьЗагрузку = Ложь;
	ЗагрузкаВыполняется = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	СоединениеЗУП = Неопределено;
	КонтекстЗагрузки = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВариантПодключенияПриИзменении(Элемент)
	
	Файловая = ВариантПодключения = "Файл";
	Элементы.КаталогБазы.Видимость = Файловая;
	Элементы.Сервер1С.Видимость = Не Файловая;
	Элементы.ИмяБазы.Видимость = Не Файловая;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогБазыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог файловой базы ЗУП";
	Если ЗначениеЗаполнено(КаталогБазы) Тогда
		Диалог.Каталог = КаталогБазы;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("КаталогБазыВыборЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогБазыВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КаталогБазы = ВыбранныеФайлы[0];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	
	Если ЗагрузкаВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не РеквизитыПодключенияЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПодключитьЗУП();
		Контекст = ПодготовитьКонтекстЧтения();
		Если Контекст = Неопределено Тогда
			ОтключитьЗУП();
			Возврат;
		КонецЕсли;
		РезультатКоличества = ВыполнитьЗапросЗУП(
			СоединениеЗУП,
			ТекстЗапросаКоличества(Контекст),
			ДатаНачала,
			КонецДня(ДатаОкончания),
			Контекст.КлючОрганизации);
		Количество = 0;
		ВыборкаКоличества = РезультатКоличества.Выбрать();
		Если БулевоCOM(ВыборкаКоличества.Следующий()) Тогда
			Количество = Число(ВыборкаКоличества.Количество);
		КонецЕсли;
		ТекстПроверки = ТекстЗапроса(Контекст.План, Контекст.ИмяРегистра, Контекст.КлючОрганизации <> Неопределено, 1);
		ВыполнитьЗапросЗУП(СоединениеЗУП, ТекстПроверки, ДатаНачала, КонецДня(ДатаОкончания), Контекст.КлючОрганизации);
		ЗаписатьЖурнал(СтрШаблон(
			"Подключение установлено. ЗУП: %1. ERP: %2. Регистр %3 (%4), вид %5. Активных записей за период: %6. Месяцев: %7.",
			Контекст.ОписаниеБазыЗУП,
			Контекст.ОписаниеБазыЕРП,
			Контекст.ИмяРегистра,
			Контекст.СинонимЗУП,
			Контекст.План.ВидРегистра,
			Формат(Количество, "ЧГ=0"),
			Контекст.Месяцы.Количество()));
		ОтключитьЗУП();
	Исключение
		ЗаписатьЖурнал(ТекстОшибки(ИнформацияОбОшибке()));
		ОтключитьЗУП();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если ЗагрузкаВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не РеквизитыПодключенияЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	ОстановитьЗагрузку = Ложь;
	ЗагрузкаВыполняется = Истина;
	УстановитьДоступностьКоманд(Истина);
	ЗаписатьЖурнал("——— " + Формат(ТекущаяДата(), "ДЛФ=DT") + " ———");
	
	Попытка
		ПодключитьЗУП();
		КонтекстЗагрузки = ПодготовитьКонтекстЧтения();
	Исключение
		ЗаписатьЖурнал(ТекстОшибки(ИнформацияОбОшибке()));
		ЗавершитьЗагрузкуНаКлиенте();
		Возврат;
	КонецПопытки;
	
	Если КонтекстЗагрузки = Неопределено Тогда
		ЗавершитьЗагрузкуНаКлиенте();
		Возврат;
	КонецЕсли;
	
	КонтекстЗагрузки.Вставить("Индекс", 0);
	КонтекстЗагрузки.Вставить("Документов", 0);
	КонтекстЗагрузки.Вставить("Записей", 0);
	КонтекстЗагрузки.Вставить("Пропущено", 0);
	КонтекстЗагрузки.Вставить("АдресКэша", "");
	ЗаписатьЖурнал(СтрШаблон(
		"Регистр %1 (%2). Документ на каждый месяц: Перенос данных. Регистраторы ЗУП заменяются этим документом.",
		КонтекстЗагрузки.ИмяРегистра,
		КонтекстЗагрузки.СинонимЗУП));
	ПодключитьОбработчикОжидания("ЗагрузитьОчереднойМесяц", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)
	
	ОстановитьЗагрузку = Истина;
	ЗаписатьЖурнал("Остановка запрошена. Текущий месяц будет дочитан.");
	
КонецПроцедуры

#КонецОбласти

#Область ЧтениеЗУП

&НаКлиенте
Процедура ЗагрузитьОчереднойМесяц()
	
	Если Не ЗагрузкаВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если ОстановитьЗагрузку Тогда
		ЗаписатьЖурнал("Остановлено пользователем.");
		ЗаписатьИтогЗагрузки();
		ЗавершитьЗагрузкуНаКлиенте();
		Возврат;
	КонецЕсли;
	
	Если КонтекстЗагрузки.Индекс >= КонтекстЗагрузки.Месяцы.Количество() Тогда
		ЗаписатьИтогЗагрузки();
		ЗавершитьЗагрузкуНаКлиенте();
		Возврат;
	КонецЕсли;
	
	ОписаниеМесяца = КонтекстЗагрузки.Месяцы[КонтекстЗагрузки.Индекс];
	КонтекстЗагрузки.Индекс = КонтекстЗагрузки.Индекс + 1;
	ПредставлениеМесяца = Формат(ОписаниеМесяца.Месяц, "ДФ='ММММ гггг'");
	
	Попытка
		ЗагрузитьМесяц(ОписаниеМесяца, ПредставлениеМесяца);
	Исключение
		ЗаписатьЖурнал(ПредставлениеМесяца + ": " + ТекстОшибки(ИнформацияОбОшибке()));
		ЗаписатьЖурнал("Загрузка остановлена из-за ошибки.");
		ЗаписатьИтогЗагрузки();
		ЗавершитьЗагрузкуНаКлиенте();
		Возврат;
	КонецПопытки;
	
	ПодключитьОбработчикОжидания("ЗагрузитьОчереднойМесяц", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМесяц(ОписаниеМесяца, ПредставлениеМесяца)
	
	Решение = ПодготовитьМесяцНаСервере(
		КонтекстЗагрузки.ИмяРегистра,
		ОписаниеМесяца.Месяц,
		ОписаниеМесяца.Начало,
		ОписаниеМесяца.Окончание,
		КонтекстЗагрузки.КлючОрганизации,
		ЗамещатьЗагруженные,
		ПропускатьЕслиЕстьДвижения);
	Если Не Решение.Грузить Тогда
		ЗаписатьЖурнал(ПредставлениеМесяца + ": " + Решение.Причина);
		Возврат;
	КонецЕсли;
	
	ЗаписатьЖурнал(ПредставлениеМесяца + ": чтение оборотов ЗУП...");
	РезультатЗапроса = ВыполнитьЗапросЗУП(
		СоединениеЗУП,
		КонтекстЗагрузки.ТекстЗапроса,
		ОписаниеМесяца.Начало,
		ОписаниеМесяца.Окончание,
		КонтекстЗагрузки.КлючОрганизации);
	Выборка = РезультатЗапроса.Выбрать();
	
	АдресНабора = "";
	Порция = Новый Массив;
	КоличествоИсточник = 0;
	СуммаИсточник = 0;
	РазмерПорции = 400;
	
	Пока БулевоCOM(Выборка.Следующий()) Цикл
		СтрокаДанных = ПрочитатьСтроку(Выборка, КонтекстЗагрузки.План);
		КоличествоИсточник = КоличествоИсточник + 1;
		СуммаИсточник = СуммаИсточник + СтрокаДанных.СуммаДохода;
		Порция.Добавить(СтрокаДанных);
		Если Порция.Количество() >= РазмерПорции Тогда
			АдресНабора = ОтправитьПорцию(АдресНабора, Порция, ОписаниеМесяца.Месяц);
			Порция = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	
	Если Порция.Количество() > 0 Тогда
		АдресНабора = ОтправитьПорцию(АдресНабора, Порция, ОписаниеМесяца.Месяц);
	КонецЕсли;
	
	Если КоличествоИсточник = 0 Тогда
		ЗаписатьЖурнал(ПредставлениеМесяца + ": нет оборотов за выбранный интервал.");
		Возврат;
	КонецЕсли;
	
	Итог = ЗавершитьМесяцНаСервере(АдресНабора, Организация, ЗамещатьЗагруженные);
	ВывестиСообщения(Итог.Сообщения);
	Если Не Итог.Успех Тогда
		ВызватьИсключение Итог.ТекстОшибки;
	КонецЕсли;
	
	КонтекстЗагрузки.Пропущено = КонтекстЗагрузки.Пропущено + Итог.Пропущено;
	Если Итог.Количество = 0 Тогда
		ЗаписатьЖурнал(СтрШаблон(
			"%1: источник %2 зап. на сумму %3, записать нечего (пропущено %4). Прежний документ месяца не изменен.",
			ПредставлениеМесяца,
			Формат(КоличествоИсточник, "ЧГ=0"),
			Формат(СуммаИсточник, "ЧДЦ=2; ЧН=0"),
			Формат(Итог.Пропущено, "ЧГ=0")));
		Возврат;
	КонецЕсли;
	
	КонтекстЗагрузки.Документов = КонтекстЗагрузки.Документов + 1;
	КонтекстЗагрузки.Записей = КонтекстЗагрузки.Записей + Итог.Количество;
	ЗаписатьЖурнал(СтрШаблон(
		"%1: документ Перенос данных %2. Записано %3 из %4, сумма дохода %5 из %6. Регистратор записей — этот документ.",
		ПредставлениеМесяца,
		Итог.Представление,
		Формат(Итог.Количество, "ЧГ=0"),
		Формат(КоличествоИсточник, "ЧГ=0"),
		Формат(Итог.СуммаДохода, "ЧДЦ=2; ЧН=0"),
		Формат(СуммаИсточник, "ЧДЦ=2; ЧН=0")));
	
КонецПроцедуры

&НаКлиенте
Функция ОтправитьПорцию(АдресНабора, Порция, Месяц)
	
	Ответ = ДобавитьПорциюНаСервере(
		АдресНабора,
		КонтекстЗагрузки.АдресКэша,
		КонтекстЗагрузки.ИмяРегистра,
		Порция,
		Месяц,
		КонтекстЗагрузки.КлючОрганизации,
		УникальныйИдентификатор);
	КонтекстЗагрузки.АдресКэша = Ответ.АдресКэша;
	ВывестиСообщения(Ответ.Сообщения);
	Если Не Ответ.Успех Тогда
		ВызватьИсключение Ответ.ТекстОшибки;
	КонецЕсли;
	Возврат Ответ.АдресНабора;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьКонтекстЧтения()
	
	КлючОрганизации = КлючиОрганизацииНаСервере(Организация);
	Если КлючОрганизации <> Неопределено И Не ЗначениеЗаполнено(КлючОрганизации.ИНН) Тогда
		ЗаписатьЖурнал("У выбранной организации не заполнен ИНН. Отбор по ней невозможен.");
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеЗУП = РазрешитьРегистрЗУП(СоединениеЗУП, ИмяРегистра);
	Если Не ОписаниеЗУП.Успех Тогда
		ЗаписатьЖурнал(ОписаниеЗУП.ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеЕРП = ОписаниеПриемникаНаСервере(ИмяРегистра);
	Если Не ОписаниеЕРП.Успех Тогда
		ЗаписатьЖурнал(ОписаниеЕРП.ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	Если ОписаниеЗУП.Имя <> ОписаниеЕРП.Имя Тогда
		ЗаписатьЖурнал(СтрШаблон(
			"Имя регистра в ЗУП (%1) и ERP (%2) не совпадает. Загрузка остановлена.",
			ОписаниеЗУП.Имя,
			ОписаниеЕРП.Имя));
		Возврат Неопределено;
	КонецЕсли;
	
	План = ПостроитьПланЧтения(СоединениеЗУП, ОписаниеЗУП.Имя, ОписаниеЕРП);
	Если ЗначениеЗаполнено(План.ТекстОшибки) Тогда
		ЗаписатьЖурнал(План.ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	Если КлючОрганизации <> Неопределено И Не ЗначениеЗаполнено(План.ВыражениеИНН) Тогда
		ЗаписатьЖурнал("В регистре ЗУП нет измерения организации с ИНН и КПП. Снимите отбор по организации или проверьте имя регистра.");
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Предупреждение Из План.Предупреждения Цикл
		ЗаписатьЖурнал(Предупреждение);
	КонецЦикла;
	
	Контекст = Новый Структура;
	Контекст.Вставить("План", План);
	Контекст.Вставить("ИмяРегистра", ОписаниеЗУП.Имя);
	Контекст.Вставить("СинонимЗУП", ОписаниеЗУП.Синоним);
	Контекст.Вставить("КлючОрганизации", КлючОрганизации);
	Контекст.Вставить("ТекстЗапроса", ТекстЗапроса(План, ОписаниеЗУП.Имя, КлючОрганизации <> Неопределено, 0));
	Контекст.Вставить("Месяцы", МесяцыПериода(ДатаНачала, ДатаОкончания));
	Контекст.Вставить("ОписаниеБазыЗУП", ОписаниеБазыЗУП(СоединениеЗУП));
	Контекст.Вставить("ОписаниеБазыЕРП", ОписаниеЕРП.ОписаниеБазы);
	Возврат Контекст;
	
КонецФункции

&НаКлиенте
Функция ПостроитьПланЧтения(Соединение, ИмяРегистраЗУП, ОписаниеЕРП)
	
	План = Новый Структура;
	План.Вставить("Поля", Новый Массив);
	План.Вставить("Предупреждения", Новый Массив);
	План.Вставить("ТекстОшибки", "");
	План.Вставить("ВыражениеИНН", "");
	План.Вставить("ВыражениеКПП", "");
	План.Вставить("ЕстьВидДвижения", Ложь);
	План.Вставить("ВидРегистра", "");
	
	МетаРегистр = Соединение.Метаданные.РегистрыНакопления.Найти(ИмяРегистраЗУП);
	Если МетаРегистр = Неопределено Тогда
		План.ТекстОшибки = "В ЗУП не найден регистр накопления " + ИмяРегистраЗУП + ".";
		Возврат План;
	КонецЕсли;
	
	ВидЗУП = ВидРегистраCOM(Соединение, МетаРегистр);
	План.ВидРегистра = ВидЗУП;
	Если ВидЗУП <> ОписаниеЕРП.ВидРегистра Тогда
		План.ТекстОшибки = СтрШаблон("Вид регистра не совпадает: ЗУП «%1», ERP «%2».", ВидЗУП, ОписаниеЕРП.ВидРегистра);
		Возврат План;
	КонецЕсли;
	План.ЕстьВидДвижения = ВидЗУП = "Остатки";
	
	ИндексЕРП = ИндексПолей(ОписаниеЕРП.Поля);
	ИменаЗУП = Новый Соответствие;
	Для Каждого ПолеЗУП Из ПоляРегистраCOM(Соединение, МетаРегистр) Цикл
		ИменаЗУП.Вставить(ПолеЗУП.Имя, Истина);
		ПолеЕРП = ИндексЕРП.Получить(ПолеЗУП.Имя);
		Если ПолеЕРП = Неопределено Тогда
			План.Предупреждения.Добавить("Поле " + ПолеЗУП.Имя + " есть в ЗУП и отсутствует в ERP, пропущено.");
			Продолжить;
		КонецЕсли;
		ОписаниеЧтения = ОписаниеЧтенияПоля(Соединение, ПолеЗУП, ПолеЕРП);
		Если ОписаниеЧтения = Неопределено Тогда
			Текст = "Поле " + ПолеЗУП.Имя + " пропущено: тип ЗУП и ERP не совпадает.";
			Если ПолеЕРП.ЗапрещатьНезаполненные Тогда
				План.ТекстОшибки = "Обязательное поле " + ПолеЗУП.Имя + " нельзя перенести: тип ЗУП и ERP не совпадает.";
				Возврат План;
			КонецЕсли;
			План.Предупреждения.Добавить(Текст);
			Продолжить;
		КонецЕсли;
		План.Поля.Добавить(ОписаниеЧтения);
	КонецЦикла;
	
	Для Каждого ПолеЕРП Из ОписаниеЕРП.Поля Цикл
		Если ИменаЗУП.Получить(ПолеЕРП.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеЕРП.ЗапрещатьНезаполненные Тогда
			План.ТекстОшибки = "В ERP обязательно поле " + ПолеЕРП.Имя + ", а в регистре ЗУП его нет.";
			Возврат План;
		КонецЕсли;
		План.Предупреждения.Добавить("Поле " + ПолеЕРП.Имя + " есть в ERP и отсутствует в ЗУП, останется пустым.");
	КонецЦикла;
	
	План.ВыражениеИНН = ВыражениеОтбораОрганизации(Соединение, МетаРегистр, ОписаниеЕРП.ПолеОтбораОрганизации, "ИНН");
	План.ВыражениеКПП = ВыражениеОтбораОрганизации(Соединение, МетаРегистр, ОписаниеЕРП.ПолеОтбораОрганизации, "КПП");
	Возврат План;
	
КонецФункции

&НаКлиенте
Функция ОписаниеЧтенияПоля(Соединение, ПолеЗУП, ПолеЕРП)
	
	Примитивы = Новый Массив;
	Ссылки = Новый Массив;
	Перечисления = Новый Массив;
	Для Каждого ТипПоля Из ПолеЗУП.Типы Цикл
		Если ТипПоля.ПолноеИмя = "Неопределено" Тогда
			Продолжить;
		ИначеЕсли ТипПоля.Вид = "Примитив" Тогда
			Примитивы.Добавить(ТипПоля);
		ИначеЕсли ТипПоля.Вид = "Перечисление" Тогда
			Перечисления.Добавить(ТипПоля);
		ИначеЕсли ЭтоСсылочныйВид(ТипПоля.Вид) Тогда
			Ссылки.Добавить(ТипПоля);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Если Примитивы.Количество() > 1 Или Перечисления.Количество() > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Примитивы.Количество() > 0 И (Ссылки.Количество() > 0 Или Перечисления.Количество() > 0) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Перечисления.Количество() > 0 И Ссылки.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", ПолеЗУП.Имя);
	Описание.Вставить("Чтение", "");
	Описание.Вставить("Примитив", "");
	Описание.Вставить("ИмяТипаПеречисления", "");
	Описание.Вставить("Колонка", ПолеЗУП.Имя);
	Описание.Вставить("КолонкаВида", "");
	Описание.Вставить("Колонки", Новый Массив);
	Описание.Вставить("Выражения", Новый Массив);
	
	Если Примитивы.Количество() = 1 Тогда
		Если ПолеЕРП.Категория <> "Примитив" Или ПолеЕРП.Примитив <> Примитивы[0].ПолноеИмя Тогда
			Возврат Неопределено;
		КонецЕсли;
		Описание.Чтение = "Примитив";
		Описание.Примитив = Примитивы[0].ПолноеИмя;
		Описание.Выражения.Добавить("ЕСТЬNULL(Сведения." + ПолеЗУП.Имя + ", " + ЛитералПустого(Описание.Примитив) + ") КАК " + ПолеЗУП.Имя);
		Возврат Описание;
	КонецЕсли;
	
	Если Перечисления.Количество() = 1 Тогда
		Если ПолеЕРП.Категория <> "Перечисление" Или ПолеЕРП.Типы.Найти(Перечисления[0].ПолноеИмя) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Описание.Чтение = "Перечисление";
		Описание.ИмяТипаПеречисления = Перечисления[0].ПолноеИмя;
		Выражение = ВыражениеПеречисления(Соединение, "Сведения." + ПолеЗУП.Имя, Описание.ИмяТипаПеречисления);
		Описание.Выражения.Добавить(Выражение + " КАК " + ПолеЗУП.Имя);
		Возврат Описание;
	КонецЕсли;
	
	Если Ссылки.Количество() = 0 Или ПолеЕРП.Категория <> "Ссылка" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание.Чтение = "Ссылка";
	Описание.КолонкаВида = ПолеЗУП.Имя + "_Вид";
	Описание.Выражения.Добавить(ВыражениеИмениТипа("Сведения." + ПолеЗУП.Имя, Ссылки) + " КАК " + Описание.КолонкаВида);
	Для Каждого ТипСсылки Из Ссылки Цикл
		Если Не ПроверитьИдентификатор(ИмяОбъекта(ТипСсылки.ПолноеИмя)) Тогда
			Продолжить;
		КонецЕсли;
		ВыражениеСсылки = "ВЫРАЗИТЬ(Сведения." + ПолеЗУП.Имя + " КАК " + ТипСсылки.ПолноеИмя + ")";
		Для Каждого КлючТипа Из КлючиТипаCOM(Соединение, ТипСсылки.ПолноеИмя) Цикл
			ПсевдонимКолонки = ПолеЗУП.Имя + "__" + СтрЗаменить(ТипСсылки.ПолноеИмя, ".", "_") + "__" + КлючТипа.Ключ;
			ЗначениеПоТипу = "ЕСТЬNULL(" + ВыражениеСсылки + "." + КлючТипа.Путь + ", " + ЛитералПустого(КлючТипа.Примитив) + ")";
			Выражение = "ВЫБОР КОГДА Сведения." + ПолеЗУП.Имя + " ССЫЛКА " + ТипСсылки.ПолноеИмя
				+ " ТОГДА " + ЗначениеПоТипу
				+ " ИНАЧЕ " + ЛитералПустого(КлючТипа.Примитив) + " КОНЕЦ";
			Описание.Выражения.Добавить(Выражение + " КАК " + ПсевдонимКолонки);
			Описание.Колонки.Добавить(Новый Структура(
				"ИмяТипа, Ключ, Колонка, Примитив",
				ТипСсылки.ПолноеИмя,
				КлючТипа.Ключ,
				ПсевдонимКолонки,
				КлючТипа.Примитив));
		КонецЦикла;
	КонецЦикла;
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция ТекстЗапроса(План, ИмяРегистраЗУП, ЕстьОтборОрганизации, Лимит)
	
	Части = Новый Массив;
	Части.Добавить("Сведения.Период КАК Период");
	Если План.ЕстьВидДвижения Тогда
		Кавычка = """";
		Части.Добавить(
			"ВЫБОР КОГДА Сведения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА " + Кавычка + "Приход" + Кавычка
			+ " КОГДА Сведения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) ТОГДА " + Кавычка + "Расход" + Кавычка
			+ " ИНАЧЕ " + Кавычка + Кавычка
			+ " КОНЕЦ КАК СлужебныйВидДвижения");
	КонецЕсли;
	Для Каждого Поле Из План.Поля Цикл
		Для Каждого Выражение Из Поле.Выражения Цикл
			Части.Добавить(Выражение);
		КонецЦикла;
	КонецЦикла;
	
	УсловиеОрганизации = "";
	Если ЕстьОтборОрганизации Тогда
		УсловиеОрганизации = "И " + План.ВыражениеИНН + " = &ИНН И " + План.ВыражениеКПП + " = &КПП";
	КонецЕсли;
	ТекстЛимита = "";
	Если Лимит > 0 Тогда
		ТекстЛимита = "ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0");
	КонецЕсли;
	
	Возврат
	"ВЫБРАТЬ " + ТекстЛимита + "
	|	" + СтрСоединить(Части, "," + Символы.ПС + Символы.Таб) + "
	|ИЗ
	|	РегистрНакопления." + ИмяРегистраЗУП + " КАК Сведения
	|ГДЕ
	|	Сведения.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Сведения.Активность
	|	" + УсловиеОрганизации + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сведения.Период,
	|	Сведения.Регистратор,
	|	Сведения.НомерСтроки";
	
КонецФункции

&НаКлиенте
Функция ТекстЗапросаКоличества(Контекст)
	
	УсловиеОрганизации = "";
	Если Контекст.КлючОрганизации <> Неопределено Тогда
		УсловиеОрганизации = "И " + Контекст.План.ВыражениеИНН + " = &ИНН И " + Контекст.План.ВыражениеКПП + " = &КПП";
	КонецЕсли;
	Возврат
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрНакопления." + Контекст.ИмяРегистра + " КАК Сведения
	|ГДЕ
	|	Сведения.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Сведения.Активность
	|	" + УсловиеОрганизации;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапросЗУП(Соединение, Текст, НачалоПериода, КонецПериода, КлючОрганизации)
	
	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Если КлючОрганизации = Неопределено Тогда
		Запрос.УстановитьПараметр("ИНН", "");
		Запрос.УстановитьПараметр("КПП", "");
	Иначе
		Запрос.УстановитьПараметр("ИНН", КлючОрганизации.ИНН);
		Запрос.УстановитьПараметр("КПП", КлючОрганизации.КПП);
	КонецЕсли;
	Попытка
		Возврат Запрос.Выполнить();
	Исключение
		ВызватьИсключение КраткийТекст(Текст) + Символы.ПС + ТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьСтроку(Выборка, План)
	
	СтрокаДанных = Новый Структура;
	СтрокаДанных.Вставить("Период", ПривестиДату(ЗначениеКолонки(Выборка, "Период")));
	СтрокаДанных.Вставить("ВидДвижения", "");
	Если План.ЕстьВидДвижения Тогда
		СтрокаДанных.ВидДвижения = СокрЛП(СтрокаCOM(ЗначениеКолонки(Выборка, "СлужебныйВидДвижения")));
	КонецЕсли;
	СтрокаДанных.Вставить("Поля", Новый Массив);
	СтрокаДанных.Вставить("СуммаДохода", 0);
	СтрокаДанных.Вставить("Представление", "");
	
	ИмяФизлица = "";
	КодДохода = "";
	Для Каждого Поле Из План.Поля Цикл
		ОписаниеПоля = ПрочитатьПоле(Выборка, Поле);
		СтрокаДанных.Поля.Добавить(ОписаниеПоля);
		Если Поле.Имя = "СуммаДохода" И ОписаниеПоля.Вид = "Примитив" И ТипЗнч(ОписаниеПоля.Значение) = Тип("Число") Тогда
			СтрокаДанных.СуммаДохода = ОписаниеПоля.Значение;
		ИначеЕсли Поле.Имя = "ФизическоеЛицо" И ОписаниеПоля.Ключи <> Неопределено Тогда
			ИмяФизлица = ОписаниеПоля.Ключи.Наименование;
		ИначеЕсли Поле.Имя = "КодДохода" И ОписаниеПоля.Ключи <> Неопределено Тогда
			КодДохода = ОписаниеПоля.Ключи.Код;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаДанных.Представление = СтрШаблон("%1, %2, код %3, сумма %4",
		Формат(СтрокаДанных.Период, "ДЛФ=D"),
		ИмяФизлица,
		КодДохода,
		Формат(СтрокаДанных.СуммаДохода, "ЧДЦ=2; ЧН=0"));
	Возврат СтрокаДанных;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьПоле(Выборка, Поле)
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", Поле.Имя);
	Результат.Вставить("Вид", "Пусто");
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("ИмяТипа", "");
	Результат.Вставить("ИмяЗначения", "");
	Результат.Вставить("Ключи", Неопределено);
	
	Если Поле.Чтение = "Примитив" Тогда
		Результат.Вид = "Примитив";
		Результат.Значение = ПривестиЗначение(ЗначениеКолонки(Выборка, Поле.Колонка), Поле.Примитив);
		Возврат Результат;
	КонецЕсли;
	
	Если Поле.Чтение = "Перечисление" Тогда
		ИмяЗначения = СокрЛП(СтрокаCOM(ЗначениеКолонки(Выборка, Поле.Колонка)));
		Если Не ЗначениеЗаполнено(ИмяЗначения) Тогда
			Возврат Результат;
		КонецЕсли;
		Результат.Вид = "Перечисление";
		Результат.ИмяТипа = Поле.ИмяТипаПеречисления;
		Результат.ИмяЗначения = ИмяЗначения;
		Возврат Результат;
	КонецЕсли;
	
	ИмяТипа = СокрЛП(СтрокаCOM(ЗначениеКолонки(Выборка, Поле.КолонкаВида)));
	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Вид = "Ссылка";
	Результат.ИмяТипа = ИмяТипа;
	Результат.Ключи = НовыеКлючиСсылки();
	Для Каждого Колонка Из Поле.Колонки Цикл
		Если Колонка.ИмяТипа <> ИмяТипа Тогда
			Продолжить;
		КонецЕсли;
		Результат.Ключи[Колонка.Ключ] = ПривестиЗначение(ЗначениеКолонки(Выборка, Колонка.Колонка), Колонка.Примитив);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Подключение

&НаКлиенте
Процедура ПодключитьЗУП()
	
	#Если ВебКлиент Тогда
		ВызватьИсключение "COM-соединение недоступно в веб-клиенте. Откройте обработку в тонком или толстом клиенте Windows.";
	#КонецЕсли
	
	Информация = Новый СистемнаяИнформация;
	Если Информация.ТипПлатформы <> ТипПлатформы.Windows_x86
		И Информация.ТипПлатформы <> ТипПлатформы.Windows_x86_64 Тогда
		ВызватьИсключение "COM-соединение с ЗУП доступно только при запуске клиента в Windows.";
	КонецЕсли;
	
	ИмяКласса = СокрЛП(ИмяКоннектора);
	Если Не ЗначениеЗаполнено(ИмяКласса) Тогда
		ИмяКласса = "V83.COMConnector";
	КонецЕсли;
	Коннектор = Новый COMОбъект(ИмяКласса);
	СоединениеЗУП = Коннектор.Connect(СтрокаСоединенияЗУП());
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьЗУП()
	
	СоединениеЗУП = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаСоединенияЗУП()
	
	ТекстПользователя = ЭкранироватьПараметрСоединения(Пользователь);
	ТекстПароля = ЭкранироватьПараметрСоединения(Пароль);
	Если ВариантПодключения = "Файл" Тогда
		Возврат СтрШаблон("File=""%1"";Usr=""%2"";Pwd=""%3"";", ЭкранироватьПараметрСоединения(КаталогБазы), ТекстПользователя, ТекстПароля);
	КонецЕсли;
	Возврат СтрШаблон("Srvr=""%1"";Ref=""%2"";Usr=""%3"";Pwd=""%4"";",
		ЭкранироватьПараметрСоединения(Сервер1С),
		ЭкранироватьПараметрСоединения(ИмяБазы),
		ТекстПользователя,
		ТекстПароля);
	
КонецФункции

&НаКлиенте
Функция РеквизитыПодключенияЗаполнены()
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ЗаписатьЖурнал("Укажите начало и окончание периода.");
		Возврат Ложь;
	КонецЕсли;
	Если ДатаНачала > ДатаОкончания Тогда
		ЗаписатьЖурнал("Начало периода больше окончания.");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(ИмяРегистра)) Тогда
		ЗаписатьЖурнал("Укажите имя или синоним регистра.");
		Возврат Ложь;
	КонецЕсли;
	Если ВариантПодключения = "Файл" Тогда
		Если Не ЗначениеЗаполнено(СокрЛП(КаталогБазы)) Тогда
			ЗаписатьЖурнал("Укажите каталог файловой базы ЗУП.");
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(СокрЛП(Сервер1С)) Или Не ЗначениеЗаполнено(СокрЛП(ИмяБазы)) Тогда
		ЗаписатьЖурнал("Укажите сервер и имя базы ЗУП.");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(Пользователь)) Тогда
		ЗаписатьЖурнал("Укажите пользователя ЗУП.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыКлиент

&НаКлиенте
Процедура ЗавершитьЗагрузкуНаКлиенте()
	
	ОтключитьЗУП();
	ЗагрузкаВыполняется = Ложь;
	ОстановитьЗагрузку = Ложь;
	УстановитьДоступностьКоманд(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИтогЗагрузки()
	
	Если КонтекстЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьЖурнал(СтрШаблон(
		"Готово. Документов Перенос данных: %1, записей: %2, пропущено строк: %3.",
		Формат(КонтекстЗагрузки.Документов, "ЧГ=0"),
		Формат(КонтекстЗагрузки.Записей, "ЧГ=0"),
		Формат(КонтекстЗагрузки.Пропущено, "ЧГ=0")));
	Если КонтекстЗагрузки.Документов > 0 Тогда
		ЗаписатьЖурнал("Пересчет итогов регистра " + КонтекстЗагрузки.ИмяРегистра + "...");
		Попытка
			ПересчитатьИтогиРегистраНаСервере(КонтекстЗагрузки.ИмяРегистра);
			ЗаписатьЖурнал("Итоги регистра пересчитаны. Обороты в отчетах учитывают загруженные записи.");
		Исключение
			ЗаписатьЖурнал("Документы записаны, но итоги регистра не пересчитаны: " + ТекстОшибки(ИнформацияОбОшибке()));
			ЗаписатьЖурнал("Выполните пересчет итогов этого регистра в ERP. Пока итоги старые, отчеты по оборотам могут не показать загрузку.");
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКоманд(ИдетЗагрузка)
	
	Элементы.Загрузить.Доступность = Не ИдетЗагрузка;
	Элементы.ПроверитьПодключение.Доступность = Не ИдетЗагрузка;
	Элементы.Остановить.Доступность = ИдетЗагрузка;
	Элементы.ГруппаПодключение.Доступность = Не ИдетЗагрузка;
	Элементы.ГруппаОтбор.Доступность = Не ИдетЗагрузка;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЖурнал(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Журнал) Тогда
		Журнал = Журнал + Символы.ПС;
	КонецЕсли;
	Журнал = Журнал + Текст;
	Если СтрДлина(Журнал) > 200000 Тогда
		Журнал = Прав(Журнал, 150000);
	КонецЕсли;
	СостояниеЗагрузки = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщения(Сообщения)
	
	Если Сообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Текст Из Сообщения Цикл
		ЗаписатьЖурнал(Текст);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция МесяцыПериода(НачалоПериода, ОкончаниеПериода)
	
	Результат = Новый Массив;
	Курсор = НачалоМесяца(НачалоПериода);
	Граница = КонецДня(ОкончаниеПериода);
	Пока Курсор <= Граница Цикл
		НачалоИнтервала = Курсор;
		Если НачалоИнтервала < НачалоПериода Тогда
			НачалоИнтервала = НачалоПериода;
		КонецЕсли;
		КонецИнтервала = КонецМесяца(Курсор);
		Если КонецИнтервала > Граница Тогда
			КонецИнтервала = Граница;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Месяц, Начало, Окончание", Курсор, НачалоИнтервала, КонецИнтервала));
		Курсор = ДобавитьМесяц(Курсор, 1);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазрешитьРегистрЗУП(Соединение, ТекстПользователя)
	
	Результат = Новый Структура("Успех, Имя, Синоним, ТекстОшибки", Ложь, "", "", "");
	Регистр = НайтиРегистрПоПредставлению(Соединение.Метаданные.РегистрыНакопления, ТекстПользователя);
	Если Регистр = Неопределено Тогда
		Результат.ТекстОшибки = "В ЗУП не найден регистр накопления «" + СокрЛП(ТекстПользователя) + "»."
			+ Символы.ПС + ТекстКандидатов(Соединение.Метаданные.РегистрыНакопления);
		Возврат Результат;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Имя = Регистр.Имя;
	Результат.Синоним = Регистр.Синоним;
	Если НРег(Результат.Имя) <> НРег(СокрЛП(ТекстПользователя)) И НРег(Результат.Синоним) <> НРег(СокрЛП(ТекстПользователя)) Тогда
		ЗаписатьЖурнал(СтрШаблон("В ЗУП выбран регистр %1 («%2»).", Результат.Имя, Результат.Синоним));
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОписаниеБазыЗУП(Соединение)
	
	Информация = Соединение.NewObject("СистемнаяИнформация");
	Возврат СокрЛП(СтрокаCOM(Соединение.Метаданные.Синоним)) + " " + СокрЛП(СтрокаCOM(Соединение.Метаданные.Версия))
		+ ", платформа " + СокрЛП(СтрокаCOM(Информация.ВерсияПриложения));
	
КонецФункции

#КонецОбласти

#Область МетаданныеCOM

&НаКлиенте
Функция ПоляРегистраCOM(Соединение, МетаРегистр)
	
	Поля = Новый Массив;
	ДобавитьПоляКоллекцииCOM(Соединение, Поля, МетаРегистр.Измерения, "Измерение");
	ДобавитьПоляКоллекцииCOM(Соединение, Поля, МетаРегистр.Ресурсы, "Ресурс");
	ДобавитьПоляКоллекцииCOM(Соединение, Поля, МетаРегистр.Реквизиты, "Реквизит");
	Исключения = ИсключаемыеСтандартныеПоля();
	Для Каждого Реквизит Из МетаРегистр.СтандартныеРеквизиты Цикл
		Если Исключения.Получить(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Типы = ТипыРеквизитаCOM(Соединение, Реквизит.Тип);
		Категория = КатегорияТипов(Типы);
		Если Категория.Категория <> "Примитив" Тогда
			Продолжить;
		КонецЕсли;
		Поля.Добавить(Новый Структура("Имя, Роль, Типы", Реквизит.Имя, "Стандартный", Типы));
	КонецЦикла;
	Возврат Поля;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьПоляКоллекцииCOM(Соединение, Поля, Коллекция, Роль)
	
	Для Каждого Реквизит Из Коллекция Цикл
		Поля.Добавить(Новый Структура("Имя, Роль, Типы", Реквизит.Имя, Роль, ТипыРеквизитаCOM(Соединение, Реквизит.Тип)));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ТипыРеквизитаCOM(Соединение, ОписаниеТипов)
	
	Результат = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		Описание = ОписаниеОдногоТипаCOM(Соединение, Тип);
		Если Описание <> Неопределено Тогда
			Результат.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОписаниеОдногоТипаCOM(Соединение, Тип)
	
	Описание = ОписаниеТипаЧерезСравнениеCOM(Соединение, Тип);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	Попытка
		МетаОбъект = Соединение.Метаданные.НайтиПоТипу(Тип);
		Если МетаОбъект <> Неопределено И ЗначениеЗаполнено(МетаОбъект.ПолноеИмя()) Тогда
			ПолноеИмя = МетаОбъект.ПолноеИмя();
			Возврат Новый Структура("Вид, ПолноеИмя", ВидПоПолномуИмени(ПолноеИмя), ПолноеИмя);
		КонецЕсли;
	Исключение
		МетаОбъект = Неопределено;
	КонецПопытки;
	
	Попытка
		ДанныеXML = Соединение.XMLТип(Тип);
		Возврат ВидПоИмениXML(ДанныеXML.ИмяТипа);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ОписаниеТипаЧерезСравнениеCOM(Соединение, Тип)
	
	Попытка
		Если Тип = Соединение.Тип("Строка") Тогда
			Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Строка");
		ИначеЕсли Тип = Соединение.Тип("Число") Тогда
			Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Число");
		ИначеЕсли Тип = Соединение.Тип("Дата") Тогда
			Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Дата");
		ИначеЕсли Тип = Соединение.Тип("Булево") Тогда
			Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Булево");
		ИначеЕсли Тип = Соединение.Тип("Неопределено") Тогда
			Возврат Новый Структура("Вид, ПолноеИмя", "Неопределено", "Неопределено");
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ВидРегистраCOM(Соединение, МетаРегистр)
	
	Виды = Соединение.Метаданные.СвойстваОбъектов.ВидРегистраНакопления;
	Если МетаРегистр.ВидРегистра = Виды.Обороты Тогда
		Возврат "Обороты";
	ИначеЕсли МетаРегистр.ВидРегистра = Виды.Остатки Тогда
		Возврат "Остатки";
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ВыражениеОтбораОрганизации(Соединение, МетаРегистр, ИмяПоля, ИмяРеквизита)
	
	Если Не ЗначениеЗаполнено(ИмяПоля) Или Не ПроверитьИдентификатор(ИмяПоля) Или Не ПроверитьИдентификатор(ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	Реквизит = НайтиРеквизитРегистраCOM(МетаРегистр, ИмяПоля);
	Если Реквизит = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Не ТипТолько(ТипыРеквизитаCOM(Соединение, Реквизит.Тип), "Справочник.Организации") Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Сведения." + ИмяПоля + "." + ИмяРеквизита;
	
КонецФункции

&НаКлиенте
Функция НайтиРеквизитРегистраCOM(МетаРегистр, ИмяПоля)
	
	Для Каждого Коллекция Из МассивКоллекцийРегистра(МетаРегистр) Цикл
		Для Каждого Реквизит Из Коллекция Цикл
			Если Реквизит.Имя = ИмяПоля Тогда
				Возврат Реквизит;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция МассивКоллекцийРегистра(МетаРегистр)
	
	Коллекции = Новый Массив;
	Коллекции.Добавить(МетаРегистр.Измерения);
	Коллекции.Добавить(МетаРегистр.Ресурсы);
	Коллекции.Добавить(МетаРегистр.Реквизиты);
	Возврат Коллекции;
	
КонецФункции

&НаКлиенте
Функция КлючиТипаCOM(Соединение, ПолноеИмя)
	
	МетаОбъект = МетаПоПолномуИмениCOM(Соединение, ПолноеИмя);
	Результат = Новый Массив;
	Если МетаОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Вид = ВидПоПолномуИмени(ПолноеИмя);
	Если Вид = "Документ" Тогда
		ДобавитьКлючТипа(Результат, "Номер", "Номер", "Строка");
		ДобавитьКлючТипа(Результат, "Дата", "Дата", "Дата");
		Если РеквизитОбъектаЕстьCOM(МетаОбъект, "Организация")
			И ТипТолько(ТипыРеквизитаОбъектаCOM(Соединение, МетаОбъект, "Организация"), "Справочник.Организации") Тогда
			ДобавитьКлючТипа(Результат, "ИНН", "Организация.ИНН", "Строка");
			ДобавитьКлючТипа(Результат, "КПП", "Организация.КПП", "Строка");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если ДлинаКодаCOM(МетаОбъект) > 0 Тогда
		ДобавитьКлючТипа(Результат, "Код", "Код", "Строка");
	КонецЕсли;
	Если ДлинаНаименованияCOM(МетаОбъект) > 0 Тогда
		ДобавитьКлючТипа(Результат, "Наименование", "Наименование", "Строка");
	КонецЕсли;
	Если РеквизитОбъектаЕстьCOM(МетаОбъект, "ИНН") Тогда
		ДобавитьКлючТипа(Результат, "ИНН", "ИНН", "Строка");
	КонецЕсли;
	Если РеквизитОбъектаЕстьCOM(МетаОбъект, "КПП") Тогда
		ДобавитьКлючТипа(Результат, "КПП", "КПП", "Строка");
	КонецЕсли;
	Если РеквизитОбъектаЕстьCOM(МетаОбъект, "СтраховойНомерПФР") Тогда
		ДобавитьКлючТипа(Результат, "СНИЛС", "СтраховойНомерПФР", "Строка");
	КонецЕсли;
	Если РеквизитОбъектаЕстьCOM(МетаОбъект, "ДатаРождения") Тогда
		ДобавитьКлючТипа(Результат, "ДатаРождения", "ДатаРождения", "Дата");
	КонецЕсли;
	Если ТипТолько(ТипыВладельцаCOM(Соединение, МетаОбъект), "Справочник.Организации") Тогда
		ДобавитьКлючТипа(Результат, "ВладелецИНН", "Владелец.ИНН", "Строка");
		ДобавитьКлючТипа(Результат, "ВладелецКПП", "Владелец.КПП", "Строка");
		ДобавитьКлючТипа(Результат, "ВладелецНаименование", "Владелец.Наименование", "Строка");
	КонецЕсли;
	Если РеквизитОбъектаЕстьCOM(МетаОбъект, "ФизическоеЛицо")
		И ТипТолько(ТипыРеквизитаОбъектаCOM(Соединение, МетаОбъект, "ФизическоеЛицо"), "Справочник.ФизическиеЛица") Тогда
		МетаФизлица = МетаПоПолномуИмениCOM(Соединение, "Справочник.ФизическиеЛица");
		Если МетаФизлица <> Неопределено И РеквизитОбъектаЕстьCOM(МетаФизлица, "ИНН") Тогда
			ДобавитьКлючТипа(Результат, "ФизическоеЛицоИНН", "ФизическоеЛицо.ИНН", "Строка");
		КонецЕсли;
		Если МетаФизлица <> Неопределено И РеквизитОбъектаЕстьCOM(МетаФизлица, "СтраховойНомерПФР") Тогда
			ДобавитьКлючТипа(Результат, "ФизическоеЛицоСНИЛС", "ФизическоеЛицо.СтраховойНомерПФР", "Строка");
		КонецЕсли;
		Если МетаФизлица <> Неопределено И ДлинаНаименованияCOM(МетаФизлица) > 0 Тогда
			ДобавитьКлючТипа(Результат, "ФизическоеЛицоНаименование", "ФизическоеЛицо.Наименование", "Строка");
		КонецЕсли;
		Если МетаФизлица <> Неопределено И РеквизитОбъектаЕстьCOM(МетаФизлица, "ДатаРождения") Тогда
			ДобавитьКлючТипа(Результат, "ФизическоеЛицоДатаРождения", "ФизическоеЛицо.ДатаРождения", "Дата");
		КонецЕсли;
		Если МетаФизлица <> Неопределено И ДлинаКодаCOM(МетаФизлица) > 0 Тогда
			ДобавитьКлючТипа(Результат, "ФизическоеЛицоКод", "ФизическоеЛицо.Код", "Строка");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МетаПоПолномуИмениCOM(Соединение, ПолноеИмя)
	
	Части = РазделитьПолноеИмя(ПолноеИмя);
	Если Части = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Коллекция = КоллекцияМетаданныхCOM(Соединение, Части.Вид);
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбъектМетаданныхПоИмени(Коллекция, Части.Имя);
	
КонецФункции

&НаКлиенте
Функция КоллекцияМетаданныхCOM(Соединение, Вид)
	
	Если Вид = "Справочник" Тогда
		Возврат Соединение.Метаданные.Справочники;
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Соединение.Метаданные.Документы;
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Соединение.Метаданные.Перечисления;
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат Соединение.Метаданные.ПланыВидовРасчета;
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат Соединение.Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат Соединение.Метаданные.ПланыСчетов;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ВыражениеПеречисления(Соединение, ВыражениеПоля, ПолноеИмя)
	
	Части = РазделитьПолноеИмя(ПолноеИмя);
	МетаПеречисления = Неопределено;
	Если Части <> Неопределено Тогда
		МетаПеречисления = ОбъектМетаданныхПоИмени(Соединение.Метаданные.Перечисления, Части.Имя);
	КонецЕсли;
	Кавычка = """";
	Варианты = Новый Массив;
	Если МетаПеречисления <> Неопределено Тогда
		Для Каждого ЗначениеПеречисления Из МетаПеречисления.ЗначенияПеречисления Цикл
			Если Не ПроверитьИдентификатор(ЗначениеПеречисления.Имя) Тогда
				Продолжить;
			КонецЕсли;
			Варианты.Добавить("КОГДА " + ВыражениеПоля + " = ЗНАЧЕНИЕ(" + ПолноеИмя + "." + ЗначениеПеречисления.Имя
				+ ") ТОГДА " + Кавычка + ЗначениеПеречисления.Имя + Кавычка);
		КонецЦикла;
	КонецЕсли;
	Если Варианты.Количество() = 0 Тогда
		Возврат Кавычка + Кавычка;
	КонецЕсли;
	Возврат "ВЫБОР " + СтрСоединить(Варианты, " ") + " ИНАЧЕ " + Кавычка + Кавычка + " КОНЕЦ";
	
КонецФункции

