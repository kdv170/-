&НаКлиентеНаСервереБезКонтекста
Функция НайтиРегистрПоПредставлению(Коллекция, ТекстПользователя)
	
	ТекстПоиска = СокрЛП(ТекстПользователя);
	Найденный = НайтиТочноеСовпадениеРегистра(Коллекция, ТекстПоиска);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;
	
	Псевдонимы = Новый Массив;
	Псевдонимы.Добавить("СведенияОДоходахНДФЛ");
	Псевдонимы.Добавить("Учет доходов для исчисления НДФЛ");
	Псевдонимы.Добавить("Учет данных для НДФЛ");
	ИскатьПсевдонимы = Не ЗначениеЗаполнено(ТекстПоиска);
	ТекстНРег = НРег(ТекстПоиска);
	Для Каждого Псевдоним Из Псевдонимы Цикл
		Если НРег(Псевдоним) = ТекстНРег Тогда
			ИскатьПсевдонимы = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ИскатьПсевдонимы Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Псевдоним Из Псевдонимы Цикл
		Найденный = НайтиТочноеСовпадениеРегистра(Коллекция, Псевдоним);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НайтиТочноеСовпадениеРегистра(Коллекция, Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ПроверитьИдентификатор(Текст) Тогда
		Найденный = ОбъектМетаданныхПоИмени(Коллекция, Текст);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	ТекстНРег = НРег(Текст);
	Для Каждого Регистр Из Коллекция Цикл
		Если НРег(Регистр.Имя) = ТекстНРег Или НРег(Регистр.Синоним) = ТекстНРег Тогда
			Возврат Регистр;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбъектМетаданныхПоИмени(Коллекция, Имя)
	
	Попытка
		Найденный = Коллекция.Найти(Имя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Найденный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Если Не ЗначениеЗаполнено(Найденный.Имя) Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Найденный;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстКандидатов(Коллекция)
	
	Строки = Новый Массив;
	Для Каждого Регистр Из Коллекция Цикл
		Если СтрНайти(НРег(Регистр.Имя), "ндфл") = 0 И СтрНайти(НРег(Регистр.Синоним), "ндфл") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Регистр.Имя + " — " + Регистр.Синоним);
		Если Строки.Количество() >= 15 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат "Регистров с «НДФЛ» в имени или синониме не найдено.";
	КонецЕсли;
	Возврат "Похожие регистры:" + Символы.ПС + СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КатегорияТипов(Типы)
	
	Категория = "";
	Примитив = "";
	Смешанный = Ложь;
	Для Каждого ТипПоля Из Типы Цикл
		Если ТипПоля.ПолноеИмя = "Неопределено" Тогда
			Продолжить;
		КонецЕсли;
		Текущая = "";
		Если ТипПоля.Вид = "Примитив" Тогда
			Текущая = "Примитив";
			Если ЗначениеЗаполнено(Примитив) И Примитив <> ТипПоля.ПолноеИмя Тогда
				Смешанный = Истина;
			КонецЕсли;
			Примитив = ТипПоля.ПолноеИмя;
		ИначеЕсли ТипПоля.Вид = "Перечисление" Тогда
			Текущая = "Перечисление";
		ИначеЕсли ЭтоСсылочныйВид(ТипПоля.Вид) Тогда
			Текущая = "Ссылка";
		Иначе
			Смешанный = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Текущая) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Категория) Тогда
			Категория = Текущая;
		ИначеЕсли Категория <> Текущая Тогда
			Смешанный = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Смешанный Или Не ЗначениеЗаполнено(Категория) Тогда
		Категория = "Смешанный";
		Примитив = "";
	КонецЕсли;
	Если Категория <> "Примитив" Тогда
		Примитив = "";
	КонецЕсли;
	Возврат Новый Структура("Категория, Примитив", Категория, Примитив);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипТолько(Типы, ПолноеИмя)
	
	Найден = Ложь;
	Для Каждого ТипПоля Из Типы Цикл
		Если ТипПоля.Вид = "Примитив" Или ТипПоля.ПолноеИмя = "Неопределено" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипПоля.ПолноеИмя <> ПолноеИмя Тогда
			Возврат Ложь;
		КонецЕсли;
		Найден = Истина;
	КонецЦикла;
	Возврат Найден;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСсылочныйВид(Вид)
	
	Возврат Вид = "Справочник"
		Или Вид = "Документ"
		Или Вид = "ПланВидовРасчета"
		Или Вид = "ПланВидовХарактеристик"
		Или Вид = "ПланСчетов"
		Или Вид = "ПланОбмена"
		Или Вид = "БизнесПроцесс"
		Или Вид = "Задача";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидПоИмениXML(ИмяТипаXML)
	
	ИмяНРег = НРег(ИмяТипаXML);
	Если ИмяНРег = "string" Тогда
		Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Строка");
	ИначеЕсли ИмяНРег = "decimal" Тогда
		Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Число");
	ИначеЕсли ИмяНРег = "boolean" Тогда
		Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Булево");
	ИначеЕсли ИмяНРег = "datetime" Или ИмяНРег = "date" Тогда
		Возврат Новый Структура("Вид, ПолноеИмя", "Примитив", "Дата");
	ИначеЕсли ИмяНРег = "undefined" Тогда
		Возврат Новый Структура("Вид, ПолноеИмя", "Неопределено", "Неопределено");
	КонецЕсли;
	
	Позиция = СтрНайти(ИмяТипаXML, ".");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Префикс = НРег(Лев(ИмяТипаXML, Позиция - 1));
	Имя = Сред(ИмяТипаXML, Позиция + 1);
	Вид = "";
	Если Префикс = "catalogref" Тогда
		Вид = "Справочник";
	ИначеЕсли Префикс = "documentref" Тогда
		Вид = "Документ";
	ИначеЕсли Префикс = "enumref" Тогда
		Вид = "Перечисление";
	ИначеЕсли Префикс = "chartofcalculationtypesref" Тогда
		Вид = "ПланВидовРасчета";
	ИначеЕсли Префикс = "chartofcharacteristictypesref" Тогда
		Вид = "ПланВидовХарактеристик";
	ИначеЕсли Префикс = "chartofaccountsref" Тогда
		Вид = "ПланСчетов";
	ИначеЕсли Префикс = "exchangeplanref" Тогда
		Вид = "ПланОбмена";
	ИначеЕсли Префикс = "businessprocessref" Тогда
		Вид = "БизнесПроцесс";
	ИначеЕсли Префикс = "taskref" Тогда
		Вид = "Задача";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Если Не ПроверитьИдентификатор(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вид, ПолноеИмя", Вид, Вид + "." + Имя);
	
КонецФункции

