	Если Варианты.Количество() = 0 Тогда
		Возврат Кавычка + Кавычка;
	КонецЕсли;
	Возврат "ВЫБОР " + СтрСоединить(Варианты, " ") + " ИНАЧЕ " + Кавычка + Кавычка + " КОНЕЦ";
	
