&НаСервереБезКонтекста
Функция МаркерМесяца(ИмяРегистра, КлючОрганизации, Месяц)
	
	Если КлючОрганизации = Неопределено Тогда
		Ключ = "ВСЕ";
	Иначе
		Ключ = СокрЛП(СвойствоСтруктуры(КлючОрганизации, "ИНН", "")) + "/" + СокрЛП(СвойствоСтруктуры(КлючОрганизации, "КПП", ""));
	КонецЕсли;
	Возврат "ЗагрузкаНДФЛИзЗУП|" + ИмяРегистра + "|" + Ключ + "|" + Формат(Месяц, "ДФ=yyyyMM")
		+ "|Не перепроводить: регистратор заменен на этот документ";
	
