&НаСервереБезКонтекста
Функция ВариантыСНИЛС(СНИЛС)
	
	Варианты = Новый Массив;
	Исходный = СокрЛП(СНИЛС);
	Если Не ЗначениеЗаполнено(Исходный) Тогда
		Возврат Варианты;
	КонецЕсли;
	Варианты.Добавить(Исходный);
	Цифры = ТолькоЦифры(Исходный);
	Если ЗначениеЗаполнено(Цифры) И Варианты.Найти(Цифры) = Неопределено Тогда
		Варианты.Добавить(Цифры);
	КонецЕсли;
	Если СтрДлина(Цифры) = 11 Тогда
		Форматированный = Сред(Цифры, 1, 3) + "-" + Сред(Цифры, 4, 3) + "-" + Сред(Цифры, 7, 3) + " " + Сред(Цифры, 10, 2);
		Если Варианты.Найти(Форматированный) = Неопределено Тогда
			Варианты.Добавить(Форматированный);
		КонецЕсли;
	КонецЕсли;
	Возврат Варианты;
	
КонецФункции

