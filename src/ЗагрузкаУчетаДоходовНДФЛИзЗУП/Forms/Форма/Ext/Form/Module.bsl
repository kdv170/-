	Если Части.Вид = "Справочник" Тогда
		Возврат Метаданные.Справочники.Найти(Части.Имя);
	ИначеЕсли Части.Вид = "Документ" Тогда
		Возврат Метаданные.Документы.Найти(Части.Имя);
	ИначеЕсли Части.Вид = "ПланВидовРасчета" Тогда
		Возврат Метаданные.ПланыВидовРасчета.Найти(Части.Имя);
	ИначеЕсли Части.Вид = "ПланВидовХарактеристик" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик.Найти(Части.Имя);
	ИначеЕсли Части.Вид = "ПланСчетов" Тогда
		Возврат Метаданные.ПланыСчетов.Найти(Части.Имя);
	КонецЕсли;
	Возврат Неопределено;
	
