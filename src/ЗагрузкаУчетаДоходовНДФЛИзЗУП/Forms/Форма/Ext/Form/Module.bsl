	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата
	|ИЗ
	|	Документ.ПереносДанных КАК Док
	|ГДЕ
	|	Док.Комментарий = &Маркер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.ПометкаУдаления,
	|	Док.Дата,
	|	Док.Номер";
	Запрос.УстановитьПараметр("Маркер", Маркер);
