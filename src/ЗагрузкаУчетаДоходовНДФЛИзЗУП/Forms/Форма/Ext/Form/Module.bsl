&НаСервереБезКонтекста
Функция ЕстьЧужиеДвижения(ИмяРегистра, НачалоПериода, КонецПериода, КлючОрганизации, Маркер)
	
	Если Не ПроверитьИдентификатор(ИмяРегистра) Или Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
		ВызватьИсключение "Некорректное имя регистра " + ИмяРегистра;
	КонецЕсли;
	Описание = ОписаниеПриемникаНаСервере(ИмяРегистра);
	УсловиеОрганизации = "";
	Если КлючОрганизации <> Неопределено И ЗначениеЗаполнено(Описание.ПолеОтбораОрганизации) Тогда
		УсловиеОрганизации = "
		|	И Движения." + Описание.ПолеОтбораОрганизации + ".ИНН = &ИНН
		|	И Движения." + Описание.ПолеОтбораОрганизации + ".КПП = &КПП";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + " КАК Движения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереносДанных КАК Перенос
	|		ПО Движения.Регистратор = Перенос.Ссылка
	|ГДЕ
	|	Движения.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Движения.Активность
	|	И (Перенос.Ссылка ЕСТЬ NULL
	|		ИЛИ Перенос.Комментарий <> &Маркер)" + УсловиеОрганизации;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Маркер", Маркер);
	Если КлючОрганизации = Неопределено Тогда
		Запрос.УстановитьПараметр("ИНН", "");
		Запрос.УстановитьПараметр("КПП", "");
	Иначе
		Запрос.УстановитьПараметр("ИНН", КлючОрганизации.ИНН);
		Запрос.УстановитьПараметр("КПП", КлючОрганизации.КПП);
	КонецЕсли;
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиДокументыМаркера(Маркер)
	
	Запрос = Новый Запрос;
