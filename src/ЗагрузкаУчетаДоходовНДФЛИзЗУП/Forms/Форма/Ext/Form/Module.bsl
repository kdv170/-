&НаСервереБезКонтекста
Функция НайтиСсылку(Кэш, ИмяТипа, Ключи)
	
	Нормализованные = НормализоватьКлючи(Ключи);
	КлючКэша = ИмяТипа + "|" + КлючКэшаСсылки(Нормализованные);
	Готовое = Кэш.Получить(КлючКэша);
	Если Готовое <> Неопределено Тогда
		Возврат Готовое;
	КонецЕсли;
	
	Если ИмяТипа = "Справочник.Организации" Тогда
		Найденное = НайтиОрганизацию(Нормализованные);
	ИначеЕсли ИмяТипа = "Справочник.ФизическиеЛица" Тогда
		Найденное = НайтиФизическоеЛицо(Нормализованные);
	ИначеЕсли ИмяТипа = "Справочник.Сотрудники" Тогда
		Найденное = НайтиСотрудника(Кэш, Нормализованные);
	ИначеЕсли ИмяТипа = "Справочник.РегистрацииВНалоговомОргане" Тогда
		Найденное = НайтиРегистрациюВНалоговомОргане(Нормализованные);
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "Справочник.") Тогда
		Найденное = НайтиПрочийСправочник(ИмяТипа, Нормализованные);
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "Документ.") Тогда
		Найденное = НайтиДокумент(ИмяТипа, Нормализованные);
	ИначеЕсли СтрНачинаетсяС(ИмяТипа, "ПланВидовРасчета.")
		Или СтрНачинаетсяС(ИмяТипа, "ПланВидовХарактеристик.")
		Или СтрНачинаетсяС(ИмяТипа, "ПланСчетов.") Тогда
		Найденное = НайтиПоКодуИНаименованию(ИмяТипа, Нормализованные);
	Иначе
		Найденное = НовыйРезультатПоиска();
	КонецЕсли;
	
	Кэш.Вставить(КлючКэша, Найденное);
	Возврат Найденное;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиОрганизацию(Ключи)
	
	Если Не ЗначениеЗаполнено(Ключи.ИНН) Тогда
		Если ЗначениеЗаполнено(Ключи.Наименование) Тогда
			Возврат НайтиПоУсловиям("Справочник.Организации", УсловиеРавенства("Наименование"), ПараметрыКлючей(Ключи, "Наименование"));
		КонецЕсли;
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	
	Параметры = ПараметрыКлючей(Ключи, "ИНН, КПП");
	Найденное = НайтиПоУсловиям("Справочник.Организации", УсловиеРавенства("ИНН") + УсловиеРавенства("КПП"), Параметры);
	Если Найденное.Статус = "Найден" Или Найденное.Статус = "Неоднозначно" Тогда
		Возврат Найденное;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ключи.КПП) Тогда
		Возврат НайтиПоУсловиям("Справочник.Организации", УсловиеРавенства("ИНН"), ПараметрыКлючей(Ключи, "ИНН"));
	КонецЕсли;
	Возврат Найденное;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиФизическоеЛицо(Ключи)
	
	МетаОбъект = Метаданные.Справочники.Найти("ФизическиеЛица");
	Если МетаОбъект = Неопределено Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	
	Если МетаОбъект.Реквизиты.Найти("СтраховойНомерПФР") <> Неопределено И ЗначениеЗаполнено(Ключи.СНИЛС) Тогда
		Для Каждого Вариант Из ВариантыСНИЛС(Ключи.СНИЛС) Цикл
			Параметры = Новый Структура("СНИЛС", Вариант);
			Найденное = НайтиПоУсловиям("Справочник.ФизическиеЛица", Символы.ПС + "	И Таблица.СтраховойНомерПФР = &СНИЛС", Параметры);
			Если Найденное.Статус = "Найден" Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если МетаОбъект.Реквизиты.Найти("ИНН") <> Неопределено И ЗначениеЗаполнено(Ключи.ИНН) Тогда
		Найденное = НайтиПоУсловиям("Справочник.ФизическиеЛица", УсловиеРавенства("ИНН"), ПараметрыКлючей(Ключи, "ИНН"));
		Если Найденное.Статус <> "НеНайден" Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	
	Если МетаОбъект.Реквизиты.Найти("ДатаРождения") <> Неопределено
		И ЗначениеЗаполнено(Ключи.Наименование)
		И ЗначениеЗаполнено(Ключи.ДатаРождения) Тогда
		Найденное = НайтиПоУсловиям(
			"Справочник.ФизическиеЛица",
			УсловиеРавенства("Наименование") + Символы.ПС + "	И Таблица.ДатаРождения = &ДатаРождения",
			ПараметрыКлючей(Ключи, "Наименование, ДатаРождения"));
		Если Найденное.Статус <> "НеНайден" Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ключи.Код) И МетаОбъект.ДлинаКода > 0 Тогда
		Возврат НайтиПоУсловиям("Справочник.ФизическиеЛица", УсловиеРавенства("Код"), ПараметрыКлючей(Ключи, "Код"));
	КонецЕсли;
	Возврат НовыйРезультатПоиска();
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСотрудника(Кэш, Ключи)
	
	Если Метаданные.Справочники.Найти("Сотрудники") = Неопределено Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	
	КлючиФизлица = НовыеКлючиСсылки();
	КлючиФизлица.ИНН = Ключи.ФизическоеЛицоИНН;
	КлючиФизлица.СНИЛС = Ключи.ФизическоеЛицоСНИЛС;
	КлючиФизлица.Наименование = Ключи.ФизическоеЛицоНаименование;
	КлючиФизлица.ДатаРождения = Ключи.ФизическоеЛицоДатаРождения;
	КлючиФизлица.Код = Ключи.ФизическоеЛицоКод;
	Физлицо = НайтиСсылку(Кэш, "Справочник.ФизическиеЛица", КлючиФизлица);
	
	ЕстьФизлицо = Метаданные.Справочники.Сотрудники.Реквизиты.Найти("ФизическоеЛицо") <> Неопределено;
	Если Физлицо.Статус = "Найден" И ЕстьФизлицо Тогда
		Параметры = Новый Структура("ФизическоеЛицо", Физлицо.Ссылка);
		Если ЗначениеЗаполнено(Ключи.Код) Тогда
			Параметры.Вставить("Код", Ключи.Код);
			Найденное = НайтиПоУсловиям(
				"Справочник.Сотрудники",
				Символы.ПС + "	И Таблица.ФизическоеЛицо = &ФизическоеЛицо" + УсловиеРавенства("Код"),
				Параметры);
			Если Найденное.Статус = "Найден" Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ключи.Наименование) Тогда
			ПараметрыНаименования = Новый Структура("ФизическоеЛицо, Наименование", Физлицо.Ссылка, Ключи.Наименование);
			Найденное = НайтиПоУсловиям(
				"Справочник.Сотрудники",
				Символы.ПС + "	И Таблица.ФизическоеЛицо = &ФизическоеЛицо" + УсловиеРавенства("Наименование"),
				ПараметрыНаименования);
			Если Найденное.Статус = "Найден" Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЕсли;
		Найденное = НайтиПоУсловиям(
			"Справочник.Сотрудники",
			Символы.ПС + "	И Таблица.ФизическоеЛицо = &ФизическоеЛицо",
			Новый Структура("ФизическоеЛицо", Физлицо.Ссылка));
		Если Найденное.Статус = "Найден" Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ключи.Код) И Метаданные.Справочники.Сотрудники.ДлинаКода > 0 Тогда
		Возврат НайтиПоУсловиям("Справочник.Сотрудники", УсловиеРавенства("Код"), ПараметрыКлючей(Ключи, "Код"));
	КонецЕсли;
	Возврат НовыйРезультатПоиска();
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиРегистрациюВНалоговомОргане(Ключи)
	
	ИмяТипа = "Справочник.РегистрацииВНалоговомОргане";
	МетаОбъект = Метаданные.Справочники.Найти("РегистрацииВНалоговомОргане");
	Если МетаОбъект = Неопределено Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	ЕстьКПП = МетаОбъект.Реквизиты.Найти("КПП") <> Неопределено;
	Если ЕстьКПП И ЗначениеЗаполнено(Ключи.Код) И ЗначениеЗаполнено(Ключи.КПП) Тогда
		Найденное = НайтиПоУсловиям(ИмяТипа, УсловиеРавенства("Код") + УсловиеРавенства("КПП"), ПараметрыКлючей(Ключи, "Код, КПП"));
		Если Найденное.Статус = "Найден" Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Ключи.Код) И МетаОбъект.ДлинаКода > 0 Тогда
		Найденное = НайтиПоУсловиям(ИмяТипа, УсловиеРавенства("Код"), ПараметрыКлючей(Ключи, "Код"));
		Если Найденное.Статус <> "НеНайден" Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	Если ЕстьКПП И ЗначениеЗаполнено(Ключи.КПП) Тогда
		Возврат НайтиПоУсловиям(ИмяТипа, УсловиеРавенства("КПП"), ПараметрыКлючей(Ключи, "КПП"));
	КонецЕсли;
	Возврат НовыйРезультатПоиска();
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПрочийСправочник(ИмяТипа, Ключи)
	
	МетаОбъект = МетаданныеОбъекта(ИмяТипа);
	Если МетаОбъект = Неопределено Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	Если ЗначениеЗаполнено(Ключи.ВладелецИНН) И ВладелецЭтоОрганизация(МетаОбъект) Тогда
		УсловиеВладельца = "
		|	И Таблица.Владелец ССЫЛКА Справочник.Организации
		|	И ВЫРАЗИТЬ(Таблица.Владелец КАК Справочник.Организации).ИНН = &ВладелецИНН
		|	И ВЫРАЗИТЬ(Таблица.Владелец КАК Справочник.Организации).КПП = &ВладелецКПП";
		Если ЗначениеЗаполнено(Ключи.Код) И МетаОбъект.ДлинаКода > 0 Тогда
			Найденное = НайтиПоУсловиям(ИмяТипа, УсловиеВладельца + УсловиеРавенства("Код"), ПараметрыКлючей(Ключи, "ВладелецИНН, ВладелецКПП, Код"));
			Если Найденное.Статус <> "НеНайден" Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ключи.Наименование) И МетаОбъект.ДлинаНаименования > 0 Тогда
			Найденное = НайтиПоУсловиям(ИмяТипа, УсловиеВладельца + УсловиеРавенства("Наименование"),
				ПараметрыКлючей(Ключи, "ВладелецИНН, ВладелецКПП, Наименование"));
			Если Найденное.Статус <> "НеНайден" Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат НайтиПоКодуИНаименованию(ИмяТипа, Ключи);
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиДокумент(ИмяТипа, Ключи)
	
	МетаОбъект = МетаданныеОбъекта(ИмяТипа);
	Если МетаОбъект = Неопределено Или Не ЗначениеЗаполнено(Ключи.Номер) Или Не ЗначениеЗаполнено(Ключи.Дата) Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	Параметры = Новый Структура;
	Параметры.Вставить("Номер", Ключи.Номер);
	Параметры.Вставить("НачалоДня", НачалоДня(Ключи.Дата));
	Параметры.Вставить("КонецДня", КонецДня(Ключи.Дата));
	Условие = "
	|	И Таблица.Номер = &Номер
	|	И Таблица.Дата МЕЖДУ &НачалоДня И &КонецДня";
	Найденное = НайтиПоУсловиям(ИмяТипа, Условие, Параметры);
	Если Найденное.Статус <> "Неоднозначно" Тогда
		Возврат Найденное;
	КонецЕсли;
	РеквизитОрганизация = МетаОбъект.Реквизиты.Найти("Организация");
	Если Не ЗначениеЗаполнено(Ключи.ИНН)
		Или РеквизитОрганизация = Неопределено
		Или Не ТипТолько(ОписаниеТиповЛокально(РеквизитОрганизация.Тип), "Справочник.Организации") Тогда
		Возврат Найденное;
	КонецЕсли;
	Параметры.Вставить("ИНН", Ключи.ИНН);
	Параметры.Вставить("КПП", Ключи.КПП);
	Условие = Условие + "
	|	И Таблица.Организация.ИНН = &ИНН
	|	И Таблица.Организация.КПП = &КПП";
	Возврат НайтиПоУсловиям(ИмяТипа, Условие, Параметры);
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоКодуИНаименованию(ИмяТипа, Ключи)
	
	МетаОбъект = МетаданныеОбъекта(ИмяТипа);
	Если МетаОбъект = Неопределено Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	Если ЗначениеЗаполнено(Ключи.Код) Тогда
		Попытка
			ЕстьКод = МетаОбъект.ДлинаКода > 0;
		Исключение
			ЕстьКод = Ложь;
		КонецПопытки;
		Если ЕстьКод Тогда
			Найденное = НайтиПоУсловиям(ИмяТипа, УсловиеРавенства("Код"), ПараметрыКлючей(Ключи, "Код"));
			Если Найденное.Статус <> "НеНайден" Тогда
				Возврат Найденное;
			КонецЕсли;
			Возврат НовыйРезультатПоиска();
		КонецЕсли;
	КонецЕсли;
	Попытка
		ЕстьНаименование = МетаОбъект.ДлинаНаименования > 0;
	Исключение
		ЕстьНаименование = Ложь;
	КонецПопытки;
	Если ЕстьНаименование И ЗначениеЗаполнено(Ключи.Наименование) И Не ЗначениеЗаполнено(Ключи.Код) Тогда
		Возврат НайтиПоУсловиям(ИмяТипа, УсловиеРавенства("Наименование"), ПараметрыКлючей(Ключи, "Наименование"));
	КонецЕсли;
	Возврат НовыйРезультатПоиска();
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоУсловиям(ИмяТипа, Условие, Параметры)
	
	Части = РазделитьПолноеИмя(ИмяТипа);
	Если Части = Неопределено Или МетаданныеОбъекта(ИмяТипа) = Неопределено Тогда
		Возврат НовыйРезультатПоиска();
	КонецЕсли;
	НеГруппа = ТекстНеГруппа(МетаданныеОбъекта(ИмяТипа));
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	" + ИмяТипа + " КАК Таблица
	|ГДЕ
	|	ИСТИНА" + Условие + НеГруппа + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.ПометкаУдаления";
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Результат = НовыйРезультатПоиска();
	Если Таблица.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Таблица.Количество() = 1
		Или (Таблица[0].ПометкаУдаления = Ложь И Таблица[1].ПометкаУдаления = Истина) Тогда
		Результат.Статус = "Найден";
		Результат.Ссылка = Таблица[0].Ссылка;
		Возврат Результат;
	КонецЕсли;
	Результат.Статус = "Неоднозначно";
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиЗначениеПеречисления(ИмяТипа, ИмяЗначения)
	
	Части = РазделитьПолноеИмя(ИмяТипа);
	Если Части = Неопределено Или Части.Вид <> "Перечисление" Или Не ПроверитьИдентификатор(ИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаПеречисления = Метаданные.Перечисления.Найти(Части.Имя);
	Если МетаПеречисления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ЗначениеПеречисления Из МетаПеречисления.ЗначенияПеречисления Цикл
		Если ЗначениеПеречисления.Имя = ИмяЗначения Тогда
			Возврат Перечисления[Части.Имя][ИмяЗначения];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

