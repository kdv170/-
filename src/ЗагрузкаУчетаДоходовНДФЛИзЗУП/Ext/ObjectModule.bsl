
#Область ПрограммныйИнтерфейс

// Регистрация в подсистеме «Дополнительные отчеты и обработки» БСП.
// Безопасный режим выключен: чтение ЗУП идет через COM-соединение.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Загрузка учета доходов НДФЛ из ЗУП (COM)'");
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация = НСтр(
		"ru = 'Читает обороты регистра накопления «Учет доходов для исчисления НДФЛ» (СведенияОДоходахНДФЛ) из базы ЗУП через COM. На каждый месяц выбранного периода создает в ERP документ «Перенос данных» и записывает обороты с этим документом в качестве регистратора.'");
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Загрузка учета доходов НДФЛ из ЗУП'");
	Команда.Идентификатор = "ЗагрузкаУчетаДоходовНДФЛИзЗУП";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	Если ПараметрыРегистрации.Команды.Колонки.Найти("Модификатор") <> Неопределено Тогда
		Команда.Модификатор = "";
	КонецЕсли;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти
