Функция СоздатьФизическоеЛицо(СтрокаДанных)
	
	Если Метаданные.Справочники.Найти("ФизическиеЛица") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Наименование = СокрЛП(СтрокаДанных.ФизическоеЛицоНаименование);
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = СокрЛП(СтрШаблон("%1 %2 %3", СтрокаДанных.Фамилия, СтрокаДанных.Имя, СтрокаДанных.Отчество));
	КонецЕсли;
	
	ОбъектФизлица = Справочники.ФизическиеЛица.СоздатьЭлемент();
	ОбъектФизлица.Наименование = Наименование;
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "ФИО", Наименование);
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "ИНН", СокрЛП(СтрокаДанных.ФизическоеЛицоИНН));
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "СтраховойНомерПФР", СокрЛП(СтрокаДанных.ФизическоеЛицоСНИЛС));
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "ДатаРождения", СтрокаДанных.ДатаРождения);
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "Фамилия", СокрЛП(СтрокаДанных.Фамилия));
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "Имя", СокрЛП(СтрокаДанных.Имя));
	УстановитьРеквизитЕслиЕсть(ОбъектФизлица, "Отчество", СокрЛП(СтрокаДанных.Отчество));
	ОбъектФизлица.Записать();
	
	ЗаписатьФИОФизическогоЛица(ОбъектФизлица.Ссылка, СтрокаДанных);
	
	Возврат ОбъектФизлица.Ссылка;
	
КонецФункции

Процедура ЗаписатьФИОФизическогоЛица(ФизическоеЛицо, СтрокаДанных)
	
	Если Метаданные.РегистрыСведений.Найти("ФИОФизическихЛиц") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаДанных.Фамилия) И Не ЗначениеЗаполнено(СтрокаДанных.Имя) Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыСведений.ФИОФизическихЛиц.СоздатьНаборЗаписей();
	Набор.Отбор.ФизическоеЛицо.Установить(ФизическоеЛицо);
	Запись = Набор.Добавить();
	Запись.Период = ?(ЗначениеЗаполнено(СтрокаДанных.ДатаРождения), СтрокаДанных.ДатаРождения, Дата(1980, 1, 1));
	Запись.ФизическоеЛицо = ФизическоеЛицо;
	Запись.Фамилия = СокрЛП(СтрокаДанных.Фамилия);
	Запись.Имя = СокрЛП(СтрокаДанных.Имя);
	Запись.Отчество = СокрЛП(СтрокаДанных.Отчество);
	Набор.Записать();
	
КонецПроцедуры

Функция НайтиИлиСоздатьСотрудника(СтрокаДанных, ФизическоеЛицо, Организация, ПараметрыЗагрузки, Кэш)
	
	Если Метаданные.Справочники.Найти("Сотрудники") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ключ = Строка(ФизическоеЛицо) + "|" + СокрЛП(СтрокаДанных.СотрудникКод);
	Найденная = Кэш.Сотрудники.Получить(Ключ);
	Если Найденная <> Неопределено Тогда
		Возврат Найденная;
	КонецЕсли;
	
	Ссылка = НайтиПоУникальномуИдентификатору("Сотрудники", СтрокаДанных.СотрудникУИД);
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
		|	И НЕ Сотрудники.ПометкаУдаления
		|	И ВЫБОР
		|			КОГДА &Код = """"
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ Сотрудники.Код = &Код
		|		КОНЕЦ";
		Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
		Запрос.УстановитьПараметр("Код", СокрЛП(СтрокаДанных.СотрудникКод));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ссылка = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) И ПараметрыЗагрузки.СоздаватьСотрудников = Истина И ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		ОбъектСотрудника = Справочники.Сотрудники.СоздатьЭлемент();
		ОбъектСотрудника.Наименование = ?(ЗначениеЗаполнено(СтрокаДанных.СотрудникНаименование),
			СтрокаДанных.СотрудникНаименование, Строка(ФизическоеЛицо));
		Если ЗначениеЗаполнено(СтрокаДанных.СотрудникКод) Тогда
			ОбъектСотрудника.Код = СтрокаДанных.СотрудникКод;
		КонецЕсли;
		УстановитьРеквизитЕслиЕсть(ОбъектСотрудника, "ФизическоеЛицо", ФизическоеЛицо);
		УстановитьРеквизитЕслиЕсть(ОбъектСотрудника, "ГоловнаяОрганизация", Организация);
		ОбъектСотрудника.Записать();
		Ссылка = ОбъектСотрудника.Ссылка;
	КонецЕсли;
	
	Кэш.Сотрудники.Вставить(Ключ, Ссылка);
	Возврат Ссылка;
	
КонецФункции

