Функция СоздатьДокументПереноса(Группа, ПараметрыЗагрузки, Результат)
	
	Если Метаданные.Документы.Найти("ПереносДанных") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации отсутствует документ ПереносДанных. Невозможно записать движения регистра учета НДФЛ.'");
	КонецЕсли;
	
	Комментарий = КомментарийПереноса(Группа.Организация, Группа.Месяц, ПараметрыЗагрузки);
	
	Если ПараметрыЗагрузки.Перезаписывать = Истина Тогда
		УдалитьРанееЗагруженныеДокументы(Группа.Организация, Группа.Месяц, Комментарий, Результат);
	КонецЕсли;
	
	ДокументОбъект = Документы.ПереносДанных.СоздатьДокумент();
	ДокументОбъект.Дата = КонецМесяца(Группа.Месяц);
	УстановитьРеквизитЕслиЕсть(ДокументОбъект, "Организация", Группа.Организация);
	УстановитьРеквизитЕслиЕсть(ДокументОбъект, "ПериодРегистрации", Группа.Месяц);
	УстановитьРеквизитЕслиЕсть(ДокументОбъект, "Период", Группа.Месяц);
	УстановитьРеквизитЕслиЕсть(ДокументОбъект, "Комментарий", Комментарий);
	
	ТабличнаяЧастьРегистров = ДокументОбъект.Метаданные().ТабличныеЧасти.Найти("ТаблицаРегистров");
	Если ТабличнаяЧастьРегистров <> Неопределено Тогда
		СтрокаРегистра = ДокументОбъект.ТаблицаРегистров.Добавить();
		Если ТабличнаяЧастьРегистров.Реквизиты.Найти("Имя") <> Неопределено Тогда
			СтрокаРегистра.Имя = "СведенияОДоходахНДФЛ";
		ИначеЕсли ТабличнаяЧастьРегистров.Реквизиты.Найти("ИмяРегистра") <> Неопределено Тогда
			СтрокаРегистра.ИмяРегистра = "СведенияОДоходахНДФЛ";
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

Функция КомментарийПереноса(Организация, Месяц, ПараметрыЗагрузки)
	
	Возврат СтрШаблон(
		НСтр("ru = 'Загрузка учета данных для НДФЛ из ЗУП (COM). Организация: %1, месяц: %2, период: %3 - %4'"),
		Организация,
		Формат(Месяц, "ДФ='ММММ гггг'"),
		Формат(ПараметрыЗагрузки.ДатаНачала, "ДФ=dd.MM.yyyy"),
		Формат(ПараметрыЗагрузки.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
КонецФункции

Процедура УдалитьРанееЗагруженныеДокументы(Организация, Месяц, Комментарий, Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносДанных.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПереносДанных КАК ПереносДанных
	|ГДЕ
	|	ПереносДанных.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И ПереносДанных.Комментарий ПОДОБНО &Маска
	|	И НЕ ПереносДанных.ПометкаУдаления";
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Месяц));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Месяц));
	Запрос.УстановитьПараметр("Маска", "%Загрузка учета данных для НДФЛ из ЗУП (COM)%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если ЗначениеЗаполнено(Организация)
			И ДокументОбъект.Метаданные().Реквизиты.Найти("Организация") <> Неопределено
			И ДокументОбъект.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыНакопления.СведенияОДоходахНДФЛ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);
		НаборЗаписей.Записать();
		
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		ДобавитьВПротокол(Результат.Протокол, "Информация",
			СтрШаблон(НСтр("ru = 'Помечен на удаление ранее загруженный документ %1'"), Выборка.Ссылка));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗаписьРегистра(Запись, СтрокаДанных, Регистратор, ПоляРегистра)
	
	Запись.Регистратор = Регистратор;
	Запись.Активность = Истина;
	Запись.Период = ?(ЗначениеЗаполнено(СтрокаДанных.Период), СтрокаДанных.Период, СтрокаДанных.ДатаПолученияДохода);
	
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ФизическоеЛицо", СтрокаДанных.ФизическоеЛицо);
	ГоловнаяОрганизация = Неопределено;
	Если ЗначениеЗаполнено(СтрокаДанных.ОрганизацияЕРП) Тогда
		ГоловнаяОрганизация = ОбщегоНазначенияЗначениеРеквизита(СтрокаДанных.ОрганизацияЕРП, "ГоловнаяОрганизация", СтрокаДанных.ОрганизацияЕРП);
		Если Не ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
			ГоловнаяОрганизация = СтрокаДанных.ОрганизацияЕРП;
		КонецЕсли;
	КонецЕсли;
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ГоловнаяОрганизация", ГоловнаяОрганизация);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "Организация", СтрокаДанных.ОрганизацияЕРП);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "Сотрудник", СтрокаДанных.СотрудникЕРП);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "Подразделение", СтрокаДанных.ПодразделениеЕРП);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ПодразделениеСотрудника", СтрокаДанных.ПодразделениеЕРП);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "МесяцНалоговогоПериода", СтрокаДанных.МесяцНалоговогоПериода);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ДатаПолученияДохода", СтрокаДанных.ДатаПолученияДохода);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "КодДохода", СтрокаДанных.КодДоходаСсылка);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "КодВычета", СтрокаДанных.КодВычетаСсылка);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "КатегорияДохода", СтрокаДанных.КатегорияДоходаСсылка);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "РегистрацияВНалоговомОргане", СтрокаДанных.РегистрацияВНО);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "СуммаДохода", СтрокаДанных.СуммаДохода);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "СуммаВычета", СтрокаДанных.СуммаВычета);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ЗарегистрированоПриНачисленииАванса", СтрокаДанных.ЗарегистрированоПриНачисленииАванса);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ВключатьВДекларациюПоНалогуНаПрибыль", СтрокаДанных.ВключатьВДекларациюПоНалогуНаПрибыль);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ИсточникДоходаЗаПределамиРФ", СтрокаДанных.ИсточникДоходаЗаПределамиРФ);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ДоходМежрасчетногоПериода", СтрокаДанных.ДоходМежрасчетногоПериода);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "НеУчитыватьДоходВ6НДФЛ", СтрокаДанных.НеУчитыватьДоходВ6НДФЛ);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "ДатаПолученияДоходаФиксирована", Истина);
	УстановитьПолеЗаписи(Запись, ПоляРегистра, "Сторно", Ложь);
	
КонецПроцедуры

Процедура ПометитьДокументПроведенным(ДокументСсылка)
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.Проведен = Истина;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Функция ПоляРегистра(МетаданныеРегистра)
	
	Поля = Новый Соответствие;
	Поля.Вставить("Период", Истина);
	Поля.Вставить("Регистратор", Истина);
	Поля.Вставить("НомерСтроки", Истина);
	Поля.Вставить("Активность", Истина);
	
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Поля.Вставить(Измерение.Имя, Истина);
	КонецЦикла;
	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		Поля.Вставить(Ресурс.Имя, Истина);
	КонецЦикла;
	Для Каждого Реквизит Из МетаданныеРегистра.Реквизиты Цикл
		Поля.Вставить(Реквизит.Имя, Истина);
	КонецЦикла;
	
	Возврат Поля;
	
КонецФункции

Процедура УстановитьПолеЗаписи(Запись, ПоляРегистра, ИмяПоля, Значение)
	
	Если ПоляРегистра.Получить(ИмяПоля) <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запись[ИмяПоля] = Значение;
	
КонецПроцедуры

Процедура УстановитьРеквизитЕслиЕсть(Объект, ИмяРеквизита, Значение)
	
	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция НайтиПоУникальномуИдентификатору(ИмяСправочника, УИДСтрока)
	
	Если Не ЗначениеЗаполнено(УИДСтрока) Или Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		УИД = Новый УникальныйИдентификатор(СокрЛП(УИДСтрока));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(УИД);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Справочник." + ИмяСправочника + " КАК Спр ГДЕ Спр.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция НайтиСсылкуПоРеквизиту(ИмяСправочника, ИмяРеквизита, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ
	|	Спр." + ИмяРеквизита + " = &Значение
	|	И НЕ Спр.ПометкаУдаления";
	Запрос.УстановитьПараметр("Значение", Значение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НормализоватьСНИЛС(СНИЛС)
	
	Результат = "";
	Для Позиция = 1 По СтрДлина(СНИЛС) Цикл
		Символ = Сред(СНИЛС, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбщегоНазначенияЗначениеРеквизита(Ссылка, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Попытка
		Возврат Ссылка[ИмяРеквизита];
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

Процедура ДобавитьВПротокол(Протокол, Уровень, Текст)
	
	Запись = Новый Структура;
	Запись.Вставить("Время", ТекущаяДатаСеанса());
	Запись.Вставить("Уровень", Уровень);
	Запись.Вставить("Сообщение", Текст);
	Протокол.Добавить(Запись);
	
КонецПроцедуры

Процедура ДобавитьВПротоколКэша(Кэш, Уровень, Текст)
	
	Если Не Кэш.Свойство("Протокол") Тогда
		Кэш.Вставить("Протокол", Новый Массив);
	КонецЕсли;
	ДобавитьВПротокол(Кэш.Протокол, Уровень, Текст);
	
КонецПроцедуры

#КонецОбласти
