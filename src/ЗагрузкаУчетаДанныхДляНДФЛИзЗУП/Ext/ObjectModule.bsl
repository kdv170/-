Функция СгруппироватьПоОрганизацииИМесяцу(СтрокиКЗагрузке)
	
	ГруппыСоответствие = Новый Соответствие;
	Группы = Новый Массив;
	
	Для Каждого СтрокаДанных Из СтрокиКЗагрузке Цикл
		
		Месяц = НачалоМесяца(?(ЗначениеЗаполнено(СтрокаДанных.МесяцНалоговогоПериода),
			СтрокаДанных.МесяцНалоговогоПериода,
			СтрокаДанных.Период));
		Ключ = Строка(СтрокаДанных.ОрганизацияЕРП) + "|" + Формат(Месяц, "ДФ=yyyyMM");
		
		Группа = ГруппыСоответствие.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Организация", СтрокаДанных.ОрганизацияЕРП);
			Группа.Вставить("Месяц", Месяц);
			Группа.Вставить("Строки", Новый Массив);
			ГруппыСоответствие.Вставить(Ключ, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;
		
		Группа.Строки.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	Возврат Группы;
	
