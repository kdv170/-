#Область ПрограммныйИнтерфейс

// Возвращает сведения для регистрации обработки в справочнике дополнительных обработок БСП.
//
// Возвращаемое значение:
//  Структура - параметры регистрации дополнительной обработки.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = НовыйПараметрыРегистрации();
	ПараметрыРегистрации.Вид = "ДополнительнаяОбработка";
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Загрузка учета данных для НДФЛ из ЗУП (COM)'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Загружает данные регистра учета доходов для исчисления НДФЛ (СведенияОДоходахНДФЛ) из 1С:ЗУП в 1С:ERP через COM-соединение. Безопасный режим должен быть выключен.'");
	
	Попытка
		ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.7.200");
		ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
		ПараметрыРегистрации.Версия = ВерсияОбработки();
		ПараметрыРегистрации.БезопасныйРежим = Ложь;
		ПараметрыРегистрации.Наименование = НСтр("ru = 'Загрузка учета данных для НДФЛ из ЗУП (COM)'");
		ПараметрыРегистрации.Информация = НСтр("ru = 'Загружает данные регистра учета доходов для исчисления НДФЛ из 1С:ЗУП в 1С:ERP через COM-соединение. Безопасный режим должен быть выключен.'");
	Исключение
		// Конфигурация без БСП: обработка открывается через Файл — Открыть.
	КонецПопытки;
	
	Если ПараметрыРегистрации.Свойство("Команды") Тогда
		Команда = ПараметрыРегистрации.Команды.Добавить();
		Команда.Представление = ПараметрыРегистрации.Наименование;
		Команда.Идентификатор = "ОткрытьЗагрузкуНДФЛИзЗУП";
		Попытка
			Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
		Исключение
			Команда.Использование = "ОткрытиеФормы";
		КонецПопытки;
		Команда.ПоказыватьОповещение = Ложь;
	КонецЕсли;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Сопоставляет примитивные данные из ЗУП со ссылками ERP.
//
// Параметры:
//  ДанныеНДФЛ - ТаблицаЗначений - строки, прочитанные через COM;
//  ПараметрыЗагрузки - Структура - Организация, СоздаватьФизлиц, СоздаватьСотрудников.
//
// Возвращаемое значение:
//  Структура - КоличествоСопоставлено, КоличествоОшибок, Протокол.
//
Функция СопоставитьДанные(ДанныеНДФЛ, ПараметрыЗагрузки) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КоличествоСопоставлено", 0);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("Протокол", Новый Массив);
	
	Кэш = НовыйКэшСопоставления();
	
	Для Каждого СтрокаДанных Из ДанныеНДФЛ Цикл
		
		ОшибкиСтроки = Новый Массив;
		
		Организация = НайтиОрганизацию(СтрокаДанных, ПараметрыЗагрузки, Кэш);
		СтрокаДанных.ОрганизацияЕРП = Организация;
		Если Не ЗначениеЗаполнено(Организация) Тогда
			ОшибкиСтроки.Добавить(НСтр("ru = 'не найдена организация'"));
		КонецЕсли;
		
		ФизическоеЛицо = НайтиИлиСоздатьФизическоеЛицо(СтрокаДанных, ПараметрыЗагрузки, Кэш, ОшибкиСтроки);
		СтрокаДанных.ФизическоеЛицо = ФизическоеЛицо;
		
		Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
			Сотрудник = НайтиИлиСоздатьСотрудника(СтрокаДанных, ФизическоеЛицо, Организация, ПараметрыЗагрузки, Кэш);
			СтрокаДанных.СотрудникЕРП = Сотрудник;
		КонецЕсли;
		
		СтрокаДанных.ПодразделениеЕРП = НайтиПодразделение(СтрокаДанных, Организация, Кэш);
		СтрокаДанных.КодДоходаСсылка = НайтиКодДохода(СтрокаДанных.КодДохода, Кэш);
		СтрокаДанных.КодВычетаСсылка = НайтиКодВычета(СтрокаДанных.КодВычета, Кэш);
		СтрокаДанных.КатегорияДоходаСсылка = НайтиКатегориюДохода(СтрокаДанных.КатегорияДоходаПредставление, Кэш);
		СтрокаДанных.РегистрацияВНО = НайтиРегистрациюВНалоговомОргане(СтрокаДанных, Организация, Кэш);
		
		Если ЗначениеЗаполнено(СтрокаДанных.КодДохода) И Не ЗначениеЗаполнено(СтрокаДанных.КодДоходаСсылка) Тогда
			ОшибкиСтроки.Добавить(СтрШаблон(НСтр("ru = 'не найден код дохода %1'"), СтрокаДанных.КодДохода));
		КонецЕсли;
		
		Если ОшибкиСтроки.Количество() = 0 И ЗначениеЗаполнено(ФизическоеЛицо) Тогда
			СтрокаДанных.СтатусСопоставления = НСтр("ru = 'Сопоставлено'");
			Результат.КоличествоСопоставлено = Результат.КоличествоСопоставлено + 1;
		Иначе
			СтрокаДанных.СтатусСопоставления = НСтр("ru = 'Ошибка'");
			СтрокаДанных.ОписаниеОшибки = СтрСоединить(ОшибкиСтроки, "; ");
			Результат.КоличествоОшибок = Результат.КоличествоОшибок + 1;
			ДобавитьВПротокол(Результат.Протокол, "Предупреждение",
				СтрШаблон(НСтр("ru = '%1: %2'"), СтрокаДанных.ФизическоеЛицоНаименование, СтрокаДанных.ОписаниеОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Записывает сопоставленные строки в регистр СведенияОДоходахНДФЛ документа «Перенос данных».
//
// Параметры:
//  ДанныеНДФЛ - ТаблицаЗначений - сопоставленные строки;
//  ПараметрыЗагрузки - Структура - период, организация, признак перезаписи.
//
// Возвращаемое значение:
//  Структура - КоличествоЗаписано, КоличествоПропущено, ДокументыПереноса, Протокол.
//
Функция ЗагрузитьДанныеВERP(ДанныеНДФЛ, ПараметрыЗагрузки) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КоличествоЗаписано", 0);
	Результат.Вставить("КоличествоПропущено", 0);
	Результат.Вставить("ДокументыПереноса", Новый Массив);
	Результат.Вставить("Протокол", Новый Массив);
	
	Если Метаданные.РегистрыНакопления.Найти("СведенияОДоходахНДФЛ") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации ERP отсутствует регистр накопления СведенияОДоходахНДФЛ (учет доходов для исчисления НДФЛ). Включите подсистему зарплаты и кадров.'");
	КонецЕсли;
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления.СведенияОДоходахНДФЛ;
	ПоляРегистра = ПоляРегистра(МетаданныеРегистра);
	
	СтрокиКЗагрузке = Новый Массив;
	Для Каждого СтрокаДанных Из ДанныеНДФЛ Цикл
		Если СтрокаДанных.Пометка <> Истина Тогда
			Результат.КоличествоПропущено = Результат.КоличествоПропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицо) Тогда
			Результат.КоличествоПропущено = Результат.КоличествоПропущено + 1;
			ДобавитьВПротокол(Результат.Протокол, "Предупреждение",
				СтрШаблон(НСтр("ru = 'Пропущена строка %1: не сопоставлено физическое лицо'"), СтрокаДанных.ФизическоеЛицоНаименование));
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаДанных.ОрганизацияЕРП) Тогда
			Результат.КоличествоПропущено = Результат.КоличествоПропущено + 1;
			ДобавитьВПротокол(Результат.Протокол, "Предупреждение",
				СтрШаблон(НСтр("ru = 'Пропущена строка %1: не сопоставлена организация'"), СтрокаДанных.ФизическоеЛицоНаименование));
			Продолжить;
		КонецЕсли;
		СтрокиКЗагрузке.Добавить(СтрокаДанных);
	КонецЦикла;
	
	Группы = СгруппироватьПоОрганизацииИМесяцу(СтрокиКЗагрузке);
	
	Для Каждого Группа Из Группы Цикл
		
		ДокументПереноса = СоздатьДокументПереноса(Группа, ПараметрыЗагрузки, Результат);
		Если ДокументПереноса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыНакопления.СведенияОДоходахНДФЛ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДокументПереноса);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Для Каждого СтрокаДанных Из Группа.Строки Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗаписьРегистра(Запись, СтрокаДанных, ДокументПереноса, ПоляРегистра);
			Результат.КоличествоЗаписано = Результат.КоличествоЗаписано + 1;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
		ПометитьДокументПроведенным(ДокументПереноса);
		
		Результат.ДокументыПереноса.Добавить(ДокументПереноса);
		ДобавитьВПротокол(Результат.Протокол, "Информация",
			СтрШаблон(НСтр("ru = 'Записан документ %1, движений: %2'"), ДокументПереноса, Группа.Строки.Количество()));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ИНН выбранной организации ERP для отбора в ЗУП.
//
Функция ИННОрганизации(Организация) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(ОбщегоНазначенияЗначениеРеквизита(Организация, "ИНН"));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВерсияОбработки()
	
	Возврат "1.0.0";
	
КонецФункции

Функция НовыйПараметрыРегистрации()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Использование");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Модификатор");
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "");
	ПараметрыРегистрации.Вставить("Наименование", "");
	ПараметрыРегистрации.Вставить("Версия", "");
	ПараметрыРегистрации.Вставить("Информация", "");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Команды", Команды);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция НовыйКэшСопоставления()
	
	Кэш = Новый Структура;
	Кэш.Вставить("Организации", Новый Соответствие);
	Кэш.Вставить("ФизическиеЛица", Новый Соответствие);
	Кэш.Вставить("Сотрудники", Новый Соответствие);
	Кэш.Вставить("Подразделения", Новый Соответствие);
	Кэш.Вставить("КодыДохода", Новый Соответствие);
	Кэш.Вставить("КодыВычета", Новый Соответствие);
	Кэш.Вставить("КатегорииДохода", Новый Соответствие);
	Кэш.Вставить("РегистрацииВНО", Новый Соответствие);
	
	Возврат Кэш;
	
КонецФункции

Функция НайтиОрганизацию(СтрокаДанных, ПараметрыЗагрузки, Кэш)
	
	Если ЗначениеЗаполнено(ПараметрыЗагрузки.Организация) Тогда
		Возврат ПараметрыЗагрузки.Организация;
	КонецЕсли;
	
	Ключ = СокрЛП(СтрокаДанных.ОрганизацияИНН) + "|" + СокрЛП(СтрокаДанных.ОрганизацияКПП);
	Найденная = Кэш.Организации.Получить(Ключ);
	Если Найденная <> Неопределено Тогда
		Возврат Найденная;
	КонецЕсли;
	
	Ссылка = НайтиПоУникальномуИдентификатору("Организации", СтрокаДанных.ОрганизацияУИД);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = НайтиПоУникальномуИдентификатору("Организации", СтрокаДанных.ГоловнаяОрганизацияУИД);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(СтрокаДанных.ОрганизацияИНН) Тогда
		Ссылка = НайтиОрганизациюПоИННКПП(СтрокаДанных.ОрганизацияИНН, СтрокаДанных.ОрганизацияКПП);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(СтрокаДанных.ГоловнаяОрганизацияИНН) Тогда
		Ссылка = НайтиОрганизациюПоИННКПП(СтрокаДанных.ГоловнаяОрганизацияИНН, СтрокаДанных.ГоловнаяОрганизацияКПП);
	КонецЕсли;
	
	Кэш.Организации.Вставить(Ключ, Ссылка);
	Возврат Ссылка;
	
КонецФункции

Функция НайтиОрганизациюПоИННКПП(ИНН, КПП)
	
	Если Метаданные.Справочники.Найти("Организации") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|	И НЕ Организации.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &КПП = """"
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Организации.КПП = &КПП
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.КПП";
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("КПП", СокрЛП(КПП));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиИлиСоздатьФизическоеЛицо(СтрокаДанных, ПараметрыЗагрузки, Кэш, ОшибкиСтроки)
	
	Ключ = КлючФизлица(СтрокаДанных);
	Найденная = Кэш.ФизическиеЛица.Получить(Ключ);
	Если Найденная <> Неопределено Тогда
		Возврат Найденная;
	КонецЕсли;
	
	Ссылка = НайтиПоУникальномуИдентификатору("ФизическиеЛица", СтрокаДанных.ФизическоеЛицоУИД);
	
	Если Не ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицоИНН) Тогда
		Ссылка = НайтиСсылкуПоРеквизиту("ФизическиеЛица", "ИНН", СокрЛП(СтрокаДанных.ФизическоеЛицоИНН));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицоСНИЛС) Тогда
		Ссылка = НайтиФизическоеЛицоПоСНИЛС(СтрокаДанных.ФизическоеЛицоСНИЛС);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = НайтиФизическоеЛицоПоФИО(СтрокаДанных);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Если ПараметрыЗагрузки.СоздаватьФизлиц = Истина Тогда
			Ссылка = СоздатьФизическоеЛицо(СтрокаДанных);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				ДобавитьВПротоколКэша(Кэш, "Информация",
					СтрШаблон(НСтр("ru = 'Создано физическое лицо: %1'"), СтрокаДанных.ФизическоеЛицоНаименование));
			КонецЕсли;
		Иначе
			ОшибкиСтроки.Добавить(НСтр("ru = 'не найдено физическое лицо'"));
		КонецЕсли;
	КонецЕсли;
	
	Кэш.ФизическиеЛица.Вставить(Ключ, Ссылка);
	Возврат Ссылка;
	
КонецФункции

Функция КлючФизлица(СтрокаДанных)
	
	Если ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицоУИД) Тогда
		Возврат "UID:" + СтрокаДанных.ФизическоеЛицоУИД;
	ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицоИНН) Тогда
		Возврат "INN:" + СокрЛП(СтрокаДанных.ФизическоеЛицоИНН);
	ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицоСНИЛС) Тогда
		Возврат "SNILS:" + НормализоватьСНИЛС(СтрокаДанных.ФизическоеЛицоСНИЛС);
	КонецЕсли;
	
	Возврат "FIO:" + ВРег(СокрЛП(СтрокаДанных.ФизическоеЛицоНаименование)) + "|" + Формат(СтрокаДанных.ДатаРождения, "ДФ=yyyyMMdd");
	
КонецФункции

