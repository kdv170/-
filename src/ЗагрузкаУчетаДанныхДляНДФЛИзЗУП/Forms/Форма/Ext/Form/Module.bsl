////////////////////////////////////////////////////////////////////////////////
// Загрузка данных регистра "Учет данных для НДФЛ" из 1С:ЗУП в 1С:ERP
// через COM-соединение.
//
// Обработка подключается к информационной базе ЗУП через V83.COMConnector,
// читает записи регистра запросом и записывает их в одноименный регистр ERP.
// Ссылочные значения сопоставляются по идентификатору, затем по реквизитам
// (для физических лиц - СНИЛС, ИНН, ФИО + дата рождения; для организаций -
// ИНН + КПП и т.д.).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ФайловаяБаза = Истина;
	ВерсияКоннектора = "V83.COMConnector";
	СинонимРегистра = "Учет данных для НДФЛ";
	ТолькоПроверка = Истина;
	ПропускатьНесопоставленные = Истина;
	СоздаватьОтсутствующие = Ложь;

	ВосстановитьНастройки();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьВидимостьЭлементов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ФайловаяБазаПриИзменении(Элемент)

	УстановитьВидимостьЭлементов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	ПроверитьПодключениеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	Если ТолькоПроверка Тогда
		ЗагрузитьНаСервере();
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Данные регистра будут записаны в информационную базу. Продолжить?";
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ЗагрузитьЗавершение", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗагрузитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурнал(Команда)

	Журнал.Очистить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиент

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()

	Элементы.КаталогБазы.Видимость = ФайловаяБаза;
	Элементы.СерверПредприятия.Видимость = НЕ ФайловаяБаза;
	Элементы.ИмяБазы.Видимость = НЕ ФайловаяБаза;

КонецПроцедуры

#КонецОбласти

#Область Журнал

&НаСервере
Процедура Лог(Уровень, Текст)

	Если Журнал.Количество() >= 5000 Тогда
		Возврат;
	КонецЕсли;

	НоваяСтрока = Журнал.Добавить();
	НоваяСтрока.Время = ТекущаяДатаСеанса();
	НоваяСтрока.Уровень = Уровень;
	НоваяСтрока.Сообщение = Текст;

КонецПроцедуры

&НаСервере
Процедура ЛогОднократно(Контекст, Уровень, Текст)

	Если Контекст.ЖурналОднократно.Получить(Текст) = Неопределено Тогда
		Контекст.ЖурналОднократно.Вставить(Текст, Истина);
		Лог(Уровень, Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Настройки

&НаСервере
Функция ИменаСохраняемыхНастроек()

	Возврат "ФайловаяБаза,КаталогБазы,СерверПредприятия,ИмяБазы,Пользователь,ВерсияКоннектора,"
		+ "ИмяРегистраИсточника,ИмяРегистраПриемника,СинонимРегистра,ДополнительноеУсловие,"
		+ "ПропускатьНесопоставленные,СоздаватьОтсутствующие";

КонецФункции

&НаСервере
Процедура СохранитьНастройки()

	Настройки = Новый Структура(ИменаСохраняемыхНастроек());
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	ХранилищеОбщихНастроек.Сохранить("ЗагрузкаУчетаДанныхДляНДФЛИзЗУП", "Параметры", Настройки);

КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройки()

	Настройки = ХранилищеОбщихНастроек.Загрузить("ЗагрузкаУчетаДанныхДляНДФЛИзЗУП", "Параметры");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Подключение

&НаСервере
Функция НовыйКонтекст()

	Контекст = Новый Структура;
	Контекст.Вставить("Соединение", Неопределено);
	Контекст.Вставить("ТолькоПроверка", ТолькоПроверка);
	Контекст.Вставить("КэшСсылок", Новый Соответствие);
	Контекст.Вставить("КэшПоиска", Новый Соответствие);
	Контекст.Вставить("ЖурналОднократно", Новый Соответствие);
	Контекст.Вставить("Статистика", Новый Структура(
		"Прочитано, Подготовлено, Записано, Пропущено, Ошибок", 0, 0, 0, 0, 0));
	Возврат Контекст;

КонецФункции

&НаСервере
Функция СтрокаСоединения()

	Если ФайловаяБаза Тогда
		Результат = "File=""" + КаталогБазы + """;";
	Иначе
		Результат = "Srvr=""" + СерверПредприятия + """;Ref=""" + ИмяБазы + """;";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Пользователь) Тогда
		Результат = Результат + "Usr=""" + СтрЗаменить(Пользователь, """", """""") + """;";
	КонецЕсли;
	Если НЕ ПустаяСтрока(Пароль) Тогда
		Результат = Результат + "Pwd=""" + СтрЗаменить(Пароль, """", """""") + """;";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодключитьсяКИсточнику(Контекст)

	Если ФайловаяБаза И ПустаяСтрока(КаталогБазы) Тогда
		Лог("Ошибка", "Не указан каталог файловой базы ЗУП.");
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ФайловаяБаза И (ПустаяСтрока(СерверПредприятия) ИЛИ ПустаяСтрока(ИмяБазы)) Тогда
		Лог("Ошибка", "Не указаны сервер 1С:Предприятия и имя базы ЗУП.");
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Коннектор = Новый COMОбъект(ВерсияКоннектора);
	Исключение
		Лог("Ошибка", "Не удалось создать COM-объект " + ВерсияКоннектора + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ " Проверьте, что на компьютере (сервере 1С ERP) зарегистрирован COM-коннектор "
			+ "(comcntr.dll), а обработка открыта не в безопасном режиме.");
		Возврат Ложь;
	КонецПопытки;

	Попытка
		Контекст.Соединение = Коннектор.Connect(СтрокаСоединения());
	Исключение
		Лог("Ошибка", "Не удалось подключиться к базе ЗУП: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Попытка
		Лог("Информация", "Подключено к конфигурации: " + Контекст.Соединение.Метаданные.Синоним
			+ ", версия " + Контекст.Соединение.Метаданные.Версия);
	Исключение
		Лог("Информация", "Подключение к базе ЗУП выполнено.");
	КонецПопытки;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ПоискРегистров

&НаСервере
Функция НормализоватьСтроку(Знач Текст)

	Текст = НРег(Текст);
	Текст = СтрЗаменить(Текст, "ё", "е");
	Текст = СтрЗаменить(Текст, " ", "");
	Возврат Текст;

КонецФункции

&НаСервере
Функция ОписаниеРегистра(МД)

	ПолноеИмя = МД.ПолноеИмя();

	Результат = Новый Структура("МД, ПолноеИмя, Имя, Вид, Синоним");
	Результат.МД = МД;
	Результат.ПолноеИмя = ПолноеИмя;
	Результат.Имя = МД.Имя;
	Результат.Синоним = МД.Синоним;
	Результат.Вид = Лев(ПолноеИмя, Найти(ПолноеИмя, ".") - 1);
	Возврат Результат;

КонецФункции

// Ищет регистр сведений или накопления по имени либо по синониму.
//
// Параметры:
//  МДКорень - Метаданные - корень метаданных (локальных или внешнего соединения);
//  ЗаданноеИмя - Строка - имя регистра или полное имя; если пусто - поиск по синониму;
//  Синоним - Строка - синоним регистра для поиска.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание найденного регистра.
&НаСервере
Функция НайтиРегистр(МДКорень, Знач ЗаданноеИмя, Синоним)

	Если НЕ ПустаяСтрока(ЗаданноеИмя) Тогда
		Кандидаты = Новый Массив;
		Если Найти(ЗаданноеИмя, ".") > 0 Тогда
			Кандидаты.Добавить(ЗаданноеИмя);
		Иначе
			Кандидаты.Добавить("РегистрСведений." + ЗаданноеИмя);
			Кандидаты.Добавить("РегистрНакопления." + ЗаданноеИмя);
		КонецЕсли;

		Для Каждого Кандидат Из Кандидаты Цикл
			МД = МДКорень.НайтиПоПолномуИмени(Кандидат);
			Если МД <> Неопределено Тогда
				Возврат ОписаниеРегистра(МД);
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;

	Цель = НормализоватьСтроку(Синоним);

	Коллекции = Новый Массив;
	Коллекции.Добавить(МДКорень.РегистрыСведений);
	Коллекции.Добавить(МДКорень.РегистрыНакопления);

	Похожие = Новый Массив;
	Для Каждого Колл Из Коллекции Цикл
		Для Каждого МД Из Колл Цикл
			ИмяНорм = НормализоватьСтроку(МД.Имя);
			СинонимНорм = НормализоватьСтроку(МД.Синоним);
			Если ИмяНорм = Цель ИЛИ СинонимНорм = Цель Тогда
				Возврат ОписаниеРегистра(МД);
			КонецЕсли;
			Если Найти(ИмяНорм, "ндфл") > 0 ИЛИ Найти(СинонимНорм, "ндфл") > 0 Тогда
				Похожие.Добавить(МД.ПолноеИмя() + " (" + МД.Синоним + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Похожие.Количество() > 0 Тогда
		Лог("Предупреждение", "Регистр с синонимом """ + Синоним + """ не найден. Найдены похожие регистры: "
			+ СтрСоединить(Похожие, "; ") + ". Укажите нужный в поле имени регистра.");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция НайтиРегистрПриемника(Источник)

	Если ПустаяСтрока(ИмяРегистраПриемника) Тогда
		Результат = НайтиРегистр(Метаданные, Источник.ПолноеИмя, СинонимРегистра);
		Если Результат = Неопределено Тогда
			Результат = НайтиРегистр(Метаданные, "", СинонимРегистра);
		КонецЕсли;
	Иначе
		Результат = НайтиРегистр(Метаданные, ИмяРегистраПриемника, СинонимРегистра);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ОписатьРегистр(Метка, Регистр)

	МД = Регистр.МД;
	Лог("Информация", Метка + ": " + Регистр.ПолноеИмя + " (" + Регистр.Синоним + ")");

	Коллекции = Новый Структура;
	Коллекции.Вставить("Измерения", МД.Измерения);
	Коллекции.Вставить("Ресурсы", МД.Ресурсы);
	Коллекции.Вставить("Реквизиты", МД.Реквизиты);

	Для Каждого Коллекция Из Коллекции Цикл
		Список = Новый Массив;
		Для Каждого Элемент Из Коллекция.Значение Цикл
			Список.Добавить(Элемент.Имя);
		КонецЦикла;
		Лог("Информация", "    " + Коллекция.Ключ + ": " + ?(Список.Количество() = 0, "-", СтрСоединить(Список, ", ")));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ДанныеИсточника

&НаСервере
Функция ИменаКолонокCOM(ТаблицаCOM)

	Имена = Новый Массив;
	Колонки = ТаблицаCOM.Колонки;
	Для Инд = 0 По Колонки.Количество() - 1 Цикл
		Имена.Добавить(Колонки.Получить(Инд).Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

&НаСервере
Функция ТаблицаИзCOM(ТаблицаCOM)

	Имена = ИменаКолонокCOM(ТаблицаCOM);

	Результат = Новый ТаблицаЗначений;
	Для Каждого Имя Из Имена Цикл
		Результат.Колонки.Добавить(Имя);
	КонецЦикла;

	КоличествоКолонок = Имена.Количество();
	Для ИндСтроки = 0 По ТаблицаCOM.Количество() - 1 Цикл
		СтрокаCOM = ТаблицаCOM.Получить(ИндСтроки);
		НоваяСтрока = Результат.Добавить();
		Для ИндКолонки = 0 По КоличествоКолонок - 1 Цикл
			НоваяСтрока[Имена[ИндКолонки]] = СтрокаCOM.Получить(ИндКолонки);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПрочитатьРегистрИсточника(Контекст, Источник)

	Соед = Контекст.Соединение;

	Запрос = Соед.NewObject("Запрос");
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ " + Источник.ПолноеИмя + " КАК Т";
	ИменаКолонок = ИменаКолонокCOM(Запрос.Выполнить().Выгрузить());

	Условия = Новый Массив;
	Запрос = Соед.NewObject("Запрос");

	Если ИменаКолонок.Найти("Период") <> Неопределено Тогда
		Если ЗначениеЗаполнено(ПериодС) Тогда
			Условия.Добавить("Т.Период >= &ПериодС");
			Запрос.УстановитьПараметр("ПериодС", НачалоДня(ПериодС));
		КонецЕсли;
		Если ЗначениеЗаполнено(ПериодПо) Тогда
			Условия.Добавить("Т.Период <= &ПериодПо");
			Запрос.УстановитьПараметр("ПериодПо", КонецДня(ПериодПо));
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ПериодС) ИЛИ ЗначениеЗаполнено(ПериодПо) Тогда
		Лог("Предупреждение", "Регистр непериодический, отбор по периоду не применяется.");
	КонецЕсли;

	Если НЕ ПустаяСтрока(ДополнительноеУсловие) Тогда
		Условия.Добавить("(" + ДополнительноеУсловие + ")");
	КонецЕсли;

	Текст = "ВЫБРАТЬ * ИЗ " + Источник.ПолноеИмя + " КАК Т";
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + " ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	Запрос.Текст = Текст;

	Возврат ТаблицаИзCOM(Запрос.Выполнить().Выгрузить());

КонецФункции

#КонецОбласти

#Область СвойстваПриемника

// Возвращает свойства регистра приемника, необходимые для записи данных.
&НаСервере
Функция СвойстваПриемника(Приемник)

	МД = Приемник.МД;

	Поля = Новый Соответствие;
	Измерения = Новый Массив;

	Для Каждого Элемент Из МД.Измерения Цикл
		Поля.Вставить(Элемент.Имя, "Измерение");
		Измерения.Добавить(Элемент.Имя);
	КонецЦикла;
	Для Каждого Элемент Из МД.Ресурсы Цикл
		Поля.Вставить(Элемент.Имя, "Ресурс");
	КонецЦикла;
	Для Каждого Элемент Из МД.Реквизиты Цикл
		Поля.Вставить(Элемент.Имя, "Реквизит");
	КонецЦикла;

	Если Приемник.Вид = "РегистрНакопления" Тогда
		ЕстьПериод = Истина;
		ЕстьРегистратор = Истина;
		Поля.Вставить("ВидДвижения", "Стандартное");
	Иначе
		ЕстьПериод = (МД.Периодичность <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
		ЕстьРегистратор = (МД.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору);
	КонецЕсли;

	Если ЕстьПериод Тогда
		Поля.Вставить("Период", "Стандартное");
	КонецЕсли;
	Если ЕстьРегистратор Тогда
		Поля.Вставить("Активность", "Стандартное");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Поля", Поля);
	Результат.Вставить("Измерения", Измерения);
	Результат.Вставить("ЕстьПериод", ЕстьПериод);
	Результат.Вставить("ЕстьРегистратор", ЕстьРегистратор);
	Возврат Результат;

КонецФункции

&НаСервере
Функция МенеджерРегистра(Регистр)

	Если Регистр.Вид = "РегистрНакопления" Тогда
		Возврат РегистрыНакопления[Регистр.Имя];
	КонецЕсли;
	Возврат РегистрыСведений[Регистр.Имя];

КонецФункции

#КонецОбласти

#Область СопоставлениеЗначений

&НаСервере
Функция ИмяТипаСсылки(Вид, ИмяОбъекта)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Справочник", "СправочникСсылка");
	Соответствие.Вставить("Документ", "ДокументСсылка");
	Соответствие.Вставить("Перечисление", "ПеречислениеСсылка");
	Соответствие.Вставить("ПланВидовХарактеристик", "ПланВидовХарактеристикСсылка");
	Соответствие.Вставить("ПланСчетов", "ПланСчетовСсылка");
	Соответствие.Вставить("ПланВидовРасчета", "ПланВидовРасчетаСсылка");
	Соответствие.Вставить("ПланОбмена", "ПланОбменаСсылка");

	Префикс = Соответствие.Получить(Вид);
	Если Префикс = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Префикс + "." + ИмяОбъекта;

КонецФункции

// Преобразует значение, полученное из ЗУП по COM, в значение для ERP.
// Примитивные значения передаются как есть, ссылки сопоставляются.
&НаСервере
Функция ПреобразоватьЗначение(Контекст, Значение, ИмяПоля, Успех)

	Успех = Истина;

	Если ТипЗнч(Значение) <> Тип("COMОбъект") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ИмяПоля = "ВидДвижения" Тогда
		Если Контекст.Соединение.XMLСтрока(Значение) = "Receipt" Тогда
			Возврат ВидДвиженияНакопления.Приход;
		КонецЕсли;
		Возврат ВидДвиженияНакопления.Расход;
	КонецЕсли;

	Возврат СопоставитьСсылку(Контекст, Значение, Успех);

КонецФункции

&НаСервере
Функция СопоставитьСсылку(Контекст, СсылкаИст, Успех)

	Соед = Контекст.Соединение;
	Успех = Истина;

	Попытка
		МДИст = СсылкаИст.Метаданные();
		ПолноеИмя = МДИст.ПолноеИмя();
	Исключение
		Попытка
			Возврат Новый УникальныйИдентификатор(Соед.XMLСтрока(СсылкаИст));
		Исключение
			Успех = Ложь;
			ЛогОднократно(Контекст, "Ошибка", "Значение неподдерживаемого типа получено из ЗУП и не будет загружено.");
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;

	Идентификатор = Соед.XMLСтрока(СсылкаИст);
	Ключ = ПолноеИмя + "|" + Идентификатор;

	Кэш = Контекст.КэшСсылок.Получить(Ключ);
	Если Кэш <> Неопределено Тогда
		Успех = Кэш.Успех;
		Возврат Кэш.Значение;
	КонецЕсли;

	Значение = НайтиСсылкуПриемника(Контекст, СсылкаИст, МДИст, ПолноеИмя, Идентификатор, Успех);
	Контекст.КэшСсылок.Вставить(Ключ, Новый Структура("Успех, Значение", Успех, Значение));

	Возврат Значение;

КонецФункции

&НаСервере
Функция НайтиСсылкуПриемника(Контекст, СсылкаИст, МДИст, ПолноеИмя, Идентификатор, Успех)

	Успех = Истина;

	Вид = Лев(ПолноеИмя, Найти(ПолноеИмя, ".") - 1);
	ИмяОбъекта = Сред(ПолноеИмя, Найти(ПолноеИмя, ".") + 1);

	ИмяТипа = ИмяТипаСсылки(Вид, ИмяОбъекта);
	Если ИмяТипа = Неопределено Тогда
		Успех = Ложь;
		ЛогОднократно(Контекст, "Ошибка", "Сопоставление ссылок вида """ + Вид + """ не поддерживается (" + ПолноеИмя + ").");
		Возврат Неопределено;
	КонецЕсли;

	МДПриемника = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МДПриемника = Неопределено Тогда
		Успех = Ложь;
		ЛогОднократно(Контекст, "Ошибка", "В информационной базе ERP нет объекта метаданных " + ПолноеИмя + ".");
		Возврат Неопределено;
	КонецЕсли;

	Если СсылкаИст.Пустая() Тогда
		Возврат Новый ОписаниеТипов(ИмяТипа).ПривестиЗначение(Неопределено);
	КонецЕсли;

	Если Вид = "Перечисление" Тогда
		Попытка
			Возврат XMLЗначение(Тип(ИмяТипа), Идентификатор);
		Исключение
			Успех = Ложь;
			ЛогОднократно(Контекст, "Ошибка", "В перечислении " + ПолноеИмя + " нет значения """ + Идентификатор + """.");
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	// 1. Совпадение по уникальному идентификатору.
	Попытка
		ПоИдентификатору = XMLЗначение(Тип(ИмяТипа), Идентификатор);
		Если СсылкаСуществует(ПолноеИмя, ПоИдентификатору) Тогда
			Возврат ПоИдентификатору;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Поиск по реквизитам.
	Описание = ОписаниеПоиска(Контекст, Вид, ИмяОбъекта, МДИст, МДПриемника);
	Данные = Новый Структура;
	Если Описание.Поля.Количество() > 0 Тогда
		Попытка
			Данные = ДанныеОбъектаИсточника(Контекст, СсылкаИст, ПолноеИмя, Описание.Поля);
		Исключение
			ЛогОднократно(Контекст, "Предупреждение", "Не удалось прочитать реквизиты " + ПолноеИмя + " из ЗУП: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Для Каждого Комбинация Из Описание.Комбинации Цикл
		Найденные = НайтиВПриемникеПоКомбинации(ПолноеИмя, Комбинация, Данные);
		Если Найденные.Количество() = 1 Тогда
			Возврат Найденные[0];
		ИначеЕсли Найденные.Количество() > 1 Тогда
			Лог("Предупреждение", "Неоднозначное соответствие для " + ПредставлениеДанных(ПолноеИмя, Данные)
				+ " (поиск по: " + СтрСоединить(Комбинация, ", ") + "). Выбран первый найденный элемент.");
			Возврат Найденные[0];
		КонецЕсли;
	КонецЦикла;

	// 3. Создание отсутствующего элемента.
	Если СоздаватьОтсутствующие И Вид = "Справочник" Тогда
		Возврат СоздатьЭлементПриемника(Контекст, ИмяОбъекта, Идентификатор, Данные, Успех);
	КонецЕсли;

	Успех = Ложь;
	Лог("Предупреждение", "В ERP не найден соответствующий элемент: " + ПредставлениеДанных(ПолноеИмя, Данные));
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПредставлениеДанных(ПолноеИмя, Данные)

	Части = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			Части.Добавить(Элемент.Ключ + "=" + Строка(Элемент.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат ПолноеИмя + ?(Части.Количество() > 0, " [" + СтрСоединить(Части, "; ") + "]", "");

КонецФункции

&НаСервере
Функция СсылкаСуществует(ПолноеИмя, Ссылка)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

&НаСервере
Функция ЕстьПоле(МД, Вид, Имя)

	Попытка
		Если Имя = "ИмяПредопределенныхДанных" Тогда
			Возврат Вид <> "Документ" И Вид <> "ПланОбмена";
		ИначеЕсли Имя = "Код" Тогда
			Возврат Вид <> "Документ" И МД.ДлинаКода > 0;
		ИначеЕсли Имя = "Наименование" Тогда
			Возврат Вид <> "Документ" И МД.ДлинаНаименования > 0;
		ИначеЕсли Имя = "Номер" ИЛИ Имя = "Дата" Тогда
			Возврат Вид = "Документ";
		КонецЕсли;
		Возврат МД.Реквизиты.Найти(Имя) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Список комбинаций реквизитов, по которым элемент ищется в приемнике (в порядке приоритета).
&НаСервере
Функция КомбинацииПоиска(Вид, ИмяОбъекта)

	Комбинации = Новый Массив;

	Если Вид = "Документ" Тогда
		Комбинации.Добавить(СтрРазделить("Номер,Дата", ","));
		Возврат Комбинации;
	КонецЕсли;

	Комбинации.Добавить(СтрРазделить("ИмяПредопределенныхДанных", ","));

	Если ИмяОбъекта = "ФизическиеЛица" Тогда
		Комбинации.Добавить(СтрРазделить("СНИЛС", ","));
		Комбинации.Добавить(СтрРазделить("ИНН", ","));
		Комбинации.Добавить(СтрРазделить("Наименование,ДатаРождения", ","));
	ИначеЕсли ИмяОбъекта = "Организации" Тогда
		Комбинации.Добавить(СтрРазделить("ИНН,КПП", ","));
		Комбинации.Добавить(СтрРазделить("ИНН", ","));
		Комбинации.Добавить(СтрРазделить("Наименование", ","));
	ИначеЕсли ИмяОбъекта = "Контрагенты" Тогда
		Комбинации.Добавить(СтрРазделить("ИНН,КПП,Наименование", ","));
		Комбинации.Добавить(СтрРазделить("Наименование", ","));
	Иначе
		Комбинации.Добавить(СтрРазделить("Код,Наименование", ","));
		Комбинации.Добавить(СтрРазделить("Наименование", ","));
		Комбинации.Добавить(СтрРазделить("Код", ","));
	КонецЕсли;

	Возврат Комбинации;

КонецФункции

// Оставляет только те комбинации поиска, поля которых есть и в источнике, и в приемнике.
&НаСервере
Функция ОписаниеПоиска(Контекст, Вид, ИмяОбъекта, МДИст, МДПриемника)

	Ключ = Вид + "." + ИмяОбъекта;
	Описание = Контекст.КэшПоиска.Получить(Ключ);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	Комбинации = Новый Массив;
	Поля = Новый Массив;

	Для Каждого Комбинация Из КомбинацииПоиска(Вид, ИмяОбъекта) Цикл
		Доступна = Истина;
		Для Каждого Поле Из Комбинация Цикл
			Если НЕ ЕстьПоле(МДИст, Вид, Поле) ИЛИ НЕ ЕстьПоле(МДПриемника, Вид, Поле) Тогда
				Доступна = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Доступна Тогда
			Комбинации.Добавить(Комбинация);
			Для Каждого Поле Из Комбинация Цикл
				Если Поля.Найти(Поле) = Неопределено Тогда
					Поля.Добавить(Поле);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Описание = Новый Структура("Комбинации, Поля", Комбинации, Поля);
	Контекст.КэшПоиска.Вставить(Ключ, Описание);
	Возврат Описание;

КонецФункции

&НаСервере
Функция ДанныеОбъектаИсточника(Контекст, Ссылка, ПолноеИмя, Поля)

	Выбираемые = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Выбираемые.Добавить("Т." + Поле + " КАК " + Поле);
	КонецЦикла;

	Запрос = Контекст.Соединение.NewObject("Запрос");
	Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(Выбираемые, ", ") + " ИЗ " + ПолноеИмя
		+ " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Таблица = ТаблицаИзCOM(Запрос.Выполнить().Выгрузить());

	Результат = Новый Структура;
	Если Таблица.Количество() > 0 Тогда
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = Таблица[0][Колонка.Имя];
			Если ТипЗнч(Значение) <> Тип("COMОбъект") Тогда
				Результат.Вставить(Колонка.Имя, Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Функция НайтиВПриемникеПоКомбинации(ПолноеИмя, Комбинация, Данные)

	Найденные = Новый Массив;

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Инд = 0;
	Для Каждого Поле Из Комбинация Цикл
		Значение = Неопределено;
		Если НЕ Данные.Свойство(Поле, Значение) ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат Найденные;
		КонецЕсли;
		Условия.Добавить("Т." + Поле + " = &П" + Инд);
		Запрос.УстановитьПараметр("П" + Инд, Значение);
		Инд = Инд + 1;
	КонецЦикла;

	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ "
		+ СтрСоединить(Условия, " И ");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Найденные;

КонецФункции

&НаСервере
Функция СоздатьЭлементПриемника(Контекст, ИмяОбъекта, Идентификатор, Данные, Успех)

	Успех = Истина;

	Менеджер = Справочники[ИмяОбъекта];
	НовыйИдентификатор = Новый УникальныйИдентификатор(Идентификатор);
	НоваяСсылка = Менеджер.ПолучитьСсылку(НовыйИдентификатор);

	Если Контекст.ТолькоПроверка Тогда
		Лог("Информация", "[Проверка] Будет создан элемент справочника " + ИмяОбъекта + ": "
			+ ПредставлениеДанных("", Данные));
		Возврат НоваяСсылка;
	КонецЕсли;

	Попытка
		НовыйЭлемент = Менеджер.СоздатьЭлемент();
		НовыйЭлемент.УстановитьСсылкуНового(НоваяСсылка);
		Для Каждого Элемент Из Данные Цикл
			Если Элемент.Ключ <> "ИмяПредопределенныхДанных" И ЗначениеЗаполнено(Элемент.Значение) Тогда
				НовыйЭлемент[Элемент.Ключ] = Элемент.Значение;
			КонецЕсли;
		КонецЦикла;
		НовыйЭлемент.Записать();
		Лог("Информация", "Создан элемент справочника " + ИмяОбъекта + ": " + ПредставлениеДанных("", Данные));
		Возврат НовыйЭлемент.Ссылка;
	Исключение
		Успех = Ложь;
		Лог("Ошибка", "Не удалось создать элемент справочника " + ИмяОбъекта + " ("
			+ ПредставлениеДанных("", Данные) + "): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Загрузка

&НаСервере
Процедура ПроверитьПодключениеНаСервере()

	Журнал.Очистить();
	СохранитьНастройки();

	Контекст = НовыйКонтекст();
	Если НЕ ПодключитьсяКИсточнику(Контекст) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Источник = НайтиРегистр(Контекст.Соединение.Метаданные, ИмяРегистраИсточника, СинонимРегистра);
		Если Источник = Неопределено Тогда
			Лог("Ошибка", "Регистр-источник в базе ЗУП не найден.");
		Иначе
			ОписатьРегистр("Источник (ЗУП)", Источник);

			Приемник = НайтиРегистрПриемника(Источник);
			Если Приемник = Неопределено Тогда
				Лог("Ошибка", "Регистр-приемник в базе ERP не найден.");
			Иначе
				ОписатьРегистр("Приемник (ERP)", Приемник);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Лог("Ошибка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Контекст.Соединение = Неопределено;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()

	Журнал.Очистить();
	СохранитьНастройки();

	Контекст = НовыйКонтекст();
	Если НЕ ПодключитьсяКИсточнику(Контекст) Тогда
		Возврат;
	КонецЕсли;

	Лог("Информация", ?(ТолькоПроверка,
		"Режим проверки: данные в ERP записываться не будут.",
		"Режим загрузки: данные будут записаны в ERP."));

	Попытка
		ВыполнитьЗагрузку(Контекст);
	Исключение
		Лог("Ошибка", "Загрузка прервана: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Контекст.Соединение = Неопределено;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗагрузку(Контекст)

	Источник = НайтиРегистр(Контекст.Соединение.Метаданные, ИмяРегистраИсточника, СинонимРегистра);
	Если Источник = Неопределено Тогда
		Лог("Ошибка", "Регистр-источник в базе ЗУП не найден.");
		Возврат;
	КонецЕсли;

	Приемник = НайтиРегистрПриемника(Источник);
	Если Приемник = Неопределено Тогда
		Лог("Ошибка", "Регистр-приемник в базе ERP не найден.");
		Возврат;
	КонецЕсли;

	Если Источник.Вид <> Приемник.Вид Тогда
		Лог("Ошибка", "Виды регистров не совпадают: " + Источник.ПолноеИмя + " и " + Приемник.ПолноеИмя + ".");
		Возврат;
	КонецЕсли;

	Лог("Информация", "Источник: " + Источник.ПолноеИмя + ". Приемник: " + Приемник.ПолноеИмя + ".");

	Св = СвойстваПриемника(Приемник);

	ТаблицаИст = ПрочитатьРегистрИсточника(Контекст, Источник);
	Лог("Информация", "Прочитано записей из ЗУП: " + ТаблицаИст.Количество() + ".");
	Если ТаблицаИст.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИменаКолонокИст = Новый Массив;
	Для Каждого Колонка Из ТаблицаИст.Колонки Цикл
		ИменаКолонокИст.Добавить(Колонка.Имя);
	КонецЦикла;

	Если НЕ Св.ЕстьРегистратор Тогда
		Для Каждого ИмяИзмерения Из Св.Измерения Цикл
			Если ИменаКолонокИст.Найти(ИмяИзмерения) = Неопределено Тогда
				Лог("Ошибка", "В регистре-источнике нет измерения """ + ИмяИзмерения
					+ """, которое есть в приемнике. Загрузка отменена, чтобы не перезаписать лишние данные.");
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Если Св.ЕстьПериод И ИменаКолонокИст.Найти("Период") = Неопределено Тогда
			Лог("Ошибка", "В регистре-источнике нет периода, а регистр-приемник периодический.");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Для Каждого ИмяКолонки Из ИменаКолонокИст Цикл
		Если ИмяКолонки = "Регистратор" ИЛИ ИмяКолонки = "НомерСтроки" Тогда
			Продолжить;
		КонецЕсли;
		Если Св.Поля.Получить(ИмяКолонки) = Неопределено Тогда
			Лог("Предупреждение", "Поле """ + ИмяКолонки + """ есть в ЗУП, но отсутствует в приемнике. Не загружается.");
		КонецЕсли;
	КонецЦикла;

	Статистика = Контекст.Статистика;
	ЗаписиБезРегистратора = Новый Массив;
	ГруппыРегистраторов = Новый Соответствие;
	ПорядокГрупп = Новый Массив;

	Для Каждого СтрокаИст Из ТаблицаИст Цикл
		Статистика.Прочитано = Статистика.Прочитано + 1;

		Запись = Новый Структура;
		Регистратор = Неопределено;
		Пропустить = Ложь;
		Успех = Истина;

		Для Каждого ИмяКолонки Из ИменаКолонокИст Цикл
			Если ИмяКолонки = "НомерСтроки" Тогда
				Продолжить;
			КонецЕсли;

			Если ИмяКолонки = "Регистратор" Тогда
				Если Св.ЕстьРегистратор Тогда
					Регистратор = ПреобразоватьЗначение(Контекст, СтрокаИст[ИмяКолонки], ИмяКолонки, Успех);
					Если НЕ Успех ИЛИ НЕ ЗначениеЗаполнено(Регистратор) Тогда
						Пропустить = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Если Св.Поля.Получить(ИмяКолонки) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Значение = ПреобразоватьЗначение(Контекст, СтрокаИст[ИмяКолонки], ИмяКолонки, Успех);
			Если НЕ Успех Тогда
				Если ПропускатьНесопоставленные Тогда
					Пропустить = Истина;
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Запись.Вставить(ИмяКолонки, Значение);
		КонецЦикла;

		Если Пропустить Тогда
			Статистика.Пропущено = Статистика.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Статистика.Подготовлено = Статистика.Подготовлено + 1;

		Если Св.ЕстьРегистратор Тогда
			КлючГруппы = Строка(Регистратор.УникальныйИдентификатор());
			Группа = ГруппыРегистраторов.Получить(КлючГруппы);
			Если Группа = Неопределено Тогда
				Группа = Новый Структура("Регистратор, Записи", Регистратор, Новый Массив);
				ГруппыРегистраторов.Вставить(КлючГруппы, Группа);
				ПорядокГрупп.Добавить(КлючГруппы);
			КонецЕсли;
			Группа.Записи.Добавить(Запись);
		Иначе
			ЗаписиБезРегистратора.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Если Контекст.ТолькоПроверка Тогда
		Лог("Информация", "[Проверка] К записи подготовлено записей: " + Статистика.Подготовлено + ".");
	ИначеЕсли Св.ЕстьРегистратор Тогда
		Лог("Предупреждение", "Регистр подчинен регистратору: движения найденных в ERP документов-регистраторов "
			+ "будут полностью заменены данными из ЗУП.");
		ЗаписатьПоРегистраторам(Контекст, Приемник, ГруппыРегистраторов, ПорядокГрупп);
	Иначе
		ЗаписатьБезРегистратора(Контекст, Приемник, Св, ЗаписиБезРегистратора);
	КонецЕсли;

	Лог("Информация", "Итого: прочитано " + Статистика.Прочитано
		+ ", подготовлено " + Статистика.Подготовлено
		+ ", пропущено (не сопоставлены ссылки) " + Статистика.Пропущено
		+ ", записано " + Статистика.Записано
		+ ", ошибок записи " + Статистика.Ошибок + ".");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьБезРегистратора(Контекст, Приемник, Св, Записи)

	Статистика = Контекст.Статистика;
	Менеджер = МенеджерРегистра(Приемник);

	Для Каждого Запись Из Записи Цикл
		Попытка
			Набор = Менеджер.СоздатьНаборЗаписей();
			Для Каждого ИмяИзмерения Из Св.Измерения Цикл
				Набор.Отбор[ИмяИзмерения].Установить(Запись[ИмяИзмерения]);
			КонецЦикла;
			Если Св.ЕстьПериод Тогда
				Набор.Отбор.Период.Установить(Запись.Период);
			КонецЕсли;

			НоваяЗапись = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись);
			Набор.Записать(Истина);

			Статистика.Записано = Статистика.Записано + 1;
		Исключение
			Статистика.Ошибок = Статистика.Ошибок + 1;
			Лог("Ошибка", "Не удалось записать запись: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьПоРегистраторам(Контекст, Приемник, Группы, Порядок)

	Статистика = Контекст.Статистика;
	Менеджер = МенеджерРегистра(Приемник);

	Для Каждого КлючГруппы Из Порядок Цикл
		Группа = Группы.Получить(КлючГруппы);
		Попытка
			Набор = Менеджер.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(Группа.Регистратор);
			Для Каждого Запись Из Группа.Записи Цикл
				НоваяЗапись = Набор.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись);
				НоваяЗапись.Регистратор = Группа.Регистратор;
			КонецЦикла;
			Набор.Записать(Истина);

			Статистика.Записано = Статистика.Записано + Группа.Записи.Количество();
		Исключение
			Статистика.Ошибок = Статистика.Ошибок + 1;
			Лог("Ошибка", "Не удалось записать движения регистратора " + Строка(Группа.Регистратор) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
