КонецФункции

&НаКлиенте
Функция ТаблицаCOMВМассивСтруктур(ТаблицаCOM)
	
	Результат = Новый Массив;
	
	Колонки = Новый Массив;
	КоллекцияКолонок = КолонкиТаблицыCOM(ТаблицаCOM);
	КоличествоКолонок = КоличествоCOM(КоллекцияКолонок);
	Для ИндексКолонки = 0 По КоличествоКолонок - 1 Цикл
		Колонка = ЭлементКоллекцииCOM(КоллекцияКолонок, ИндексКолонки);
		Колонки.Добавить(СтрокаCOM(ЗначениеСвойстваCOM(Колонка, "Name", "Имя")));
	КонецЦикла;
	
	КоличествоСтрок = КоличествоCOM(ТаблицаCOM);
	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
		СтрокаCOM = ЭлементКоллекцииCOM(ТаблицаCOM, ИндексСтроки);
		СтрокаДанных = Новый Структура;
		Для Каждого ИмяКолонки Из Колонки Цикл
			СтрокаДанных.Вставить(ИмяКолонки, ЗначениеИзCOM(ЗначениеКолонкиCOM(СтрокаCOM, ИмяКолонки)));
		КонецЦикла;
		Результат.Добавить(СтрокаДанных);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТаблицуДанных(ПрочитанныеСтроки)
	
	Для Каждого СтрокаИсточника Из ПрочитанныеСтроки Цикл
		
		СтрокаДанных = ДанныеНДФЛ.Добавить();
		СтрокаДанных.Пометка = Истина;
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "Период");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "МесяцНалоговогоПериода");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ДатаПолученияДохода");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "СуммаДохода");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "СуммаВычета");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "КодДохода");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "КодВычета");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "КатегорияДоходаПредставление");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ФизическоеЛицоУИД");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ФизическоеЛицоИНН");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ФизическоеЛицоСНИЛС");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ФизическоеЛицоНаименование");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "Фамилия");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "Имя");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "Отчество");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ДатаРождения");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "СотрудникУИД");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "СотрудникКод");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "СотрудникНаименование");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ПодразделениеУИД");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ПодразделениеКод");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ПодразделениеНаименование");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "РегистрацияКод");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "РегистрацияКПП");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "КодНО");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ЗарегистрированоПриНачисленииАванса");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ВключатьВДекларациюПоНалогуНаПрибыль");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ИсточникДоходаЗаПределамиРФ");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "ДоходМежрасчетногоПериода");
		ЗаполнитьЗначениеЕслиЕсть(СтрокаДанных, СтрокаИсточника, "НеУчитыватьДоходВ6НДФЛ");
		
		Если СтрокаИсточника.Свойство("ОрганизацияИНН") И ЗначениеЗаполнено(СтрокаИсточника.ОрганизацияИНН) Тогда
			СтрокаДанных.ОрганизацияИНН = СтрокаИсточника.ОрганизацияИНН;
			СтрокаДанных.ОрганизацияКПП = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ОрганизацияКПП");
			СтрокаДанных.ОрганизацияНаименование = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ОрганизацияНаименование");
			СтрокаДанных.ОрганизацияУИД = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ОрганизацияУИД");
		Иначе
			СтрокаДанных.ОрганизацияИНН = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияИНН");
			СтрокаДанных.ОрганизацияКПП = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияКПП");
			СтрокаДанных.ОрганизацияНаименование = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияНаименование");
			СтрокаДанных.ОрганизацияУИД = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияУИД");
		КонецЕсли;
		СтрокаДанных.ГоловнаяОрганизацияУИД = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияУИД");
		СтрокаДанных.ГоловнаяОрганизацияИНН = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияИНН");
		СтрокаДанных.ГоловнаяОрганизацияКПП = ЗначениеСвойстваСтруктуры(СтрокаИсточника, "ГоловнаяОрганизацияКПП");
		
		СтрокаДанных.СтатусСопоставления = НСтр("ru = 'Не сопоставлено'");
		
	КонецЦикла;
	
КонецПроцедуры

