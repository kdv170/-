&НаКлиенте
Процедура ДобавитьКандидатаПоля(Кандидаты, Псевдоним, Выражение)
	
	Кандидат = Новый Структура("Псевдоним, Выражение", Псевдоним, Выражение);
	Кандидаты.Добавить(Кандидат);
	
КонецПроцедуры

&НаКлиенте
Функция ПолеЗапросаДоступно(Соединение, ИмяРегистра, Выражение)
	
	Попытка
		Запрос = НовыйЗапросCOM(Соединение);
		УстановитьТекстЗапросаCOM(Запрос, "ВЫБРАТЬ ПЕРВЫЕ 0 " + Выражение + " КАК Поле ИЗ РегистрНакопления." + ИмяРегистра + " КАК Сведения");
		ВыполнитьЗапросCOM(Запрос);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция СобратьТекстЗапросаНДФЛ(ИмяРегистра, ДоступныеПоля)
	
	ПоляВыборки = Новый Массив;
	Кандидаты = КандидатыПолейЗапроса();
	
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ДоступныеПоля.Получить(Кандидат.Псевдоним) = Истина Тогда
			ПоляВыборки.Добавить(Кандидат.Выражение + " КАК " + Кандидат.Псевдоним);
		КонецЕсли;
	КонецЦикла;
	
	Если ПоляВыборки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось определить состав полей регистра учета НДФЛ в базе ЗУП.'");
	КонецЕсли;
	
	Текст =
	"ВЫБРАТЬ
	|	" + СтрСоединить(ПоляВыборки, "," + Символы.ПС + Символы.Таб) + "
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + " КАК Сведения
	|ГДЕ
	|	Сведения.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Сведения.Активность";
	
	УсловияИНН = Новый Массив;
	Если ДоступныеПоля.Получить("ГоловнаяОрганизацияИНН") = Истина Тогда
		УсловияИНН.Добавить("Сведения.ГоловнаяОрганизация.ИНН = &ИННОрганизации");
	КонецЕсли;
	Если ДоступныеПоля.Получить("ОрганизацияИНН") = Истина Тогда
		УсловияИНН.Добавить("Сведения.Организация.ИНН = &ИННОрганизации");
	КонецЕсли;
	Если УсловияИНН.Количество() > 0 И ЗначениеЗаполнено(ИННОрганизацииНаСервере(Организация)) Тогда
		Текст = Текст + "
		|	И (" + СтрСоединить(УсловияИНН, " ИЛИ ") + ")";
	КонецЕсли;
	
	Текст = Текст + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сведения.Период,
	|	Сведения.НомерСтроки";
	
	Возврат Текст;
	
КонецФункции

