&НаКлиенте
Функция СвойствоCOM(Корень, ПутьРус, ПутьАнгл)
	
	Значение = ЗначениеПоПутиCOM(Корень, ПутьРус);
	Если Значение = Неопределено Тогда
		Значение = ЗначениеПоПутиCOM(Корень, ПутьАнгл);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Функция ЗначениеПоПутиCOM(Корень, Путь)
	
	Текущий = Корень;
	Части = СтрРазделить(Путь, ".");
	Для Каждого Часть Из Части Цикл
		Попытка
			Текущий = Текущий[Часть];
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Текущий;
	
КонецФункции

&НаКлиенте
Функция ЗначениеКолонкиCOM(СтрокаCOM, ИмяКолонки)
	
	Попытка
		Возврат СтрокаCOM[ИмяКолонки];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ЗначениеИзCOM(ЗначениеCOM)
	
	Если ЗначениеCOM = Неопределено Или ЗначениеCOM = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ТипЗначения = ТипЗнч(ЗначениеCOM);
		Если ТипЗначения = Тип("Строка")
			Или ТипЗначения = Тип("Число")
			Или ТипЗначения = Тип("Дата")
			Или ТипЗначения = Тип("Булево") Тогда
			Возврат ЗначениеCOM;
		КонецЕсли;
		Возврат Строка(ЗначениеCOM);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция СтрокаCOM(ЗначениеCOM)
	
	Если ЗначениеCOM = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеCOM));
	
КонецФункции

#КонецОбласти

#Область СерверныеДействия

&НаСервере
Процедура СопоставитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаДанных = РеквизитФормыВЗначение("ДанныеНДФЛ");
	
	ПараметрыЗагрузки = ПараметрыЗагрузкиНаСервере();
	Результат = ОбработкаОбъект.СопоставитьДанные(ТаблицаДанных, ПараметрыЗагрузки);
	
	ЗначениеВРеквизитФормы(ТаблицаДанных, "ДанныеНДФЛ");
	ДобавитьПротоколНаСервере(Результат.Протокол);
	ДобавитьСтрокуПротоколаНаСервере("Информация",
		СтрШаблон(НСтр("ru = 'Сопоставление завершено. Успешно: %1, с ошибками: %2'"),
			Результат.КоличествоСопоставлено, Результат.КоличествоОшибок));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВERPПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьВERPНаСервере();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВERPНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаДанных = РеквизитФормыВЗначение("ДанныеНДФЛ");
	
	ПараметрыЗагрузки = ПараметрыЗагрузкиНаСервере();
	Результат = ОбработкаОбъект.ЗагрузитьДанныеВERP(ТаблицаДанных, ПараметрыЗагрузки);
	
	ДобавитьПротоколНаСервере(Результат.Протокол);
	ДобавитьСтрокуПротоколаНаСервере("Информация",
		СтрШаблон(НСтр("ru = 'Загрузка завершена. Записано: %1, пропущено: %2, документов: %3'"),
			Результат.КоличествоЗаписано, Результат.КоличествоПропущено, Результат.ДокументыПереноса.Количество()));
	
КонецПроцедуры

&НаСервере
Функция ПараметрыЗагрузкиНаСервере()
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("Организация", Организация);
	ПараметрыЗагрузки.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыЗагрузки.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыЗагрузки.Вставить("СоздаватьФизлиц", СоздаватьФизлиц);
	ПараметрыЗагрузки.Вставить("СоздаватьСотрудников", СоздаватьСотрудников);
	ПараметрыЗагрузки.Вставить("Перезаписывать", ПерезаписыватьРанееЗагруженное);
	
	Возврат ПараметрыЗагрузки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИННОрганизацииНаСервере(ОрганизацияСсылка)
	
	Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат СокрЛП(ОрганизацияСсылка.ИНН);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область НастройкиИОформление

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	Элементы.ВариантПодключения.СписокВыбора.Очистить();
	Элементы.ВариантПодключения.СписокВыбора.Добавить("Файл", НСтр("ru = 'Файловая база'"));
	Элементы.ВариантПодключения.СписокВыбора.Добавить("Сервер", НСтр("ru = 'Клиент-серверная база'"));
	
	Элементы.ИмяCOMКоннектора.СписокВыбора.Очистить();
	Элементы.ИмяCOMКоннектора.СписокВыбора.Добавить("V83.COMConnector");
	Элементы.ИмяCOMКоннектора.СписокВыбора.Добавить("V84.COMConnector");
	Элементы.ИмяCOMКоннектора.СписокВыбора.Добавить("V85.COMConnector");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Кирпичный);
	Поле = ЭлементОформления.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ДанныеНДФЛСтатусСопоставления");
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеНДФЛ.СтатусСопоставления");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = НСтр("ru = 'Ошибка'");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ЦветМорскойВолны);
	Поле = ЭлементОформления.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ДанныеНДФЛСтатусСопоставления");
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеНДФЛ.СтатусСопоставления");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = НСтр("ru = 'Сопоставлено'");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПараметровПодключения()
	
	ЭтоФайл = (ВариантПодключения <> "Сервер");
	Элементы.КаталогИБ.Видимость = ЭтоФайл;
	Элементы.ИмяСервера.Видимость = Не ЭтоФайл;
	Элементы.ИмяБазы.Видимость = Не ЭтоФайл;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПараметровЧтения()
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите период чтения данных.'"));
		Возврат Ложь;
	КонецЕсли;
	Если ДатаНачала > ДатаОкончания Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дата начала периода больше даты окончания.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИтоги()
	
	СуммаДохода = 0;
	СуммаВычета = 0;
	Отмечено = 0;
	Для Каждого СтрокаДанных Из ДанныеНДФЛ Цикл
		Если СтрокаДанных.Пометка Тогда
			СуммаДохода = СуммаДохода + СтрокаДанных.СуммаДохода;
			СуммаВычета = СуммаВычета + СтрокаДанных.СуммаВычета;
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	
	НадписьИтоги = СтрШаблон(
		НСтр("ru = 'Строк: %1, отмечено: %2, сумма дохода: %3, сумма вычета: %4'"),
		ДанныеНДФЛ.Количество(),
		Отмечено,
		Формат(СуммаДохода, "ЧДЦ=2; ЧН=0"),
		Формат(СуммаВычета, "ЧДЦ=2; ЧН=0"));
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиНаСервере()
	
	Настройки = ХранилищеОбщихНастроек.Загрузить("ЗагрузкаУчетаДанныхДляНДФЛИзЗУП", "Форма");
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначениеНастройки(Настройки, "ВариантПодключения");
	ЗаполнитьЗначениеНастройки(Настройки, "ИмяCOMКоннектора");
	ЗаполнитьЗначениеНастройки(Настройки, "КаталогИБ");
	ЗаполнитьЗначениеНастройки(Настройки, "ИмяСервера");
	ЗаполнитьЗначениеНастройки(Настройки, "ИмяБазы");
	ЗаполнитьЗначениеНастройки(Настройки, "ПользовательЗУП");
	ЗаполнитьЗначениеНастройки(Настройки, "Организация");
	ЗаполнитьЗначениеНастройки(Настройки, "СоздаватьФизлиц");
	ЗаполнитьЗначениеНастройки(Настройки, "СоздаватьСотрудников");
	ЗаполнитьЗначениеНастройки(Настройки, "ПерезаписыватьРанееЗагруженное");
	ЗаполнитьЗначениеНастройки(Настройки, "ИмяРегистраЗУП");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеНастройки(Настройки, ИмяНастройки)
	
	Если Настройки.Свойство(ИмяНастройки) Тогда
		ЭтотОбъект[ИмяНастройки] = Настройки[ИмяНастройки];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	
	Настройки = Новый Структура;
	Настройки.Вставить("ВариантПодключения", ВариантПодключения);
	Настройки.Вставить("ИмяCOMКоннектора", ИмяCOMКоннектора);
	Настройки.Вставить("КаталогИБ", КаталогИБ);
	Настройки.Вставить("ИмяСервера", ИмяСервера);
	Настройки.Вставить("ИмяБазы", ИмяБазы);
	Настройки.Вставить("ПользовательЗУП", ПользовательЗУП);
	Настройки.Вставить("Организация", Организация);
	Настройки.Вставить("СоздаватьФизлиц", СоздаватьФизлиц);
	Настройки.Вставить("СоздаватьСотрудников", СоздаватьСотрудников);
	Настройки.Вставить("ПерезаписыватьРанееЗагруженное", ПерезаписыватьРанееЗагруженное);
	Настройки.Вставить("ИмяРегистраЗУП", ИмяРегистраЗУП);
	
	ХранилищеОбщихНастроек.Сохранить("ЗагрузкаУчетаДанныхДляНДФЛИзЗУП", "Форма", Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуПротоколаНаКлиенте(Уровень, Текст)
	
	СтрокаПротокола = Протокол.Добавить();
	СтрокаПротокола.Время = ТекущаяДата();
	СтрокаПротокола.Уровень = Уровень;
	СтрокаПротокола.Сообщение = Текст;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуПротоколаНаСервере(Уровень, Текст)
	
	СтрокаПротокола = Протокол.Добавить();
	СтрокаПротокола.Время = ТекущаяДатаСеанса();
	СтрокаПротокола.Уровень = Уровень;
	СтрокаПротокола.Сообщение = Текст;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПротоколНаСервере(МассивПротокола)
	
	Для Каждого Запись Из МассивПротокола Цикл
		СтрокаПротокола = Протокол.Добавить();
		СтрокаПротокола.Время = Запись.Время;
		СтрокаПротокола.Уровень = Запись.Уровень;
		СтрокаПротокола.Сообщение = Запись.Сообщение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениеЕслиЕсть(Приемник, Источник, ИмяПоля)
	
	Если Источник.Свойство(ИмяПоля) И Источник[ИмяПоля] <> Неопределено Тогда
		Приемник[ИмяПоля] = Источник[ИмяПоля];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЗначениеСвойстваСтруктуры(Источник, ИмяПоля)
	
	Значение = Неопределено;
	Источник.Свойство(ИмяПоля, Значение);
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#КонецОбласти
