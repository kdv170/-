#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСпискиВыбора();
	ВосстановитьНастройкиНаСервере();
	
	Если Не ЗначениеЗаполнено(ВариантПодключения) Тогда
		ВариантПодключения = "Файл";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяCOMКоннектора) Тогда
		ИмяCOMКоннектора = "V83.COMConnector";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
		ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПараметровПодключения();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантПодключенияПриИзменении(Элемент)
	
	УстановитьВидимостьПараметровПодключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеНДФЛПометкаПриИзменении(Элемент)
	
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = КаталогИБ;
	Диалог.Заголовок = НСтр("ru = 'Каталог информационной базы ЗУП'");
	Оповещение = Новый ОписаниеОповещения("КаталогИБЗавершениеВыбора", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогИБЗавершениеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КаталогИБ = ВыбранныеФайлы[0];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	
	#Если ВебКлиент Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'COM-соединение недоступно в веб-клиенте. Откройте обработку в тонком или толстом клиенте Windows.'"));
		Возврат;
	#КонецЕсли
	
	ОчиститьСообщения();
	Соединение = Неопределено;
	
	Попытка
		Соединение = ПодключитьсяКЗУП();
		ИнформацияИБ = ИнформацияИнформационнойБазыЗУП(Соединение);
		ДобавитьСтрокуПротоколаНаКлиенте("Информация", ИнформацияИБ);
		ПоказатьПредупреждение(, ИнформацияИБ);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьСтрокуПротоколаНаКлиенте("Ошибка", ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецПопытки;
	
	Соединение = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьДанные(Команда)
	
	#Если ВебКлиент Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'COM-соединение недоступно в веб-клиенте. Откройте обработку в тонком или толстом клиенте Windows.'"));
		Возврат;
	#КонецЕсли
	
	Если Не ПроверитьЗаполнениеПараметровЧтения() Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ДанныеНДФЛ.Очистить();
	
	Соединение = Неопределено;
	Попытка
		Состояние(НСтр("ru = 'Подключение к ЗУП...'"));
		Соединение = ПодключитьсяКЗУП();
		
		ИмяРегистра = ОпределитьИмяРегистраЗУП(Соединение);
		Если Не ЗначениеЗаполнено(ИмяРегистра) Тогда
			ВызватьИсключение НСтр("ru = 'В базе ЗУП не найден регистр учета данных для НДФЛ (СведенияОДоходахНДФЛ).'");
		КонецЕсли;
		ИмяРегистраЗУП = ИмяРегистра;
		
		Состояние(НСтр("ru = 'Чтение регистра учета НДФЛ...'"));
		ПрочитанныеСтроки = ПрочитатьРегистрНДФЛЧерезCOM(Соединение, ИмяРегистра);
		
		ЗаполнитьТаблицуДанных(ПрочитанныеСтроки);
		ДобавитьСтрокуПротоколаНаКлиенте("Информация",
			СтрШаблон(НСтр("ru = 'Прочитано записей из ЗУП (%1): %2'"), ИмяРегистра, ДанныеНДФЛ.Количество()));
		
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьСтрокуПротоколаНаКлиенте("Ошибка", ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецПопытки;
	
	Соединение = Неопределено;
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)
	
	Если ДанныеНДФЛ.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала прочитайте данные из ЗУП.'"));
		Возврат;
	КонецЕсли;
	
	СопоставитьНаСервере();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВERP(Команда)
	
	Если ДанныеНДФЛ.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет данных для загрузки. Сначала прочитайте регистр из ЗУП.'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьВERPПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Загрузить отмеченные строки в регистр учета доходов для исчисления НДФЛ ERP? Будет создан документ «Перенос данных».'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	СохранитьНастройкиНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки сохранены'"));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	Для Каждого СтрокаДанных Из ДанныеНДФЛ Цикл
		СтрокаДанных.Пометка = Истина;
	КонецЦикла;
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	Для Каждого СтрокаДанных Из ДанныеНДФЛ Цикл
		СтрокаДанных.Пометка = Ложь;
	КонецЦикла;
	ОбновитьИтоги();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПодключениеCOM

&НаКлиенте
Функция ПодключитьсяКЗУП()
	
	Коннектор = Неопределено;
	Попытка
		Коннектор = Новый COMОбъект(ИмяCOMКоннектора);
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось создать COM-объект %1. Зарегистрируйте comcntr.dll той же разрядности, что и клиент 1С.
				|Подробности: %2'"),
			ИмяCOMКоннектора,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	СтрокаСоединения = СтрокаСоединенияЗУП();
	
	Попытка
		Соединение = Коннектор.Connect(СтрокаСоединения);
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось подключиться к информационной базе ЗУП.
				|Строка соединения: %1
				|Подробности: %2'"),
			СтрокаСоединенияБезПароля(СтрокаСоединения),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции

&НаКлиенте
Функция СтрокаСоединенияЗУП()
	
	Части = Новый Массив;
	
	Если ВариантПодключения = "Сервер" Тогда
		Если Не ЗначениеЗаполнено(ИмяСервера) Или Не ЗначениеЗаполнено(ИмяБазы) Тогда
			ВызватьИсключение НСтр("ru = 'Для клиент-серверного подключения укажите имя сервера 1С и имя информационной базы ЗУП.'");
		КонецЕсли;
		Части.Добавить(СтрШаблон("Srvr=""%1""", СокрЛП(ИмяСервера)));
		Части.Добавить(СтрШаблон("Ref=""%1""", СокрЛП(ИмяБазы)));
	Иначе
		Если Не ЗначениеЗаполнено(КаталогИБ) Тогда
			ВызватьИсключение НСтр("ru = 'Укажите каталог файловой информационной базы ЗУП.'");
		КонецЕсли;
		Части.Добавить(СтрШаблон("File=""%1""", СокрЛП(КаталогИБ)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПользовательЗУП) Тогда
		Части.Добавить(СтрШаблон("Usr=""%1""", СтрЗаменить(ПользовательЗУП, """", """""")));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПарольЗУП) Тогда
		Части.Добавить(СтрШаблон("Pwd=""%1""", СтрЗаменить(ПарольЗУП, """", """""")));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ";") + ";";
	
КонецФункции

&НаКлиенте
Функция СтрокаСоединенияБезПароля(СтрокаСоединения)
	
	Результат = СтрокаСоединения;
	НачалоПароля = СтрНайти(ВРег(Результат), "PWD=");
	Если НачалоПароля = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат Лев(Результат, НачалоПароля - 1) + "Pwd=""***"";";
	
КонецФункции

&НаКлиенте
Функция ИнформацияИнформационнойБазыЗУП(Соединение)
	
	ИмяКонфигурации = СтрокаCOM(СвойствоCOM(Соединение, "Метаданные.Имя", "Metadata.Name"));
	Синоним = СтрокаCOM(СвойствоCOM(Соединение, "Метаданные.Синоним", "Metadata.Synonym"));
	Версия = СтрокаCOM(СвойствоCOM(Соединение, "Метаданные.Версия", "Metadata.Version"));
	
	Возврат СтрШаблон(
		НСтр("ru = 'Подключение установлено. Конфигурация: %1 (%2), версия %3.'"),
		?(ЗначениеЗаполнено(Синоним), Синоним, ИмяКонфигурации),
		ИмяКонфигурации,
		Версия);
	
КонецФункции

#КонецОбласти

#Область ЧтениеРегистра

&НаКлиенте
Функция ОпределитьИмяРегистраЗУП(Соединение)
	
	Если ЗначениеЗаполнено(ИмяРегистраЗУП) Тогда
		Возврат СокрЛП(ИмяРегистраЗУП);
	КонецЕсли;
	
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("СведенияОДоходахНДФЛ");
	Кандидаты.Добавить("УчетДанныхДляНДФЛ");
	Кандидаты.Добавить("УчетДоходовДляИсчисленияНДФЛ");
	
	Для Каждого ИмяКандидата Из Кандидаты Цикл
		Если РегистрНакопленияСуществует(Соединение, ИмяКандидата) Тогда
			Возврат ИмяКандидата;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НайтиРегистрПоСинониму(Соединение);
	
КонецФункции

&НаКлиенте
Функция РегистрНакопленияСуществует(Соединение, ИмяРегистра)
	
	Попытка
		Запрос = НовыйЗапросCOM(Соединение);
		УстановитьТекстЗапросаCOM(Запрос, "ВЫБРАТЬ ПЕРВЫЕ 0 1 ИЗ РегистрНакопления." + ИмяРегистра + " КАК Сведения");
		ВыполнитьЗапросCOM(Запрос);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция НайтиРегистрПоСинониму(Соединение)
	
	Ключи = Новый Массив;
	Ключи.Добавить("учет данных для ндфл");
	Ключи.Добавить("учет доходов для исчисления ндфл");
	Ключи.Добавить("сведения о доходах для расчета ндфл");
	Ключи.Добавить("сведения о доходах ндфл");
	
	Попытка
		Регистры = Соединение.Метаданные.РегистрыНакопления;
	Исключение
		Попытка
			Регистры = Соединение.Metadata.AccumulationRegisters;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
	
	Количество = КоличествоCOM(Регистры);
	Для Индекс = 0 По Количество - 1 Цикл
		РегистрМД = ЭлементКоллекцииCOM(Регистры, Индекс);
		Синоним = НРег(СтрокаCOM(ЗначениеСвойстваCOM(РегистрМД, "Синоним", "Synonym")));
		Имя = СтрокаCOM(ЗначениеСвойстваCOM(РегистрМД, "Имя", "Name"));
		Для Каждого Ключ Из Ключи Цикл
			Если СтрНайти(Синоним, Ключ) > 0 Тогда
				Возврат Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ПрочитатьРегистрНДФЛЧерезCOM(Соединение, ИмяРегистра)
	
	ДоступныеПоля = ОпределитьДоступныеПоляРегистра(Соединение, ИмяРегистра);
	ТекстЗапроса = СобратьТекстЗапросаНДФЛ(ИмяРегистра, ДоступныеПоля);
	
	Запрос = НовыйЗапросCOM(Соединение);
	УстановитьТекстЗапросаCOM(Запрос, ТекстЗапроса);
	УстановитьПараметрCOM(Запрос, "НачалоПериода", ДатаНачала);
	УстановитьПараметрCOM(Запрос, "КонецПериода", КонецДня(ДатаОкончания));
	
	ИННОтбора = ИННОрганизацииНаСервере(Организация);
	Если ЗначениеЗаполнено(ИННОтбора)
		И (ДоступныеПоля.Получить("ГоловнаяОрганизацияИНН") = Истина
			Или ДоступныеПоля.Получить("ОрганизацияИНН") = Истина) Тогда
		УстановитьПараметрCOM(Запрос, "ИННОрганизации", ИННОтбора);
	КонецЕсли;
	
	РезультатЗапроса = ВыполнитьЗапросCOM(Запрос);
	ТаблицаCOM = ВыгрузитьРезультатCOM(РезультатЗапроса);
	
	Возврат ТаблицаCOMВМассивСтруктур(ТаблицаCOM);
	
КонецФункции

&НаКлиенте
Функция ОпределитьДоступныеПоляРегистра(Соединение, ИмяРегистра)
	
	ДоступныеПоля = Новый Соответствие;
	Кандидаты = КандидатыПолейЗапроса();
	
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ПолеЗапросаДоступно(Соединение, ИмяРегистра, Кандидат.Выражение) Тогда
			ДоступныеПоля.Вставить(Кандидат.Псевдоним, Истина);
			ДоступныеПоля.Вставить(Кандидат.Псевдоним + "_Выражение", Кандидат.Выражение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДоступныеПоля;
	
КонецФункции

&НаКлиенте
Функция КандидатыПолейЗапроса()
	
	Кандидаты = Новый Массив;
	ДобавитьКандидатаПоля(Кандидаты, "Период", "Сведения.Период");
	ДобавитьКандидатаПоля(Кандидаты, "НомерСтроки", "Сведения.НомерСтроки");
	ДобавитьКандидатаПоля(Кандидаты, "МесяцНалоговогоПериода", "Сведения.МесяцНалоговогоПериода");
	ДобавитьКандидатаПоля(Кандидаты, "ДатаПолученияДохода", "Сведения.ДатаПолученияДохода");
	ДобавитьКандидатаПоля(Кандидаты, "СуммаДохода", "Сведения.СуммаДохода");
	ДобавитьКандидатаПоля(Кандидаты, "СуммаВычета", "Сведения.СуммаВычета");
	ДобавитьКандидатаПоля(Кандидаты, "ЗарегистрированоПриНачисленииАванса", "Сведения.ЗарегистрированоПриНачисленииАванса");
	ДобавитьКандидатаПоля(Кандидаты, "ВключатьВДекларациюПоНалогуНаПрибыль", "Сведения.ВключатьВДекларациюПоНалогуНаПрибыль");
	ДобавитьКандидатаПоля(Кандидаты, "ИсточникДоходаЗаПределамиРФ", "Сведения.ИсточникДоходаЗаПределамиРФ");
	ДобавитьКандидатаПоля(Кандидаты, "ДоходМежрасчетногоПериода", "Сведения.ДоходМежрасчетногоПериода");
	ДобавитьКандидатаПоля(Кандидаты, "НеУчитыватьДоходВ6НДФЛ", "Сведения.НеУчитыватьДоходВ6НДФЛ");
	
	ДобавитьКандидатаПоля(Кандидаты, "ГоловнаяОрганизацияУИД", "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Сведения.ГоловнаяОрганизация)");
	ДобавитьКандидатаПоля(Кандидаты, "ГоловнаяОрганизацияИНН", "Сведения.ГоловнаяОрганизация.ИНН");
	ДобавитьКандидатаПоля(Кандидаты, "ГоловнаяОрганизацияКПП", "Сведения.ГоловнаяОрганизация.КПП");
	ДобавитьКандидатаПоля(Кандидаты, "ГоловнаяОрганизацияНаименование", "Сведения.ГоловнаяОрганизация.Наименование");
	
