#Область ПрограммныйИнтерфейс

// Функция для регистрации внешней обработки в БСП (Библиотека Стандартных Подсистем)
// Справочник "Дополнительные отчеты и обработки"
//
// Возвращаемое значение:
//   Структура - параметры регистрации обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Перенос документов Исполнительный лист из ЗУП в ERP");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Обработка для переноса действующих документов Исполнительный лист из 1С:ЗУП 3.1 в 1С:ERP 2. Отбор производится по регистру сведений ПлановыеУдержания на дату переноса.");

	// Команды обработки
	ТаблицаКоманд = ПолучитьТаблицуКоманд();

	ДобавитьКоманду(ТаблицаКоманд,
		"Перенос документов Исполнительный лист",
		"ПереносИсполнительныхЛистов",
		"ОткрытиеФормы",
		Истина
	);

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

// Возвращает параметры загрузки по умолчанию
//
// Возвращаемое значение:
//   Структура - параметры загрузки
//
Функция ПараметрыЗагрузкиПоУмолчанию() Экспорт

	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ПроводитьДокументы", Истина);
	ПараметрыЗагрузки.Вставить("ПерезаписыватьСуществующие", Ложь);
	ПараметрыЗагрузки.Вставить("СоздаватьНовыеЭлементыНСИ", Истина);
	ПараметрыЗагрузки.Вставить("УстанавливатьИсходныйНомерИДату", Истина);
	ПараметрыЗагрузки.Вставить("ИспользоватьТранзакцию", Истина);

	Возврат ПараметрыЗагрузки;

КонецФункции

// Получает таблицу действующих исполнительных листов по регистру сведений ПлановыеУдержания
//
// Параметры:
//   ДатаПереноса - Дата - дата, на которую проверяется действие удержаний
//   Организация - СправочникСсылка.Организации, Неопределено - отбор по организации
//   Сотрудник - СправочникСсылка.Сотрудники, Неопределено - отбор по сотруднику
//   ТолькоДействующиеПоДатамДокумента - Булево - проверять период действия в самом документе
//
// Возвращаемое значение:
//   ТаблицаЗначений - отобранные документы со всеми реквизитами
//
Функция ПолучитьТаблицуДокументовПоРегистру(Знач ДатаПереноса, 
                                            Знач Организация = Неопределено, 
                                            Знач Сотрудник = Неопределено, 
                                            Знач ТолькоДействующиеПоДатамДокумента = Истина) Экспорт

	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ДатаПереноса = ТекущаяДатаСеанса();
	КонецЕсли;

	НачалоДняПереноса = НачалоДня(ДатаПереноса);
	КонецДняПереноса  = КонецДня(ДатаПереноса);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПлановыеУдержанияСрез.ДокументОснование КАК ДокументОснование,
	|	ПлановыеУдержанияСрез.Сотрудник КАК Сотрудник,
	|	ПлановыеУдержанияСрез.Удержание КАК Удержание,
	|	ПлановыеУдержанияСрез.Размер КАК РазмерИзРегистра,
	|	ПлановыеУдержанияСрез.Действует КАК ДействуетПоРегистру,
	|	ПлановыеУдержанияСрез.ДействуетДо КАК ДействуетДоПоРегистру
	|ПОМЕСТИТЬ ВТ_ДействующиеПлановыеУдержания
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(
	|			&КонецДняПереноса,
	|			ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист
	|				И (&ОтборОрганизация = НЕОПРЕДЕЛЕНО
	|					ИЛИ &ОтборОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|					ИЛИ ДокументОснование.Организация = &ОтборОрганизация)
	|				И (&ОтборСотрудник = НЕОПРЕДЕЛЕНО
	|					ИЛИ &ОтборСотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|					ИЛИ Сотрудник = &ОтборСотрудник)) КАК ПлановыеУдержанияСрез
	|ГДЕ
	|	ПлановыеУдержанияСрез.Действует = ИСТИНА
	|	И (ПлановыеУдержанияСрез.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ПлановыеУдержанияСрез.ДействуетДо >= &НачалоДняПереноса)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Пометка,
	|	Док.Ссылка КАК Документ,
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Организация.ИНН КАК ОрганизацияИНН,
	|	Док.Организация.КПП КАК ОрганизацияКПП,
	|	Док.Организация.Наименование КАК ОрганизацияНаименование,
	|	Док.Организация.ОГРН КАК ОрганизацияОГРН,
	|	Док.Сотрудник КАК Сотрудник,
	|	Док.Сотрудник.Код КАК СотрудникТабельныйНомер,
	|	Док.Сотрудник.Наименование КАК СотрудникНаименование,
	|	Док.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Док.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН,
	|	Док.ФизическоеЛицо.СтраховойНомерПФР КАК ФизическоеЛицоСНИЛС,
	|	Док.ФизическоеЛицо.ДатаРождения КАК ФизическоеЛицоДатаРождения,
	|	Док.ФизическоеЛицо.Наименование КАК ФизическоеЛицоФИО,
	|	Док.ФизическоеЛицо.Пол КАК ФизическоеЛицоПол,
	|	Док.Получатель КАК Получатель,
	|	Док.Получатель.ИНН КАК ПолучательИНН,
	|	Док.Получатель.КПП КАК ПолучательКПП,
	|	Док.Получатель.Наименование КАК ПолучательНаименование,
	|	Док.БанковскийСчет КАК БанковскийСчет,
	|	Док.БанковскийСчет.НомерСчета КАК БанковскийСчетНомерСчета,
	|	Док.БанковскийСчет.Банк.Код КАК БанковскийСчетБИК,
	|	Док.БанковскийСчет.Банк.Наименование КАК БанковскийСчетБанкНаименование,
	|	Док.БанковскийСчет.Банк.КоррСчет КАК БанковскийСчетКоррСчет,
	|	Док.ВидИсполнительногоДокумента КАК ВидИсполнительногоДокумента,
	|	Док.НомерИсполнительногоДокумента КАК НомерИсполнительногоДокумента,
	|	Док.ДатаВыдачи КАК ДатаВыдачи,
	|	Док.КемВыдан КАК КемВыдан,
	|	Док.СпособРасчета КАК СпособРасчета,
	|	Док.Удержание КАК Удержание,
	|	Док.Удержание.Код КАК УдержаниеКод,
	|	Док.Удержание.Наименование КАК УдержаниеНаименование,
	|	Док.Размер КАК Размер,
	|	Док.Процент КАК Процент,
	|	Док.Числитель КАК Числитель,
	|	Док.Знаменатель КАК Знаменатель,
	|	Док.ДатаНачала КАК ДатаНачала,
	|	Док.ДатаОкончания КАК ДатаОкончания,
	|	Док.ПрекратитьПоДостижениюПредела КАК ПрекратитьПоДостижениюПредела,
	|	Док.Предел КАК Предел,
	|	Док.УчитыватьБольничныеЛисты КАК УчитыватьБольничныеЛисты,
	|	Док.ПлатежныйАгент КАК ПлатежныйАгент,
	|	Док.ПлатежныйАгент.ИНН КАК ПлатежныйАгентИНН,
	|	Док.ПлатежныйАгент.КПП КАК ПлатежныйАгентКПП,
	|	Док.ПлатежныйАгент.Наименование КАК ПлатежныйАгентНаименование,
	|	Док.ТарифАгента КАК ТарифАгента,
	|	Док.ТарифАгента.Наименование КАК ТарифАгентаНаименование,
	|	Док.УдерживатьВознаграждениеАгента КАК УдерживатьВознаграждениеАгента,
	|	Док.ОчередностьВзыскания КАК ОчередностьВзыскания,
	|	Док.Комментарий КАК Комментарий,
	|	ВТ.РазмерИзРегистра КАК РазмерИзРегистра,
	|	ВТ.ДействуетПоРегистру КАК ДействуетПоРегистру,
	|	ВТ.ДействуетДоПоРегистру КАК ДействуетДоПоРегистру,
	|	"""" КАК СтатусПереноса
	|ИЗ
	|	ВТ_ДействующиеПлановыеУдержания КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК Док
	|		ПО ВТ.ДокументОснование = Док.Ссылка
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И НЕ Док.ПометкаУдаления
	|	И (&ТолькоДействующиеПоДатамДокумента = ЛОЖЬ
	|		ИЛИ (Док.ДатаНачала <= &КонецДняПереноса
	|			И (Док.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ Док.ДатаОкончания >= &НачалоДняПереноса)))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияНаименование,
	|	СотрудникНаименование,
	|	ДатаНачала";

	Запрос.УстановитьПараметр("КонецДняПереноса", КонецДняПереноса);
	Запрос.УстановитьПараметр("НачалоДняПереноса", НачалоДняПереноса);
	Запрос.УстановитьПараметр("ОтборОрганизация", Организация);
	Запрос.УстановитьПараметр("ОтборСотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ТолькоДействующиеПоДатамДокумента", ТолькоДействующиеПоДатамДокумента);

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаДокументов = РезультатЗапроса.Выгрузить();
	Исключение
		// Резервный вариант отбора, если виртуальная таблица СрезПоследних недоступна в специфическом релизе
		ТаблицаДокументов = ПолучитьТаблицуДокументовРезервныйЗапрос(НачалоДняПереноса, КонецДняПереноса, Организация, Сотрудник, ТолькоДействующиеПоДатамДокумента);
	КонецПопытки;

	Возврат ТаблицаДокументов;

КонецФункции

// Выгружает отобранные документы в файл (XML или JSON)
//
// Параметры:
//   ПутьКФайлу - Строка - абсолютный путь к файлу назначения
//   ТаблицаДокументов - ТаблицаЗначений - таблица документов для выгрузки
//   ДатаПереноса - Дата - дата переноса
//   ФорматФайла - Строка - "XML" или "JSON"
//
Процедура ВыгрузитьВФайл(Знач ПутьКФайлу, Знач ТаблицаДокументов, Знач ДатаПереноса, Знач ФорматФайла = "XML") Экспорт

	ТекстВыгрузки = ВыгрузитьВСтроку(ТаблицаДокументов, ДатаПереноса, ФорматФайла);

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстВыгрузки);
	ТекстовыйДокумент.Записать(ПутьКФайлу, КодировкаТекста.UTF8);

КонецПроцедуры

// Выгружает документы в текстовую строку (XML или JSON)
//
// Параметры:
//   ТаблицаДокументов - ТаблицаЗначений - таблица документов
//   ДатаПереноса - Дата - дата переноса
//   ФорматФайла - Строка - "XML" или "JSON"
//
// Возвращаемое значение:
//   Строка - сформированный XML или JSON
//
Функция ВыгрузитьВСтроку(Знач ТаблицаДокументов, Знач ДатаПереноса, Знач ФорматФайла = "XML") Экспорт

	Если ВРег(СокрЛП(ФорматФайла)) = "JSON" Тогда
		Возврат СериализоватьТаблицуВJSON(ТаблицаДокументов, ДатаПереноса);
	Иначе
		Возврат СериализоватьТаблицуВXML(ТаблицаДокументов, ДатаПереноса);
	КонецЕсли;

КонецФункции

// Загружает документы в базу ERP из файла
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу выгрузки
//   ПараметрыЗагрузки - Структура - параметры загрузки
//   Протокол - ТаблицаЗначений, Неопределено - таблица для протокола загрузки
//
// Возвращаемое значение:
//   Структура - результат загрузки (КоличествоВсего, Создано, Обновлено, Пропущено, Ошибок)
//
Функция ЗагрузитьИзФайла(Знач ПутьКФайлу, Знач ПараметрыЗагрузки = Неопределено, Протокол = Неопределено) Экспорт

	Если ПараметрыЗагрузки = Неопределено Тогда
		ПараметрыЗагрузки = ПараметрыЗагрузкиПоУмолчанию();
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекстДанных = ТекстовыйДокумент.ПолучитьТекст();

	// Определение формата по содержимому файла
	ПервыеСимволы = ВРег(СокрЛП(Лев(ТекстДанных, 50)));
	Если Найти(ПервыеСимволы, "<?XML") > 0 ИЛИ Найти(ПервыеСимволы, "<TRANSFER") > 0 Тогда
		ФорматФайла = "XML";
	Иначе
		ФорматФайла = "JSON";
	КонецЕсли;

	Возврат ЗагрузитьИзСтроки(ТекстДанных, ФорматФайла, ПараметрыЗагрузки, Протокол);

КонецФункции

// Загружает документы в базу ERP из текстовой строки
//
// Параметры:
//   ТекстДанных - Строка - содержимое XML или JSON
//   ФорматФайла - Строка - "XML" или "JSON"
//   ПараметрыЗагрузки - Структура - параметры загрузки
//   Протокол - ТаблицаЗначений, Неопределено - журнал операций
//
// Возвращаемое значение:
//   Структура - статистика переноса
//
Функция ЗагрузитьИзСтроки(Знач ТекстДанных, Знач ФорматФайла, Знач ПараметрыЗагрузки = Неопределено, Протокол = Неопределено) Экспорт

	Если ПараметрыЗагрузки = Неопределено Тогда
		ПараметрыЗагрузки = ПараметрыЗагрузкиПоУмолчанию();
	КонецЕсли;

	Если Протокол = Неопределено Тогда
		Протокол = ИнициализироватьПротокол();
	КонецЕсли;

	Статистика = Новый Структура;
	Статистика.Вставить("Всего", 0);
	Статистика.Вставить("Создано", 0);
	Статистика.Вставить("Обновлено", 0);
	Статистика.Вставить("Пропущено", 0);
	Статистика.Вставить("Ошибок", 0);

	ЗаписатьВПротокол(Протокол, "Начало загрузки документов Исполнительный лист...", "Информация");

	// Десериализация данных
	Если ВРег(СокрЛП(ФорматФайла)) = "JSON" Тогда
		ПакетДанных = ДесериализоватьИзJSON(ТекстДанных);
	Иначе
		ПакетДанных = ДесериализоватьИзXML(ТекстДанных);
	КонецЕсли;

	Если ПакетДанных = Неопределено ИЛИ Не ПакетДанных.Свойство("Документы") Тогда
		ЗаписатьВПротокол(Протокол, "Ошибка десериализации данных: структура пакета некорректна.", "Ошибка");
		Статистика.Ошибок = Статистика.Ошибок + 1;
		Возврат Статистика;
	КонецЕсли;

	МассивДокументов = ПакетДанных.Документы;
	Статистика.Всего = МассивДокументов.Количество();

	ЗаписатьВПротокол(Протокол, СтрШаблон("Получено документов к загрузке: %1", Статистика.Всего), "Информация");

	Для Каждого ДанныеДок Из МассивДокументов Цикл

		Если ПараметрыЗагрузки.ИспользоватьТранзакцию Тогда
			НачатьТранзакцию();
		КонецЕсли;

		Попытка
			РезультатОбработки = СоздатьИлиОбновитьИсполнительныйЛист(ДанныеДок, ПараметрыЗагрузки, Протокол);

			Если РезультатОбработки = "Создан" Тогда
				Статистика.Создано = Статистика.Создано + 1;
			ИначеЕсли РезультатОбработки = "Обновлен" Тогда
				Статистика.Обновлено = Статистика.Обновлено + 1;
			ИначеЕсли РезультатОбработки = "Пропущен" Тогда
				Статистика.Пропущено = Статистика.Пропущено + 1;
			КонецЕсли;

			Если ПараметрыЗагрузки.ИспользоватьТранзакцию Тогда
				ЗафиксироватьТранзакцию();
			КонецЕсли;

		Исключение
			Если ПараметрыЗагрузки.ИспользоватьТранзакцию И ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;

			Статистика.Ошибок = Статистика.Ошибок + 1;
			ТекстОшибки = СтрШаблон("Ошибка при обработке документа № %1 от %2 (Сотрудник: %3): %4",
				ДанныеДок.НомерИсполнительногоДокумента,
				Формат(ДанныеДок.Дата, "ДФ=dd.MM.yyyy"),
				ДанныеДок.Сотрудник.Наименование,
				ОписаниеОшибки()
			);
			ЗаписатьВПротокол(Протокол, ТекстОшибки, "Ошибка");
		КонецПопытки;

	КонецЦикла;

	ИтоговыйТекст = СтрШаблон("Загрузка завершена! Всего: %1, Создано: %2, Обновлено: %3, Пропущено: %4, Ошибок: %5",
		Статистика.Всего, Статистика.Создано, Статистика.Обновлено, Статистика.Пропущено, Статистика.Ошибок);
	ЗаписатьВПротокол(Протокол, ИтоговыйТекст, ?(Статистика.Ошибок > 0, "Предупреждение", "Успех"));

	Возврат Статистика;

КонецФункции

// Прямой перенос документов через COM-соединение (V83.COMConnector)
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры доступа к базе 1С:ЗУП
//   ПараметрыПереноса - Структура - параметры отбора и загрузки
//   Протокол - ТаблицаЗначений, Неопределено
//
// Возвращаемое значение:
//   Структура - статистика переноса
//
Функция ВыполнитьПрямойПереносCOM(Знач ПараметрыПодключения, Знач ПараметрыПереноса, Протокол = Неопределено) Экспорт

	Если Протокол = Неопределено Тогда
		Протокол = ИнициализироватьПротокол();
	КонецЕсли;

	ЗаписатьВПротокол(Протокол, "Подключение к базе ЗУП через COMConnector...", "Информация");

	Попытка
		COMСоединитель = Новый COMОбъект("V83.COMConnector");
	Исключение
		ЗаписатьВПротокол(Протокол, "Не удалось создать объект V83.COMConnector: " + ОписаниеОшибки(), "Ошибка");
		Возврат Новый Структура("Всего,Создано,Обновлено,Пропущено,Ошибок", 0, 0, 0, 0, 1);
	КонецПопытки;

	СтрокаПодключения = СформироватьСтрокуПодключения(ПараметрыПодключения);

	Попытка
		ВнешняяБаза = COMСоединитель.Connect(СтрокаПодключения);
		ЗаписатьВПротокол(Протокол, "Успешное подключение к внешней базе 1С:ЗУП!", "Успех");
	Исключение
		ЗаписатьВПротокол(Протокол, "Ошибка подключения к базе ЗУП: " + ОписаниеОшибки(), "Ошибка");
		Возврат Новый Структура("Всего,Создано,Обновлено,Пропущено,Ошибок", 0, 0, 0, 0, 1);
	КонецПопытки;

	// Выполнение запроса во внешней базе ЗУП
	ЗапросВнешний = ВнешняяБаза.NewObject("Запрос");
	ЗапросВнешний.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПлановыеУдержанияСрез.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ ВТ_Действующие
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(
	|			&КонецДняПереноса,
	|			ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист) КАК ПлановыеУдержанияСрез
	|ГДЕ
	|	ПлановыеУдержанияСрез.Действует = ИСТИНА
	|	И (ПлановыеУдержанияСрез.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ПлановыеУдержанияСрез.ДействуетДо >= &НачалоДняПереноса)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Организация.ИНН КАК ОрганизацияИНН,
	|	Док.Организация.КПП КАК ОрганизацияКПП,
	|	Док.Организация.Наименование КАК ОрганизацияНаименование,
	|	Док.Организация.ОГРН КАК ОрганизацияОГРН,
	|	Док.Сотрудник.Код КАК СотрудникТабельныйНомер,
	|	Док.Сотрудник.Наименование КАК СотрудникНаименование,
	|	Док.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН,
	|	Док.ФизическоеЛицо.СтраховойНомерПФР КАК ФизическоеЛицоСНИЛС,
	|	Док.ФизическоеЛицо.ДатаРождения КАК ФизическоеЛицоДатаРождения,
	|	Док.ФизическоеЛицо.Наименование КАК ФизическоеЛицоФИО,
	|	Строка(Док.ФизическоеЛицо.Пол) КАК ФизическоеЛицоПол,
	|	Док.Получатель.ИНН КАК ПолучательИНН,
	|	Док.Получатель.КПП КАК ПолучательКПП,
	|	Док.Получатель.Наименование КАК ПолучательНаименование,
	|	Док.БанковскийСчет.НомерСчета КАК БанковскийСчетНомерСчета,
	|	Док.БанковскийСчет.Банк.Код КАК БанковскийСчетБИК,
	|	Док.БанковскийСчет.Банк.Наименование КАК БанковскийСчетБанкНаименование,
	|	Док.БанковскийСчет.Банк.КоррСчет КАК БанковскийСчетКоррСчет,
	|	Строка(Док.ВидИсполнительногоДокумента) КАК ВидИсполнительногоДокумента,
	|	Док.НомерИсполнительногоДокумента КАК НомерИсполнительногоДокумента,
	|	Док.ДатаВыдачи КАК ДатаВыдачи,
	|	Док.КемВыдан КАК КемВыдан,
	|	Строка(Док.СпособРасчета) КАК СпособРасчета,
	|	Док.Удержание.Код КАК УдержаниеКод,
	|	Док.Удержание.Наименование КАК УдержаниеНаименование,
	|	Док.Размер КАК Размер,
	|	Док.Процент КАК Процент,
	|	Док.Числитель КАК Числитель,
	|	Док.Знаменатель КАК Знаменатель,
	|	Док.ДатаНачала КАК ДатаНачала,
	|	Док.ДатаОкончания КАК ДатаОкончания,
	|	Док.ПрекратитьПоДостижениюПредела КАК ПрекратитьПоДостижениюПредела,
	|	Док.Предел КАК Предел,
	|	Док.УчитыватьБольничныеЛисты КАК УчитыватьБольничныеЛисты,
	|	Док.ПлатежныйАгент.ИНН КАК ПлатежныйАгентИНН,
	|	Док.ПлатежныйАгент.КПП КАК ПлатежныйАгентКПП,
	|	Док.ПлатежныйАгент.Наименование КАК ПлатежныйАгентНаименование,
	|	Док.ТарифАгента.Наименование КАК ТарифАгентаНаименование,
	|	Док.УдерживатьВознаграждениеАгента КАК УдерживатьВознаграждениеАгента,
	|	Строка(Док.ОчередностьВзыскания) КАК ОчередностьВзыскания,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	ВТ_Действующие КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнительныйЛист КАК Док
	|		ПО ВТ.ДокументОснование = Док.Ссылка
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И НЕ Док.ПометкаУдаления";

	ДатаПереноса = ПараметрыПереноса.ДатаПереноса;
	ЗапросВнешний.УстановитьПараметр("КонецДняПереноса", КонецДня(ДатаПереноса));
	ЗапросВнешний.УстановитьПараметр("НачалоДняПереноса", НачалоДня(ДатаПереноса));

	Выборка = ЗапросВнешний.Выполнить().Выбрать();

	МассивДокументов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ДанныеДок = Новый Структура;
		ДанныеДок.Вставить("УникальныйИдентификатор", Строка(ВнешняяБаза.String(Выборка.Ссылка.UUID())));
		ДанныеДок.Вставить("Номер", Строка(Выборка.Номер));
		ДанныеДок.Вставить("Дата", Выборка.Дата);

		ДанныеОрг = Новый Структура("ИНН,КПП,Наименование,ОГРН",
			Строка(Выборка.ОрганизацияИНН), Строка(Выборка.ОрганизацияКПП),
			Строка(Выборка.ОрганизацияНаименование), Строка(Выборка.ОрганизацияОГРН));
		ДанныеДок.Вставить("Организация", ДанныеОрг);

		ДанныеФизЛицо = Новый Структура("ИНН,СНИЛС,ДатаРождения,ФИО,Пол",
			Строка(Выборка.ФизическоеЛицоИНН), Строка(Выборка.ФизическоеЛицоСНИЛС),
			Выборка.ФизическоеЛицоДатаРождения, Строка(Выборка.ФизическоеЛицоФИО),
			Строка(Выборка.ФизическоеЛицоПол));
		ДанныеДок.Вставить("ФизическоеЛицо", ДанныеФизЛицо);

		ДанныеСотрудник = Новый Структура("ТабельныйНомер,Наименование",
			Строка(Выборка.СотрудникТабельныйНомер), Строка(Выборка.СотрудникНаименование));
		ДанныеДок.Вставить("Сотрудник", ДанныеСотрудник);

		ДанныеПолучатель = Новый Структура("ИНН,КПП,Наименование",
			Строка(Выборка.ПолучательИНН), Строка(Выборка.ПолучательКПП),
			Строка(Выборка.ПолучательНаименование));
		ДанныеДок.Вставить("Получатель", ДанныеПолучатель);

		ДанныеСчет = Новый Структура("НомерСчета,БИК,БанкНаименование,КоррСчет",
			Строка(Выборка.БанковскийСчетНомерСчета), Строка(Выборка.БанковскийСчетБИК),
			Строка(Выборка.БанковскийСчетБанкНаименование), Строка(Выборка.БанковскийСчетКоррСчет));
		ДанныеДок.Вставить("БанковскийСчет", ДанныеСчет);

		ДанныеДок.Вставить("ВидИсполнительногоДокумента", Строка(Выборка.ВидИсполнительногоДокумента));
		ДанныеДок.Вставить("НомерИсполнительногоДокумента", Строка(Выборка.НомерИсполнительногоДокумента));
		ДанныеДок.Вставить("ДатаВыдачи", Выборка.ДатаВыдачи);
		ДанныеДок.Вставить("КемВыдан", Строка(Выборка.КемВыдан));
		ДанныеДок.Вставить("СпособРасчета", Строка(Выборка.СпособРасчета));

		ДанныеУдержание = Новый Структура("Код,Наименование,Предопределенный",
			Строка(Выборка.УдержаниеКод), Строка(Выборка.УдержаниеНаименование), "");
		ДанныеДок.Вставить("Удержание", ДанныеУдержание);

		ДанныеДок.Вставить("Размер", Число(Выборка.Размер));
		ДанныеДок.Вставить("Процент", Число(Выборка.Процент));
		ДанныеДок.Вставить("Числитель", Число(Выборка.Числитель));
		ДанныеДок.Вставить("Знаменатель", Число(Выборка.Знаменатель));
		ДанныеДок.Вставить("ДатаНачала", Выборка.ДатаНачала);
		ДанныеДок.Вставить("ДатаОкончания", Выборка.ДатаОкончания);
		ДанныеДок.Вставить("ПрекратитьПоДостижениюПредела", Булево(Выборка.ПрекратитьПоДостижениюПредела));
		ДанныеДок.Вставить("Предел", Число(Выборка.Предел));
		ДанныеДок.Вставить("УчитыватьБольничныеЛисты", Булево(Выборка.УчитыватьБольничныеЛисты));

		ДанныеАгент = Новый Структура("ИНН,КПП,Наименование",
			Строка(Выборка.ПлатежныйАгентИНН), Строка(Выборка.ПлатежныйАгентКПП),
			Строка(Выборка.ПлатежныйАгентНаименование));
		ДанныеДок.Вставить("ПлатежныйАгент", ДанныеАгент);

		ДанныеТариф = Новый Структура("Наименование", Строка(Выборка.ТарифАгентаНаименование));
		ДанныеДок.Вставить("ТарифАгента", ДанныеТариф);

		ДанныеДок.Вставить("УдерживатьВознаграждениеАгента", Булево(Выборка.УдерживатьВознаграждениеАгента));
		ДанныеДок.Вставить("ОчередностьВзыскания", Строка(Выборка.ОчередностьВзыскания));
		ДанныеДок.Вставить("Комментарий", Строка(Выборка.Комментарий));

		МассивДокументов.Добавить(ДанныеДок);
	КонецЦикла;

	ВнешняяБаза = Неопределено;
	COMСоединитель = Неопределено;

	Пакет = Новый Структура("Документы", МассивДокументов);
	ТекстJSON = ЗаписатьДанныеВJSON(Пакет);

	Возврат ЗагрузитьИзСтроки(ТекстJSON, "JSON", ПараметрыПереноса, Протокол);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает или обновляет документ ИсполнительныйЛист в целевой информационной базе ERP
//
Функция СоздатьИлиОбновитьИсполнительныйЛист(Знач ДанныеДок, Знач ПараметрыЗагрузки, Протокол)

	// 1. Сопоставление Организации
	ОрганизацияСсылка = НайтиИлиСоздатьОрганизацию(ДанныеДок.Организация, ПараметрыЗагрузки.СоздаватьНовыеЭлементыНСИ, Протокол);
	Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		ВызватьИсключение СтрШаблон("Не удалось определить организацию '%1' (ИНН: %2, КПП: %3)",
			ДанныеДок.Организация.Наименование, ДанныеДок.Организация.ИНН, ДанныеДок.Организация.КПП);
	КонецЕсли;

	// 2. Сопоставление Физического лица
	ФизЛицоСсылка = НайтиИлиСоздатьФизЛицо(ДанныеДок.ФизическоеЛицо, ПараметрыЗагрузки.СоздаватьНовыеЭлементыНСИ, Протокол);
	Если Не ЗначениеЗаполнено(ФизЛицоСсылка) Тогда
		ВызватьИсключение СтрШаблон("Не удалось определить физ. лицо '%1' (СНИЛС: %2, ИНН: %3)",
			ДанныеДок.ФизическоеЛицо.ФИО, ДанныеДок.ФизическоеЛицо.СНИЛС, ДанныеДок.ФизическоеЛицо.ИНН);
	КонецЕсли;

	// 3. Сопоставление Сотрудника
	СотрудникСсылка = НайтиИлиСоздатьСотрудника(ДанныеДок.Сотрудник, ФизЛицоСсылка, ОрганизацияСсылка, ПараметрыЗагрузки.СоздаватьНовыеЭлементыНСИ, Протокол);
	Если Не ЗначениеЗаполнено(СотрудникСсылка) Тогда
		ВызватьИсключение СтрШаблон("Не удалось определить сотрудника '%1' по организации '%2'",
			ДанныеДок.Сотрудник.Наименование, ОрганизацияСсылка);
	КонецЕсли;

	// 4. Сопоставление Получателя (Контрагента)
	ПолучательСсылка = НайтиИлиСоздатьКонтрагента(ДанныеДок.Получатель, ПараметрыЗагрузки.СоздаватьНовыеЭлементыНСИ, Протокол);
	Если Не ЗначениеЗаполнено(ПолучательСсылка) Тогда
		ВызватьИсключение СтрШаблон("Не удалось определить получателя '%1' (ИНН: %2)",
			ДанныеДок.Получатель.Наименование, ДанныеДок.Получатель.ИНН);
	КонецЕсли;

	// 5. Сопоставление Банковского счета получателя
	БанковскийСчетСсылка = Справочники.БанковскиеСчетаКонтрагентов.ПустаяСсылка();
	Если ДанныеДок.Свойство("БанковскийСчет") И ЗначениеЗаполнено(ДанныеДок.БанковскийСчет.НомерСчета) Тогда
		БанковскийСчетСсылка = НайтиИлиСоздатьБанковскийСчет(ДанныеДок.БанковскийСчет, ПолучательСсылка, ПараметрыЗагрузки.СоздаватьНовыеЭлементыНСИ, Протокол);
	КонецЕсли;

	// 6. Сопоставление вида удержания
	УдержаниеСсылка = НайтиВидУдержания(ДанныеДок.Удержание, ДанныеДок.СпособРасчета);
	Если Не ЗначениеЗаполнено(УдержаниеСсылка) Тогда
		ВызватьИсключение СтрШаблон("Не найден подходящий вид удержания для '%1'", ДанныеДок.Удержание.Наименование);
	КонецЕсли;

	// 7. Поиск существующего документа
	ДокументСсылка = НайтиСуществующийДокумент(ДанныеДок, ОрганизацияСсылка, СотрудникСсылка);

	ЭтоНовый = Не ЗначениеЗаполнено(ДокументСсылка);
	Если Не ЭтоНовый И Не ПараметрыЗагрузки.ПерезаписыватьСуществующие Тогда
		ЗаписатьВПротокол(Протокол, СтрШаблон("Документ № %1 от %2 (Сотрудник: %3) уже существует, пропущен.",
			ДанныеДок.НомерИсполнительногоДокумента, Формат(ДанныеДок.Дата, "ДФ=dd.MM.yyyy"), ДанныеДок.Сотрудник.Наименование), "Предупреждение");
		Возврат "Пропущен";
	КонецЕсли;

	Если ЭтоНовый Тогда
		ДокументОбъект = Документы.ИсполнительныйЛист.СоздатьДокумент();
		Если ПараметрыЗагрузки.УстанавливатьИсходныйНомерИДату Тогда
			ДокументОбъект.Номер = ДанныеДок.Номер;
			ДокументОбъект.Дата  = ДанныеДок.Дата;
		Иначе
			ДокументОбъект.Дата  = ТекущаяДатаСеанса();
		КонецЕсли;
	Иначе
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;

	// Заполнение реквизитов документа
	ДокументОбъект.Организация                   = ОрганизацияСсылка;
	ДокументОбъект.Сотрудник                     = СотрудникСсылка;
	ДокументОбъект.ФизическоеЛицо                = ФизЛицоСсылка;
	ДокументОбъект.Получатель                    = ПолучательСсылка;
	ДокументОбъект.БанковскийСчет                = БанковскийСчетСсылка;
	ДокументОбъект.ВидИсполнительногоДокумента   = ПолучитьЗначениеПеречисления("ВидыИсполнительныхДокументов", ДанныеДок.ВидИсполнительногоДокумента);
	ДокументОбъект.НомерИсполнительногоДокумента = ДанныеДок.НомерИсполнительногоДокумента;
	ДокументОбъект.ДатаВыдачи                    = ДанныеДок.ДатаВыдачи;
	ДокументОбъект.КемВыдан                      = ДанныеДок.КемВыдан;
	ДокументОбъект.СпособРасчета                 = ПолучитьЗначениеПеречисления("СпособыРасчетаУдержанийПоИсполнительнымДокументам", ДанныеДок.СпособРасчета);
	ДокументОбъект.Удержание                     = УдержаниеСсылка;
	ДокументОбъект.Размер                        = ДанныеДок.Размер;
	ДокументОбъект.Процент                       = ДанныеДок.Процент;
	ДокументОбъект.Числитель                     = ДанныеДок.Числитель;
	ДокументОбъект.Знаменатель                   = ДанныеДок.Знаменатель;
	ДокументОбъект.ДатаНачала                    = ДанныеДок.ДатаНачала;
	ДокументОбъект.ДатаОкончания                 = ДанныеДок.ДатаОкончания;
	ДокументОбъект.ПрекратитьПоДостижениюПредела = ДанныеДок.ПрекратитьПоДостижениюПредела;
	ДокументОбъект.Предел                        = ДанныеДок.Предел;
	ДокументОбъект.УчитыватьБольничныеЛисты      = ДанныеДок.УчитыватьБольничныеЛисты;

	// Платежный агент
	Если ДанныеДок.Свойство("ПлатежныйАгент") И ЗначениеЗаполнено(ДанныеДок.ПлатежныйАгент.Наименование) Тогда
		ДокументОбъект.ПлатежныйАгент = НайтиИлиСоздатьКонтрагента(ДанныеДок.ПлатежныйАгент, ПараметрыЗагрузки.СоздаватьНовыеЭлементыНСИ, Протокол);
	КонецЕсли;

	// Очередность взыскания
	Если ДанныеДок.Свойство("ОчередностьВзыскания") И ЗначениеЗаполнено(ДанныеДок.ОчередностьВзыскания) Тогда
		ДокументОбъект.ОчередностьВзыскания = ПолучитьЗначениеПеречисления("ОчередностьВзысканияУдержаний", ДанныеДок.ОчередностьВзыскания);
	КонецЕсли;

	КомментарийПрефикс = "[Перенос из ЗУП " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy") + "] ";
	Если Найти(ДокументОбъект.Комментарий, КомментарийПрефикс) = 0 Тогда
		ДокументОбъект.Комментарий = СокрЛП(КомментарийПрефикс + ДанныеДок.Комментарий);
	КонецЕсли;

	// Запись и проведение
	РежимЗаписи = ?(ПараметрыЗагрузки.ПроводитьДокументы, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Попытка
		ДокументОбъект.Записать(РежимЗаписи);
	Исключение
		// Если проведение не удалось, пробуем записать без проведения, чтобы данные сохранились
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ЗаписатьВПротокол(Протокол, СтрШаблон("Документ № %1 записан, но не проведен: %2",
				ДанныеДок.НомерИсполнительногоДокумента, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), "Предупреждение");
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;

	ДействиеСтрока = ?(ЭтоНовый, "Создан", "Обновлен");
	ЗаписатьВПротокол(Протокол, СтрШаблон("%1 документ № %2 от %3 (Сотрудник: %4)",
		ДействиеСтрока, ДокументОбъект.НомерИсполнительногоДокумента, 
		Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy"), ДокументОбъект.Сотрудник), "Успех");

	Возврат ДействиеСтрока;

КонецФункции

// Поиск существующего документа ИсполнительныйЛист
Функция НайтиСуществующийДокумент(Знач ДанныеДок, Знач ОрганизацияСсылка, Знач СотрудникСсылка)

	// 1. Поиск по Уникальному Идентификатору
	Если ДанныеДок.Свойство("УникальныйИдентификатор") И ЗначениеЗаполнено(ДанныеДок.УникальныйИдентификатор) Тогда
		Попытка
			Идентификатор = Новый УникальныйИдентификатор(ДанныеДок.УникальныйИдентификатор);
			СсылкаПоГУИД = Документы.ИсполнительныйЛист.ПолучитьСсылку(Идентификатор);
			Если ЗначениеЗаполнено(СсылкаПоГУИД.Номер) Тогда
				Возврат СсылкаПоГУИД;
			КонецЕсли;
		Исключение
			// ГУИД не найден в базе, переходим к поиску по реквизитам
		КонецПопытки;
	КонецЕсли;

	// 2. Поиск по ключевым реквизитам документа: Организация + Сотрудник + НомерИспДокумента
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИсполнительныйЛист КАК Док
	|ГДЕ
	|	Док.Организация = &Организация
	|	И Док.Сотрудник = &Сотрудник
	|	И Док.НомерИсполнительногоДокумента = &НомерИсполнительногоДокумента
	|	И (НЕ Док.ПометкаУдаления)";

	Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
	Запрос.УстановитьПараметр("Сотрудник", СотрудникСсылка);
	Запрос.УстановитьПараметр("НомерИсполнительногоДокумента", ДанныеДок.НомерИсполнительногоДокумента);

	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.ИсполнительныйЛист.ПустаяСсылка();

КонецФункции

// Сопоставление организации по ИНН/КПП, наименованию или создание новой
Функция НайтиИлиСоздатьОрганизацию(Знач ДанныеОрг, Знач СоздаватьНовые, Протокол)

	ИНН = СокрЛП(ДанныеОрг.ИНН);
	КПП = СокрЛП(ДанныеОрг.КПП);
	Наименование = СокрЛП(ДанныеОрг.Наименование);

	// 1. Поиск по ИНН и КПП
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Орг.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Орг
		|ГДЕ
		|	Орг.ИНН = &ИНН
		|	И (&КПП = """" ИЛИ Орг.КПП = &КПП ИЛИ Орг.КПП = """")";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 2. Поиск по точному наименованию
	ОрганизацияСсылка = Справочники.Организации.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		Возврат ОрганизацияСсылка;
	КонецЕсли;

	// 3. Создание новой организации при необходимости
	Если СоздаватьНовые Тогда
		НоваяОрг = Справочники.Организации.СоздатьЭлемент();
		НоваяОрг.Наименование = Наименование;
		НоваяОрг.НаименованиеПолное = Наименование;
		НоваяОрг.ИНН = ИНН;
		НоваяОрг.КПП = КПП;
		Если ДанныеОрг.Свойство("ОГРН") Тогда
			НоваяОрг.ОГРН = СокрЛП(ДанныеОрг.ОГРН);
		КонецЕсли;
		НоваяОрг.Записать();
		ЗаписатьВПротокол(Протокол, СтрШаблон("Создана новая организация: '%1' (ИНН: %2)", Наименование, ИНН), "Информация");
		Возврат НоваяОрг.Ссылка;
	КонецЕсли;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Сопоставление физического лица по СНИЛС, ИНН, ФИО + дате рождения
Функция НайтиИлиСоздатьФизЛицо(Знач ДанныеФизЛица, Знач СоздаватьНовые, Протокол)

	СНИЛС = СокрЛП(ДанныеФизЛица.СНИЛС);
	ИНН   = СокрЛП(ДанныеФизЛица.ИНН);
	ФИО   = СокрЛП(ДанныеФизЛица.ФИО);

	// 1. Поиск по СНИЛС (СтраховойНомерПФР)
	Если ЗначениеЗаполнено(СНИЛС) Тогда
		// Очистка СНИЛС от разделителей для точного сравнения
		СНИЛСОчищенный = СтрЗаменить(СтрЗаменить(СНИЛС, "-", ""), " ", "");
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ФЛ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФЛ
		|ГДЕ
		|	ФЛ.СтраховойНомерПФР = &СНИЛС
		|	И НЕ ФЛ.ПометкаУдаления";
		Запрос.УстановитьПараметр("СНИЛС", СНИЛС);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 2. Поиск по ИНН
	Если ЗначениеЗаполнено(ИНН) Тогда
		ФизЛицоСсылка = Справочники.ФизическиеЛица.НайтиПоРеквизиту("ИНН", ИНН);
		Если ЗначениеЗаполнено(ФизЛицоСсылка) Тогда
			Возврат ФизЛицоСсылка;
		КонецЕсли;
	КонецЕсли;

	// 3. Поиск по ФИО и дате рождения
	Если ЗначениеЗаполнено(ФИО) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ФЛ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФЛ
		|ГДЕ
		|	ФЛ.Наименование = &ФИО
		|	И (&ДатаРождения = ДАТАВРЕМЯ(1, 1, 1) ИЛИ ФЛ.ДатаРождения = &ДатаРождения)
		|	И НЕ ФЛ.ПометкаУдаления";
		Запрос.УстановитьПараметр("ФИО", ФИО);
		Запрос.УстановитьПараметр("ДатаРождения", ДанныеФизЛица.ДатаРождения);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 4. Создание нового физ. лица
	Если СоздаватьНовые Тогда
		НовоеФЛ = Справочники.ФизическиеЛица.СоздатьЭлемент();
		НовоеФЛ.Наименование = ФИО;
		НовоеФЛ.ФИО = ФИО;
		НовоеФЛ.ИНН = ИНН;
		НовоеФЛ.СтраховойНомерПФР = СНИЛС;
		НовоеФЛ.ДатаРождения = ДанныеФизЛица.ДатаРождения;
		Если ДанныеФизЛица.Свойство("Пол") И ЗначениеЗаполнено(ДанныеФизЛица.Пол) Тогда
			НовоеФЛ.Пол = ПолучитьЗначениеПеречисления("ПолФизическогоЛица", ДанныеФизЛица.Пол);
		КонецЕсли;
		НовоеФЛ.Записать();
		ЗаписатьВПротокол(Протокол, СтрШаблон("Создано новое физическое лицо: '%1' (СНИЛС: %2)", ФИО, СНИЛС), "Информация");
		Возврат НовоеФЛ.Ссылка;
	КонецЕсли;

	Возврат Справочники.ФизическиеЛица.ПустаяСсылка();

КонецФункции

// Сопоставление сотрудника по физ. лицу и организации
Функция НайтиИлиСоздатьСотрудника(Знач ДанныеСотрудника, Знач ФизЛицоСсылка, Знач ОрганизацияСсылка, Знач СоздаватьНовые, Протокол)

	ТабельныйНомер = СокрЛП(ДанныеСотрудника.ТабельныйНомер);
	Наименование   = СокрЛП(ДанныеСотрудника.Наименование);

	// 1. Поиск по физ. лицу и головной организации
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Сотр.Ссылка КАК Ссылка,
	|	Сотр.ВАрхиве КАК ВАрхиве
	|ИЗ
	|	Справочник.Сотрудники КАК Сотр
	|ГДЕ
	|	Сотр.ФизическоеЛицо = &ФизЛицо
	|	И (Сотр.ГоловнаяОрганизация = &Организация ИЛИ Сотр.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И НЕ Сотр.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Сотр.ВАрхиве ВОЗР";
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицоСсылка);
	Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);

	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// 2. Поиск по табельному номеру и организации
	Если ЗначениеЗаполнено(ТабельныйНомер) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сотр.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотр
		|ГДЕ
		|	Сотр.Код = &ТабельныйНомер
		|	И (Сотр.ГоловнаяОрганизация = &Организация ИЛИ Сотр.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|	И НЕ Сотр.ПометкаУдаления";
		Запрос.УстановитьПараметр("ТабельныйНомер", ТабельныйНомер);
		Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 3. Создание сотрудника при необходимости
	Если СоздаватьНовые Тогда
		НовыйСотр = Справочники.Сотрудники.СоздатьЭлемент();
		НовыйСотр.Наименование        = Наименование;
		НовыйСотр.ФизическоеЛицо      = ФизЛицоСсылка;
		НовыйСотр.ГоловнаяОрганизация = ОрганизацияСсылка;
		Если ЗначениеЗаполнено(ТабельныйНомер) Тогда
			НовыйСотр.Код = ТабельныйНомер;
		КонецЕсли;
		НовыйСотр.Записать();
		ЗаписатьВПротокол(Протокол, СтрШаблон("Создан новый сотрудник: '%1' в организации '%2'", Наименование, ОрганизацияСсылка), "Информация");
		Возврат НовыйСотр.Ссылка;
	КонецЕсли;

	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

// Сопоставление контрагента (получателя) по ИНН/КПП или наименованию
Функция НайтиИлиСоздатьКонтрагента(Знач ДанныеКонтрагента, Знач СоздаватьНовые, Протокол)

	ИНН = СокрЛП(ДанныеКонтрагента.ИНН);
	КПП = СокрЛП(ДанныеКонтрагента.КПП);
	Наименование = СокрЛП(ДанныеКонтрагента.Наименование);

	// 1. Поиск по ИНН и КПП
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.ИНН = &ИНН
		|	И (&КПП = """" ИЛИ К.КПП = &КПП ИЛИ К.КПП = """")
		|	И НЕ К.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 2. Поиск по точному наименованию
	КонтрагентСсылка = Справочники.Контрагенты.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат КонтрагентСсылка;
	КонецЕсли;

	// 3. Создание нового контрагента
	Если СоздаватьНовые Тогда
		НовыйК = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйК.Наименование       = Наименование;
		НовыйК.НаименованиеПолное = Наименование;
		НовыйК.ИНН                = ИНН;
		НовыйК.КПП                = КПП;
		НовыйК.ЮрФизЛицо          = ?(СтрДлина(ИНН) = 12, 
			ПолучитьЗначениеПеречисления("ЮрФизЛицо", "ФизЛицо"), 
			ПолучитьЗначениеПеречисления("ЮрФизЛицо", "ЮрЛицо"));
		НовыйК.Записать();
		ЗаписатьВПротокол(Протокол, СтрШаблон("Создан новый контрагент: '%1' (ИНН: %2)", Наименование, ИНН), "Информация");
		Возврат НовыйК.Ссылка;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Сопоставление или создание банковского счета контрагента
Функция НайтиИлиСоздатьБанковскийСчет(Знач ДанныеСчета, Знач КонтрагентСсылка, Знач СоздаватьНовые, Протокол)

	НомерСчета = СокрЛП(ДанныеСчета.НомерСчета);
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		Возврат Справочники.БанковскиеСчетаКонтрагентов.ПустаяСсылка();
	КонецЕсли;

	// Поиск существующего счета у данного контрагента
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчетаКонтрагентов КАК БС
	|ГДЕ
	|	БС.Владелец = &Владелец
	|	И БС.НомерСчета = &НомерСчета
	|	И НЕ БС.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", КонтрагентСсылка);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);

	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Создание нового банковского счета
	Если СоздаватьНовые Тогда
		НовыйСчет = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
		НовыйСчет.Владелец = КонтрагентСсылка;
		НовыйСчет.НомерСчета = НомерСчета;
		НовыйСчет.Наименование = "Расчетный счет " + НомерСчета;

		// Поиск банка по БИК
		БИК = СокрЛП(ДанныеСчета.БИК);
		Если ЗначениеЗаполнено(БИК) Тогда
			БанкСсылка = Справочники.КлассификаторБанков.НайтиПоКоду(БИК);
			Если ЗначениеЗаполнено(БанкСсылка) Тогда
				НовыйСчет.Банк = БанкСсылка;
			КонецЕсли;
		КонецЕсли;

		НовыйСчет.Записать();
		ЗаписатьВПротокол(Протокол, СтрШаблон("Создан банковский счет '%1' для контрагента '%2'", НомерСчета, КонтрагентСсылка), "Информация");
		Возврат НовыйСчет.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчетаКонтрагентов.ПустаяСсылка();

КонецФункции

// Сопоставление вида расчета удержания
Функция НайтиВидУдержания(Знач ДанныеУдержания, Знач СпособРасчетаИмя)

	// 1. Поиск по предопределенным удержаниям в зависимости от способа расчета
	Попытка
		Если Найти(ВРег(СпособРасчетаИмя), "ПРОЦЕНТ") > 0 Тогда
			Возврат ПланыВидовРасчета.Удержания.ИсполнительныйЛистПроцентом;
		ИначеЕсли Найти(ВРег(СпособРасчетаИмя), "ФИКСИРОВАН") > 0 Тогда
			Возврат ПланыВидовРасчета.Удержания.ИсполнительныйЛистФиксированнойСуммой;
		ИначеЕсли Найти(ВРег(СпособРасчетаИмя), "ДОЛЕЙ") > 0 Тогда
			Возврат ПланыВидовРасчета.Удержания.ИсполнительныйЛист;
		КонецЕсли;
	Исключение
		// Если предопределенные реквизиты имеют другие имена, продолжаем поиск
	КонецПопытки;

	// 2. Поиск по коду
	Если ЗначениеЗаполнено(ДанныеУдержания.Код) Тогда
		УдержаниеСсылка = ПланыВидовРасчета.Удержания.НайтиПоКоду(СокрЛП(ДанныеУдержания.Код));
		Если ЗначениеЗаполнено(УдержаниеСсылка) Тогда
			Возврат УдержаниеСсылка;
		КонецЕсли;
	КонецЕсли;

	// 3. Поиск по наименованию
	Если ЗначениеЗаполнено(ДанныеУдержания.Наименование) Тогда
		УдержаниеСсылка = ПланыВидовРасчета.Удержания.НайтиПоНаименованию(СокрЛП(ДанныеУдержания.Наименование), Истина);
		Если ЗначениеЗаполнено(УдержаниеСсылка) Тогда
			Возврат УдержаниеСсылка;
		КонецЕсли;
	КонецЕсли;

	// 4. Поиск первого удержания с категорией ИсполнительныйЛист
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Уд.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовРасчета.Удержания КАК Уд
	|ГДЕ
	|	Уд.КатегорияУдержания = ЗНАЧЕНИЕ(Перечисление.КатегорииУдержаний.ИсполнительныйЛист)
	|	И НЕ Уд.ПометкаУдаления";
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// 5. Стандартное предопределенное удержание ИсполнительныйЛист
	Попытка
		Возврат ПланыВидовРасчета.Удержания.ИсполнительныйЛист;
	Исключение
		Возврат ПланыВидовРасчета.Удержания.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Безопасное получение значения перечисления по имени
Функция ПолучитьЗначениеПеречисления(Знач ИмяПеречисления, Знач ИмяЗначения, Знач ЗначениеПоУмолчанию = Неопределено)

	Попытка
		ИмяОчищенное = СтрЗаменить(СокрЛП(ИмяЗначения), " ", "");
		Значение = Перечисления[ИмяПеречисления][ИмяОчищенное];
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
		// Значение перечисления не найдено по точному имени
	КонецПопытки;

	// Попытка найти первое значение перечисления или значение по умолчанию
	Если ЗначениеПоУмолчанию <> Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Попытка
		Мета = Метаданные.Перечисления[ИмяПеречисления];
		Если Мета.ЗначенияПеречисления.Количество() > 0 Тогда
			ПервоеИмя = Мета.ЗначенияПеречисления[0].Имя;
			Возврат Перечисления[ИмяПеречисления][ПервоеИмя];
		КонецЕсли;
	Исключение
		// Игнорируем
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Формирует строку подключения для COMConnector
Функция СформироватьСтрокуПодключения(Знач ПараметрыПодключения)

	Если ПараметрыПодключения.ТипПодключения = "Файловый" Тогда
		СтрокаПодключения = СтрШаблон("File=""%1"";Usr=""%2"";Pwd=""%3"";",
			ПараметрыПодключения.КаталогИБ,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль);
	Иначе
		СтрокаПодключения = СтрШаблон("Srvr=""%1"";Ref=""%2"";Usr=""%3"";Pwd=""%4"";",
			ПараметрыПодключения.Сервер1С,
			ПараметрыПодключения.ИмяБазы,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль);
	КонецЕсли;

	Возврат СтрокаПодключения;

КонецФункции

// Резервный запрос отбора действующих исполнительных листов
Функция ПолучитьТаблицуДокументовРезервныйЗапрос(НачалоДня, КонецДня, Организация, Сотрудник, ТолькоДействующиеПоДатам)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Истина КАК Пометка,
	|	Док.Ссылка КАК Документ,
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Организация.ИНН КАК ОрганизацияИНН,
	|	Док.Организация.КПП КАК ОрганизацияКПП,
	|	Док.Организация.Наименование КАК ОрганизацияНаименование,
	|	Док.Организация.ОГРН КАК ОрганизацияОГРН,
