	|	Док.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН,
	|	Док.ФизическоеЛицо.СтраховойНомерПФР КАК ФизическоеЛицоСНИЛС,
	|	Док.ФизическоеЛицо.ДатаРождения КАК ФизическоеЛицоДатаРождения,
	|	Док.ФизическоеЛицо.Наименование КАК ФизическоеЛицоФИО,
	|	Док.ФизическоеЛицо.Пол КАК ФизическоеЛицоПол,
	|	Док.Получатель КАК Получатель,
	|	Док.Получатель.ИНН КАК ПолучательИНН,
	|	Док.Получатель.КПП КАК ПолучательКПП,
	|	Док.Получатель.Наименование КАК ПолучательНаименование,
	|	Док.БанковскийСчет КАК БанковскийСчет,
	|	Док.БанковскийСчет.НомерСчета КАК БанковскийСчетНомерСчета,
	|	Док.БанковскийСчет.Банк.Код КАК БанковскийСчетБИК,
	|	Док.БанковскийСчет.Банк.Наименование КАК БанковскийСчетБанкНаименование,
	|	Док.БанковскийСчет.Банк.КоррСчет КАК БанковскийСчетКоррСчет,
	|	Док.ВидИсполнительногоДокумента КАК ВидИсполнительногоДокумента,
	|	Док.НомерИсполнительногоДокумента КАК НомерИсполнительногоДокумента,
	|	Док.ДатаВыдачи КАК ДатаВыдачи,
	|	Док.КемВыдан КАК КемВыдан,
	|	Док.СпособРасчета КАК СпособРасчета,
	|	Док.Удержание КАК Удержание,
	|	Док.Удержание.Код КАК УдержаниеКод,
	|	Док.Удержание.Наименование КАК УдержаниеНаименование,
	|	Док.Размер КАК Размер,
	|	Док.Процент КАК Процент,
	|	Док.Числитель КАК Числитель,
	|	Док.Знаменатель КАК Знаменатель,
	|	Док.ДатаНачала КАК ДатаНачала,
	|	Док.ДатаОкончания КАК ДатаОкончания,
	|	Док.ПрекратитьПоДостижениюПредела КАК ПрекратитьПоДостижениюПредела,
	|	Док.Предел КАК Предел,
	|	Док.УчитыватьБольничныеЛисты КАК УчитыватьБольничныеЛисты,
	|	Док.ПлатежныйАгент КАК ПлатежныйАгент,
	|	Док.ПлатежныйАгент.ИНН КАК ПлатежныйАгентИНН,
	|	Док.ПлатежныйАгент.КПП КАК ПлатежныйАгентКПП,
	|	Док.ПлатежныйАгент.Наименование КАК ПлатежныйАгентНаименование,
	|	Док.ТарифАгента КАК ТарифАгента,
	|	Док.ТарифАгента.Наименование КАК ТарифАгентаНаименование,
	|	Док.УдерживатьВознаграждениеАгента КАК УдерживатьВознаграждениеАгента,
	|	Док.ОчередностьВзыскания КАК ОчередностьВзыскания,
	|	Док.Комментарий КАК Комментарий,
	|	Док.Размер КАК РазмерИзРегистра,
	|	ИСТИНА КАК ДействуетПоРегистру,
	|	Док.ДатаОкончания КАК ДействуетДоПоРегистру,
	|	"""" КАК СтатусПереноса
	|ИЗ
	|	Документ.ИсполнительныйЛист КАК Док
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И НЕ Док.ПометкаУдаления
	|	И Док.ДатаНачала <= &КонецДня
	|	И (Док.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Док.ДатаОкончания >= &НачалоДня)
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ИЛИ Док.Организация = &Организация)
	|	И (&Сотрудник = НЕОПРЕДЕЛЕНО ИЛИ &Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) ИЛИ Док.Сотрудник = &Сотрудник)
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияНаименование,
	|	СотрудникНаименование,
	|	ДатаНачала";

	Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
	Запрос.УстановитьПараметр("КонецДня", КонецДня);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сериализация в XML
Функция СериализоватьТаблицуВXML(Знач ТаблицаДокументов, Знач ДатаПереноса)

	ЗаписьXML = Новый ЗаписьXML;
	ПараметрыЗаписи = Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь);
	ЗаписьXML.УстановитьСтроку("UTF-8");

	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("TransferData");
	ЗаписьXML.ЗаписатьАтрибут("Format", "Transfer_IspolnitelnyList_ZUP_ERP");
	ЗаписьXML.ЗаписатьАтрибут("Version", "1.0");
	ЗаписьXML.ЗаписатьАтрибут("ExportDate", XMLСтрока(ТекущаяДатаСеанса()));
	ЗаписьXML.ЗаписатьАтрибут("TransferDate", XMLСтрока(ДатаПереноса));
	ЗаписьXML.ЗаписатьАтрибут("SourceConfig", "1C:ZUP 3.1");
	ЗаписьXML.ЗаписатьАтрибут("TargetConfig", "1C:ERP 2");
	ЗаписьXML.ЗаписатьАтрибут("Count", XMLСтрока(ТаблицаДокументов.Количество()));

	ЗаписьXML.ЗаписатьНачалоЭлемента("Documents");

	Для Каждого Стр Из ТаблицаДокументов Цикл
		Если ТаблицаДокументов.Колонки.Найти("Пометка") <> Неопределено И Не Стр.Пометка Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьXML.ЗаписатьНачалоЭлемента("IspolnitelnyList");
		
		ГУИД = ?(ТаблицаДокументов.Колонки.Найти("Ссылка") <> Неопределено И ЗначениеЗаполнено(Стр.Ссылка),
			XMLСтрока(Стр.Ссылка.УникальныйИдентификатор()),
			Строка(Новый УникальныйИдентификатор));
		ЗаписьXML.ЗаписатьАтрибут("UUID", ГУИД);

		ЗаписатьЭлементXML(ЗаписьXML, "Number", Стр.Номер);
		ЗаписатьЭлементXML(ЗаписьXML, "Date", XMLСтрока(Стр.Дата));

		// Организация
		ЗаписьXML.ЗаписатьНачалоЭлемента("Organization");
		ЗаписатьЭлементXML(ЗаписьXML, "INN", Стр.ОрганизацияИНН);
		ЗаписатьЭлементXML(ЗаписьXML, "KPP", Стр.ОрганизацияКПП);
		ЗаписатьЭлементXML(ЗаписьXML, "Name", Стр.ОрганизацияНаименование);
		ЗаписатьЭлементXML(ЗаписьXML, "OGRN", Стр.ОрганизацияОГРН);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Organization

		// Физическое лицо
		ЗаписьXML.ЗаписатьНачалоЭлемента("Individual");
		ЗаписатьЭлементXML(ЗаписьXML, "INN", Стр.ФизическоеЛицоИНН);
		ЗаписатьЭлементXML(ЗаписьXML, "SNILS", Стр.ФизическоеЛицоСНИЛС);
		ЗаписатьЭлементXML(ЗаписьXML, "BirthDate", XMLСтрока(Стр.ФизическоеЛицоДатаРождения));
		ЗаписатьЭлементXML(ЗаписьXML, "FullName", Стр.ФизическоеЛицоФИО);
		ЗаписатьЭлементXML(ЗаписьXML, "Gender", XMLСтрока(Стр.ФизическоеЛицоПол));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Individual

		// Сотрудник
		ЗаписьXML.ЗаписатьНачалоЭлемента("Employee");
		ЗаписатьЭлементXML(ЗаписьXML, "PersonnelNumber", Стр.СотрудникТабельныйНомер);
		ЗаписатьЭлементXML(ЗаписьXML, "Name", Стр.СотрудникНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Employee

		// Получатель
		ЗаписьXML.ЗаписатьНачалоЭлемента("Recipient");
		ЗаписатьЭлементXML(ЗаписьXML, "INN", Стр.ПолучательИНН);
		ЗаписатьЭлементXML(ЗаписьXML, "KPP", Стр.ПолучательКПП);
		ЗаписатьЭлементXML(ЗаписьXML, "Name", Стр.ПолучательНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Recipient

		// Банковский счет
		ЗаписьXML.ЗаписатьНачалоЭлемента("BankAccount");
		ЗаписатьЭлементXML(ЗаписьXML, "AccountNumber", Стр.БанковскийСчетНомерСчета);
		ЗаписатьЭлементXML(ЗаписьXML, "BIC", Стр.БанковскийСчетБИК);
		ЗаписатьЭлементXML(ЗаписьXML, "BankName", Стр.БанковскийСчетБанкНаименование);
		ЗаписатьЭлементXML(ЗаписьXML, "CorrAccount", Стр.БанковскийСчетКоррСчет);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // BankAccount

		// Реквизиты исполнительного листа
		ЗаписатьЭлементXML(ЗаписьXML, "DocumentType", XMLСтрока(Стр.ВидИсполнительногоДокумента));
		ЗаписатьЭлементXML(ЗаписьXML, "DocumentNumber", Стр.НомерИсполнительногоДокумента);
		ЗаписатьЭлементXML(ЗаписьXML, "IssueDate", XMLСтрока(Стр.ДатаВыдачи));
		ЗаписатьЭлементXML(ЗаписьXML, "IssuedBy", Стр.КемВыдан);
		ЗаписатьЭлементXML(ЗаписьXML, "CalculationMethod", XMLСтрока(Стр.СпособРасчета));

		// Удержание
		ЗаписьXML.ЗаписатьНачалоЭлемента("Deduction");
		ЗаписатьЭлементXML(ЗаписьXML, "Code", Стр.УдержаниеКод);
		ЗаписатьЭлементXML(ЗаписьXML, "Name", Стр.УдержаниеНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Deduction

		ЗаписатьЭлементXML(ЗаписьXML, "Amount", XMLСтрока(Стр.Размер));
		ЗаписатьЭлементXML(ЗаписьXML, "Percent", XMLСтрока(Стр.Процент));
		ЗаписатьЭлементXML(ЗаписьXML, "Numerator", XMLСтрока(Стр.Числитель));
		ЗаписатьЭлементXML(ЗаписьXML, "Denominator", XMLСтрока(Стр.Знаменатель));
		ЗаписатьЭлементXML(ЗаписьXML, "StartDate", XMLСтрока(Стр.ДатаНачала));
		ЗаписатьЭлементXML(ЗаписьXML, "EndDate", XMLСтрока(Стр.ДатаОкончания));
		ЗаписатьЭлементXML(ЗаписьXML, "StopAtLimit", XMLСтрока(Стр.ПрекратитьПоДостижениюПредела));
		ЗаписатьЭлементXML(ЗаписьXML, "Limit", XMLСтрока(Стр.Предел));
		ЗаписатьЭлементXML(ЗаписьXML, "IncludeSickLeave", XMLСтрока(Стр.УчитыватьБольничныеЛисты));

		// Платежный агент
		ЗаписьXML.ЗаписатьНачалоЭлемента("PaymentAgent");
		ЗаписатьЭлементXML(ЗаписьXML, "INN", Стр.ПлатежныйАгентИНН);
		ЗаписатьЭлементXML(ЗаписьXML, "KPP", Стр.ПлатежныйАгентКПП);
		ЗаписатьЭлементXML(ЗаписьXML, "Name", Стр.ПлатежныйАгентНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // PaymentAgent

		ЗаписьXML.ЗаписатьНачалоЭлемента("AgentTariff");
		ЗаписатьЭлементXML(ЗаписьXML, "Name", Стр.ТарифАгентаНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // AgentTariff

		ЗаписатьЭлементXML(ЗаписьXML, "RetainAgentFee", XMLСтрока(Стр.УдерживатьВознаграждениеАгента));
		ЗаписатьЭлементXML(ЗаписьXML, "RecoveryPriority", XMLСтрока(Стр.ОчередностьВзыскания));
		ЗаписатьЭлементXML(ЗаписьXML, "Comment", Стр.Комментарий);

		// Сведения из регистра сведений ПлановыеУдержания
		ЗаписьXML.ЗаписатьНачалоЭлемента("PlannedDeductionsRegisterInfo");
		ЗаписатьЭлементXML(ЗаписьXML, "RegisterAmount", XMLСтрока(Стр.РазмерИзРегистра));
		ЗаписатьЭлементXML(ЗаписьXML, "IsActiveInRegister", XMLСтрока(Стр.ДействуетПоРегистру));
		ЗаписатьЭлементXML(ЗаписьXML, "ActiveUntilInRegister", XMLСтрока(Стр.ДействуетДоПоРегистру));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // PlannedDeductionsRegisterInfo

		ЗаписьXML.ЗаписатьКонецЭлемента(); // IspolnitelnyList
	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента(); // Documents
	ЗаписьXML.ЗаписатьКонецЭлемента(); // TransferData

	Возврат ЗаписьXML.Закрыть();

КонецФункции

// Вспомогательная процедура записи тега XML
Процедура ЗаписатьЭлементXML(ЗаписьXML, Знач Имя, Знач Значение)
	ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
	ЗаписьXML.ЗаписатьТекст(Строка(Значение));
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

// Сериализация в JSON
Функция СериализоватьТаблицуВJSON(Знач ТаблицаДокументов, Знач ДатаПереноса)

	Пакет = Новый Структура;
	Пакет.Вставить("Формат", "Transfer_IspolnitelnyList_ZUP_ERP");
	Пакет.Вставить("Версия", "1.0");
	Пакет.Вставить("ДатаВыгрузки", ТекущаяДатаСеанса());
	Пакет.Вставить("ДатаПереноса", ДатаПереноса);
	Пакет.Вставить("КонфигурацияИсточник", "1C:ZUP 3.1");
	Пакет.Вставить("КонфигурацияПриемник", "1C:ERP 2");

	МассивДокументов = Новый Массив;

	Для Каждого Стр Из ТаблицаДокументов Цикл
		Если ТаблицаДокументов.Колонки.Найти("Пометка") <> Неопределено И Не Стр.Пометка Тогда
			Продолжить;
		КонецЕсли;

		ДанныеДок = Новый Структура;
		ГУИД = ?(ТаблицаДокументов.Колонки.Найти("Ссылка") <> Неопределено И ЗначениеЗаполнено(Стр.Ссылка),
			Строка(Стр.Ссылка.УникальныйИдентификатор()),
			Строка(Новый УникальныйИдентификатор));
		ДанныеДок.Вставить("УникальныйИдентификатор", ГУИД);
		ДанныеДок.Вставить("Номер", Стр.Номер);
		ДанныеДок.Вставить("Дата", Стр.Дата);

		ДанныеДок.Вставить("Организация", Новый Структура("ИНН,КПП,Наименование,ОГРН",
			Стр.ОрганизацияИНН, Стр.ОрганизацияКПП, Стр.ОрганизацияНаименование, Стр.ОрганизацияОГРН));

		ДанныеДок.Вставить("ФизическоеЛицо", Новый Структура("ИНН,СНИЛС,ДатаРождения,ФИО,Пол",
			Стр.ФизическоеЛицоИНН, Стр.ФизическоеЛицоСНИЛС, Стр.ФизическоеЛицоДатаРождения,
			Стр.ФизическоеЛицоФИО, Строка(Стр.ФизическоеЛицоПол)));

		ДанныеДок.Вставить("Сотрудник", Новый Структура("ТабельныйНомер,Наименование",
			Стр.СотрудникТабельныйНомер, Стр.СотрудникНаименование));

		ДанныеДок.Вставить("Получатель", Новый Структура("ИНН,КПП,Наименование",
			Стр.ПолучательИНН, Стр.ПолучательКПП, Стр.ПолучательНаименование));

		ДанныеДок.Вставить("БанковскийСчет", Новый Структура("НомерСчета,БИК,БанкНаименование,КоррСчет",
			Стр.БанковскийСчетНомерСчета, Стр.БанковскийСчетБИК, Стр.БанковскийСчетБанкНаименование,
			Стр.БанковскийСчетКоррСчет));

		ДанныеДок.Вставить("ВидИсполнительногоДокумента", Строка(Стр.ВидИсполнительногоДокумента));
		ДанныеДок.Вставить("НомерИсполнительногоДокумента", Стр.НомерИсполнительногоДокумента);
		ДанныеДок.Вставить("ДатаВыдачи", Стр.ДатаВыдачи);
		ДанныеДок.Вставить("КемВыдан", Стр.КемВыдан);
		ДанныеДок.Вставить("СпособРасчета", Строка(Стр.СпособРасчета));

		ДанныеДок.Вставить("Удержание", Новый Структура("Код,Наименование",
			Стр.УдержаниеКод, Стр.УдержаниеНаименование));

		ДанныеДок.Вставить("Размер", Стр.Размер);
		ДанныеДок.Вставить("Процент", Стр.Процент);
		ДанныеДок.Вставить("Числитель", Стр.Числитель);
		ДанныеДок.Вставить("Знаменатель", Стр.Знаменатель);
		ДанныеДок.Вставить("ДатаНачала", Стр.ДатаНачала);
		ДанныеДок.Вставить("ДатаОкончания", Стр.ДатаОкончания);
		ДанныеДок.Вставить("ПрекратитьПоДостижениюПредела", Стр.ПрекратитьПоДостижениюПредела);
		ДанныеДок.Вставить("Предел", Стр.Предел);
		ДанныеДок.Вставить("УчитыватьБольничныеЛисты", Стр.УчитыватьБольничныеЛисты);

		ДанныеДок.Вставить("ПлатежныйАгент", Новый Структура("ИНН,КПП,Наименование",
			Стр.ПлатежныйАгентИНН, Стр.ПлатежныйАгентКПП, Стр.ПлатежныйАгентНаименование));

		ДанныеДок.Вставить("ТарифАгента", Новый Структура("Наименование", Стр.ТарифАгентаНаименование));

		ДанныеДок.Вставить("УдерживатьВознаграждениеАгента", Стр.УдерживатьВознаграждениеАгента);
		ДанныеДок.Вставить("ОчередностьВзыскания", Строка(Стр.ОчередностьВзыскания));
		ДанныеДок.Вставить("Комментарий", Стр.Комментарий);

		МассивДокументов.Добавить(ДанныеДок);
	КонецЦикла;

	Пакет.Вставить("КоличествоДокументов", МассивДокументов.Количество());
	Пакет.Вставить("Документы", МассивДокументов);

	Возврат ЗаписатьДанныеВJSON(Пакет);

КонецФункции

// Десериализация XML в структуру
Функция ДесериализоватьИзXML(Знач ТекстXML)

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);

	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();

	КорневойУзел = ДокументDOM.ЭлементДокумента;
	Если КорневойУзел.ИмяУзла <> "TransferData" Тогда
		ВызватьИсключение "Неверный формат XML: корневой узел должен быть 'TransferData'";
	КонецЕсли;

	Пакет = Новый Структура;
	Пакет.Вставить("Формат", КорневойУзел.ПолучитьАтрибут("Format"));
	Пакет.Вставить("Версия", КорневойУзел.ПолучитьАтрибут("Version"));

	МассивДокументов = Новый Массив;

	УзлыДокументов = КорневойУзел.ПолучитьЭлементыПоИмениИмени("IspolnitelnyList");
	Для Счетчик = 0 По УзлыДокументов.Количество() - 1 Цикл
		УзелДок = УзлыДокументов.Получить(Счетчик);

		ДанныеДок = Новый Структура;
		ДанныеДок.Вставить("УникальныйИдентификатор", УзелДок.ПолучитьАтрибут("UUID"));
		ДанныеДок.Вставить("Номер", ПолучитьЗначениеЭлементаDOM(УзелДок, "Number"));
		ДанныеДок.Вставить("Дата", XMLЗначение(Тип("Дата"), ПолучитьЗначениеЭлементаDOM(УзелДок, "Date")));

		// Организация
		УзелОрг = ПолучитьПервыйДочернийУзелDOM(УзелДок, "Organization");
		ДанныеОрг = Новый Структура("ИНН,КПП,Наименование,ОГРН",
			ПолучитьЗначениеЭлементаDOM(УзелОрг, "INN"),
			ПолучитьЗначениеЭлементаDOM(УзелОрг, "KPP"),
			ПолучитьЗначениеЭлементаDOM(УзелОрг, "Name"),
			ПолучитьЗначениеЭлементаDOM(УзелОрг, "OGRN"));
		ДанныеДок.Вставить("Организация", ДанныеОрг);

		// Физическое лицо
		УзелФЛ = ПолучитьПервыйДочернийУзелDOM(УзелДок, "Individual");
		ДанныеФЛ = Новый Структура("ИНН,СНИЛС,ДатаРождения,ФИО,Пол",
			ПолучитьЗначениеЭлементаDOM(УзелФЛ, "INN"),
			ПолучитьЗначениеЭлементаDOM(УзелФЛ, "SNILS"),
			XMLЗначение(Тип("Дата"), ПолучитьЗначениеЭлементаDOM(УзелФЛ, "BirthDate")),
			ПолучитьЗначениеЭлементаDOM(УзелФЛ, "FullName"),
			ПолучитьЗначениеЭлементаDOM(УзелФЛ, "Gender"));
		ДанныеДок.Вставить("ФизическоеЛицо", ДанныеФЛ);

		// Сотрудник
		УзелСотр = ПолучитьПервыйДочернийУзелDOM(УзелДок, "Employee");
		ДанныеСотр = Новый Структура("ТабельныйНомер,Наименование",
			ПолучитьЗначениеЭлементаDOM(УзелСотр, "PersonnelNumber"),
			ПолучитьЗначениеЭлементаDOM(УзелСотр, "Name"));
		ДанныеДок.Вставить("Сотрудник", ДанныеСотр);

		// Получатель
		УзелПолучатель = ПолучитьПервыйДочернийУзелDOM(УзелДок, "Recipient");
		ДанныеПолучатель = Новый Структура("ИНН,КПП,Наименование",
			ПолучитьЗначениеЭлементаDOM(УзелПолучатель, "INN"),
			ПолучитьЗначениеЭлементаDOM(УзелПолучатель, "KPP"),
			ПолучитьЗначениеЭлементаDOM(УзелПолучатель, "Name"));
		ДанныеДок.Вставить("Получатель", ДанныеПолучатель);

		// Банковский счет
		УзелСчет = ПолучитьПервыйДочернийУзелDOM(УзелДок, "BankAccount");
		ДанныеСчет = Новый Структура("НомерСчета,БИК,БанкНаименование,КоррСчет",
			ПолучитьЗначениеЭлементаDOM(УзелСчет, "AccountNumber"),
			ПолучитьЗначениеЭлементаDOM(УзелСчет, "BIC"),
			ПолучитьЗначениеЭлементаDOM(УзелСчет, "BankName"),
			ПолучитьЗначениеЭлементаDOM(УзелСчет, "CorrAccount"));
		ДанныеДок.Вставить("БанковскийСчет", ДанныеСчет);

		ДанныеДок.Вставить("ВидИсполнительногоДокумента", ПолучитьЗначениеЭлементаDOM(УзелДок, "DocumentType"));
		ДанныеДок.Вставить("НомерИсполнительногоДокумента", ПолучитьЗначениеЭлементаDOM(УзелДок, "DocumentNumber"));
		ДанныеДок.Вставить("ДатаВыдачи", XMLЗначение(Тип("Дата"), ПолучитьЗначениеЭлементаDOM(УзелДок, "IssueDate")));
		ДанныеДок.Вставить("КемВыдан", ПолучитьЗначениеЭлементаDOM(УзелДок, "IssuedBy"));
		ДанныеДок.Вставить("СпособРасчета", ПолучитьЗначениеЭлементаDOM(УзелДок, "CalculationMethod"));

		// Удержание
		УзелУд = ПолучитьПервыйДочернийУзелDOM(УзелДок, "Deduction");
		ДанныеУд = Новый Структура("Код,Наименование",
			ПолучитьЗначениеЭлементаDOM(УзелУд, "Code"),
			ПолучитьЗначениеЭлементаDOM(УзелУд, "Name"));
		ДанныеДок.Вставить("Удержание", ДанныеУд);

		ДанныеДок.Вставить("Размер", XMLЗначение(Тип("Число"), ПолучитьЗначениеЭлементаDOM(УзелДок, "Amount")));
		ДанныеДок.Вставить("Процент", XMLЗначение(Тип("Число"), ПолучитьЗначениеЭлементаDOM(УзелДок, "Percent")));
		ДанныеДок.Вставить("Числитель", XMLЗначение(Тип("Число"), ПолучитьЗначениеЭлементаDOM(УзелДок, "Numerator")));
		ДанныеДок.Вставить("Знаменатель", XMLЗначение(Тип("Число"), ПолучитьЗначениеЭлементаDOM(УзелДок, "Denominator")));
		ДанныеДок.Вставить("ДатаНачала", XMLЗначение(Тип("Дата"), ПолучитьЗначениеЭлементаDOM(УзелДок, "StartDate")));
		ДанныеДок.Вставить("ДатаОкончания", XMLЗначение(Тип("Дата"), ПолучитьЗначениеЭлементаDOM(УзелДок, "EndDate")));
		ДанныеДок.Вставить("ПрекратитьПоДостижениюПредела", XMLЗначение(Тип("Булево"), ПолучитьЗначениеЭлементаDOM(УзелДок, "StopAtLimit")));
		ДанныеДок.Вставить("Предел", XMLЗначение(Тип("Число"), ПолучитьЗначениеЭлементаDOM(УзелДок, "Limit")));
		ДанныеДок.Вставить("УчитыватьБольничныеЛисты", XMLЗначение(Тип("Булево"), ПолучитьЗначениеЭлементаDOM(УзелДок, "IncludeSickLeave")));

		// Платежный агент
		УзелАгент = ПолучитьПервыйДочернийУзелDOM(УзелДок, "PaymentAgent");
		ДанныеАгент = Новый Структура("ИНН,КПП,Наименование",
			ПолучитьЗначениеЭлементаDOM(УзелАгент, "INN"),
			ПолучитьЗначениеЭлементаDOM(УзелАгент, "KPP"),
			ПолучитьЗначениеЭлементаDOM(УзелАгент, "Name"));
		ДанныеДок.Вставить("ПлатежныйАгент", ДанныеАгент);

		УзелТариф = ПолучитьПервыйДочернийУзелDOM(УзелДок, "AgentTariff");
		ДанныеТариф = Новый Структура("Наименование", ПолучитьЗначениеЭлементаDOM(УзелТариф, "Name"));
		ДанныеДок.Вставить("ТарифАгента", ДанныеТариф);

		ДанныеДок.Вставить("УдерживатьВознаграждениеАгента", XMLЗначение(Тип("Булево"), ПолучитьЗначениеЭлементаDOM(УзелДок, "RetainAgentFee")));
		ДанныеДок.Вставить("ОчередностьВзыскания", ПолучитьЗначениеЭлементаDOM(УзелДок, "RecoveryPriority"));
		ДанныеДок.Вставить("Комментарий", ПолучитьЗначениеЭлементаDOM(УзелДок, "Comment"));

		МассивДокументов.Добавить(ДанныеДок);
	КонецЦикла;

	Пакет.Вставить("Документы", МассивДокументов);
	Возврат Пакет;

КонецФункции

// Вспомогательные функции работы с DOM
Функция ПолучитьЗначениеЭлементаDOM(УзелDOM, ИмяЭлемента)
	Если УзелDOM = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Список = УзелDOM.ПолучитьЭлементыПоИмениИмени(ИмяЭлемента);
	Если Список.Количество() > 0 Тогда
		Возврат СокрЛП(Список.Получить(0).ТекстовоеСодержимое);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьПервыйДочернийУзелDOM(УзелDOM, ИмяЭлемента)
	Если УзелDOM = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Список = УзелDOM.ПолучитьЭлементыПоИмениИмени(ИмяЭлемента);
	Если Список.Количество() > 0 Тогда
		Возврат Список.Получить(0);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Десериализация JSON
Функция ДесериализоватьИзJSON(Знач ТекстJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

// Сериализация объекта в JSON строку
Функция ЗаписатьДанныеВJSON(Знач Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Добавление записи в таблицу протокола
Процедура ЗаписатьВПротокол(Протокол, Знач Текст, Знач ТипСообщения = "Информация")

	Если Протокол = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяСтр = Протокол.Добавить();
	НоваяСтр.Время = ТекущаяДатаСеанса();
	НоваяСтр.Тип   = ТипСообщения;
	НоваяСтр.Текст = Текст;

КонецПроцедуры

// Инициализация таблицы протокола
Функция ИнициализироватьПротокол()

	Протокол = Новый ТаблицаЗначений;
	Протокол.Колонки.Добавить("Время", Новый ОписаниеТипов("Дата"));
	Протокол.Колонки.Добавить("Тип",   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Протокол.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));

	Возврат Протокол;

КонецФункции

// Формирование структуры команд для БСП
Функция ПолучитьТаблицуКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор",   Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование",   Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор",     Новый ОписаниеТипов("Строка"));

	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

