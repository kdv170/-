#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантБазы = "Файловая";
	ИмяCOMСоединителя = "V83.COMConnector";
	ТолькоРегистрыНДФЛ = Истина;
	РежимРегистраторов = "ИсходныеРегистраторы";
	ДействиеПриНенайденнойСсылке = "ПропускатьЗапись";
	СопоставлятьПоРеквизитам = Истина;
	ЗаменятьСуществующие = Истина;
	Период.ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
	Период.ДатаОкончания = КонецГода(ТекущаяДатаСеанса());
	
	ЗагрузитьНастройки();
	НастроитьЭлементыФормы();
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантБазыПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимРегистраторовПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогБазыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Выберите каталог информационной базы 1С:ЗУП'");
	Диалог.Каталог = КаталогБазы;
	Диалог.Показать(Новый ОписаниеОповещения("КаталогБазыНачалоВыбораЗавершение", ЭтотОбъект));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключиться(Команда)
	
	Если Не ПараметрыПодключенияЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Подключение к информационной базе 1С:ЗУП...'"));
	Если ПодключитьсяНаСервере() Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРегистры;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если Не ПараметрыПодключенияЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаРегистров.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Подключитесь к базе 1С:ЗУП и отметьте регистры для загрузки.'"));
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРегистры;
		Возврат;
	КонецЕсли;
	
	Если РежимРегистраторов = "ОдинДокумент" И Не ЗначениеЗаполнено(ДокументПриемник) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите документ ERP, в движения которого будут загружены записи.'"));
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПараметры;
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Записи отмеченных регистров будут загружены из 1С:ЗУП в текущую информационную базу.
		|Рекомендуется предварительно создать резервную копию. Продолжить?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	УстановитьПометкиРегистров(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьПометкиРегистров(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура КаталогБазыНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		КаталогБазы = ВыбранныеФайлы[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Выполняется загрузка данных из 1С:ЗУП...'"));
	ЗагрузитьНаСервере();
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПротокол;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Загрузка завершена'"), , НСтр("ru = 'Подробности - в протоколе.'"));
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодключенияЗаполнены()
	
	Если ВариантБазы = "Серверная" Тогда
		Если Не ЗначениеЗаполнено(СерверБазы) Или Не ЗначениеЗаполнено(ИмяБазы) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Укажите кластер серверов и имя информационной базы 1С:ЗУП.'"));
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПодключение;
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(КаталогБазы) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог информационной базы 1С:ЗУП.'"));
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПодключение;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиРегистров(Пометка)
	
	Для Каждого СтрокаТаблицы Из ТаблицаРегистров Цикл
		СтрокаТаблицы.Пометка = Пометка И СтрокаТаблицы.ЕстьВПриемнике;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПодключитьсяНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Соединение = Обработка.УстановитьСоединение(ПараметрыПодключения());
		ИнформацияОбИсточнике = Обработка.ОписаниеИсточника(Соединение);
		Регистры = Обработка.РегистрыИсточника(Соединение, ТолькоРегистрыНДФЛ);
		Соединение = Неопределено;
	Исключение
		ИнформацияОбИсточнике = "";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецПопытки;
	
	ОтмеченныеРанее = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ТаблицаРегистров Цикл
		Если СтрокаТаблицы.Пометка Тогда
			ОтмеченныеРанее.Вставить(СтрокаТаблицы.ТипРегистра + "." + СтрокаТаблицы.Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРегистров.Очистить();
	Для Каждого ОписаниеРегистра Из Регистры Цикл
		СтрокаТаблицы = ТаблицаРегистров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОписаниеРегистра);
		Если ОтмеченныеРанее.Количество() > 0 Тогда
			СтрокаТаблицы.Пометка = СтрокаТаблицы.ЕстьВПриемнике
				И ОтмеченныеРанее[СтрокаТаблицы.ТипРегистра + "." + СтрокаТаблицы.Имя] <> Неопределено;
		Иначе
			СтрокаТаблицы.Пометка = СтрокаТаблицы.ЕстьВПриемнике И ТолькоРегистрыНДФЛ;
		КонецЕсли;
	КонецЦикла;
	
	СохранитьНастройки();
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	Регистры = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаРегистров.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Регистры.Добавить(Новый Структура("ТипРегистра, Имя", СтрокаТаблицы.ТипРегистра, СтрокаТаблицы.Имя));
	КонецЦикла;
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ПараметрыПодключения", ПараметрыПодключения());
	ПараметрыЗагрузки.Вставить("Регистры", Регистры);
	ПараметрыЗагрузки.Вставить("НачалоПериода", Период.ДатаНачала);
	ПараметрыЗагрузки.Вставить("КонецПериода",
		?(ЗначениеЗаполнено(Период.ДатаОкончания), КонецДня(Период.ДатаОкончания), Дата(1, 1, 1)));
	ПараметрыЗагрузки.Вставить("ИННОрганизации", ?(ЗначениеЗаполнено(Организация), Организация.ИНН, ""));
	ПараметрыЗагрузки.Вставить("РежимРегистраторов", РежимРегистраторов);
	ПараметрыЗагрузки.Вставить("ДокументПриемник", ДокументПриемник);
	ПараметрыЗагрузки.Вставить("СоздаватьРегистраторы", СоздаватьРегистраторы);
	ПараметрыЗагрузки.Вставить("ДействиеПриНенайденнойСсылке", ДействиеПриНенайденнойСсылке);
	ПараметрыЗагрузки.Вставить("СопоставлятьПоРеквизитам", СопоставлятьПоРеквизитам);
	ПараметрыЗагрузки.Вставить("ЗаменятьСуществующие", ЗаменятьСуществующие);
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Протокол = СтрСоединить(Обработка.ЗагрузитьДанные(ПараметрыЗагрузки), Символы.ПС);
	
	СохранитьНастройки();
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПодключения()
	
	Результат = Новый Структура;
	Результат.Вставить("ВариантБазы", ВариантБазы);
	Результат.Вставить("КаталогБазы", КаталогБазы);
	Результат.Вставить("СерверБазы", СерверБазы);
	Результат.Вставить("ИмяБазы", ИмяБазы);
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИмяCOMСоединителя", ИмяCOMСоединителя);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Элементы.ВариантБазы.РежимВыбораИзСписка = Истина;
	Элементы.ВариантБазы.СписокВыбора.Добавить("Файловая", НСтр("ru = 'Файловая'"));
	Элементы.ВариантБазы.СписокВыбора.Добавить("Серверная", НСтр("ru = 'Клиент-серверная'"));
	
	Элементы.КаталогБазы.КнопкаВыбора = Истина;
	Элементы.СерверБазы.ПодсказкаВвода = НСтр("ru = 'Например: srv-1c или srv-1c:1541'");
	Элементы.Пароль.РежимПароля = Истина;
	Элементы.ИмяCOMСоединителя.Подсказка =
		НСтр("ru = 'ProgID COM-соединителя той же версии платформы, что и база ЗУП. Обычно V83.COMConnector.'");
	Элементы.ИмяCOMСоединителя.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	Элементы.ТолькоРегистрыНДФЛ.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Элементы.ИнформацияОбИсточнике.ТолькоПросмотр = Истина;
	
	Элементы.ГруппаОтбор.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	
	Элементы.ТаблицаРегистров.ИзменятьСоставСтрок = Ложь;
	Элементы.ТаблицаРегистров.ИзменятьПорядокСтрок = Ложь;
	Элементы.ТаблицаРегистровВидРегистра.ТолькоПросмотр = Истина;
	Элементы.ТаблицаРегистровИмя.ТолькоПросмотр = Истина;
	Элементы.ТаблицаРегистровСиноним.ТолькоПросмотр = Истина;
	Элементы.ТаблицаРегистровЕстьВПриемнике.ТолькоПросмотр = Истина;
	
	Элементы.РежимРегистраторов.РежимВыбораИзСписка = Истина;
	Элементы.РежимРегистраторов.СписокВыбора.Добавить("ИсходныеРегистраторы",
		НСтр("ru = 'Документы-регистраторы из ЗУП (поиск в ERP по идентификатору)'"));
	Элементы.РежимРегистраторов.СписокВыбора.Добавить("ОдинДокумент",
		НСтр("ru = 'Все записи - в движения одного документа ERP'"));
	
	Элементы.ДействиеПриНенайденнойСсылке.РежимВыбораИзСписка = Истина;
	Элементы.ДействиеПриНенайденнойСсылке.СписокВыбора.Добавить("ПропускатьЗапись",
		НСтр("ru = 'Не загружать запись'"));
	Элементы.ДействиеПриНенайденнойСсылке.СписокВыбора.Добавить("ПустаяСсылка",
		НСтр("ru = 'Загружать с пустым значением'"));
	Элементы.ДействиеПриНенайденнойСсылке.СписокВыбора.Добавить("ИсходнаяСсылка",
		НСтр("ru = 'Загружать ссылку с идентификатором из ЗУП (<Объект не найден>)'"));
	
	Для Каждого ИмяЭлемента Из СтрРазделить("СоздаватьРегистраторы,СопоставлятьПоРеквизитам,ЗаменятьСуществующие", ",") Цикл
		Элементы[ИмяЭлемента].ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	КонецЦикла;
	
	Элементы.Протокол.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Элементы.Протокол.МногострочныйРежим = Истина;
	Элементы.Протокол.Высота = 20;
	Элементы.Протокол.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Элементы = Форма.Элементы;
	
	ЭтоСервернаяБаза = (Форма.ВариантБазы = "Серверная");
	Элементы.КаталогБазы.Видимость = Не ЭтоСервернаяБаза;
	Элементы.СерверБазы.Видимость = ЭтоСервернаяБаза;
	Элементы.ИмяБазы.Видимость = ЭтоСервернаяБаза;
	
	ОдинДокумент = (Форма.РежимРегистраторов = "ОдинДокумент");
	Элементы.ДокументПриемник.Видимость = ОдинДокумент;
	Элементы.СоздаватьРегистраторы.Видимость = Не ОдинДокумент;
	
КонецПроцедуры

#Область Настройки

// Пароль в настройках не сохраняется.
&НаСервере
Процедура СохранитьНастройки()
	
	Настройки = Новый Структура;
	Настройки.Вставить("ВариантБазы", ВариантБазы);
	Настройки.Вставить("КаталогБазы", КаталогБазы);
	Настройки.Вставить("СерверБазы", СерверБазы);
	Настройки.Вставить("ИмяБазы", ИмяБазы);
	Настройки.Вставить("Пользователь", Пользователь);
	Настройки.Вставить("ИмяCOMСоединителя", ИмяCOMСоединителя);
	Настройки.Вставить("РежимРегистраторов", РежимРегистраторов);
	Настройки.Вставить("ДействиеПриНенайденнойСсылке", ДействиеПриНенайденнойСсылке);
	Настройки.Вставить("СоздаватьРегистраторы", СоздаватьРегистраторы);
	Настройки.Вставить("СопоставлятьПоРеквизитам", СопоставлятьПоРеквизитам);
	Настройки.Вставить("ЗаменятьСуществующие", ЗаменятьСуществующие);
	
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Параметры", Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()
	
	Настройки = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Параметры");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючНастроек()
	
	Возврат "ВнешняяОбработка.ЗагрузкаДанныхНДФЛИзЗУП";
	
КонецФункции

#КонецОбласти

#КонецОбласти
