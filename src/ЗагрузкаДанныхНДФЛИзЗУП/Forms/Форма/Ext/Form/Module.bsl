#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Установка значений по умолчанию
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	ДатаНачала = НачалоГода(ТекущаяДата);
	ДатаОкончания = КонецДня(ТекущаяДата);
	
	ФайловаяБаза = Ложь;
	СерверЗУП = "localhost";
	ИмяБазыЗУП = "zup";
	ПользовательЗУП = "Администратор";
	ПарольЗУП = "";
	КаталогБазы = "";
	
	СпособЗагрузки = "ОперацияУчетаНДФЛ";
	ПроводитьДокументы = Истина;
	СоздаватьНовыеФизлица = Истина;
	ЗаменятьСуществующие = Истина;
	
	ИмяРегистраЗУП = "СведенияОДоходахНДФЛ";
	
	ВсегоСтрок = 0;
	ВыбраноСтрок = 0;
	ОбщаяСуммаДохода = 0;
	ОбщаяСуммаВычетов = 0;
	УспешноЗагружено = 0;
	ОшибокЗагрузки = 0;
	
	// Восстановление сохраненных настроек пользователя
	ВосстановитьНастройкиПодключения();
	
	// Информация о текущей конфигурации
	ПредставлениеБазы = СтрШаблон("Текущая база: %1 (версия %2)",
		Метаданные.Синоним, Метаданные.Версия);
	СтатусПодключения = "Подключение к ЗУП не проверялось";
	
	ОбновитьВидимостьПодключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	СохранитьНастройкиПодключения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ФайловаяБазаПриИзменении(Элемент)
	
	ОбновитьВидимостьПодключения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьКаталог(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите каталог файловой информационной базы 1С:ЗУП";
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьКаталогЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		КаталогБазы = ВыбранныеФайлы[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	
	#Если ВебКлиент Или МобильныйКлиент Тогда
		ПоказатьПредупреждение(, "COM-соединение поддерживается только в тонком или толстом клиенте Windows.");
		Возврат;
	#Иначе
		Если Не ПроверитьЗаполнениеПараметровПодключения() Тогда
			Возврат;
		КонецЕсли;
		
		Состояние("Проверка COM-подключения к базе ЗУП...");
		
		СтрокиЖурнала = Новый Массив;
		Соединение = ОткрытьСоединениеCOM(СтрокиЖурнала);
		Если Соединение = Неопределено Тогда
			СтатусПодключения = "Ошибка подключения (см. журнал)";
			ДобавитьВЖурнал(СтрокиЖурнала);
			ПоказатьПредупреждение(, "Не удалось подключиться к базе 1С:ЗУП. Подробности см. в журнале.");
			Возврат;
		КонецЕсли;
		
		// Диагностика метаданных в подключенной базе
		Попытка
			ИмяКонфигурации = Строка(Соединение.Метаданные.Имя);
			СинонимКонфигурации = Строка(Соединение.Метаданные.Синоним);
			ВерсияКонфигурации = Строка(Соединение.Метаданные.Версия);
			
			// Проверяем наличие регистра доходов по НДФЛ
			ИмяРегистра = ОтределитьИмяРегистраВCOM(Соединение);
			Если Не ПустаяСтрока(ИмяРегистра) Тогда
				ИмяРегистраЗУП = ИмяРегистра;
				СообщениеРегистр = СтрШаблон("Найден регистр НДФЛ: '%1'.", ИмяРегистра);
			Иначе
				СообщениеРегистр = "ВНИМАНИЕ: Регистр учета доходов НДФЛ не найден в метаданных!";
			КонецЕсли;
			
			СтатусПодключения = СтрШаблон("Успешно подключено к '%1' (версия %2)", СинонимКонфигурации, ВерсияКонфигурации);
			
			СтрокиЖурнала.Добавить("=== Проверка подключения ===");
			СтрокиЖурнала.Добавить("Подключение успешно установлено.");
			СтрокиЖурнала.Добавить(СтрШаблон("Конфигурация источника: %1 (%2), версия %3.", СинонимКонфигурации, ИмяКонфигурации, ВерсияКонфигурации));
			СтрокиЖурнала.Добавить(СообщениеРегистр);
			
			ДобавитьВЖурнал(СтрокиЖурнала);
			ПоказатьОповещениеПользователя("COM-соединение", , "Подключение к 1С:ЗУП успешно установлено!", СтатусОповещенияПользователя.Информация);
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			СтатусПодключения = "Ошибка чтения метаданных ЗУП: " + ТекстОшибки;
			СтрокиЖурнала.Добавить(СтатусПодключения);
			ДобавитьВЖурнал(СтрокиЖурнала);
		КонецПопытки;
		
		Соединение = Неопределено;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзЗУП(Команда)
	
	#Если ВебКлиент Или МобильныйКлиент Тогда
		ПоказатьПредупреждение(, "COM-соединение поддерживается только в тонком или толстом клиенте Windows.");
		Возврат;
	#Иначе
		Если Не ПроверитьЗаполнениеПараметровПодключения() Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаНачала > ДатаОкончания Тогда
			ПоказатьПредупреждение(, "Дата начала периода не может быть больше даты окончания.");
			Возврат;
		КонецЕсли;
		
		ПараметрыОтбора = ПолучитьПараметрыОтбораНаСервере();
		
		Состояние("Чтение данных регистра НДФЛ из базы 1С:ЗУП по COM-соединению...");
		
		РезультатЧтения = ПрочитатьДанныеИзЗУПЧерезCOM(ПараметрыОтбора);
		Если Не РезультатЧтения.Успех Тогда
			ДобавитьВЖурнал(РезультатЧтения.Журнал);
			ПоказатьПредупреждение(, "Ошибка при чтении данных из ЗУП. См. журнал сообщений.");
			Возврат;
		КонецЕсли;
		
		ЗаполнитьТаблицуНаСервере(РезультатЧтения.Строки, РезультатЧтения.Журнал);
		
		ПересчитатьИтогиНаСервере();
		
		ПоказатьОповещениеПользователя(
			"Заполнение из ЗУП",
			,
			СтрШаблон("Прочитано записей: %1 на сумму %2 руб.", ВсегоСтрок, ОбщаяСуммаДохода),
			СтатусОповещенияПользователя.Информация);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВБазу(Команда)
	
	Если ВыбраноСтрок = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных строк для загрузки в ERP.");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗагрузки = ПолучитьПараметрыЗагрузкиНаСервере();
	
	Состояние("Загрузка данных НДФЛ в базу ERP...");
	
	Результат = ЗагрузитьДанныеВБазуERPНаСервере(ПараметрыЗагрузки);
	
	ПересчитатьИтогиНаСервере();
	
	ТекстИтога = СтрШаблон("Загружено строк: %1, ошибок: %2. Создано документов: %3.",
		Результат.Загружено, Результат.Ошибок, Результат.СозданоДокументов);
	
	ПоказатьОповещениеПользователя(
		"Загрузка в ERP завершена",
		,
		ТекстИтога,
		?(Результат.Ошибок = 0, СтатусОповещенияПользователя.Информация, СтатусОповещенияПользователя.Предупреждение));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	УстановитьПометкиТаблицы(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	УстановитьПометкиТаблицы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицу(Команда)
	
	ДанныеКЗагрузке.Очистить();
	ПересчитатьИтогиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВJSON(Команда)
	
	Если ДанныеКЗагрузке.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица данных пуста.");
		Возврат;
	КонецЕсли;
	
	ТекстJSON = ПолучитьJSONТаблицыНаСервере();
	ИмяФайла = СтрШаблон("ДанныеНДФЛ_%1.json", Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss"));
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить данные в JSON";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json|Все файлы (*.*)|*.*";
	Диалог.ПолноеИмяФайла = ИмяФайла;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВJSONЗавершение", ЭтотОбъект, ТекстJSON);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВJSONЗавершение(ВыбранныеФайлы, ТекстJSON) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
		Попытка
			ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
			ЗаписьТекста.Записать(ТекстJSON);
			ЗаписьТекста.Закрыть();
			ПоказатьОповещениеПользователя("Экспорт", , "Данные успешно выгружены в файл " + ПутьКФайлу, СтатусОповещенияПользователя.Информация);
		Исключение
			ПоказатьПредупреждение(, "Ошибка сохранения файла: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзJSON(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл JSON с данными НДФЛ";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json|Все файлы (*.*)|*.*";
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзJSONЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзJSONЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
		Попытка
			ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
			ТекстJSON = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
			ЗагрузитьJSONВТаблицуНаСервере(ТекстJSON);
			ПересчитатьИтогиНаСервере();
			ПоказатьОповещениеПользователя("Импорт", , "Данные успешно загружены из файла!", СтатусОповещенияПользователя.Информация);
		Исключение
			ПоказатьПредупреждение(, "Ошибка чтения файла: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЧтениеДанныхЧерезCOM

#Если Не ВебКлиент И Не МобильныйКлиент Тогда

&НаКлиенте
Функция ОткрытьСоединениеCOM(СтрокиЖурнала)
	
	Попытка
		Коннектор = Новый COMОбъект("V83.COMConnector");
	Исключение
		СтрокиЖурнала.Добавить("Ошибка создания объекта V83.COMConnector: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		СтрокиЖурнала.Добавить("Убедитесь, что:");
		СтрокиЖурнала.Добавить("1. Обработка выполняется в клиенте 1С под Windows (тонкий или толстый клиент).");
		СтрокиЖурнала.Добавить("2. Разрядность клиента 1С совпадает с разрядностью зарегистрированной библиотеки comcntr.dll (x86 или x64).");
		СтрокиЖурнала.Добавить("3. Для обработки отключено ограничение опасных действий платформы.");
		Возврат Неопределено;
	КонецПопытки;
	
	СтрокаСоединения = СформироватьСтрокуСоединенияCOM();
	
	Попытка
		Соединение = Коннектор.Connect(СтрокаСоединения);
		Возврат Соединение;
	Исключение
		СтрокиЖурнала.Добавить("Ошибка подключения к информационной базе ЗУП: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		СтрокиЖурнала.Добавить("Проверьте параметры подключения (сервер, имя базы или каталог файловой базы, имя пользователя и пароль).");
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция СформироватьСтрокуСоединенияCOM()
	
	Если ФайловаяБаза Тогда
		ОписаниеБазы = "File=""" + СтрЗаменить(СокрЛП(КаталогБазы), """", """""") + """;";
	Иначе
		ОписаниеБазы = "Srvr=""" + СтрЗаменить(СокрЛП(СерверЗУП), """", """""") + """;Ref="""
			+ СтрЗаменить(СокрЛП(ИмяБазыЗУП), """", """""") + """;";
	КонецЕсли;
	
	Возврат ОписаниеБазы
		+ "Usr=""" + СтрЗаменить(СокрЛП(ПользовательЗУП), """", """""") + """;"
		+ "Pwd=""" + СтрЗаменить(ПарольЗУП, """", """""") + """;";
	
КонецФункции

&НаКлиенте
Функция ОтределитьИмяРегистраВCOM(Соединение)
	
	Если Соединение.Метаданные.РегистрыНакопления.Найти("СведенияОДоходахНДФЛ") <> Неопределено Тогда
		Возврат "СведенияОДоходахНДФЛ";
	КонецЕсли;
	
	Если Соединение.Метаданные.РегистрыНакопления.Найти("УчетДоходовДляИсчисленияНДФЛ") <> Неопределено Тогда
		Возврат "УчетДоходовДляИсчисленияНДФЛ";
	КонецЕсли;
	
	Если Соединение.Метаданные.РегистрыНакопления.Найти("УчетДанныхДляНДФЛ") <> Неопределено Тогда
		Возврат "УчетДанныхДляНДФЛ";
	КонецЕсли;
	
	Для Индекс = 0 По Соединение.Метаданные.РегистрыНакопления.Количество() - 1 Цикл
		МДРег = Соединение.Метаданные.РегистрыНакопления.Получить(Индекс);
		Синоним = НРег(Строка(МДРег.Синоним));
		Если СтрНайти(Синоним, "учет доходов") > 0 И СтрНайти(Синоним, "ндфл") > 0 Тогда
			Возврат Строка(МДРег.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция СоздатьОбъектЗапросаCOM(Соединение)
	
	Попытка
		Возврат Соединение.NewObject("Query");
	Исключение
		Попытка
			Возврат Соединение.НовыйОбъект("Запрос");
		Исключение
			Попытка
				Возврат Соединение.NewObject("Запрос");
			Исключение
				Возврат Соединение.НовыйОбъект("Query");
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьДанныеИзЗУПЧерезCOM(ПараметрыОтбора)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("Журнал", Новый Массив);
	
	Соединение = ОткрытьСоединениеCOM(Результат.Журнал);
	Если Соединение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяРегистра = ОтределитьИмяРегистраВCOM(Соединение);
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Результат.Журнал.Добавить("В базе ЗУП не найден регистр учета доходов по НДФЛ.");
		Соединение = Неопределено;
		Возврат Результат;
	КонецЕсли;
	
	МДРегистра = Соединение.Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	
	// Проверяем состав полей регистра в базе ЗУП для безопасного построения запроса
	ЕстьПолеСотрудник = (МДРегистра.Измерения.Найти("Сотрудник") <> Неопределено Или МДРегистра.Реквизиты.Найти("Сотрудник") <> Неопределено);
	ЕстьПолеКатегорияДохода = (МДРегистра.Измерения.Найти("КатегорияДохода") <> Неопределено);
	ЕстьПолеСтавка = (МДРегистра.Измерения.Найти("СтавкаНалогообложенияРезидента") <> Неопределено);
	ЕстьПолеПодразделение = (МДРегистра.Измерения.Найти("Подразделение") <> Неопределено);
	ЕстьПолеПрибыль = (МДРегистра.Измерения.Найти("ВключатьВДекларациюПоНалогуНаПрибыль") <> Неопределено);
	ЕстьПолеДатаДохода = (МДРегистра.Реквизиты.Найти("ДатаПолученияДохода") <> Неопределено);
	ЕстьПолеМесяцПериода = (МДРегистра.Измерения.Найти("МесяцНалоговогоПериода") <> Неопределено);
	ЕстьПолеКодВычета = (МДРегистра.Реквизиты.Найти("КодВычета") <> Неопределено);
	ЕстьПолеСуммаВычета = (МДРегистра.Ресурсы.Найти("СуммаВычета") <> Неопределено Или МДРегистра.Реквизиты.Найти("СуммаВычета") <> Неопределено);
	ЕстьРесурсВычетТекущий = (МДРегистра.Ресурсы.Найти("УчитыватьВычетВТекущемМесяце") <> Неопределено);
	
	// Формируем текст запроса к регистру в ЗУП
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Рег.Период КАК Период,
		|	Рег.Регистратор КАК Регистратор,
		|	Рег.Организация КАК ОрганизацияСсылка,
		|	ЕСТЬNULL(Рег.Организация.ИНН, """") КАК ОрганизацияИНН,
		|	ЕСТЬNULL(Рег.Организация.КПП, """") КАК ОрганизацияКПП,
		|	ЕСТЬNULL(Рег.Организация.Наименование, """") КАК ОрганизацияНаименование,
		|	Рег.ФизическоеЛицо КАК ФизическоеЛицоСсылка,
		|	ЕСТЬNULL(Рег.ФизическоеЛицо.Наименование, """") КАК ФизическоеЛицоНаименование,
		|	ЕСТЬNULL(Рег.ФизическоеЛицо.ИНН, """") КАК ФизическоеЛицоИНН,
		|	ЕСТЬNULL(Рег.ФизическоеЛицо.СтраховойНомерПФР, """") КАК ФизическоеЛицоСНИЛС,
		|	ЕСТЬNULL(Рег.ФизическоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ФизическоеЛицоДатаРождения,
		|	" + ?(ЕстьПолеСотрудник, "Рег.Сотрудник КАК СотрудникСсылка, ЕСТЬNULL(Рег.Сотрудник.Наименование, """") КАК СотрудникНаименование, ЕСТЬNULL(Рег.Сотрудник.Код, """") КАК СотрудникКод", "НЕОПРЕДЕЛЕНО КАК СотрудникСсылка, """" КАК СотрудникНаименование, """" КАК СотрудникКод") + ",
		|	" + ?(ЕстьПолеДатаДохода, "Рег.ДатаПолученияДохода", "Рег.Период") + " КАК ДатаПолученияДохода,
		|	" + ?(ЕстьПолеМесяцПериода, "Рег.МесяцНалоговогоПериода", "НАЧАЛОПЕРИОДА(Рег.Период, МЕСЯЦ)") + " КАК МесяцНалоговогоПериода,
		|	Рег.КодДохода КАК КодДоходаСсылка,
		|	ЕСТЬNULL(Рег.КодДохода.Код, """") КАК КодДоходаКод,
		|	ЕСТЬNULL(Рег.КодДохода.Наименование, """") КАК КодДоходаНаименование,
		|	" + ?(ЕстьПолеКатегорияДохода, "Рег.КатегорияДохода", "НЕОПРЕДЕЛЕНО") + " КАК КатегорияДохода,
		|	" + ?(ЕстьПолеСтавка, "Рег.СтавкаНалогообложенияРезидента", "НЕОПРЕДЕЛЕНО") + " КАК СтавкаНалогообложения,
		|	Рег.Сумма КАК СуммаДохода,
		|	" + ?(ЕстьПолеКодВычета, "ЕСТЬNULL(Рег.КодВычета.Код, """")", """""") + " КАК КодВычетаКод,
		|	" + ?(ЕстьПолеСуммаВычета, "Рег.СуммаВычета", ?(ЕстьРесурсВычетТекущий, "Рег.УчитыватьВычетВТекущемМесяце", "0")) + " КАК СуммаВычета,
		|	" + ?(ЕстьПолеПодразделение, "ЕСТЬNULL(Рег.Подразделение.Наименование, """")", """""") + " КАК ПодразделениеНаименование,
		|	" + ?(ЕстьПолеПодразделение, "Рег.Подразделение", "НЕОПРЕДЕЛЕНО") + " КАК ПодразделениеСсылка,
		|	" + ?(ЕстьПолеПрибыль, "Рег.ВключатьВДекларациюПоНалогуНаПрибыль", "ЛОЖЬ") + " КАК ВключатьВДекларацию
		|ИЗ
		|	РегистрНакопления." + ИмяРегистра + " КАК Рег
		|ГДЕ
		|	Рег.Активность = ИСТИНА
		|	И (&БезОтбораПоПериоду ИЛИ Рег.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|	И (&БезОтбораПоОрганизации ИЛИ Рег.Организация.ИНН = &ОрганизацияИНН)
		|	И (&БезОтбораПоФизЛицу ИЛИ Рег.ФизическоеЛицо.ИНН = &ФизЛицоИНН ИЛИ Рег.ФизическоеЛицо.СтраховойНомерПФР ПОДОБНО &ФизЛицоСНИЛС ИЛИ Рег.ФизическоеЛицо.Наименование = &ФизЛицоФИО)";
	
	Попытка
		ЗапросCOM = СоздатьОбъектЗапросаCOM(Соединение);
		ЗапросCOM.Текст = ТекстЗапроса;
		
		ЕстьОтборПоПериоду = ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания);
		ЗапросCOM.УстановитьПараметр("БезОтбораПоПериоду", Не ЕстьОтборПоПериоду);
		ЗапросCOM.УстановитьПараметр("ДатаНачала", ?(ЕстьОтборПоПериоду, НачалоДня(ДатаНачала), Дата(1, 1, 1)));
		ЗапросCOM.УстановитьПараметр("ДатаОкончания", ?(ЕстьОтборПоПериоду, КонецДня(ДатаОкончания), Дата(1, 1, 1)));
		
		ЗапросCOM.УстановитьПараметр("БезОтбораПоОрганизации", Не ПараметрыОтбора.ОтборПоОрганизации);
		ЗапросCOM.УстановитьПараметр("ОрганизацияИНН", ПараметрыОтбора.ОрганизацияИНН);
		
		ЗапросCOM.УстановитьПараметр("БезОтбораПоФизЛицу", Не ПараметрыОтбора.ОтборПоФизЛицу);
		ЗапросCOM.УстановитьПараметр("ФизЛицоИНН", ПараметрыОтбора.ФизЛицоИНН);
		ЗапросCOM.УстановитьПараметр("ФизЛицоСНИЛС", "%" + ПараметрыОтбора.ФизЛицоСНИЛС + "%");
		ЗапросCOM.УстановитьПараметр("ФизЛицоФИО", ПараметрыОтбора.ФизЛицоФИО);
		
		РезультатЗапросаCOM = ЗапросCOM.Выполнить();
		ВыборкаCOM = РезультатЗапросаCOM.Выбрать();
		
		СчетчикСтрок = 0;
		Пока ВыборкаCOM.Следующий() Цикл
			СчетчикСтрок = СчетчикСтрок + 1;
			
			СтрокаДанных = Новый Структура;
			СтрокаДанных.Вставить("ИдентификаторСтроки", "СТР_" + Строка(СчетчикСтрок));
			СтрокаДанных.Вставить("Пометка", Истина);
			СтрокаДанных.Вставить("Статус", "К загрузке");
			СтрокаДанных.Вставить("Сообщение", "");
			
			СтрокаДанных.Вставить("Период", ВыборкаCOM.Период);
			СтрокаДанных.Вставить("ДатаПолученияДохода", ВыборкаCOM.ДатаПолученияДохода);
			СтрокаДанных.Вставить("МесяцНалоговогоПериода", ВыборкаCOM.МесяцНалоговогоПериода);
			
			// Организация
			СтрокаДанных.Вставить("ОрганизацияНаименование", СокрЛП(ВыборкаCOM.ОрганизацияНаименование));
			СтрокаДанных.Вставить("ОрганизацияИНН", СокрЛП(ВыборкаCOM.ОрганизацияИНН));
			СтрокаДанных.Вставить("ОрганизацияКПП", СокрЛП(ВыборкаCOM.ОрганизацияКПП));
			Попытка
				СтрокаДанных.Вставить("ОрганизацияУИД", Строка(Соединение.XMLСтрока(ВыборкаCOM.ОрганизацияСсылка)));
			Исключение
				СтрокаДанных.Вставить("ОрганизацияУИД", "");
			КонецПопытки;
			
			// Физическое лицо
			СтрокаДанных.Вставить("ФизическоеЛицоНаименование", СокрЛП(ВыборкаCOM.ФизическоеЛицоНаименование));
			СтрокаДанных.Вставить("ФизическоеЛицоИНН", СокрЛП(ВыборкаCOM.ФизическоеЛицоИНН));
			СтрокаДанных.Вставить("ФизическоеЛицоСНИЛС", СокрЛП(ВыборкаCOM.ФизическоеЛицоСНИЛС));
			СтрокаДанных.Вставить("ФизическоеЛицоДатаРождения", ВыборкаCOM.ФизическоеЛицоДатаРождения);
			Попытка
				СтрокаДанных.Вставить("ФизическоеЛицоУИД", Строка(Соединение.XMLСтрока(ВыборкаCOM.ФизическоеЛицоСсылка)));
			Исключение
				СтрокаДанных.Вставить("ФизическоеЛицоУИД", "");
			КонецПопытки;
			
			// Сотрудник
			СтрокаДанных.Вставить("СотрудникНаименование", СокрЛП(ВыборкаCOM.СотрудникНаименование));
			СтрокаДанных.Вставить("СотрудникКод", СокрЛП(ВыборкаCOM.СотрудникКод));
			Попытка
				СтрокаДанных.Вставить("СотрудникУИД", ?(ВыборкаCOM.СотрудникСсылка <> Неопределено, Строка(Соединение.XMLСтрока(ВыборкаCOM.СотрудникСсылка)), ""));
			Исключение
				СтрокаДанных.Вставить("СотрудникУИД", "");
			КонецПопытки;
			
			// Доход и вычеты
			СтрокаДанных.Вставить("КодДохода", СокрЛП(ВыборкаCOM.КодДоходаКод));
			СтрокаДанных.Вставить("НаименованиеДохода", СокрЛП(ВыборкаCOM.КодДоходаНаименование));
			
			Попытка
				СтрокаДанных.Вставить("КатегорияДохода", ?(ВыборкаCOM.КатегорияДохода <> Неопределено, Строка(Соединение.XMLСтрока(ВыборкаCOM.КатегорияДохода)), ""));
			Исключение
				СтрокаДанных.Вставить("КатегорияДохода", "");
			КонецПопытки;
			
			Попытка
				СтрокаДанных.Вставить("СтавкаНалогообложения", ?(ВыборкаCOM.СтавкаНалогообложения <> Неопределено, Строка(Соединение.XMLСтрока(ВыборкаCOM.СтавкаНалогообложения)), ""));
			Исключение
				СтрокаДанных.Вставить("СтавкаНалогообложения", "");
			КонецПопытки;
			
			СтрокаДанных.Вставить("СуммаДохода", Число(ВыборкаCOM.СуммаДохода));
			СтрокаДанных.Вставить("КодВычета", СокрЛП(ВыборкаCOM.КодВычетаКод));
			СтрокаДанных.Вставить("СуммаВычета", Число(ВыборкаCOM.СуммаВычета));
			
			// Прочие реквизиты
			СтрокаДанных.Вставить("ПодразделениеНаименование", СокрЛП(ВыборкаCOM.ПодразделениеНаименование));
			Попытка
				СтрокаДанных.Вставить("ПодразделениеУИД", ?(ВыборкаCOM.ПодразделениеСсылка <> Неопределено, Строка(Соединение.XMLСтрока(ВыборкаCOM.ПодразделениеСсылка)), ""));
			Исключение
				СтрокаДанных.Вставить("ПодразделениеУИД", "");
			КонецПопытки;
			
			СтрокаДанных.Вставить("ВключатьВДекларациюПоНалогуНаПрибыль", Булево(ВыборкаCOM.ВключатьВДекларацию));
			СтрокаДанных.Вставить("РегистраторПредставление", Строка(ВыборкаCOM.Регистратор));
			
			Результат.Строки.Добавить(СтрокаДанных);
		КонецЦикла;
		
		Результат.Успех = Истина;
		Результат.Журнал.Добавить(СтрШаблон("Успешно прочитано строк из ЗУП: %1.", СчетчикСтрок));
		
	Исключение
		Результат.Журнал.Добавить("Ошибка выполнения запроса к ЗУП: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Успех = Ложь;
	КонецПопытки;
	
	Соединение = Неопределено;
	Возврат Результат;
	
КонецФункции

#КонецЕсли

#КонецОбласти

#Область СлужебныеСерверныеПроцедуры

&НаСервере
Функция ПолучитьПараметрыОтбораНаСервере()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОтборПоОрганизации", ЗначениеЗаполнено(Организация));
	ПараметрыОтбора.Вставить("ОрганизацияИНН", ?(ЗначениеЗаполнено(Организация), Организация.ИНН, ""));
	
	ПараметрыОтбора.Вставить("ОтборПоФизЛицу", ЗначениеЗаполнено(ФизическоеЛицо));
	ПараметрыОтбора.Вставить("ФизЛицоИНН", ?(ЗначениеЗаполнено(ФизическоеЛицо), ФизическоеЛицо.ИНН, ""));
	
	СНИЛС = "";
	Если ЗначениеЗаполнено(ФизическоеЛицо) И ФизическоеЛицо.Метаданные().Реквизиты.Найти("СтраховойНомерПФР") <> Неопределено Тогда
		СНИЛС = СтрЗаменить(СтрЗаменить(ФизическоеЛицо.СтраховойНомерПФР, "-", ""), " ", "");
	КонецЕсли;
	ПараметрыОтбора.Вставить("ФизЛицоСНИЛС", СНИЛС);
	ПараметрыОтбора.Вставить("ФизЛицоФИО", ?(ЗначениеЗаполнено(ФизическоеЛицо), ФизическоеЛицо.Наименование, ""));
	
	Возврат ПараметрыОтбора;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыЗагрузкиНаСервере()
	
	Параметры = Новый Структура;
	Параметры.Вставить("СпособЗагрузки", СпособЗагрузки);
	Параметры.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	Параметры.Вставить("СоздаватьНовыеФизлица", СоздаватьНовыеФизлица);
	Параметры.Вставить("ЗаменятьСуществующие", ЗаменятьСуществующие);
	Возврат Параметры;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере(МассивСтрок, ЖурналЧтения)
	
	ДанныеКЗагрузке.Очистить();
	
	Для Каждого Стр Данных Из МассивСтрок Цикл
		НоваяСтрока = ДанныеКЗагрузке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	Для Каждого Сообщение Из ЖурналЧтения Цикл
		ДобавитьСообщениеВЖурналСервер(Сообщение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьДанныеВБазуERPНаСервере(ПараметрыЗагрузки)
	
	ТаблицаДанных = ДанныеКЗагрузке.Выгрузить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ЗагрузитьДанныеВERP(ТаблицаДанных, ПараметрыЗагрузки);
	
	// Обновляем статусы и сообщения в строках формы
	Для Каждого СтрокаФормы Из ДанныеКЗагрузке Цикл
		Инфо = Результат.РезультатыСтрок[СтрокаФормы.ИдентификаторСтроки];
		Если Инфо <> Неопределено Тогда
			СтрокаФормы.Статус = Инфо.Статус;
			СтрокаФормы.Сообщение = Инфо.Сообщение;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Сообщение Из Результат.Журнал Цикл
		ДобавитьСообщениеВЖурналСервер(Сообщение);
	КонецЦикла;
	
	УспешноЗагружено = Результат.Загружено;
	ОшибокЗагрузки = Результат.Ошибок;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПересчитатьИтогиНаСервере()
	
	ВсегоСтрок = ДанныеКЗагрузке.Количество();
	Выбрано = 0;
	СуммаДох = 0;
	СуммаВыч = 0;
	
	Для Каждого Стр Из ДанныеКЗагрузке Цикл
		Если Стр.Пометка Тогда
			Выбрано = Выбрано + 1;
			СуммаДох = СуммаДох + Стр.СуммаДохода;
			СуммаВыч = СуммаВыч + Стр.СуммаВычета;
		КонецЕсли;
	КонецЦикла;
	
	ВыбраноСтрок = Выбрано;
	ОбщаяСуммаДохода = СуммаДох;
	ОбщаяСуммаВычетов = СуммаВыч;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСообщениеВЖурналСервер(Сообщение)
	
	Текст = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss") + " " + Сообщение;
	Если ПустаяСтрока(Журнал) Тогда
		Журнал = Текст;
	Иначе
		Журнал = Журнал + Символы.ПС + Текст;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьJSONТаблицыНаСервере()
	
	Таблица = ДанныеКЗагрузке.Выгрузить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ВыгрузитьВJSON(Таблица);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьJSONВТаблицуНаСервере(ТекстJSON)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МассивСтрок = ОбработкаОбъект.ЗагрузитьИзJSON(ТекстJSON);
	
	ДанныеКЗагрузке.Очистить();
	Счетчик = 0;
	Для Каждого Стр Данных Из МассивСтрок Цикл
		Счетчик = Счетчик + 1;
		НоваяСтрока = ДанныеКЗагрузке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		Если ПустаяСтрока(НоваяСтрока.ИдентификаторСтроки) Тогда
			НоваяСтрока.ИдентификаторСтроки = "СТР_" + Строка(Счетчик);
		КонецЕсли;
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.Статус = "К загрузке";
	КонецЦикла;
	
	ДобавитьСообщениеВЖурналСервер(СтрШаблон("Загружено %1 строк из файла JSON.", Счетчик));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПодключения()
	
	Элементы.ГруппаПутьФайловойБазы.Видимость = ФайловаяБаза;
	Элементы.ГруппаКлиентСервер.Видимость = Не ФайловаяБаза;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиПодключения()
	
	Настройки = Новый Структура;
	Настройки.Вставить("ФайловаяБаза", ФайловаяБаза);
	Настройки.Вставить("КаталогБазы", КаталогБазы);
	Настройки.Вставить("СерверЗУП", СерверЗУП);
	Настройки.Вставить("ИмяБазыЗУП", ИмяБазыЗУП);
	Настройки.Вставить("ПользовательЗУП", ПользовательЗУП);
	Настройки.Вставить("СпособЗагрузки", СпособЗагрузки);
	Настройки.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	Настройки.Вставить("СоздаватьНовыеФизлица", СоздаватьНовыеФизлица);
	Настройки.Вставить("ЗаменятьСуществующие", ЗаменятьСуществующие);
	
	ХранилищеОбщихНастроек.Сохранить("ЗагрузкаДанныхНДФЛИзЗУП", "ПараметрыПодключения", Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиПодключения()
	
	Настройки = ХранилищеОбщихНастроек.Загрузить("ЗагрузкаДанныхНДФЛИзЗУП", "ПараметрыПодключения");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Если Настройки.Свойство("ФайловаяБаза") Тогда ФайловаяБаза = Настройки.ФайловаяБаза; КонецЕсли;
		Если Настройки.Свойство("КаталогБазы") Тогда КаталогБазы = Настройки.КаталогБазы; КонецЕсли;
		Если Настройки.Свойство("СерверЗУП") Тогда СерверЗУП = Настройки.СерверЗУП; КонецЕсли;
		Если Настройки.Свойство("ИмяБазыЗУП") Тогда ИмяБазыЗУП = Настройки.ИмяБазыЗУП; КонецЕсли;
		Если Настройки.Свойство("ПользовательЗУП") Тогда ПользовательЗУП = Настройки.ПользовательЗУП; КонецЕсли;
		Если Настройки.Свойство("СпособЗагрузки") Тогда СпособЗагрузки = Настройки.СпособЗагрузки; КонецЕсли;
		Если Настройки.Свойство("ПроводитьДокументы") Тогда ПроводитьДокументы = Настройки.ПроводитьДокументы; КонецЕсли;
		Если Настройки.Свойство("СоздаватьНовыеФизлица") Тогда СоздаватьНовыеФизлица = Настройки.СоздаватьНовыеФизлица; КонецЕсли;
		Если Настройки.Свойство("ЗаменятьСуществующие") Тогда ЗаменятьСуществующие = Настройки.ЗаменятьСуществующие; КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеКлиентскиеПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПараметровПодключения()
	
	Если ФайловаяБаза Тогда
		Если ПустаяСтрока(СокрЛП(КаталогБазы)) Тогда
			ПоказатьПредупреждение(, "Укажите каталог файловой информационной базы 1С:ЗУП.");
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если ПустаяСтрока(СокрЛП(СерверЗУП)) Тогда
			ПоказатьПредупреждение(, "Укажите сервер 1С:Предприятия базы ЗУП.");
			Возврат Ложь;
		КонецЕсли;
		Если ПустаяСтрока(СокрЛП(ИмяБазыЗУП)) Тогда
			ПоказатьПредупреждение(, "Укажите имя информационной базы ЗУП на сервере.");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиТаблицы(ЗначениеПометки)
	
	Для Каждого Стр Из ДанныеКЗагрузке Цикл
		Стр.Пометка = ЗначениеПометки;
	КонецЦикла;
	
	ПересчитатьИтогиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВЖурнал(СтрокиЖурнала)
	
	Если ТипЗнч(СтрокиЖурнала) = Тип("Массив") Тогда
		Для Каждого Строка Из СтрокиЖурнала Цикл
			ДобавитьСообщениеВЖурналСервер(Строка);
		КонецЦикла;
	Иначе
		ДобавитьСообщениеВЖурналСервер(СтрокиЖурнала);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
