#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ИмяРегистра = "УчетДоходовДляИсчисленияНДФЛ";
	КонецЕсли;
	Если НачалоПериода = Дата(1, 1, 1) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если КонецПериода = Дата(1, 1, 1) Тогда
		КонецПериода = КонецМесяца(ТекущаяДата());
	КонецЕсли;
	Если МаксимумСтрок = 0 Тогда
		МаксимумСтрок = 100000;
	КонецЕсли;
	ТестовыйРежим = Истина;
	Статус = "Сначала выполните проверку подключения.";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)
	
	Статус = "Проверка подключения...";
	Результат = ПроверитьНаСервере();
	Статус = Результат.Сообщение;
	Если Результат.Успех Тогда
		Сообщить(Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если Не ТестовыйРежим Тогда
		ТекстВопроса = "Данные ERP будут замещены наборами записей из ЗУП "
			+ "по каждому найденному регистратору. Продолжить?";
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Статус = ?(ТестовыйРежим,
		"Проверка данных без записи...",
		"Выполняется загрузка...");
	Результат = ЗагрузитьНаСервере();
	Статус = Результат.Сообщение;
	
	Если Результат.Успех Тогда
		Сообщить(Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедуры

&НаСервере
Функция ПроверитьНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПроверитьПодключение(ПараметрыЗагрузки());
	
КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.Загрузить(ПараметрыЗагрузки());
	
КонецФункции

&НаСервере
Функция ПараметрыЗагрузки()
	
	Возврат Новый Структура(
		"СтрокаСоединения,ИмяРегистра,НачалоПериода,КонецПериода,МаксимумСтрок,ТестовыйРежим",
		СтрокаСоединения,
		ИмяРегистра,
		НачалоПериода,
		КонецПериода,
		МаксимумСтрок,
		ТестовыйРежим);
	
КонецФункции

#КонецОбласти
