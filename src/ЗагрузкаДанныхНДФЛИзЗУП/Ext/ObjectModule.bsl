#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем МаксимумСообщенийОдногоВида;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает COM-соединение с информационной базой 1С:ЗУП.
//
// Параметры:
//  ПараметрыПодключения - Структура:
//   * ВариантБазы - Строка - "Файловая" или "Серверная".
//   * КаталогБазы - Строка - каталог файловой информационной базы.
//   * СерверБазы - Строка - адрес кластера серверов 1С:Предприятия.
//   * ИмяБазы - Строка - имя информационной базы в кластере.
//   * Пользователь - Строка
//   * Пароль - Строка
//   * ИмяCOMСоединителя - Строка - например, "V83.COMConnector".
//
// Возвращаемое значение:
//  COMОбъект - соединение с информационной базой-источником.
//
Функция УстановитьСоединение(ПараметрыПодключения) Экспорт
	
	ИмяCOMСоединителя = СокрЛП(ПараметрыПодключения.ИмяCOMСоединителя);
	Если Не ЗначениеЗаполнено(ИмяCOMСоединителя) Тогда
		ИмяCOMСоединителя = "V83.COMConnector";
	КонецЕсли;
	
	Попытка
		COMСоединитель = Новый COMОбъект(ИмяCOMСоединителя);
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось создать COM-объект ""%1"".
			|Проверьте, что компонента comcntr.dll зарегистрирована на компьютере, где выполняется загрузка
			|(для клиент-серверной базы ERP - на сервере 1С:Предприятия), и ее версия совпадает с версией платформы.
			|%2'"),
			ИмяCOMСоединителя,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Соединение = COMСоединитель.Connect(СтрокаСоединения(ПараметрыПодключения));
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось подключиться к информационной базе 1С:ЗУП:
			|%1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции

// Возвращает представление конфигурации информационной базы-источника.
//
// Параметры:
//  Соединение - COMОбъект - см. УстановитьСоединение.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеИсточника(Соединение) Экспорт
	
	МетаданныеИсточника = Соединение.Метаданные;
	Возврат СтрШаблон(НСтр("ru = '%1 (%2), версия %3'"),
		МетаданныеИсточника.Синоним, МетаданныеИсточника.Имя, МетаданныеИсточника.Версия);
	
КонецФункции

// Возвращает список регистров накопления и сведений информационной базы-источника.
//
// Параметры:
//  Соединение - COMОбъект - см. УстановитьСоединение.
//  ТолькоРегистрыНДФЛ - Булево - отбирать только регистры, в имени или синониме которых есть "НДФЛ".
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ТипРегистра, ВидРегистра, Имя, Синоним, ЕстьВПриемнике.
//
Функция РегистрыИсточника(Соединение, ТолькоРегистрыНДФЛ) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипРегистра", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ВидРегистра", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЕстьВПриемнике", Новый ОписаниеТипов("Булево"));
	
	ДобавитьРегистрыИсточника(Результат, Соединение.Метаданные.РегистрыНакопления,
		"РегистрНакопления", НСтр("ru = 'Регистр накопления'"), Метаданные.РегистрыНакопления, ТолькоРегистрыНДФЛ);
	ДобавитьРегистрыИсточника(Результат, Соединение.Метаданные.РегистрыСведений,
		"РегистрСведений", НСтр("ru = 'Регистр сведений'"), Метаданные.РегистрыСведений, ТолькоРегистрыНДФЛ);
	
	Результат.Сортировать("ТипРегистра, Имя");
	Возврат Результат;
	
КонецФункции

// Загружает записи регистров из информационной базы 1С:ЗУП в текущую информационную базу.
//
// Параметры:
//  ПараметрыЗагрузки - Структура:
//   * ПараметрыПодключения - Структура - см. УстановитьСоединение.
//   * Регистры - Массив из Структура - со свойствами ТипРегистра ("РегистрНакопления", "РегистрСведений") и Имя.
//   * НачалоПериода - Дата - пустая дата - без ограничения.
//   * КонецПериода - Дата - пустая дата - без ограничения.
//   * ИННОрганизации - Строка - отбор записей источника по ИНН организации, пустая строка - без отбора.
//   * РежимРегистраторов - Строка - "ИсходныеРегистраторы" или "ОдинДокумент".
//   * ДокументПриемник - ДокументСсылка - регистратор для режима "ОдинДокумент".
//   * СоздаватьРегистраторы - Булево - создавать в приемнике ненайденные документы-регистраторы.
//   * ДействиеПриНенайденнойСсылке - Строка - "ПропускатьЗапись", "ПустаяСсылка" или "ИсходнаяСсылка".
//   * СопоставлятьПоРеквизитам - Булево - искать ненайденные элементы справочников по ИНН/КПП и наименованию.
//   * ЗаменятьСуществующие - Булево - заменять существующие записи приемника.
//
// Возвращаемое значение:
//  Массив из Строка - протокол загрузки.
//
Функция ЗагрузитьДанные(ПараметрыЗагрузки) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("Параметры", ПараметрыЗагрузки);
	Контекст.Вставить("Соединение", Неопределено);
	Контекст.Вставить("Протокол", Новый Массив);
	Контекст.Вставить("СчетчикиСообщений", Новый Соответствие);
	Контекст.Вставить("КэшЗначений", Новый Соответствие);
	Контекст.Вставить("КэшТипов", Новый Соответствие);
	Контекст.Вставить("КэшРегистраторов", Новый Соответствие);
	Контекст.Вставить("ЕстьНенайденныеЗначения", Ложь);
	
	ДобавитьВПротокол(Контекст, НСтр("ru = 'Начало загрузки.'"));
	
	Попытка
		Контекст.Соединение = УстановитьСоединение(ПараметрыЗагрузки.ПараметрыПодключения);
	Исключение
		ДобавитьВПротокол(Контекст, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Контекст.Протокол;
	КонецПопытки;
	
	ДобавитьВПротокол(Контекст, СтрШаблон(НСтр("ru = 'Подключено к базе-источнику: %1'"),
		ОписаниеИсточника(Контекст.Соединение)));
	
	Для Каждого ОписаниеРегистра Из ПараметрыЗагрузки.Регистры Цикл
		Попытка
			ЗагрузитьРегистр(Контекст, ОписаниеРегистра);
		Исключение
			Пока ТранзакцияАктивна() Цикл
				ОтменитьТранзакцию();
			КонецЦикла;
			ДобавитьВПротокол(Контекст, СтрШаблон(НСтр("ru = 'Ошибка при загрузке регистра %1.%2:
				|%3'"),
				ОписаниеРегистра.ТипРегистра, ОписаниеРегистра.Имя,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;
	
	Контекст.Соединение = Неопределено;
	ДобавитьВПротокол(Контекст, НСтр("ru = 'Загрузка завершена.'"));
	
	Возврат Контекст.Протокол;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Подключение

Функция СтрокаСоединения(ПараметрыПодключения)
	
	Части = Новый Массив;
	Если ПараметрыПодключения.ВариантБазы = "Серверная" Тогда
		Части.Добавить(ПараметрСтрокиСоединения("Srvr", СокрЛП(ПараметрыПодключения.СерверБазы)));
		Части.Добавить(ПараметрСтрокиСоединения("Ref", СокрЛП(ПараметрыПодключения.ИмяБазы)));
	Иначе
		Части.Добавить(ПараметрСтрокиСоединения("File", СокрЛП(ПараметрыПодключения.КаталогБазы)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПодключения.Пользователь) Тогда
		Части.Добавить(ПараметрСтрокиСоединения("Usr", СокрЛП(ПараметрыПодключения.Пользователь)));
		Части.Добавить(ПараметрСтрокиСоединения("Pwd", ПараметрыПодключения.Пароль));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ";") + ";";
	
КонецФункции

Функция ПараметрСтрокиСоединения(Имя, Значение)
	
	Возврат Имя + "=""" + СтрЗаменить(Значение, """", """""") + """";
	
КонецФункции

Процедура ДобавитьРегистрыИсточника(Таблица, КоллекцияИсточника, ТипРегистра, ВидРегистра,
	КоллекцияПриемника, ТолькоРегистрыНДФЛ)
	
	Для Индекс = 0 По КоллекцияИсточника.Количество() - 1 Цикл
		ОбъектМетаданных = КоллекцияИсточника.Получить(Индекс);
		Имя = ОбъектМетаданных.Имя;
		Синоним = ОбъектМетаданных.Синоним;
		
		Если ТолькоРегистрыНДФЛ
			И СтрНайти(ВРег(Имя), "НДФЛ") = 0
			И СтрНайти(ВРег(Синоним), "НДФЛ") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.ТипРегистра = ТипРегистра;
		НоваяСтрока.ВидРегистра = ВидРегистра;
		НоваяСтрока.Имя = Имя;
		НоваяСтрока.Синоним = Синоним;
		НоваяСтрока.ЕстьВПриемнике = (КоллекцияПриемника.Найти(Имя) <> Неопределено);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаРегистра

Процедура ЗагрузитьРегистр(Контекст, ОписаниеРегистра)
	
	Параметры = Контекст.Параметры;
	ПолноеИмя = ОписаниеРегистра.ТипРегистра + "." + ОписаниеРегистра.Имя;
	ДобавитьВПротокол(Контекст, СтрШаблон(НСтр("ru = 'Загрузка регистра %1.'"), ПолноеИмя));
	
	МетаданныеПриемника = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МетаданныеПриемника = Неопределено Тогда
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Регистр %1 отсутствует в текущей конфигурации, загрузка пропущена.'"), ПолноеИмя));
		Возврат;
	КонецЕсли;
	
	МетаданныеИсточника = Контекст.Соединение.Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МетаданныеИсточника = Неопределено Тогда
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Регистр %1 отсутствует в базе-источнике, загрузка пропущена.'"), ПолноеИмя));
		Возврат;
	КонецЕсли;
	
	ЭтоРегистрНакопления = (ОписаниеРегистра.ТипРегистра = "РегистрНакопления");
	Если ЭтоРегистрНакопления Тогда
		ПодчиненРегистратору = Истина;
		Периодический = Истина;
		ЕстьВидДвижения = (МетаданныеПриемника.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки);
	Иначе
		ПодчиненРегистратору = (МетаданныеПриемника.РежимЗаписи
			= Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору);
		Периодический = (МетаданныеПриемника.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
		ЕстьВидДвижения = Ложь;
	КонецЕсли;
	
	ОдинДокумент = ПодчиненРегистратору И Параметры.РежимРегистраторов = "ОдинДокумент";
	Если ОдинДокумент И Не ДокументПриемникПодходит(Контекст, МетаданныеПриемника) Тогда
		Возврат;
	КонецЕсли;
	
	Поля = ПоляДляПереноса(Контекст, МетаданныеПриемника, МетаданныеИсточника,
		Периодический, ПодчиненРегистратору, ЕстьВидДвижения);
	
	Запрос = ЗапросКИсточнику(Контекст, ПолноеИмя, Поля, МетаданныеИсточника, Периодический, ПодчиненРегистратору);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Статистика = Новый Структура("Прочитано, Записано, Пропущено", 0, 0, 0);
	ИндексРегистратора = Поля.Найти("Регистратор");
	
	ОписаниеНабора = Неопределено;
	КлючТекущегоРегистратора = Неопределено;
	Если ОдинДокумент Тогда
		ОписаниеНабора = НовыйНаборЗаписей(ЭтоРегистрНакопления, ОписаниеРегистра.Имя,
			Параметры.ДокументПриемник, Параметры.ЗаменятьСуществующие);
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		Статистика.Прочитано = Статистика.Прочитано + 1;
		
		Если ПодчиненРегистратору И Не ОдинДокумент Тогда
			РегистраторИсточника = Выборка.Получить(ИндексРегистратора);
			КлючРегистратора = КлючЗначенияИсточника(Контекст, РегистраторИсточника);
			Если КлючРегистратора <> КлючТекущегоРегистратора Тогда
				ЗаписатьНаборЗаписей(Контекст, ОписаниеНабора, Статистика, ПолноеИмя);
				КлючТекущегоРегистратора = КлючРегистратора;
				ДокументРегистратор = РегистраторПриемника(Контекст, РегистраторИсточника, МетаданныеПриемника);
				Если ДокументРегистратор = Неопределено Тогда
					ОписаниеНабора = Неопределено;
				Иначе
					ОписаниеНабора = НовыйНаборЗаписей(ЭтоРегистрНакопления, ОписаниеРегистра.Имя,
						ДокументРегистратор, Параметры.ЗаменятьСуществующие);
				КонецЕсли;
			КонецЕсли;
			
			Если ОписаниеНабора = Неопределено Тогда
				Статистика.Пропущено = Статистика.Пропущено + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЗначенияПолей = ЗначенияПолейЗаписи(Контекст, Выборка, Поля);
		Если ЗначенияПолей = Неопределено Тогда
			Статистика.Пропущено = Статистика.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Если ПодчиненРегистратору Тогда
			ЗаполнитьЗначенияСвойств(ОписаниеНабора.Набор.Добавить(), ЗначенияПолей);
			ОписаниеНабора.Добавлено = ОписаниеНабора.Добавлено + 1;
		Иначе
			ЗаписатьНезависимуюЗапись(Контекст, ОписаниеРегистра.Имя, ЗначенияПолей, Статистика, ПолноеИмя);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьНаборЗаписей(Контекст, ОписаниеНабора, Статистика, ПолноеИмя);
	
	ДобавитьВПротокол(Контекст, СтрШаблон(
		НСтр("ru = 'Регистр %1: прочитано записей - %2, записано - %3, пропущено - %4.'"),
		ПолноеИмя, Статистика.Прочитано, Статистика.Записано, Статистика.Пропущено));
	
КонецПроцедуры

Функция ДокументПриемникПодходит(Контекст, МетаданныеРегистра)
	
	ДокументПриемник = Контекст.Параметры.ДокументПриемник;
	Если Не ЗначениеЗаполнено(ДокументПриемник) Тогда
		ДобавитьВПротокол(Контекст, НСтр("ru = 'Не указан документ-регистратор в ERP, загрузка регистра пропущена.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ДокументПриемник.Метаданные().Движения.Содержит(МетаданныеРегистра) Тогда
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Документ ""%1"" не является регистратором регистра %2, загрузка регистра пропущена.'"),
			ДокументПриемник, МетаданныеРегистра.ПолноеИмя()));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Возвращает имена полей, общих для регистра источника и приемника.
// Стандартные поля (Период, Регистратор, Активность, ВидДвижения) идут первыми.
//
Функция ПоляДляПереноса(Контекст, МетаданныеПриемника, МетаданныеИсточника,
	Периодический, ПодчиненРегистратору, ЕстьВидДвижения)
	
	Поля = Новый Массив;
	Если ПодчиненРегистратору Тогда
		Поля.Добавить("Регистратор");
		Поля.Добавить("Активность");
	КонецЕсли;
	Если Периодический Тогда
		Поля.Добавить("Период");
	КонецЕсли;
	Если ЕстьВидДвижения Тогда
		Поля.Добавить("ВидДвижения");
	КонецЕсли;
	
	ПоляИсточника = ПоляРегистраИсточника(МетаданныеИсточника);
	ПолноеИмя = МетаданныеПриемника.ПолноеИмя();
	
	КоллекцииПолей = Новый Массив;
	КоллекцииПолей.Добавить(МетаданныеПриемника.Измерения);
	КоллекцииПолей.Добавить(МетаданныеПриемника.Ресурсы);
	КоллекцииПолей.Добавить(МетаданныеПриемника.Реквизиты);
	
	Для Каждого КоллекцияПолей Из КоллекцииПолей Цикл
		Для Каждого ПолеПриемника Из КоллекцияПолей Цикл
			Если ПоляИсточника[ПолеПриемника.Имя] = Неопределено Тогда
				ДобавитьВПротокол(Контекст, СтрШаблон(
					НСтр("ru = 'Регистр %1: поле ""%2"" отсутствует в базе-источнике и будет заполнено значением по умолчанию.'"),
					ПолноеИмя, ПолеПриемника.Имя));
			Иначе
				Поля.Добавить(ПолеПриемника.Имя);
				ПоляИсточника.Удалить(ПолеПриемника.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ПолеИсточника Из ПоляИсточника Цикл
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Регистр %1: поле источника ""%2"" отсутствует в ERP и не переносится.'"),
			ПолноеИмя, ПолеИсточника.Ключ));
	КонецЦикла;
	
	Возврат Поля;
	
КонецФункции

Функция ПоляРегистраИсточника(МетаданныеИсточника)
	
	Результат = Новый Соответствие;
	
	КоллекцииПолей = Новый Массив;
	КоллекцииПолей.Добавить(МетаданныеИсточника.Измерения);
	КоллекцииПолей.Добавить(МетаданныеИсточника.Ресурсы);
	КоллекцииПолей.Добавить(МетаданныеИсточника.Реквизиты);
	
	Для Каждого КоллекцияПолей Из КоллекцииПолей Цикл
		Для Индекс = 0 По КоллекцияПолей.Количество() - 1 Цикл
			Результат.Вставить(КоллекцияПолей.Получить(Индекс).Имя, Истина);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросКИсточнику(Контекст, ПолноеИмя, Поля, МетаданныеИсточника, Периодический, ПодчиненРегистратору)
	
	Параметры = Контекст.Параметры;
	Запрос = Контекст.Соединение.NewObject("Запрос");
	
	ТекстПолей = Новый Массив;
	Для Каждого ИмяПоля Из Поля Цикл
		ТекстПолей.Добавить("	Т." + ИмяПоля + " КАК " + ИмяПоля);
	КонецЦикла;
	
	Условия = Новый Массив;
	Если Периодический Тогда
		Если ЗначениеЗаполнено(Параметры.НачалоПериода) Тогда
			Условия.Добавить("Т.Период >= &НачалоПериода");
			Запрос.УстановитьПараметр("НачалоПериода", Параметры.НачалоПериода);
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметры.КонецПериода) Тогда
			Условия.Добавить("Т.Период <= &КонецПериода");
			Запрос.УстановитьПараметр("КонецПериода", Параметры.КонецПериода);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ИННОрганизации) Тогда
		ПоляИсточника = ПоляРегистраИсточника(МетаданныеИсточника);
		Если ПоляИсточника["Организация"] <> Неопределено Тогда
			ПолеОрганизации = "Организация";
		ИначеЕсли ПоляИсточника["ГоловнаяОрганизация"] <> Неопределено Тогда
			ПолеОрганизации = "ГоловнаяОрганизация";
		Иначе
			ПолеОрганизации = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПолеОрганизации) Тогда
			Условия.Добавить("Т." + ПолеОрганизации + ".ИНН = &ИННОрганизации");
			Запрос.УстановитьПараметр("ИННОрганизации", Параметры.ИННОрганизации);
		Иначе
			ДобавитьВПротокол(Контекст, СтрШаблон(
				НСтр("ru = 'Регистр %1 не содержит поля ""Организация"", отбор по организации не применяется.'"),
				ПолноеИмя));
		КонецЕсли;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ" + Символы.ПС
		+ СтрСоединить(ТекстПолей, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	" + ПолноеИмя + " КАК Т";
	
	Если Условия.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ГДЕ" + Символы.ПС
			+ "	" + СтрСоединить(Условия, Символы.ПС + "	И ");
	КонецЕсли;
	
	Если ПодчиненРегистратору Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС
			+ "	Т.Регистратор," + Символы.ПС + "	Т.НомерСтроки";
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Возврат Запрос;
	
КонецФункции

// Возвращает структуру значений полей записи в терминах приемника
// или Неопределено, если запись нужно пропустить из-за ненайденных значений.
//
Функция ЗначенияПолейЗаписи(Контекст, Выборка, Поля)
	
	Контекст.ЕстьНенайденныеЗначения = Ложь;
	Результат = Новый Структура;
	
	Для Индекс = 0 По Поля.ВГраница() Цикл
		ИмяПоля = Поля[Индекс];
		Если ИмяПоля = "Регистратор" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(ИмяПоля, ЗначениеВПриемнике(Контекст, Выборка.Получить(Индекс)));
	КонецЦикла;
	
	Если Контекст.ЕстьНенайденныеЗначения
		И Контекст.Параметры.ДействиеПриНенайденнойСсылке = "ПропускатьЗапись" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗаписьДанных

Функция НовыйНаборЗаписей(ЭтоРегистрНакопления, ИмяРегистра, Регистратор, ЗаменятьСуществующие)
	
	Если ЭтоРегистрНакопления Тогда
		Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
	Иначе
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	КонецЕсли;
	Набор.Отбор.Регистратор.Установить(Регистратор);
	
	Если Не ЗаменятьСуществующие Тогда
		Набор.Прочитать();
	КонецЕсли;
	
	Возврат Новый Структура("Набор, Регистратор, Добавлено", Набор, Регистратор, 0);
	
КонецФункции

Процедура ЗаписатьНаборЗаписей(Контекст, ОписаниеНабора, Статистика, ПолноеИмя)
	
	// Пустой набор не записывается, чтобы не удалить существующие движения регистратора.
	Если ОписаниеНабора = Неопределено Или ОписаниеНабора.Добавлено = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Набор = ОписаниеНабора.Набор;
	Набор.ОбменДанными.Загрузка = Истина;
	
	Попытка
		Набор.Записать(Истина);
		Статистика.Записано = Статистика.Записано + ОписаниеНабора.Добавлено;
	Исключение
		Статистика.Пропущено = Статистика.Пропущено + ОписаниеНабора.Добавлено;
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Регистр %1: не удалось записать движения документа ""%2"":
			|%3'"),
			ПолноеИмя, ОписаниеНабора.Регистратор, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"ОшибкаЗаписи" + ПолноеИмя);
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьНезависимуюЗапись(Контекст, ИмяРегистра, ЗначенияПолей, Статистика, ПолноеИмя)
	
	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ЗначенияПолей);
	
	Попытка
		МенеджерЗаписи.Записать(Контекст.Параметры.ЗаменятьСуществующие);
		Статистика.Записано = Статистика.Записано + 1;
	Исключение
		Статистика.Пропущено = Статистика.Пропущено + 1;
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Регистр %1: не удалось записать запись:
			|%2'"),
			ПолноеИмя, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"ОшибкаЗаписи" + ПолноеИмя);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Регистраторы

// Возвращает документ ERP, в движения которого переносятся записи исходного регистратора,
// или Неопределено, если записи этого регистратора нужно пропустить.
//
Функция РегистраторПриемника(Контекст, РегистраторИсточника, МетаданныеРегистра)
	
	КлючКэша = МетаданныеРегистра.ПолноеИмя() + "|" + КлючЗначенияИсточника(Контекст, РегистраторИсточника);
	Если Контекст.КэшРегистраторов[КлючКэша] <> Неопределено Тогда
		Возврат Контекст.КэшРегистраторов[КлючКэша].Значение;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Соединение = Контекст.Соединение;
	ТипXML = Соединение.XMLТипЗнч(РегистраторИсточника);
	ТипРегистратора = ТипПриемника(Контекст, ТипXML.ИмяТипа, ТипXML.URIПространстваИмен);
	Представление = ПредставлениеЗначенияИсточника(Контекст, РегистраторИсточника);
	
	Если ТипРегистратора <> Неопределено Тогда
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипРегистратора);
		Если МетаданныеДокумента = Неопределено
			Или Не Метаданные.Документы.Содержит(МетаданныеДокумента)
			Или Не МетаданныеДокумента.Движения.Содержит(МетаданныеРегистра) Тогда
			
			ДобавитьВПротокол(Контекст, СтрШаблон(
				НСтр("ru = 'Регистр %1: документ ""%2"" не является регистратором регистра в ERP, его движения пропущены.'"),
				МетаданныеРегистра.ПолноеИмя(), Представление),
				"НеРегистратор" + МетаданныеРегистра.ПолноеИмя());
		Иначе
			Ссылка = XMLЗначение(ТипРегистратора, Соединение.XMLСтрока(РегистраторИсточника));
			Если СсылкаСуществует(Ссылка) Тогда
				Результат = Ссылка;
			ИначеЕсли Контекст.Параметры.СоздаватьРегистраторы Тогда
				Результат = СоздатьДокументРегистратор(Контекст, Ссылка, РегистраторИсточника,
					МетаданныеДокумента, Представление);
			Иначе
				ДобавитьВПротокол(Контекст, СтрШаблон(
					НСтр("ru = 'Регистр %1: документ ""%2"" не найден в ERP, его движения пропущены.'"),
					МетаданныеРегистра.ПолноеИмя(), Представление),
					"НетРегистратора" + МетаданныеРегистра.ПолноеИмя());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Контекст.КэшРегистраторов.Вставить(КлючКэша, Новый Структура("Значение", Результат));
	Возврат Результат;
	
КонецФункции

Функция СоздатьДокументРегистратор(Контекст, Ссылка, РегистраторИсточника, МетаданныеДокумента, Представление)
	
	ДокументОбъект = Документы[МетаданныеДокумента.Имя].СоздатьДокумент();
	ДокументОбъект.УстановитьСсылкуНового(Ссылка);
	
	ДатаДокумента = СвойствоИсточника(РегистраторИсточника, "Дата");
	ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ДатаДокумента), ДатаДокумента, ТекущаяДатаСеанса());
	
	Если МетаданныеДокумента.ДлинаНомера > 0 Тогда
		Попытка
			ДокументОбъект.Номер = СвойствоИсточника(РегистраторИсточника, "Номер");
		Исключение
			// Номер останется пустым, если типы номеров в конфигурациях различаются.
		КонецПопытки;
	КонецЕсли;
	
	Если МетаданныеДокумента.Реквизиты.Найти("Организация") <> Неопределено Тогда
		Контекст.ЕстьНенайденныеЗначения = Ложь;
		Организация = ЗначениеВПриемнике(Контекст, СвойствоИсточника(РегистраторИсточника, "Организация"));
		Если Не Контекст.ЕстьНенайденныеЗначения Тогда
			ДокументОбъект.Организация = Организация;
		КонецЕсли;
		Контекст.ЕстьНенайденныеЗначения = Ложь;
	КонецЕсли;
	
	Если МетаданныеДокумента.Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		ДокументОбъект.Комментарий = СтрШаблон(
			НСтр("ru = 'Создан при загрузке данных учета НДФЛ из 1С:ЗУП. Исходный документ: %1'"), Представление);
	КонецЕсли;
	
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	
	Попытка
		ДокументОбъект.Записать();
	Исключение
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Не удалось создать документ-регистратор ""%1"":
			|%2'"),
			Представление, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"ОшибкаСозданияРегистратора");
		Возврат Неопределено;
	КонецПопытки;
	
	ДобавитьВПротокол(Контекст, СтрШаблон(
		НСтр("ru = 'Создан документ-регистратор ""%1"" (без проведения).'"), Представление),
		"СозданРегистратор");
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

#КонецОбласти

#Область ПреобразованиеЗначений

// Преобразует значение, полученное через COM-соединение, в значение текущей информационной базы.
// Ссылки сопоставляются по уникальному идентификатору, а при включенном сопоставлении
// по реквизитам - элементы справочников дополнительно ищутся по ИНН/КПП и наименованию.
//
Функция ЗначениеВПриемнике(Контекст, ЗначениеИсточника)
	
	Если ЗначениеИсточника = Неопределено Или ЗначениеИсточника = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеИсточника) <> Тип("COMОбъект") Тогда
		Возврат ЗначениеИсточника;
	КонецЕсли;
	
	Соединение = Контекст.Соединение;
	ТипXML = Соединение.XMLТипЗнч(ЗначениеИсточника);
	Если ТипXML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяТипа = ТипXML.ИмяТипа;
	ПространствоИмен = ТипXML.URIПространстваИмен;
	СтрокаXML = Соединение.XMLСтрока(ЗначениеИсточника);
	
	КлючКэша = ПространствоИмен + "|" + ИмяТипа + "|" + СтрокаXML;
	Результат = Контекст.КэшЗначений[КлючКэша];
	
	Если Результат = Неопределено Тогда
		Результат = СопоставитьЗначение(Контекст, ЗначениеИсточника, ИмяТипа, ПространствоИмен, СтрокаXML);
		Контекст.КэшЗначений.Вставить(КлючКэша, Результат);
	КонецЕсли;
	
	Если Не Результат.Найдено Тогда
		Контекст.ЕстьНенайденныеЗначения = Истина;
	КонецЕсли;
	
	Возврат Результат.Значение;
	
КонецФункции

Функция СопоставитьЗначение(Контекст, ЗначениеИсточника, ИмяТипа, ПространствоИмен, СтрокаXML)
	
	Результат = Новый Структура("Значение, Найдено", Неопределено, Истина);
	
	ТипЗначения = ТипПриемника(Контекст, ИмяТипа, ПространствоИмен);
	Если ТипЗначения = Неопределено Тогда
		Результат.Найдено = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат.Значение = XMLЗначение(ТипЗначения, СтрокаXML);
	Исключение
		Результат.Найдено = Ложь;
		Результат.Значение = ПустоеЗначениеТипа(ТипЗначения);
		ДобавитьВПротокол(Контекст, СтрШаблон(
			НСтр("ru = 'Значение ""%1"" типа %2 не найдено в ERP.'"),
			ПредставлениеЗначенияИсточника(Контекст, ЗначениеИсточника), ИмяТипа),
			"НеНайдено" + ИмяТипа);
		Возврат Результат;
	КонецПопытки;
	
	Если Не ЭтоСсылочныйТип(ТипЗначения)
		Или Не ЗначениеЗаполнено(Результат.Значение)
		Или СсылкаСуществует(Результат.Значение) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Контекст.Параметры.СопоставлятьПоРеквизитам Тогда
		НайденнаяСсылка = НайтиПоРеквизитам(ЗначениеИсточника, ТипЗначения);
		Если НайденнаяСсылка <> Неопределено Тогда
			Результат.Значение = НайденнаяСсылка;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Найдено = Ложь;
	Если Контекст.Параметры.ДействиеПриНенайденнойСсылке = "ПустаяСсылка" Тогда
		Результат.Значение = ПустоеЗначениеТипа(ТипЗначения);
	КонецЕсли;
	
	ДобавитьВПротокол(Контекст, СтрШаблон(
		НСтр("ru = 'Объект ""%1"" (%2, идентификатор %3) не найден в ERP.'"),
		ПредставлениеЗначенияИсточника(Контекст, ЗначениеИсточника), ИмяТипа, СтрокаXML),
		"НеНайдено" + ИмяТипа);
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПоРеквизитам(ЗначениеИсточника, ТипЗначения)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных = Неопределено Или Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	
	Если ОбъектМетаданных.Реквизиты.Найти("ИНН") <> Неопределено Тогда
		ИНН = СвойствоИсточника(ЗначениеИсточника, "ИНН");
		Если ЗначениеЗаполнено(ИНН) Тогда
			Условия.Добавить("Т.ИНН = &ИНН");
			Запрос.УстановитьПараметр("ИНН", ИНН);
			
			Если ОбъектМетаданных.Реквизиты.Найти("КПП") <> Неопределено Тогда
				Условия.Добавить("Т.КПП = &КПП");
				КПП = СвойствоИсточника(ЗначениеИсточника, "КПП");
				Запрос.УстановитьПараметр("КПП", ?(КПП = Неопределено, "", КПП));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Условия.Количество() = 0 Тогда
		Если ОбъектМетаданных.ДлинаНаименования = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Наименование = СвойствоИсточника(ЗначениеИсточника, "Наименование");
		Если Не ЗначениеЗаполнено(Наименование) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Условия.Добавить("Т.Наименование = &Наименование");
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Если ОбъектМетаданных.Реквизиты.Найти("ДатаРождения") <> Неопределено Тогда
			Условия.Добавить("Т.ДатаРождения = &ДатаРождения");
			ДатаРождения = СвойствоИсточника(ЗначениеИсточника, "ДатаРождения");
			Запрос.УстановитьПараметр("ДатаРождения", ?(ДатаРождения = Неопределено, Дата(1, 1, 1), ДатаРождения));
		КонецЕсли;
	КонецЕсли;
	
	Условия.Добавить("НЕ Т.ПометкаУдаления");
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	" + ОбъектМетаданных.ПолноеИмя() + " КАК Т
	|ГДЕ
	|	" + СтрСоединить(Условия, Символы.ПС + "	И ");
	
	Найденные = Запрос.Выполнить().Выгрузить();
	
	// При неоднозначном сопоставлении элемент считается ненайденным.
	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ТипПриемника(Контекст, ИмяТипа, ПространствоИмен)
	
	КлючКэша = ПространствоИмен + "|" + ИмяТипа;
	ОписаниеТипа = Контекст.КэшТипов[КлючКэша];
	
	Если ОписаниеТипа = Неопределено Тогда
		Попытка
			ТипЗначения = ИзXMLТипа(ИмяТипа, ПространствоИмен);
		Исключение
			ТипЗначения = Неопределено;
		КонецПопытки;
		
		Если ТипЗначения = Неопределено Тогда
			ДобавитьВПротокол(Контекст, СтрШаблон(
				НСтр("ru = 'Тип %1 отсутствует в ERP, значения этого типа не переносятся.'"), ИмяТипа));
		КонецЕсли;
		
		ОписаниеТипа = Новый Структура("Тип", ТипЗначения);
		Контекст.КэшТипов.Вставить(КлючКэша, ОписаниеТипа);
	КонецЕсли;
	
	Возврат ОписаниеТипа.Тип;
	
КонецФункции

Функция ЭтоСсылочныйТип(ТипЗначения)
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения);
	
КонецФункции

Функция СсылкаСуществует(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Существует
	|ИЗ
	|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПустоеЗначениеТипа(ТипЗначения)
	
	Типы = Новый Массив;
	Типы.Добавить(ТипЗначения);
	Возврат Новый ОписаниеТипов(Типы).ПривестиЗначение(Неопределено);
	
КонецФункции

Функция КлючЗначенияИсточника(Контекст, ЗначениеИсточника)
	
	Соединение = Контекст.Соединение;
	Возврат Соединение.XMLТипЗнч(ЗначениеИсточника).ИмяТипа + "|" + Соединение.XMLСтрока(ЗначениеИсточника);
	
КонецФункции

// Читает реквизит объекта базы-источника. Обращение к реквизитам ссылки через COM
// выполняется по имени, поэтому используется Вычислить с фиксированным набором имен из этого модуля.
//
Функция СвойствоИсточника(ЗначениеИсточника, ИмяСвойства)
	
	Если ТипЗнч(ЗначениеИсточника) <> Тип("COMОбъект") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Вычислить("ЗначениеИсточника." + ИмяСвойства);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПредставлениеЗначенияИсточника(Контекст, ЗначениеИсточника)
	
	Попытка
		Возврат Контекст.Соединение.Строка(ЗначениеИсточника);
	Исключение
		Возврат Контекст.Соединение.XMLСтрока(ЗначениеИсточника);
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область Протокол

// Добавляет строку в протокол. Если указан ключ группы, в протокол выводится
// не более МаксимумСообщенийОдногоВида сообщений этой группы.
//
Процедура ДобавитьВПротокол(Контекст, Текст, КлючГруппы = "")
	
	Если ЗначениеЗаполнено(КлючГруппы) Тогда
		Количество = Контекст.СчетчикиСообщений[КлючГруппы];
		Количество = ?(Количество = Неопределено, 1, Количество + 1);
		Контекст.СчетчикиСообщений.Вставить(КлючГруппы, Количество);
		
		Если Количество > МаксимумСообщенийОдногоВида Тогда
			Если Количество = МаксимумСообщенийОдногоВида + 1 Тогда
				Текст = НСтр("ru = '... дальнейшие однотипные сообщения не выводятся.'");
			Иначе
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Контекст.Протокол.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss") + "  " + Текст);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Инициализация

МаксимумСообщенийОдногоВида = 20;

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
