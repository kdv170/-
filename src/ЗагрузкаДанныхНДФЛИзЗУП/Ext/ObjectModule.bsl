Перем КэшПроверенныхСсылок;

#Область ПрограммныйИнтерфейс

// Проверяет COM-соединение и наличие регистра в ЗУП и ERP.
//
// Параметры:
//  Параметры - Структура:
//   * СтрокаСоединения - Строка - строка подключения COMConnector;
//   * ИмяРегистра - Строка - имя регистра накопления без префикса;
//   * НачалоПериода - Дата;
//   * КонецПериода - Дата;
//   * МаксимумСтрок - Число - 0 означает отсутствие ограничения;
//   * ТестовыйРежим - Булево - если Истина, запись в ERP не выполняется.
//
// Возвращаемое значение:
//  Структура - поля Успех, Сообщение, Прочитано, Записано, Регистраторов.
Функция ПроверитьПодключение(Параметры) Экспорт
	
	Результат = НовыйРезультат();
	
	Попытка
		ПроверитьПараметры(Параметры);
		МетаданныеРегистра = МетаданныеРегистраПриемника(
			Параметры.ИмяРегистра);
		Соединение = СоздатьCOMСоединение(Параметры.СтрокаСоединения);
		МетаданныеРегистраИсточника = ПроверитьРегистрИсточника(
			Соединение,
			Параметры.ИмяРегистра);
		ПроверитьСовместимостьРегистров(
			Соединение,
			МетаданныеРегистраИсточника,
			МетаданныеРегистра);
		
		Результат.Успех = Истина;
		Результат.Сообщение = "Соединение установлено. Структура регистра совместима.";
	Исключение
		Результат.Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Загружает движения регистра накопления из ЗУП в текущую базу ERP.
//
// Для каждого регистратора набор записей приемника замещается целиком. Поэтому
// в выборку источника включаются все движения регистраторов, попавших в период.
// Ссылки сопоставляются по полному имени метаданных и UUID.
Функция Загрузить(Параметры) Экспорт
	
	Результат = НовыйРезультат();
	
	Попытка
		ПроверитьПараметры(Параметры);
		КэшПроверенныхСсылок = Новый Соответствие;
		МетаданныеРегистра = МетаданныеРегистраПриемника(Параметры.ИмяРегистра);
		Соединение = СоздатьCOMСоединение(Параметры.СтрокаСоединения);
		МетаданныеРегистраИсточника = ПроверитьРегистрИсточника(
			Соединение,
			Параметры.ИмяРегистра);
		ПроверитьСовместимостьРегистров(
			Соединение,
			МетаданныеРегистраИсточника,
			МетаданныеРегистра);
		
		ИменаПолей = ИменаПереносимыхПолей(МетаданныеРегистра);
		ПереноситьВидДвижения = МетаданныеРегистра.ВидРегистра
			= ВидРегистраНакопления.Остатки;
		ТекстЗапроса = ТекстЗапросаИсточник(
			Параметры.ИмяРегистра,
			ИменаПолей,
			ПереноситьВидДвижения,
			Параметры.МаксимумСтрок);
		
		ЗапросИсточник = Соединение.NewObject("Запрос", ТекстЗапроса);
		ЗапросИсточник.УстановитьПараметр("НачалоПериода", Параметры.НачалоПериода);
		ЗапросИсточник.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
		
		Выборка = ЗапросИсточник.Выполнить().Выбрать();
		ПодготовленныеНаборы = ПодготовитьНаборы(
			Выборка,
			Соединение,
			МетаданныеРегистра,
			ИменаПолей,
			ПереноситьВидДвижения,
			Параметры.МаксимумСтрок,
			Результат);
		
		ПроверитьЗаполнениеНаборов(
			Параметры.ИмяРегистра,
			ПодготовленныеНаборы);
		
		Если Не Параметры.ТестовыйРежим Тогда
			ЗаписатьНаборы(Параметры.ИмяРегистра, ПодготовленныеНаборы, Результат);
		КонецЕсли;
		
		Результат.Успех = Истина;
		Если Параметры.ТестовыйРежим Тогда
			Результат.Сообщение = СтрШаблон(
				"Проверка завершена: подготовлено %1 строк по %2 регистраторам, запись не выполнялась.",
				Результат.Прочитано,
				Результат.Регистраторов);
		Иначе
			Результат.Сообщение = СтрШаблон(
				"Загрузка завершена: записано %1 строк по %2 регистраторам.",
				Результат.Записано,
				Результат.Регистраторов);
		КонецЕсли;
	Исключение
		Результат.Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодключениеИПроверки

Функция СоздатьCOMСоединение(СтрокаСоединения)
	
	Попытка
		Коннектор = Новый COMОбъект("V83.COMConnector");
		Возврат Коннектор.Connect(СтрокаСоединения);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не удалось подключиться к ЗУП через V83.COMConnector: %1",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецФункции

Процедура ПроверитьПараметры(Параметры)
	
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ВызватьИсключение "Параметры загрузки должны быть переданы структурой.";
	КонецЕсли;
	
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("СтрокаСоединения");
	ОбязательныеПоля.Добавить("ИмяРегистра");
	ОбязательныеПоля.Добавить("НачалоПериода");
	ОбязательныеПоля.Добавить("КонецПериода");
	ОбязательныеПоля.Добавить("МаксимумСтрок");
	ОбязательныеПоля.Добавить("ТестовыйРежим");
	
	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Если Не Параметры.Свойство(ИмяПоля) Тогда
			ВызватьИсключение "Не задан параметр """ + ИмяПоля + """.";
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(Параметры.СтрокаСоединения) Тогда
		ВызватьИсключение "Не задана строка соединения с ЗУП.";
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.ИмяРегистра) Тогда
		ВызватьИсключение "Не задано имя регистра.";
	КонецЕсли;
	
	Если Параметры.НачалоПериода > КонецДня(Параметры.КонецПериода) Тогда
		ВызватьИсключение "Начало периода не может быть позже окончания.";
	КонецЕсли;
	
	Если Параметры.МаксимумСтрок < 0 Тогда
		ВызватьИсключение "Максимальное число строк не может быть отрицательным.";
	КонецЕсли;
	
КонецПроцедуры

Функция МетаданныеРегистраПриемника(ИмяРегистра)
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		ВызватьИсключение "В ERP не найден регистр накопления """ + ИмяРегистра + """.";
	КонецЕсли;
	
	Если МетаданныеРегистра.Регистраторы.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Регистр ""%1"" не подчинен регистратору. Такой вариант обработки не поддерживается.",
			ИмяРегистра);
	КонецЕсли;
	
	Возврат МетаданныеРегистра;
	
КонецФункции

Функция ПроверитьРегистрИсточника(Соединение, ИмяРегистра)
	
	Попытка
		МетаданныеИсточника = Соединение.Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
		Если МетаданныеИсточника = Неопределено Тогда
			ВызватьИсключение "В ЗУП не найден регистр накопления """ + ИмяРегистра + """.";
		КонецЕсли;
		Возврат МетаданныеИсточника;
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не удалось проверить регистр в ЗУП: %1",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецФункции

Процедура ПроверитьСовместимостьРегистров(
	Соединение,
	МетаданныеИсточника,
	МетаданныеПриемника)
	
	ВидИсточника = Соединение.XMLСтрока(МетаданныеИсточника.ВидРегистра);
	ВидПриемника = XMLСтрока(МетаданныеПриемника.ВидРегистра);
	Если ВидИсточника <> ВидПриемника Тогда
		ВызватьИсключение "Виды регистра в ЗУП и ERP не совпадают.";
	КонецЕсли;
	
	ПроверитьСоставПолей(
		МетаданныеИсточника.Измерения,
		МетаданныеПриемника.Измерения,
		"измерений");
	ПроверитьСоставПолей(
		МетаданныеИсточника.Ресурсы,
		МетаданныеПриемника.Ресурсы,
		"ресурсов");
	ПроверитьСоставПолей(
		МетаданныеИсточника.Реквизиты,
		МетаданныеПриемника.Реквизиты,
		"реквизитов");
	
КонецПроцедуры

Процедура ПроверитьСоставПолей(ПоляИсточника, ПоляПриемника, ВидПолей)
	
	Если ПоляИсточника.Количество() <> ПоляПриемника.Количество() Тогда
		ВызватьИсключение СтрШаблон(
			"Не совпадает количество %1 регистра в ЗУП и ERP.",
			ВидПолей);
	КонецЕсли;
	
	Для Каждого ПолеИсточника Из ПоляИсточника Цикл
		Если ПоляПриемника.Найти(Строка(ПолеИсточника.Имя)) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Поле %1 ""%2"" есть в ЗУП, но отсутствует в ERP.",
				ВидПолей,
				Строка(ПолеИсточника.Имя));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЧтениеИПодготовка

Функция ИменаПереносимыхПолей(МетаданныеРегистра)
	
	Результат = Новый Массив;
	
	Для Каждого Поле Из МетаданныеРегистра.Измерения Цикл
		Результат.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
		Результат.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
		Результат.Добавить(Поле.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаИсточник(
	ИмяРегистра,
	ИменаПолей,
	ПереноситьВидДвижения,
	МаксимумСтрок)
	
	Первые = "";
	Если МаксимумСтрок > 0 Тогда
		// Дополнительная строка нужна, чтобы обнаружить превышение лимита,
		// а не записать неполный набор регистратора.
		Первые = "ПЕРВЫЕ " + Формат(Цел(МаксимумСтрок) + 1, "ЧГ=0") + " ";
	КонецЕсли;
	
	Поля = Новый Массив;
	Поля.Добавить("Данные.Период КАК Период");
	Поля.Добавить("Данные.Регистратор КАК Регистратор");
	Поля.Добавить("Данные.НомерСтроки КАК НомерСтроки");
	Поля.Добавить("Данные.Активность КАК Активность");
	Если ПереноситьВидДвижения Тогда
		Поля.Добавить("Данные.ВидДвижения КАК ВидДвижения");
	КонецЕсли;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Поля.Добавить("Данные." + ИмяПоля + " КАК " + ИмяПоля);
	КонецЦикла;
	
	Возврат "ВЫБРАТЬ " + Первые + Символы.ПС
		+ СтрСоединить(Поля, "," + Символы.ПС)
		+ Символы.ПС + "ИЗ РегистрНакопления." + ИмяРегистра + " КАК Данные"
		+ Символы.ПС + "ГДЕ Данные.Регистратор В ("
		+ Символы.ПС + "  ВЫБРАТЬ РАЗЛИЧНЫЕ Отбор.Регистратор"
		+ Символы.ПС + "  ИЗ РегистрНакопления." + ИмяРегистра + " КАК Отбор"
		+ Символы.ПС + "  ГДЕ Отбор.Период МЕЖДУ &НачалоПериода И &КонецПериода)"
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки";
	
КонецФункции

Функция ПодготовитьНаборы(
	Выборка,
	Соединение,
	МетаданныеРегистра,
	ИменаПолей,
	ПереноситьВидДвижения,
	МаксимумСтрок,
	Результат)
	
	Наборы = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Если МаксимумСтрок > 0 И Результат.Прочитано >= МаксимумСтрок Тогда
			ВызватьИсключение СтрШаблон(
				"Число строк превышает установленный предел (%1). "
				+ "Увеличьте предел или сократите период.",
				МаксимумСтрок);
		КонецЕсли;
		
		UUIDРегистратора = UUIDИсточника(Выборка.Регистратор, "Регистратор");
		ПолноеИмяРегистратора = ПолноеИмяМетаданныхИсточника(
			Выборка.Регистратор,
			"Регистратор");
		Регистратор = СсылкаПриемника(
			ПолноеИмяРегистратора,
			UUIDРегистратора,
			Неопределено);
		
		Если Не ЗначениеЗаполнено(Регистратор) Тогда
			ВызватьИсключение СтрШаблон(
				"В ERP отсутствует регистратор %1 с UUID %2.",
				ПолноеИмяРегистратора,
				UUIDРегистратора);
		КонецЕсли;
		
		КлючНабора = ПолноеИмяРегистратора + ":" + UUIDРегистратора;
		Набор = Наборы.Получить(КлючНабора);
		Если Набор = Неопределено Тогда
			Набор = Новый Структура;
			Набор.Вставить("Регистратор", Регистратор);
			Набор.Вставить("Строки", Новый Массив);
			Наборы.Вставить(КлючНабора, Набор);
		КонецЕсли;
		
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("Период", Выборка.Период);
		СтрокаДанных.Вставить("Активность", Выборка.Активность);
		Если ПереноситьВидДвижения Тогда
			СтрокаДанных.Вставить(
				"ВидДвижения",
				XMLЗначение(
					Тип("ВидДвиженияНакопления"),
					Соединение.XMLСтрока(Выборка.ВидДвижения)));
		КонецЕсли;
		
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			МетаданныеПоля = МетаданныеПоляРегистра(МетаданныеРегистра, ИмяПоля);
			ЗначениеПоля = ПреобразоватьЗначение(
				Выборка[ИмяПоля],
				Соединение,
				МетаданныеПоля.Тип,
				ИмяПоля);
			СтрокаДанных.Вставить(ИмяПоля, ЗначениеПоля);
		КонецЦикла;
		
		Набор.Строки.Добавить(СтрокаДанных);
		Результат.Прочитано = Результат.Прочитано + 1;
		
	КонецЦикла;
	
	Результат.Регистраторов = Наборы.Количество();
	Возврат Наборы;
	
КонецФункции

Функция МетаданныеПоляРегистра(МетаданныеРегистра, ИмяПоля)
	
	Поле = МетаданныеРегистра.Измерения.Найти(ИмяПоля);
	Если Поле = Неопределено Тогда
		Поле = МетаданныеРегистра.Ресурсы.Найти(ИмяПоля);
	КонецЕсли;
	Если Поле = Неопределено Тогда
		Поле = МетаданныеРегистра.Реквизиты.Найти(ИмяПоля);
	КонецЕсли;
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле регистра не найдено в ERP: " + ИмяПоля + ".";
	КонецЕсли;
	
	Возврат Поле;
	
КонецФункции

#КонецОбласти

#Область ПреобразованиеСсылок

Функция ПреобразоватьЗначение(
	ЗначениеИсточника,
	Соединение,
	ОписаниеТиповПриемника,
	ИмяПоля)
	
	Если ЗначениеИсточника = Неопределено Или ЗначениеИсточника = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ПолноеИмя = ПолноеИмяМетаданныхИсточника(ЗначениеИсточника, ИмяПоля);
	Исключение
		// Примитивы COM автоматически маршалируются в значения платформы.
		Возврат ЗначениеИсточника;
	КонецПопытки;
	
	Если СтрНачинаетсяС(ПолноеИмя, "Перечисление.") Тогда
		Возврат ЗначениеПеречисленияПриемника(
			ПолноеИмя,
			Соединение.XMLСтрока(ЗначениеИсточника),
			ОписаниеТиповПриемника);
	КонецЕсли;
	
	UUID = UUIDИсточника(ЗначениеИсточника, ИмяПоля);
	Возврат СсылкаПриемника(ПолноеИмя, UUID, ОписаниеТиповПриемника);
	
КонецФункции

Функция UUIDИсточника(ЗначениеИсточника, ИмяПоля)
	
	Попытка
		Возврат Строка(ЗначениеИсточника.УникальныйИдентификатор());
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не удалось получить UUID ссылочного значения поля ""%1"": %2",
			ИмяПоля,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецФункции

Функция ПолноеИмяМетаданныхИсточника(ЗначениеИсточника, ИмяПоля)
	
	Попытка
		Возврат Строка(ЗначениеИсточника.Метаданные().ПолноеИмя());
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не удалось определить тип ссылочного значения поля ""%1"": %2",
			ИмяПоля,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецФункции

Функция СсылкаПриемника(ПолноеИмя, UUIDСтрокой, ОписаниеТиповПриемника)
	
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	Если ЧастиИмени.Количество() <> 2 Тогда
		ВызватьИсключение "Неподдерживаемый ссылочный тип: " + ПолноеИмя + ".";
	КонецЕсли;
	
	ВидМетаданных = ЧастиИмени[0];
	ИмяОбъекта = ЧастиИмени[1];
	
	Если ОписаниеТиповПриемника <> Неопределено Тогда
		МетаданныеТипа = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если МетаданныеТипа = Неопределено
			Или Не ОписаниеТиповПриемника.СодержитТип(МетаданныеТипа.Тип()) Тогда
			ВызватьИсключение СтрШаблон(
				"Тип %1 отсутствует в типе поля регистра-приемника.",
				ПолноеИмя);
		КонецЕсли;
	КонецЕсли;
	
	UUID = Новый УникальныйИдентификатор(UUIDСтрокой);
	
	Если ВидМетаданных = "Справочник" Тогда
		Ссылка = Справочники[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли ВидМетаданных = "Документ" Тогда
		Ссылка = Документы[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли ВидМетаданных = "ПланВидовХарактеристик" Тогда
		Ссылка = ПланыВидовХарактеристик[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли ВидМетаданных = "ПланСчетов" Тогда
		Ссылка = ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли ВидМетаданных = "ПланВидовРасчета" Тогда
		Ссылка = ПланыВидовРасчета[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли ВидМетаданных = "БизнесПроцесс" Тогда
		Ссылка = БизнесПроцессы[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли ВидМетаданных = "Задача" Тогда
		Ссылка = Задачи[ИмяОбъекта].ПолучитьСсылку(UUID);
	Иначе
		ВызватьИсключение "Ссылочный тип не поддерживается: " + ПолноеИмя + ".";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПроверитьСуществованиеСсылки(ПолноеИмя, Ссылка, UUIDСтрокой);
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция ЗначениеПеречисленияПриемника(
	ПолноеИмя,
	XMLПредставление,
	ОписаниеТиповПриемника)
	
	// Метаданные значения перечисления в разных версиях платформы могут
	// возвращать имя с третьей частью. Для типа нужен уровень перечисления.
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	Если ЧастиИмени.Количество() < 2 Тогда
		ВызватьИсключение "Некорректное имя перечисления: " + ПолноеИмя + ".";
	КонецЕсли;
	ПолноеИмяПеречисления = ЧастиИмени[0] + "." + ЧастиИмени[1];
	
	МетаданныеПеречисления = Метаданные.НайтиПоПолномуИмени(
		ПолноеИмяПеречисления);
	Если МетаданныеПеречисления = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"В ERP отсутствует перечисление %1.",
			ПолноеИмяПеречисления);
	КонецЕсли;
	
	Если Не ОписаниеТиповПриемника.СодержитТип(
		МетаданныеПеречисления.Тип()) Тогда
		ВызватьИсключение СтрШаблон(
			"Тип %1 отсутствует в типе поля регистра-приемника.",
			ПолноеИмяПеречисления);
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(
			МетаданныеПеречисления.Тип(),
			XMLПредставление);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не удалось сопоставить значение перечисления %1: %2",
			ПолноеИмяПеречисления,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецФункции

Процедура ПроверитьСуществованиеСсылки(ПолноеИмя, Ссылка, UUIDСтрокой)
	
	Если КэшПроверенныхСсылок = Неопределено Тогда
		КэшПроверенныхСсылок = Новый Соответствие;
	КонецЕсли;
	
	КлючКэша = ПолноеИмя + ":" + UUIDСтрокой;
	Если КэшПроверенныхСсылок.Получить(КлючКэша) = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Объект.Ссылка КАК Ссылка
		|ИЗ
		|	" + ПолноеИмя + " КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение СтрШаблон(
			"В ERP отсутствует объект %1 с UUID %2.",
			ПолноеИмя,
			UUIDСтрокой);
	КонецЕсли;
	
	КэшПроверенныхСсылок.Вставить(КлючКэша, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область Запись

Процедура ПроверитьЗаполнениеНаборов(ИмяРегистра, ПодготовленныеНаборы)
	
	Для Каждого ЭлементНабора Из ПодготовленныеНаборы Цикл
		ПодготовленныйНабор = ЭлементНабора.Значение;
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(
			ПодготовленныйНабор.Регистратор);
		
		Для Каждого ДанныеСтроки Из ПодготовленныйНабор.Строки Цикл
			СтрокаНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНабора, ДанныеСтроки);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНаборы(ИмяРегистра, ПодготовленныеНаборы, Результат)
	
	НачатьТранзакцию();
	Попытка
		Для Каждого ЭлементНабора Из ПодготовленныеНаборы Цикл
			ПодготовленныйНабор = ЭлементНабора.Значение;
			НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(
				ПодготовленныйНабор.Регистратор);
			
			Для Каждого ДанныеСтроки Из ПодготовленныйНабор.Строки Цикл
				СтрокаНабора = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНабора, ДанныеСтроки);
			КонецЦикла;
			
			НаборЗаписей.Записать();
			Результат.Записано = Результат.Записано
				+ ПодготовленныйНабор.Строки.Количество();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Записано = 0;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция НовыйРезультат()
	
	Возврат Новый Структура(
		"Успех,Сообщение,Прочитано,Записано,Регистраторов",
		Ложь,
		"",
		0,
		0,
		0);
	
КонецФункции

#КонецОбласти
