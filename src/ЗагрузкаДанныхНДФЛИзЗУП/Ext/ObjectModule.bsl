// Возвращает структуру параметров загрузки по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * СпособЗагрузки         - Строка - "ОперацияУчетаНДФЛ" или "ПереносДанных".
//   * ПроводитьДокументы     - Булево - проводить созданные документы.
//   * СоздаватьНовыеФизлица  - Булево - создавать физлица при отсутствии.
//   * ЗаменятьСуществующие   - Булево - перезаписывать ранее созданные документы.
//
Функция ПараметрыЗагрузкиПоУмолчанию() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("СпособЗагрузки", "ОперацияУчетаНДФЛ");
	Параметры.Вставить("ПроводитьДокументы", Истина);
	Параметры.Вставить("СоздаватьНовыеФизлица", Истина);
	Параметры.Вставить("ЗаменятьСуществующие", Истина);
	Возврат Параметры;
	
КонецФункции

// Определяет имя регистра накопления для учета доходов по НДФЛ в текущей конфигурации.
// В типовых ЗУП 3.1 и ERP 2.5 регистр называется "СведенияОДоходахНДФЛ",
// синоним "Учет доходов для исчисления НДФЛ".
//
// Возвращаемое значение:
//  Строка - имя регистра или пустая строка, если регистр не найден.
//
Функция ИмяОсновногоРегистраНДФЛ() Экспорт
	
	// 1. Стандартное имя в ЗУП 3 / ERP 2 / КА 2
	Если Метаданные.РегистрыНакопления.Найти("СведенияОДоходахНДФЛ") <> Неопределено Тогда
		Возврат "СведенияОДоходахНДФЛ";
	КонецЕсли;
	
	// 2. Вариант именования по синониму
	Если Метаданные.РегистрыНакопления.Найти("УчетДоходовДляИсчисленияНДФЛ") <> Неопределено Тогда
		Возврат "УчетДоходовДляИсчисленияНДФЛ";
	КонецЕсли;
	
	// 3. Возможный доработанный регистр
	Если Метаданные.РегистрыНакопления.Найти("УчетДанныхДляНДФЛ") <> Неопределено Тогда
		Возврат "УчетДанныхДляНДФЛ";
	КонецЕсли;
	
	// 4. Поиск по синониму среди регистров накопления
	Для Каждого МДРегистр Из Метаданные.РегистрыНакопления Цикл
		Синоним = НРег(МДРегистр.Синоним);
		Если СтрНайти(Синоним, "учет доходов") > 0 И СтрНайти(Синоним, "ндфл") > 0 Тогда
			Возврат МДРегистр.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Загружает переданную таблицу данных по НДФЛ в текущую информационную базу (ERP).
//
// Параметры:
//  ТаблицаДанных     - ТаблицаЗначений - строки данных регистра, полученные из ЗУП.
//  ПараметрыЗагрузки - Структура       - настройки (СпособЗагрузки, ПроводитьДокументы и др.).
//
// Возвращаемое значение:
//  Структура:
//   * Успех            - Булево
//   * ВсегоСтрок       - Число
//   * Загружено        - Число
//   * Ошибок           - Число
//   * СозданоДокументов - Число
//   * Журнал           - Массив строк
//   * РезультатыСтрок  - Соответствие: ИдентификаторСтроки -> Структура (Статус, Сообщение)
//
Функция ЗагрузитьДанныеВERP(ТаблицаДанных, ПараметрыЗагрузки = Неопределено) Экспорт
	
	Если ПараметрыЗагрузки = Неопределено Тогда
		ПараметрыЗагрузки = ПараметрыЗагрузкиПоУмолчанию();
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ВсегоСтрок", ТаблицаДанных.Количество());
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("СозданоДокументов", 0);
	Результат.Вставить("Журнал", Новый Массив);
	Результат.Вставить("РезультатыСтрок", Новый Соответствие);
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Результат.Журнал.Добавить("Таблица данных для загрузки пуста.");
		Возврат Результат;
	КонецЕсли;
	
	Способ = ПараметрыЗагрузки.СпособЗагрузки;
	Если Способ = "ОперацияУчетаНДФЛ" Тогда
		Если Метаданные.Документы.Найти("ОперацияУчетаНДФЛ") = Неопределено Тогда
			Результат.Журнал.Добавить("В конфигурации отсутствует документ 'ОперацияУчетаНДФЛ'. Переключение на 'ПереносДанных'.");
			Способ = "ПереносДанных";
		КонецЕсли;
	КонецЕсли;
	
	Если Способ = "ОперацияУчетаНДФЛ" Тогда
		ЗагрузитьЧерезОперацииУчетаНДФЛ(ТаблицаДанных, ПараметрыЗагрузки, Результат);
	Иначе
		ЗагрузитьЧерезПереносДанных(ТаблицаДанных, ПараметрыЗагрузки, Результат);
	КонецЕсли;
	
	Результат.Успех = (Результат.Ошибок = 0);
	
	ЗаписьЖурналаРегистрации(
		"ЗагрузкаДанныхНДФЛИзЗУП",
		?(Результат.Ошибок = 0, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
		,
		,
		СтрШаблон("Загрузка НДФЛ завершена. Обработано строк: %1, успешно: %2, ошибок: %3, создано документов: %4.",
			Результат.ВсегоСтрок, Результат.Загружено, Результат.Ошибок, Результат.СозданоДокументов));
	
	Возврат Результат;
	
КонецФункции

// Преобразует таблицу данных в форматированную строку JSON для сохранения в файл.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений
//
// Возвращаемое значение:
//  Строка - JSON
//
Функция ВыгрузитьВJSON(ТаблицаДанных) Экспорт
	
	МассивСтрок = Новый Массив;
	Для Каждого Стр Из ТаблицаДанных Цикл
		СтрокаПакет = Новый Структура;
		Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
			Значение = Стр[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				СтрокаПакет.Вставить(Колонка.Имя, Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			Иначе
				СтрокаПакет.Вставить(Колонка.Имя, Значение);
			КонецЕсли;
		КонецЦикла;
		МассивСтрок.Добавить(СтрокаПакет);
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто));
	ЗаписатьJSON(ЗаписьJSON, МассивСтрок);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Восстанавливает массив структур из строки JSON.
//
// Параметры:
//  ТекстJSON - Строка
//
// Возвращаемое значение:
//  Массив структур
//
Функция ЗагрузитьИзJSON(ТекстJSON) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	
	Возврат ?(ТипЗнч(Данные) = Тип("Массив"), Данные, Новый Массив);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СопоставлениеОбъектов

// Находит организацию в базе ERP по ИНН, КПП, наименованию или УИД.
Функция НайтиОрганизацию(ДанныеОРГ) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеОРГ) Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	ИНН = СокрЛП(ДанныеОРГ.ИНН);
	КПП = СокрЛП(ДанныеОРГ.КПП);
	Наименование = СокрЛП(ДанныеОРГ.Наименование);
	УИД = СокрЛП(ДанныеОРГ.УИД);
	
	// 1. По ИНН + КПП
	Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.Организации
			|ГДЕ ИНН = &ИНН И КПП = &КПП И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 2. По ИНН
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.Организации
			|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() = 1 Тогда
			Возврат ТЗ[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 3. По точному наименованию
	Если ЗначениеЗаполнено(Наименование) Тогда
		Ссылка = Справочники.Организации.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 4. По УИД
	Если ЗначениеЗаполнено(УИД) Тогда
		Попытка
			Гуид = Новый УникальныйИдентификатор(УИД);
			Ссылка = Справочники.Организации.ПолучитьСсылку(Гуид);
			Если Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)) <> Неопределено
				И ЗначениеЗаполнено(Ссылка.ВерсияДанных) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

// Находит физическое лицо в ERP по СНИЛС, ИНН, ФИО+ДатаРождения, Наименованию или УИД.
// При необходимости создает новое физлицо.
Функция НайтиФизическоеЛицо(ДанныеФЛ, СоздаватьЕслиНеНайдено, Протокол) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеФЛ) Тогда
		Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецЕсли;
	
	СНИЛС = СокрЛП(ДанныеФЛ.СНИЛС);
	ИНН = СокрЛП(ДанныеФЛ.ИНН);
	ФИО = СокрЛП(ДанныеФЛ.Наименование);
	ДатаРождения = ДанныеФЛ.ДатаРождения;
	УИД = СокрЛП(ДанныеФЛ.УИД);
	
	// 1. По СНИЛС (СтраховойНомерПФР)
	Если ЗначениеЗаполнено(СНИЛС) Тогда
		ЧистыйСНИЛС = СтрЗаменить(СтрЗаменить(СНИЛС, "-", ""), " ", "");
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.ФизическиеЛица
			|ГДЕ СтраховойНомерПФР ПОДОБНО &СНИЛС И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("СНИЛС", "%" + ЧистыйСНИЛС + "%");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 2. По ИНН
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.ФизическиеЛица
			|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() = 1 Тогда
			Возврат ТЗ[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 3. По ФИО и дате рождения
	Если ЗначениеЗаполнено(ФИО) И ЗначениеЗаполнено(ДатаРождения) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.ФизическиеЛица
			|ГДЕ Наименование = &ФИО И ДатаРождения = &ДатаРождения И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ФИО", ФИО);
		Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 4. По точному ФИО
	Если ЗначениеЗаполнено(ФИО) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.ФизическиеЛица
			|ГДЕ Наименование = &ФИО И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ФИО", ФИО);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() = 1 Тогда
			Возврат ТЗ[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 5. По УИД
	Если ЗначениеЗаполнено(УИД) Тогда
		Попытка
			Гуид = Новый УникальныйИдентификатор(УИД);
			Ссылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Гуид);
			Если Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)) <> Неопределено
				И ЗначениеЗаполнено(Ссылка.ВерсияДанных) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// 6. Создание нового физлица при необходимости
	Если СоздаватьЕслиНеНайдено И ЗначениеЗаполнено(ФИО) Тогда
		Попытка
			НовыйОбъект = Справочники.ФизическиеЛица.СоздатьЭлемент();
			Если ЗначениеЗаполнено(УИД) Тогда
				Попытка
					НовыйОбъект.УстановитьСсылкуНового(Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД)));
				Исключение
				КонецПопытки;
			КонецЕсли;
			НовыйОбъект.Наименование = ФИО;
			Если ЗначениеЗаполнено(ИНН) Тогда
				НовыйОбъект.ИНН = ИНН;
			КонецЕсли;
			Если ЗначениеЗаполнено(СНИЛС) И НовыйОбъект.Метаданные().Реквизиты.Найти("СтраховойНомерПФР") <> Неопределено Тогда
				НовыйОбъект.СтраховойНомерПФР = СНИЛС;
			КонецЕсли;
			Если ЗначениеЗаполнено(ДатаРождения) И НовыйОбъект.Метаданные().Реквизиты.Найти("ДатаРождения") <> Неопределено Тогда
				НовыйОбъект.ДатаРождения = ДатаРождения;
			КонецЕсли;
			НовыйОбъект.Записать();
			
			Протокол.Добавить(СтрШаблон("Создано новое физическое лицо: %1 (ИНН: %2, СНИЛС: %3).", ФИО, ИНН, СНИЛС));
			Возврат НовыйОбъект.Ссылка;
		Исключение
			Протокол.Добавить(СтрШаблон("Ошибка создания физлица %1: %2", ФИО, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;
	
	Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	
КонецФункции

// Находит сотрудника в ERP по физическому лицу, организации и табельному номеру.
Функция НайтиСотрудника(ДанныеСотр, ФизЛицоСсылка, ОрганизацияСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ФизЛицоСсылка) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	ТабНомер = ?(ЗначениеЗаполнено(ДанныеСотр), СокрЛП(ДанныеСотр.Код), "");
	УИД = ?(ЗначениеЗаполнено(ДанныеСотр), СокрЛП(ДанныеСотр.УИД), "");
	
	// 1. По Физлицу, Организации и Табельному номеру
	Если ЗначениеЗаполнено(ТабНомер) И ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.Сотрудники
			|ГДЕ ФизическоеЛицо = &ФизЛицо
			|  И ГоловнаяОрганизация = &Организация
			|  И Код = &ТабНомер
			|  И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ФизЛицо", ФизЛицоСсылка);
		Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
		Запрос.УстановитьПараметр("ТабНомер", ТабНомер);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 2. По Физлицу и Организации (основное место работы)
	Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Справочник.Сотрудники
			|ГДЕ ФизическоеЛицо = &ФизЛицо
			|  И ГоловнаяОрганизация = &Организация
			|  И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ФизЛицо", ФизЛицоСсылка);
		Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() > 0 Тогда
			Возврат ТЗ[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 3. По Физлицу в целом
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ссылка ИЗ Справочник.Сотрудники
		|ГДЕ ФизическоеЛицо = &ФизЛицо И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицоСсылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() > 0 Тогда
		Возврат ТЗ[0].Ссылка;
	КонецЕсли;
	
	// 4. По УИД
	Если ЗначениеЗаполнено(УИД) Тогда
		Попытка
			Ссылка = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
			Если Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)) <> Неопределено
				И ЗначениеЗаполнено(Ссылка.ВерсияДанных) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Справочники.Сотрудники.ПустаяСсылка();
	
КонецФункции

// Находит вид дохода НДФЛ по коду или наименованию в Справочник.ВидыДоходовНДФЛ.
Функция НайтиВидДоходаНДФЛ(Код, Наименование) Экспорт
	
	КодСтр = СокрЛП(Код);
	Если ЗначениеЗаполнено(КодСтр) Тогда
		Ссылка = Справочники.ВидыДоходовНДФЛ.НайтиПоКоду(КодСтр);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
		
		// Проверка без ведущих нулей / с ведущими нулями
		Ссылка = Справочники.ВидыДоходовНДФЛ.НайтиПоРеквизиту("Код", КодСтр);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Ссылка = Справочники.ВидыДоходовНДФЛ.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.ВидыДоходовНДФЛ.ПустаяСсылка();
	
КонецФункции

// Находит вид вычета НДФЛ по коду или наименованию в Справочник.ВидыВычетовНДФЛ.
Функция НайтиВидВычетаНДФЛ(Код, Наименование) Экспорт
	
	КодСтр = СокрЛП(Код);
	Если Не ЗначениеЗаполнено(КодСтр) Тогда
		Возврат Справочники.ВидыВычетовНДФЛ.ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = Справочники.ВидыВычетовНДФЛ.НайтиПоКоду(КодСтр);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Ссылка = Справочники.ВидыВычетовНДФЛ.НайтиПоРеквизиту("Код", КодСтр);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Ссылка = Справочники.ВидыВычетовНДФЛ.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.ВидыВычетовНДФЛ.ПустаяСсылка();
	
КонецФункции

// Находит подразделение организации по организации и наименованию.
Функция НайтиПодразделение(ОрганизацияСсылка, Наименование) Экспорт
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;
	
	Наим = СокрЛП(Наименование);
	Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		Ссылка = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию(Наим, Истина, , ОрганизацияСсылка);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию(Наим, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	
КонецФункции

// Находит значение перечисления по имени перечисления и имени значения.
Функция НайтиЗначениеПеречисления(ИмяПеречисления, ИмяЗначения) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Коллекция = Перечисления[ИмяПеречисления];
		ЧистоеИмя = СокрЛП(ИмяЗначения);
		Значение = Коллекция[ЧистоеИмя];
		Возврат Значение;
	Исключение
	КонецПопытки;
	
	// Поиск по синониму
	Попытка
		МДПеречисление = Метаданные.Перечисления.Найти(ИмяПеречисления);
		Если МДПеречисление <> Неопределено Тогда
			Для Каждого ЗначМД Из МДПеречисление.ЗначенияПеречисления Цикл
				Если ВРег(ЗначМД.Синоним) = ВРег(ИмяЗначения) Или ВРег(ЗначМД.Имя) = ВРег(ИмяЗначения) Тогда
					Возврат Перечисления[ИмяПеречисления][ЗначМД.Имя];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаЧерезОперацииУчетаНДФЛ

// Загружает данные через создание документов "ОперацияУчетаНДФЛ" в ERP.
Процедура ЗагрузитьЧерезОперацииУчетаНДФЛ(ТаблицаДанных, ПараметрыЗагрузки, Результат)
	
	Протокол = Результат.Журнал;
	Протокол.Добавить("Начало загрузки через документы 'Операция учета НДФЛ'...");
	
	// Группируем строки по ключу: Организация + МесяцНалоговогоПериода + ФизическоеЛицо
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;
	
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если Не Стр.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = СтрШаблон("%1#%2#%3",
			СокрЛП(Стр.ОрганизацияИНН),
			Формат(Стр.МесяцНалоговогоПериода, "ДФ=yyyyMM01"),
			?(ЗначениеЗаполнено(Стр.ФизическоеЛицоСНИЛС), СокрЛП(Стр.ФизическоеЛицоСНИЛС), СокрЛП(Стр.ФизическоеЛицоНаименование)));
		
		СтрокиГруппы = Группы[Ключ];
		Если СтрокиГруппы = Неопределено Тогда
			СтрокиГруппы = Новый Массив;
			Группы.Вставить(Ключ, СтрокиГруппы);
			ПорядокГрупп.Добавить(Ключ);
		КонецЕсли;
		СтрокиГруппы.Добавить(Стр);
	КонецЦикла;
	
	Для Каждого Ключ Из ПорядокГрупп Цикл
		СтрокиГруппы = Группы[Ключ];
		ПерваяСтрока = СтрокиГруппы[0];
		
		// 1. Сопоставляем организацию
		ДанныеОРГ = Новый Структура("ИНН, КПП, Наименование, УИД",
			ПерваяСтрока.ОрганизацияИНН, ПерваяСтрока.ОрганизацияКПП, ПерваяСтрока.ОрганизацияНаименование, ПерваяСтрока.ОрганизацияУИД);
		ОрганизацияСсылка = НайтиОрганизацию(ДанныеОРГ);
		Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
			Сообщение = СтрШаблон("Организация '%1' (ИНН: %2) не найдена в базе ERP.", ПерваяСтрока.ОрганизацияНаименование, ПерваяСтрока.ОрганизацияИНН);
			ЗафиксироватьОшибкуГруппы(СтрокиГруппы, Сообщение, Результат);
			Продолжить;
		КонецЕсли;
		
		// 2. Сопоставляем физическое лицо
		ДанныеФЛ = Новый Структура("СНИЛС, ИНН, Наименование, ДатаРождения, УИД",
			ПерваяСтрока.ФизическоеЛицоСНИЛС, ПерваяСтрока.ФизическоеЛицоИНН, ПерваяСтрока.ФизическоеЛицоНаименование, ПерваяСтрока.ФизическоеЛицоДатаРождения, ПерваяСтрока.ФизическоеЛицоУИД);
		ФизЛицоСсылка = НайтиФизическоеЛицо(ДанныеФЛ, ПараметрыЗагрузки.СоздаватьНовыеФизлица, Протокол);
		Если Не ЗначениеЗаполнено(ФизЛицоСсылка) Тогда
			Сообщение = СтрШаблон("Физическое лицо '%1' не найдено в базе ERP.", ПерваяСтрока.ФизическоеЛицоНаименование);
			ЗафиксироватьОшибкуГруппы(СтрокиГруппы, Сообщение, Результат);
			Продолжить;
		КонецЕсли;
		
		// 3. Сопоставляем сотрудника
		ДанныеСотр = Новый Структура("Код, Наименование, УИД",
			ПерваяСтрока.СотрудникКод, ПерваяСтрока.СотрудникНаименование, ПерваяСтрока.СотрудникУИД);
		СотрудникСсылка = НайтиСотрудника(ДанныеСотр, ФизЛицоСсылка, ОрганизацияСсылка);
		
		// 4. Поиск существующего документа ОперацияУчетаНДФЛ за этот месяц
		ПериодРегистрации = НачалоМесяца(ПерваяСтрока.МесяцНалоговогоПериода);
		Если Не ЗначениеЗаполнено(ПериодРегистрации) Тогда
			ПериодРегистрации = НачалоМесяца(ПерваяСтрока.ДатаПолученияДохода);
		КонецЕсли;
		
		ДокументОбъект = Неопределено;
		Если ПараметрыЗагрузки.ЗаменятьСуществующие Тогда
			ДокументОбъект = НайтиСуществующийДокументОперацияУчетаНДФЛ(ОрганизацияСсылка, ФизЛицоСсылка, ПериодРегистрации);
		КонецЕсли;
		
		Если ДокументОбъект = Неопределено Тогда
			ДокументОбъект = Документы.ОперацияУчетаНДФЛ.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Организация = ОрганизацияСсылка;
			ДокументОбъект.ФизическоеЛицо = ФизЛицоСсылка;
			ДокументОбъект.Сотрудник = СотрудникСсылка;
			ДокументОбъект.ПериодРегистрации = ПериодРегистрации;
			ДокументОбъект.Комментарий = "Загружено из 1С:ЗУП по COM-соединению";
		Иначе
			ДокументОбъект.Комментарий = ДокументОбъект.Комментарий + " [Обновлено из ЗУП " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy") + "]";
		КонецЕсли;
		
		// Очищаем существующие строки доходов перед перезаполнением
		ДокументОбъект.Доходы.Очистить();
		
		ВсеСтрокиУспешны = Истина;
		Для Каждого СтрДанных Из СтрокиГруппы Цикл
			ВидДоходаСсылка = НайтиВидДоходаНДФЛ(СтрДанных.КодДохода, СтрДанных.НаименованиеДохода);
			ВидВычетаСсылка = НайтиВидВычетаНДФЛ(СтрДанных.КодВычета, "");
			ПодразделениеСсылка = НайтиПодразделение(ОрганизацияСсылка, СтрДанных.ПодразделениеНаименование);
			КатегорияДоходаЗнач = НайтиЗначениеПеречисления("КатегорииДоходовНДФЛ", СтрДанных.КатегорияДохода);
			СтавкаЗнач = НайтиЗначениеПеречисления("СтавкиНалогообложенияРезидента", СтрДанных.СтавкаНалогообложения);
			
			СтрокаТЧ = ДокументОбъект.Доходы.Добавить();
			СтрокаТЧ.ДатаПолученияДохода = СтрДанных.ДатаПолученияДохода;
			СтрокаТЧ.КодДохода = ВидДоходаСсылка;
			
			Если ДокументОбъект.Метаданные().ТабличныеЧасти.Доходы.Реквизиты.Найти("КатегорияДохода") <> Неопределено Тогда
				СтрокаТЧ.КатегорияДохода = КатегорияДоходаЗнач;
			ИначеЕсли ДокументОбъект.Метаданные().ТабличныеЧасти.Доходы.Реквизиты.Найти("ВидДохода") <> Неопределено Тогда
				СтрокаТЧ.ВидДохода = КатегорияДоходаЗнач;
			КонецЕсли;
			
			СтрокаТЧ.СуммаДохода = СтрДанных.СуммаДохода;
			
			Если ЗначениеЗаполнено(ВидВычетаСсылка) И ДокументОбъект.Метаданные().ТабличныеЧасти.Доходы.Реквизиты.Найти("КодВычета") <> Неопределено Тогда
				СтрокаТЧ.КодВычета = ВидВычетаСсылка;
				СтрокаТЧ.СуммаВычета = СтрДанных.СуммаВычета;
			КонецЕсли;
			
			Если ДокументОбъект.Метаданные().ТабличныеЧасти.Доходы.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
				СтрокаТЧ.Подразделение = ПодразделениеСсылка;
			КонецЕсли;
			
			Если ДокументОбъект.Метаданные().ТабличныеЧасти.Доходы.Реквизиты.Найти("ВключатьВДекларациюПоНалогуНаПрибыль") <> Неопределено Тогда
				СтрокаТЧ.ВключатьВДекларациюПоНалогуНаПрибыль = СтрДанных.ВключатьВДекларациюПоНалогуНаПрибыль;
			КонецЕсли;
			
			Если ДокументОбъект.Метаданные().ТабличныеЧасти.Доходы.Реквизиты.Найти("СтавкаНалогообложенияРезидента") <> Неопределено Тогда
				СтрокаТЧ.СтавкаНалогообложенияРезидента = СтавкаЗнач;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			Если ПараметрыЗагрузки.ПроводитьДокументы Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				СтатусДокумента = "Проведен";
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
				СтатусДокумента = "Записан";
			КонецЕсли;
			
			Результат.СозданоДокументов = Результат.СозданоДокументов + 1;
			ПредставлениеДок = СтрШаблон("%1 № %2 от %3", ДокументОбъект.Метаданные().Синоним, ДокументОбъект.Номер, Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy"));
			Протокол.Добавить(СтрШаблон("%1: %2 (%3, %4).", СтатусДокумента, ПредставлениеДок, ФизЛицоСсылка, Формат(ПериодРегистрации, "ДФ='ММММ yyyy'")));
			
			Для Каждого СтрДанных Из СтрокиГруппы Цикл
				Результат.Загружено = Результат.Загружено + 1;
				ФиксироватьУспехСтроки(СтрДанных, СтрШаблон("%1 (%2)", СтатусДокумента, ПредставлениеДок), Результат);
			КонецЦикла;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			// Попытка записать без проведения, если проведение не удалось
			Если ПараметрыЗагрузки.ПроводитьДокументы Тогда
				Попытка
					ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
					Результат.СозданоДокументов = Результат.СозданоДокументов + 1;
					ПредставлениеДок = СтрШаблон("%1 № %2 от %3", ДокументОбъект.Метаданные().Синоним, ДокументОбъект.Номер, Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy"));
					Протокол.Добавить(СтрШаблон("Записан без проведения (ошибка проведения: %1): %2.", ТекстОшибки, ПредставлениеДок));
					Для Каждого СтрДанных Из СтрокиГруппы Цикл
						Результат.Загружено = Результат.Загружено + 1;
						ФиксироватьУспехСтроки(СтрДанных, "Записан непроведенным: " + ТекстОшибки, Результат);
					КонецЦикла;
					Продолжить;
				Исключение
					ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			КонецЕсли;
			
			ЗафиксироватьОшибкуГруппы(СтрокиГруппы, "Ошибка записи документа: " + ТекстОшибки, Результат);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Ищет существующий документ "ОперацияУчетаНДФЛ" в базе ERP.
Функция НайтиСуществующийДокументОперацияУчетаНДФЛ(Организация, ФизическоеЛицо, ПериодРегистрации)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ссылка ИЗ Документ.ОперацияУчетаНДФЛ
		|ГДЕ Организация = &Организация
		|  И ФизическоеЛицо = &ФизическоеЛицо
		|  И ПериодРегистрации = &ПериодРегистрации
		|  И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("ПериодРегистрации", ПериодРегистрации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаЧерезПереносДанных

// Загружает данные через технический документ "ПереносДанных" с прямой записью движений в регистр.
Процедура ЗагрузитьЧерезПереносДанных(ТаблицаДанных, ПараметрыЗагрузки, Результат)
	
	Протокол = Результат.Журнал;
	Протокол.Добавить("Начало загрузки через документы 'Перенос данных'...");
	
	ИмяРегистра = ИмяОсновногоРегистраНДФЛ();
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Результат.Ошибок = Результат.ВсегоСтрок;
		Протокол.Добавить("В базе ERP не найден регистр учета доходов по НДФЛ ('СведенияОДоходахНДФЛ'). Загрузка невозможна.");
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Документы.Найти("ПереносДанных") = Неопределено Тогда
		Результат.Ошибок = Результат.ВсегоСтрок;
		Протокол.Добавить("В конфигурации отсутствует документ 'ПереносДанных'. Выберите способ 'ОперацияУчетаНДФЛ'.");
		Возврат;
	КонецЕсли;
	
	// Группируем по Организации и Месяцу
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;
	
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если Не Стр.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = СтрШаблон("%1#%2",
			СокрЛП(Стр.ОрганизацияИНН),
			Формат(Стр.МесяцНалоговогоПериода, "ДФ=yyyyMM01"));
		
		СтрокиГруппы = Группы[Ключ];
		Если СтрокиГруппы = Неопределено Тогда
			СтрокиГруппы = Новый Массив;
			Группы.Вставить(Ключ, СтрокиГруппы);
			ПорядокГрупп.Добавить(Ключ);
		КонецЕсли;
		СтрокиГруппы.Добавить(Стр);
	КонецЦикла;
	
	Для Каждого Ключ Из ПорядокГрупп Цикл
		СтрокиГруппы = Группы[Ключ];
		ПерваяСтрока = СтрокиГруппы[0];
		
		ДанныеОРГ = Новый Структура("ИНН, КПП, Наименование, УИД",
			ПерваяСтрока.ОрганизацияИНН, ПерваяСтрока.ОрганизацияКПП, ПерваяСтрока.ОрганизацияНаименование, ПерваяСтрока.ОрганизацияУИД);
		ОрганизацияСсылка = НайтиОрганизацию(ДанныеОРГ);
		Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
			Сообщение = СтрШаблон("Организация '%1' (ИНН: %2) не найдена в базе ERP.", ПерваяСтрока.ОрганизацияНаименование, ПерваяСтрока.ОрганизацияИНН);
			ЗафиксироватьОшибкуГруппы(СтрокиГруппы, Сообщение, Результат);
			Продолжить;
		КонецЕсли;
		
		ПериодРегистрации = НачалоМесяца(ПерваяСтрока.МесяцНалоговогоПериода);
		Если Не ЗначениеЗаполнено(ПериодРегистрации) Тогда
			ПериодРегистрации = НачалоМесяца(ПерваяСтрока.ДатаПолученияДохода);
		КонецЕсли;
		
		Попытка
			ДокОбъект = Документы.ПереносДанных.СоздатьДокумент();
			ДокОбъект.Дата = ТекущаяДатаСеанса();
			ДокОбъект.Организация = ОрганизацияСсылка;
			ДокОбъект.ПериодРегистрации = ПериодРегистрации;
			Если ДокОбъект.Метаданные().Реквизиты.Найти("НомерРегистратора") <> Неопределено Тогда
				ДокОбъект.НомерРегистратора = "НДФЛ";
			КонецЕсли;
			ДокОбъект.Комментарий = "Загрузка данных НДФЛ из ЗУП по COM-соединению";
			
			// Настройка состава регистров переноса данных
			Если ДокОбъект.Метаданные().ТабличныеЧасти.Найти("Настройка") <> Неопределено Тогда
				СтрокаНастройки = ДокОбъект.Настройка.Добавить();
				СтрокаНастройки.ИмяРегистра = ИмяРегистра;
			КонецЕсли;
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			// Записываем движения напрямую через НаборЗаписей регистра
			НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ДокОбъект.Ссылка);
			
			Для Каждого СтрДанных Из СтрокиГруппы Цикл
				ДанныеФЛ = Новый Структура("СНИЛС, ИНН, Наименование, ДатаРождения, УИД",
					СтрДанных.ФизическоеЛицоСНИЛС, СтрДанных.ФизическоеЛицоИНН, СтрДанных.ФизическоеЛицоНаименование, СтрДанных.ФизическоеЛицоДатаРождения, СтрДанных.ФизическоеЛицоУИД);
				ФизЛицоСсылка = НайтиФизическоеЛицо(ДанныеФЛ, ПараметрыЗагрузки.СоздаватьНовыеФизлица, Протокол);
				Если Не ЗначениеЗаполнено(ФизЛицоСсылка) Тогда
					ФиксироватьОшибкуСтроки(СтрДанных, "Физическое лицо не сопоставлено в ERP", Результат);
					Продолжить;
				КонецЕсли;
				
				ДанныеСотр = Новый Структура("Код, Наименование, УИД",
					СтрДанных.СотрудникКод, СтрДанных.СотрудникНаименование, СтрДанных.СотрудникУИД);
				СотрудникСсылка = НайтиСотрудника(ДанныеСотр, ФизЛицоСсылка, ОрганизацияСсылка);
				ВидДоходаСсылка = НайтиВидДоходаНДФЛ(СтрДанных.КодДохода, СтрДанных.НаименованиеДохода);
				ВидВычетаСсылка = НайтиВидВычетаНДФЛ(СтрДанных.КодВычета, "");
				ПодразделениеСсылка = НайтиПодразделение(ОрганизацияСсылка, СтрДанных.ПодразделениеНаименование);
				КатегорияДоходаЗнач = НайтиЗначениеПеречисления("КатегорииДоходовНДФЛ", СтрДанных.КатегорияДохода);
				СтавкаЗнач = НайтиЗначениеПеречисления("СтавкиНалогообложенияРезидента", СтрДанных.СтавкаНалогообложения);
				
				Запись = НаборЗаписей.Добавить();
				Запись.Период = СтрДанных.ДатаПолученияДохода;
				Запись.Организация = ОрганизацияСсылка;
				Запись.ФизическоеЛицо = ФизЛицоСсылка;
				
				МДРег = Метаданные.РегистрыНакопления[ИмяРегистра];
				Если МДРег.Измерения.Найти("Сотрудник") <> Неопределено Или МДРег.Реквизиты.Найти("Сотрудник") <> Неопределено Тогда
					Запись.Сотрудник = СотрудникСсылка;
				КонецЕсли;
				Если МДРег.Измерения.Найти("МесяцНалоговогоПериода") <> Неопределено Тогда
					Запись.МесяцНалоговогоПериода = НачалоМесяца(СтрДанных.МесяцНалоговогоПериода);
				КонецЕсли;
				Если МДРег.Реквизиты.Найти("ДатаПолученияДохода") <> Неопределено Тогда
					Запись.ДатаПолученияДохода = СтрДанных.ДатаПолученияДохода;
				КонецЕсли;
				Если МДРег.Измерения.Найти("КодДохода") <> Неопределено Тогда
					Запись.КодДохода = ВидДоходаСсылка;
				КонецЕсли;
				Если МДРег.Измерения.Найти("КатегорияДохода") <> Неопределено Тогда
					Запись.КатегорияДохода = КатегорияДоходаЗнач;
				КонецЕсли;
				Если МДРег.Измерения.Найти("СтавкаНалогообложенияРезидента") <> Неопределено Тогда
					Запись.СтавкаНалогообложенияРезидента = СтавкаЗнач;
				КонецЕсли;
				Если МДРег.Измерения.Найти("Подразделение") <> Неопределено Тогда
					Запись.Подразделение = ПодразделениеСсылка;
				КонецЕсли;
				Если МДРег.Измерения.Найти("ВключатьВДекларациюПоНалогуНаПрибыль") <> Неопределено Тогда
					Запись.ВключатьВДекларациюПоНалогуНаПрибыль = СтрДанных.ВключатьВДекларациюПоНалогуНаПрибыль;
				КонецЕсли;
				
				// Ресурсы
				Запись.Сумма = СтрДанных.СуммаДохода;
				Если МДРег.Ресурсы.Найти("СуммаВычета") <> Неопределено Тогда
					Запись.СуммаВычета = СтрДанных.СуммаВычета;
				ИначеЕсли МДРег.Ресурсы.Найти("УчитыватьВычетВТекущемМесяце") <> Неопределено Тогда
					Запись.УчитыватьВычетВТекущемМесяце = СтрДанных.СуммаВычета;
				КонецЕсли;
				
				// Реквизиты вычета
				Если МДРег.Реквизиты.Найти("КодВычета") <> Неопределено Тогда
					Запись.КодВычета = ВидВычетаСсылка;
				КонецЕсли;
				Если МДРег.Реквизиты.Найти("СуммаВычета") <> Неопределено Тогда
					Запись.СуммаВычета = СтрДанных.СуммаВычета;
				КонецЕсли;
				
				Результат.Загружено = Результат.Загружено + 1;
				ФиксироватьУспехСтроки(СтрДанных, "Загружено в регистр через ПереносДанных № " + ДокОбъект.Номер, Результат);
			КонецЦикла;
			
			НаборЗаписей.Записать(Истина);
			Результат.СозданоДокументов = Результат.СозданоДокументов + 1;
			Протокол.Добавить(СтрШаблон("Создан документ 'Перенос данных' № %1 от %2 (записей: %3).",
				ДокОбъект.Номер, Формат(ДокОбъект.Дата, "ДФ=dd.MM.yyyy"), НаборЗаписей.Количество()));
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗафиксироватьОшибкуГруппы(СтрокиГруппы, "Ошибка создания Переноса данных: " + ТекстОшибки, Результат);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ФиксацияРезультатов

Процедура ФиксироватьУспехСтроки(СтрДанных, Сообщение, Результат)
	
	Инфо = Новый Структура;
	Инфо.Вставить("Статус", "Загружен");
	Инфо.Вставить("Сообщение", Сообщение);
	Результат.РезультатыСтрок.Вставить(СтрДанных.ИдентификаторСтроки, Инфо);
	
КонецПроцедуры

Процедура ФиксироватьОшибкуСтроки(СтрДанных, Сообщение, Результат)
	
	Результат.Ошибок = Результат.Ошибок + 1;
	Инфо = Новый Структура;
	Инфо.Вставить("Статус", "Ошибка");
	Инфо.Вставить("Сообщение", Сообщение);
	Результат.РезультатыСтрок.Вставить(СтрДанных.ИдентификаторСтроки, Инфо);
	Результат.Журнал.Добавить(СтрШаблон("Строка %1 (%2, %3): %4",
		СтрДанных.ИдентификаторСтроки, СтрДанных.ФизическоеЛицоНаименование, Формат(СтрДанных.ДатаПолученияДохода, "ДФ=dd.MM.yyyy"), Сообщение));
	
КонецПроцедуры

Процедура ЗафиксироватьОшибкуГруппы(СтрокиГруппы, Сообщение, Результат)
	
	Для Каждого Стр Из СтрокиГруппы Цикл
		ФиксироватьОшибкуСтроки(Стр, Сообщение, Результат);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
