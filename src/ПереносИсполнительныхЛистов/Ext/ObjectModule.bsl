#Область ПубличныйИнтерфейс

// Формирует JSON-пакет в базе ЗУП.
// В пакет попадают только документы, которые являются основаниями действующих
// записей регистра ПлановыеУдержания на ДатаПереноса.
Функция ВыгрузитьИсполнительныеЛисты(ДатаПереноса) Экспорт

	ПроверитьМетаданныеДляВыгрузки();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПлановыеУдержания.ДокументОснование КАК ДокументОснование,
	|	ПлановыеУдержания.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ПлановыеУдержания.СрезПоследних(&ДатаПереноса) КАК ПлановыеУдержания
	|ГДЕ
	|	ПлановыеУдержания.Используется
	|	И ПлановыеУдержания.ДокументОснование ССЫЛКА Документ.ИсполнительныйЛист";
	Запрос.УстановитьПараметр("ДатаПереноса", КонецДня(ДатаПереноса));

	ДокументыПакета = Новый Массив;
	ДанныеПоUUID = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		UUIDДокумента = Строка(Выборка.ДокументОснование.УникальныйИдентификатор());
		ДанныеДокумента = ДанныеПоUUID.Получить(UUIDДокумента);
		Если ДанныеДокумента = Неопределено Тогда
			ДанныеДокумента = СериализоватьДокумент(Выборка.ДокументОснование);
			ДанныеПоUUID.Вставить(UUIDДокумента, ДанныеДокумента);
			ДокументыПакета.Добавить(ДанныеДокумента);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Регистратор)
			И Выборка.Регистратор.Метаданные().ПолноеИмя()
				= "Документ.ИзменениеУсловийИсполнительногоЛиста" Тогда
			ДополнитьАктуальнымиУсловиями(ДанныеДокумента, Выборка.Регистратор);
		КонецЕсли;
		СкорректироватьПределПоОстатку(
			ДанныеДокумента,
			Выборка.ДокументОснование,
			КонецДня(ДатаПереноса));
	КонецЦикла;

	Пакет = Новый Структура;
	Пакет.Вставить("Формат", "ПереносИсполнительныхЛистов");
	Пакет.Вставить("Версия", 1);
	Пакет.Вставить("ДатаПереноса", XMLСтрока(КонецДня(ДатаПереноса)));
	Пакет.Вставить("ДатаФормирования", XMLСтрока(ТекущаяДатаСеанса()));
	Пакет.Вставить("Документы", ДокументыПакета);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Пакет);
	Возврат Новый Структура(
		"Данные,Количество",
		Запись.Закрыть(),
		ДокументыПакета.Количество());

КонецФункции

// Загружает пакет в ERP. Возвращает счетчики и подробный протокол.
// Каждый документ записывается в отдельной транзакции: ошибка одной строки
// не отменяет успешно загруженные документы.
Функция ЗагрузитьИсполнительныеЛисты(СтрокаJSON, ПроводитьДокументы = Истина) Экспорт

	ПроверитьМетаданныеДляЗагрузки();
	Пакет = ПрочитатьПакет(СтрокаJSON);
	ПроверитьДокументыПакета(Пакет.Документы);
	Протокол = Новый Массив;
	Создано = 0;
	Пропущено = 0;
	Ошибок = 0;

	Для Каждого ДанныеДокумента Из Пакет.Документы Цикл
		Попытка
			СуществующийДокумент = НайтиЗагруженныйДокумент(ДанныеДокумента, Протокол);
		Исключение
			Ошибок = Ошибок + 1;
			Протокол.Добавить(ПредставлениеИсточника(ДанныеДокумента)
				+ ": ОШИБКА ПРОВЕРКИ ДУБЛЯ: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

		Если СуществующийДокумент <> Неопределено Тогда
			Пропущено = Пропущено + 1;
			Протокол.Добавить(ПредставлениеИсточника(ДанныеДокумента)
				+ ": пропущен, документ уже существует.");
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.ИсполнительныйЛист");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			ДубльПодБлокировкой =
				НайтиЗагруженныйДокумент(ДанныеДокумента, Протокол) <> Неопределено;

			Если Не ДубльПодБлокировкой Тогда
				НовыйДокумент = Документы.ИсполнительныйЛист.СоздатьДокумент();
				ЗаполнитьДокумент(НовыйДокумент, ДанныеДокумента, Протокол);

				Если ПроводитьДокументы Тогда
					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			КонецЕсли;

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Ошибок = Ошибок + 1;
			Протокол.Добавить(ПредставлениеИсточника(ДанныеДокумента)
				+ ": ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если ДубльПодБлокировкой Тогда
			Пропущено = Пропущено + 1;
			Протокол.Добавить(ПредставлениеИсточника(ДанныеДокумента)
				+ ": пропущен после блокировки, документ уже существует.");
		Иначе
			Создано = Создано + 1;
			Протокол.Добавить(ПредставлениеИсточника(ДанныеДокумента)
				+ ": создан " + Строка(НовыйДокумент.Ссылка) + ".");
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура(
		"Создано,Пропущено,Ошибок,Протокол",
		Создано,
		Пропущено,
		Ошибок,
		Протокол);

КонецФункции

#КонецОбласти

#Область Выгрузка

Процедура ПроверитьМетаданныеДляВыгрузки()

	Если Метаданные.РегистрыСведений.Найти("ПлановыеУдержания") = Неопределено Тогда
		ВызватьИсключение "В конфигурации отсутствует регистр сведений ПлановыеУдержания.";
	КонецЕсли;
	Если Метаданные.Документы.Найти("ИсполнительныйЛист") = Неопределено Тогда
		ВызватьИсключение "В конфигурации отсутствует документ ИсполнительныйЛист.";
	КонецЕсли;
	Если Метаданные.РегистрыСведений.ПлановыеУдержания.Ресурсы.Найти("Используется") = Неопределено
		И Метаданные.РегистрыСведений.ПлановыеУдержания.Реквизиты.Найти("Используется") = Неопределено
		И Метаданные.РегистрыСведений.ПлановыеУдержания.Измерения.Найти("Используется") = Неопределено Тогда
		ВызватьИсключение "В регистре ПлановыеУдержания отсутствует поле Используется. Требуется адаптация запроса под релиз ЗУП.";
	КонецЕсли;
	Если Метаданные.РегистрыСведений.ПлановыеУдержания.Измерения.Найти("ДокументОснование") = Неопределено
		И Метаданные.РегистрыСведений.ПлановыеУдержания.Ресурсы.Найти("ДокументОснование") = Неопределено
		И Метаданные.РегистрыСведений.ПлановыеУдержания.Реквизиты.Найти("ДокументОснование") = Неопределено Тогда
		ВызватьИсключение "В регистре ПлановыеУдержания отсутствует поле ДокументОснование. Требуется адаптация запроса под релиз ЗУП.";
	КонецЕсли;

КонецПроцедуры

Функция СериализоватьДокумент(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("Номер", Объект.Номер);
	Данные.Вставить("Дата", XMLСтрока(Объект.Дата));
	Данные.Вставить("ИсходныйUUID", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Проведен", Объект.Проведен);

	Поля = Новый Структура;
	Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
		Поля.Вставить(Реквизит.Имя, СериализоватьЗначение(Объект[Реквизит.Имя], 0));
	КонецЦикла;
	Данные.Вставить("Поля", Поля);

	ТабличныеЧасти = Новый Структура;
	Для Каждого МетаданныеТЧ Из Объект.Метаданные().ТабличныеЧасти Цикл
		Строки = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект[МетаданныеТЧ.Имя] Цикл
			ДанныеСтроки = Новый Структура;
			Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
				ДанныеСтроки.Вставить(
					РеквизитТЧ.Имя,
					СериализоватьЗначение(СтрокаТЧ[РеквизитТЧ.Имя], 0));
			КонецЦикла;
			Строки.Добавить(ДанныеСтроки);
		КонецЦикла;
		ТабличныеЧасти.Вставить(МетаданныеТЧ.Имя, Строки);
	КонецЦикла;
	Данные.Вставить("ТабличныеЧасти", ТабличныеЧасти);

	Возврат Данные;

КонецФункции

Процедура ДополнитьАктуальнымиУсловиями(ДанныеДокумента, Регистратор)

	ОбъектИзменения = Регистратор.ПолучитьОбъект();
	Для Каждого Реквизит Из ОбъектИзменения.Метаданные().Реквизиты Цикл
		СтароеЗначение = Неопределено;
		Если ДанныеДокумента.Поля.Свойство(Реквизит.Имя, СтароеЗначение) Тогда
			ДанныеДокумента.Поля.Вставить(
				Реквизит.Имя,
				СериализоватьЗначение(ОбъектИзменения[Реквизит.Имя], 0));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СкорректироватьПределПоОстатку(ДанныеДокумента, ДокументОснование, ДатаПереноса)

	Предел = Неопределено;
	Если Не ДанныеДокумента.Поля.Свойство("Предел", Предел)
		Или Предел = Неопределено
		Или Предел = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти("УдержанияДоПределаПоСотрудникам") = Неопределено Тогда
		ВызватьИсключение "Не найден регистр УдержанияДоПределаПоСотрудникам: "
			+ "невозможно определить остаток по исполнительному листу "
			+ Строка(ДокументОснование) + ".";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Остатки.СуммаОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.УдержанияДоПределаПоСотрудникам.Остатки(
	|		&ДатаПереноса,
	|		ДокументОснование = &ДокументОснование) КАК Остатки";
	Запрос.УстановитьПараметр("ДатаПереноса", ДатаПереноса);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Остаток <> NULL Тогда
		ДанныеДокумента.Поля.Вставить("Предел", Выборка.Остаток);
	КонецЕсли;

КонецПроцедуры

Функция СериализоватьЗначение(Значение, Глубина)

	Если Значение = Неопределено
		Или Значение = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Новый Структура("Вид,Значение", "Дата", XMLСтрока(Значение));
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Новый Структура("Вид,Значение", "УникальныйИдентификатор", Строка(Значение));
	КонецЕсли;

	Попытка
		МетаданныеЗначения = Значение.Метаданные();
	Исключение
		Возврат Новый Структура("Вид,Значение", "Представление", Строка(Значение));
	КонецПопытки;

	Если МетаданныеЗначения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Вид", "Ссылка");
	Описание.Вставить("ТипМетаданных", МетаданныеЗначения.ПолноеИмя());
	Описание.Вставить("Представление", Строка(Значение));
	Описание.Вставить("Пустая", Не ЗначениеЗаполнено(Значение));
	Ключи = Новый Структура;

	Если СтрНачинаетсяС(МетаданныеЗначения.ПолноеИмя(), "Перечисление.")
		И ЗначениеЗаполнено(Значение) Тогда
		ИндексЗначения = Перечисления[МетаданныеЗначения.Имя].Индекс(Значение);
		Описание.Вставить(
			"ИмяЗначения",
			МетаданныеЗначения.ЗначенияПеречисления[ИндексЗначения].Имя);
	КонецЕсли;

	Если ЗначениеЗаполнено(Значение) И Глубина < 2 Тогда
		ДобавитьКлючСсылки(Ключи, Значение, "Код", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "Наименование", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "ИмяПредопределенныхДанных", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "ИНН", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "КПП", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "СНИЛС", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "ДатаРождения", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "НомерСчета", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "Владелец", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "Банк", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "ТабельныйНомер", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "ФизическоеЛицо", Глубина);
		ДобавитьКлючСсылки(Ключи, Значение, "Организация", Глубина);
	КонецЕсли;

	Описание.Вставить("Ключи", Ключи);
	Возврат Описание;

КонецФункции

Процедура ДобавитьКлючСсылки(Ключи, Ссылка, ИмяСвойства, Глубина)

	Попытка
		ЗначениеКлюча = Ссылка[ИмяСвойства];
		Если ЗначениеЗаполнено(ЗначениеКлюча) Тогда
			Ключи.Вставить(ИмяСвойства, СериализоватьЗначение(ЗначениеКлюча, Глубина + 1));
		КонецЕсли;
	Исключение
		// Реквизит отсутствует у этого ссылочного типа.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Загрузка

Процедура ПроверитьМетаданныеДляЗагрузки()

	Если Метаданные.Документы.Найти("ИсполнительныйЛист") = Неопределено Тогда
		ВызватьИсключение "В конфигурации отсутствует документ ИсполнительныйЛист.";
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьПакет(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Пакет = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Если ТипЗнч(Пакет) <> Тип("Структура")
		Или Не Пакет.Свойство("Формат")
		Или Пакет.Формат <> "ПереносИсполнительныхЛистов"
		Или Не Пакет.Свойство("Версия")
		Или Пакет.Версия <> 1
		Или Не Пакет.Свойство("Документы") Тогда
		ВызватьИсключение "Файл не является пакетом переноса исполнительных листов версии 1.";
	КонецЕсли;

	Возврат Пакет;

КонецФункции

Процедура ПроверитьДокументыПакета(ДокументыПакета)

	Если ТипЗнч(ДокументыПакета) <> Тип("Массив") Тогда
		ВызватьИсключение "Поле Документы пакета должно быть массивом.";
	КонецЕсли;

	НомераUUID = Новый Соответствие;
	Для Каждого ДанныеДокумента Из ДокументыПакета Цикл
		Если ТипЗнч(ДанныеДокумента) <> Тип("Структура")
			Или Не ДанныеДокумента.Свойство("Номер")
			Или Не ДанныеДокумента.Свойство("Дата")
			Или Не ДанныеДокумента.Свойство("ИсходныйUUID")
			Или Не ДанныеДокумента.Свойство("Поля")
			Или ТипЗнч(ДанныеДокумента.Поля) <> Тип("Структура")
			Или Не ДанныеДокумента.Свойство("ТабличныеЧасти")
			Или ТипЗнч(ДанныеДокумента.ТабличныеЧасти) <> Тип("Структура") Тогда
			ВызватьИсключение "В пакете обнаружено некорректное описание документа.";
		КонецЕсли;
		Попытка
			XMLЗначение(Тип("Дата"), ДанныеДокумента.Дата);
			ПроверочныйUUID = Новый УникальныйИдентификатор(ДанныеДокумента.ИсходныйUUID);
		Исключение
			ВызватьИсключение "В пакете обнаружены некорректные дата или UUID документа.";
		КонецПопытки;
		Если НомераUUID.Получить(ДанныеДокумента.ИсходныйUUID) <> Неопределено Тогда
			ВызватьИсключение "В пакете повторяется UUID документа "
				+ ДанныеДокумента.ИсходныйUUID + ".";
		КонецЕсли;
		НомераUUID.Вставить(ДанныеДокумента.ИсходныйUUID, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДокумент(ДокументОбъект, ДанныеДокумента, Протокол)

	ДокументОбъект.Дата = XMLЗначение(Тип("Дата"), ДанныеДокумента.Дата);
	МетаданныеДокумента = ДокументОбъект.Метаданные();

	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		СериализованноеЗначение = Неопределено;
		Если Не ДанныеДокумента.Поля.Свойство(Реквизит.Имя, СериализованноеЗначение) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ДокументОбъект[Реквизит.Имя] =
				ВосстановитьЗначение(СериализованноеЗначение, Протокол, Реквизит.Имя);
		Исключение
			ТекстОшибки = "Не удалось заполнить реквизит " + Реквизит.Имя
				+ ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецЦикла;

	Если МетаданныеДокумента.Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Маркер = МаркерИсточника(ДанныеДокумента);
		Если СтрНайти(ДокументОбъект.Комментарий, Маркер) = 0 Тогда
			ДокументОбъект.Комментарий =
				СокрЛП(Маркер + " " + ДокументОбъект.Комментарий);
		КонецЕсли;
	КонецЕсли;

	Для Каждого МетаданныеТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		СтрокиИсточника = Неопределено;
		Если Не ДанныеДокумента.ТабличныеЧасти.Свойство(МетаданныеТЧ.Имя, СтрокиИсточника) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ДанныеСтроки Из СтрокиИсточника Цикл
			НоваяСтрока = ДокументОбъект[МетаданныеТЧ.Имя].Добавить();
			Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
				СериализованноеЗначение = Неопределено;
				Если ДанныеСтроки.Свойство(РеквизитТЧ.Имя, СериализованноеЗначение) Тогда
					НоваяСтрока[РеквизитТЧ.Имя] =
						ВосстановитьЗначение(
							СериализованноеЗначение,
							Протокол,
							МетаданныеТЧ.Имя + "." + РеквизитТЧ.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ВосстановитьЗначение(Описание, Протокол, Путь)

	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Возврат Описание;
	КонецЕсли;

	Вид = "";
	Если Не Описание.Свойство("Вид", Вид) Тогда
		Возврат Описание;
	КонецЕсли;
	Если Вид = "Дата" Тогда
		Возврат XMLЗначение(Тип("Дата"), Описание.Значение);
	ИначеЕсли Вид = "УникальныйИдентификатор" Тогда
		Возврат Новый УникальныйИдентификатор(Описание.Значение);
	ИначеЕсли Вид = "Ссылка" Тогда
		Возврат НайтиСсылку(Описание, Протокол, Путь);
	Иначе
		Возврат Описание.Значение;
	КонецЕсли;

КонецФункции

Функция НайтиСсылку(Описание, Протокол, Путь)

	ЧастиИмени = СтрРазделить(Описание.ТипМетаданных, ".");
	Если ЧастиИмени.Количество() < 2 Тогда
		ВызватьИсключение "Некорректный тип ссылки " + Описание.ТипМетаданных + ".";
	КонецЕсли;
	ВидМетаданных = ЧастиИмени[0];
	ИмяМетаданных = ЧастиИмени[1];

	Если ВидМетаданных = "Перечисление" Тогда
		МетаданныеПеречисления = Метаданные.Перечисления.Найти(ИмяМетаданных);
		Если МетаданныеПеречисления = Неопределено Тогда
			ВызватьИсключение "В ERP отсутствует " + Описание.ТипМетаданных + ".";
		КонецЕсли;
		Если Описание.Пустая Тогда
			Возврат Перечисления[ИмяМетаданных].ПустаяСсылка();
		КонецЕсли;
		Если Не Описание.Свойство("ИмяЗначения")
			Или МетаданныеПеречисления.ЗначенияПеречисления.Найти(Описание.ИмяЗначения) = Неопределено Тогда
			ВызватьИсключение "Не найдено значение " + Описание.ТипМетаданных
				+ " """ + Описание.Представление + """.";
		КонецЕсли;
		Возврат Перечисления[ИмяМетаданных][Описание.ИмяЗначения];
	КонецЕсли;

	Если ВидМетаданных = "Справочник" Тогда
		МетаданныеСсылки = Метаданные.Справочники.Найти(ИмяМетаданных);
		ИмяТаблицы = "Справочник." + ИмяМетаданных;
	ИначеЕсли ВидМетаданных = "ПланВидовРасчета" Тогда
		МетаданныеСсылки = Метаданные.ПланыВидовРасчета.Найти(ИмяМетаданных);
		ИмяТаблицы = "ПланВидовРасчета." + ИмяМетаданных;
	ИначеЕсли ВидМетаданных = "ПланВидовХарактеристик" Тогда
		МетаданныеСсылки = Метаданные.ПланыВидовХарактеристик.Найти(ИмяМетаданных);
		ИмяТаблицы = "ПланВидовХарактеристик." + ИмяМетаданных;
	Иначе
		ВызватьИсключение "Автоматическое сопоставление типа "
			+ Описание.ТипМетаданных + " не поддерживается.";
	КонецЕсли;

	Если МетаданныеСсылки = Неопределено Тогда
		ВызватьИсключение "В ERP отсутствует " + Описание.ТипМетаданных + ".";
	КонецЕсли;
	Если Описание.Пустая Тогда
		Если ВидМетаданных = "Справочник" Тогда
			Возврат Справочники[ИмяМетаданных].ПустаяСсылка();
		ИначеЕсли ВидМетаданных = "ПланВидовРасчета" Тогда
			Возврат ПланыВидовРасчета[ИмяМетаданных].ПустаяСсылка();
		Иначе
			Возврат ПланыВидовХарактеристик[ИмяМетаданных].ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;

	Условия = Новый Массив;
	Параметры = Новый Структура;
	Если ИмяМетаданных = "Организации" Или ИмяМетаданных = "Контрагенты" Тогда
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "ИНН", Протокол);
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "КПП", Протокол);
	ИначеЕсли ИмяМетаданных = "ФизическиеЛица" Тогда
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "СНИЛС", Протокол);
		Если Условия.Количество() = 0 Тогда
			ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "ИНН", Протокол);
		КонецЕсли;
		Если Условия.Количество() = 0 Тогда
			ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "Наименование", Протокол);
			ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "ДатаРождения", Протокол);
		КонецЕсли;
	ИначеЕсли ИмяМетаданных = "Сотрудники" Тогда
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "ФизическоеЛицо", Протокол);
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "Организация", Протокол);
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "ТабельныйНомер", Протокол);
	ИначеЕсли ИмяМетаданных = "БанковскиеСчетаКонтрагентов" Тогда
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "НомерСчета", Протокол);
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "Владелец", Протокол);
		ДобавитьУсловиеПоКлючу(Условия, Параметры, МетаданныеСсылки, Описание.Ключи, "Банк", Протокол);
	Иначе
		ДобавитьУсловиеПоКлючу(
			Условия,
			Параметры,
			МетаданныеСсылки,
			Описание.Ключи,
			"ИмяПредопределенныхДанных",
			Протокол);
		Если Условия.Количество() = 0 Тогда
			// Коды в независимых базах ЗУП и ERP не являются общим ключом.
			ДобавитьУсловиеПоКлючу(
				Условия,
				Параметры,
				МетаданныеСсылки,
				Описание.Ключи,
				"Наименование",
				Протокол);
		КонецЕсли;
	КонецЕсли;

	Если Условия.Количество() = 0 Тогда
		ВызватьИсключение "Недостаточно ключей для сопоставления "
			+ Описание.ТипМетаданных + " """ + Описание.Представление + """.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка "
		+ "ИЗ " + ИмяТаблицы + " "
		+ "ГДЕ " + СтрСоединить(Условия, " И ");
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Найденные = Запрос.Выполнить().Выгрузить();

	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение "В ERP не найден " + Описание.ТипМетаданных
			+ " """ + Описание.Представление + """.";
	ИначеЕсли Найденные.Количество() > 1 Тогда
		ВызватьИсключение "В ERP найдено несколько элементов "
			+ Описание.ТипМетаданных + " """ + Описание.Представление + """.";
	КонецЕсли;

	Возврат Найденные[0].Ссылка;

КонецФункции

Процедура ДобавитьУсловиеПоКлючу(
		Условия,
		Параметры,
		МетаданныеСправочника,
		Ключи,
		ИмяКлюча,
		Протокол)

	ОписаниеКлюча = Неопределено;
	Если Не Ключи.Свойство(ИмяКлюча, ОписаниеКлюча) Тогда
		Возврат;
	КонецЕсли;
	Если ИмяКлюча <> "Код"
		И ИмяКлюча <> "Наименование"
		И ИмяКлюча <> "ИмяПредопределенныхДанных"
		И ИмяКлюча <> "Владелец"
		И МетаданныеСправочника.Реквизиты.Найти(ИмяКлюча) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеКлюча = ВосстановитьЗначение(ОписаниеКлюча, Протокол, ИмяКлюча);
	Если Не ЗначениеЗаполнено(ЗначениеКлюча) Тогда
		Возврат;
	КонецЕсли;
	Условия.Добавить(ИмяКлюча + " = &" + ИмяКлюча);
	Параметры.Вставить(ИмяКлюча, ЗначениеКлюча);

КонецПроцедуры

Функция НайтиЗагруженныйДокумент(ДанныеДокумента, Протокол)

	МетаданныеДокумента = Метаданные.Документы.ИсполнительныйЛист;
	Если МетаданныеДокумента.Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИсполнительныйЛист.Ссылка
		|ИЗ
		|	Документ.ИсполнительныйЛист КАК ИсполнительныйЛист
		|ГДЕ
		|	ИсполнительныйЛист.Комментарий ПОДОБНО &Маркер";
		Запрос.УстановитьПараметр("Маркер", "%" + МаркерИсточника(ДанныеДокумента) + "%");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаркерИсточника(ДанныеДокумента)

	Возврат "[ZUP-IL:"
		+ ДанныеДокумента.ИсходныйUUID
		+ "]";

КонецФункции

Функция ПредставлениеИсточника(ДанныеДокумента)

	Возврат "Исполнительный лист ЗУП № "
		+ ДанныеДокумента.Номер
		+ " от "
		+ Формат(XMLЗначение(Тип("Дата"), ДанныеДокумента.Дата), "ДФ=dd.MM.yyyy");

КонецФункции

#КонецОбласти
