#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

// Соответствие: полное имя объекта метаданных -> Массив строк вида "Поле1,Поле2".
// Наборы полей перебираются по порядку, ссылка считается найденной при единственном совпадении.
Перем ПравилаПоискаСсылок;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Подбирает исполнительные листы, действующие на дату по регистру сведений ПлановыеУдержания.
//
// Параметры:
//  ДатаПереноса - Дата - дата, на которую удержание должно действовать.
//  Организация  - СправочникСсылка.Организации - отбор, пустое значение - все организации.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Пометка, Ссылка, Организация, ФизическоеЛицо.
//
Функция ДокументыДействующиеНаДату(ДатаПереноса, Организация = Неопределено) Экспорт
	
	МДРегистра = Метаданные.РегистрыСведений.Найти("ПлановыеУдержания");
	Если МДРегистра = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации нет регистра сведений ""Плановые удержания"". Выгрузку выполняйте в информационной базе ЗУП.'");
	КонецЕсли;
	
	ИмяПоляДокумента = ИмяПоляИсполнительногоЛиста(МДРегистра);
	Если ПустаяСтрока(ИмяПоляДокумента) Тогда
		ВызватьИсключение НСтр("ru = 'В регистре сведений ""Плановые удержания"" не найдено поле со ссылкой на документ ""Исполнительный лист"".'");
	КонецЕсли;
	
	Если МДРегистра.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		ИсточникДанных = "РегистрСведений.ПлановыеУдержания";
	Иначе
		ИсточникДанных = "РегистрСведений.ПлановыеУдержания.СрезПоследних(&Дата)";
	КонецЕсли;
	
	// Условие "Действует" накладывается на результат среза, а не на параметры виртуальной таблицы:
	// иначе срез вернет последнюю действовавшую запись даже для прекращенных удержаний.
	УсловияРегистра = Новый Массив;
	УсловияРегистра.Добавить(СтрШаблон("ПлановыеУдержания.%1 ССЫЛКА Документ.ИсполнительныйЛист", ИмяПоляДокумента));
	Если ЕстьБулевоПолеРегистра(МДРегистра, "Действует") Тогда
		УсловияРегистра.Добавить("ПлановыеУдержания.Действует = ИСТИНА");
	КонецЕсли;
	
	МДДокумента = Метаданные.Документы.ИсполнительныйЛист;
	ЕстьОрганизация = МДДокумента.Реквизиты.Найти("Организация") <> Неопределено;
	
	ПолеОрганизация = ?(ЕстьОрганизация,
		"Действующие.Ссылка.Организация",
		"ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)");
	ПолеФизическоеЛицо = ?(МДДокумента.Реквизиты.Найти("ФизическоеЛицо") <> Неопределено,
		"Действующие.Ссылка.ФизическоеЛицо",
		"ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)");
	
	УсловиеОрганизация = "";
	Если ЕстьОрганизация И ЗначениеЗаполнено(Организация) Тогда
		УсловиеОрганизация = "И Действующие.Ссылка.Организация = &Организация";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ПлановыеУдержания.%1 КАК Документ.ИсполнительныйЛист) КАК Ссылка
	|ПОМЕСТИТЬ ВТДействующие
	|ИЗ
	|	%2 КАК ПлановыеУдержания
	|ГДЕ
	|	%3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Пометка,
	|	Действующие.Ссылка КАК Ссылка,
	|	%4 КАК Организация,
	|	%5 КАК ФизическоеЛицо
	|ИЗ
	|	ВТДействующие КАК Действующие
	|ГДЕ
	|	Действующие.Ссылка.Проведен
	|	%6
	|
	|УПОРЯДОЧИТЬ ПО
	|	Действующие.Ссылка.Дата,
	|	Действующие.Ссылка.Номер";
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(ТекстЗапроса,
		ИмяПоляДокумента,
		ИсточникДанных,
		СтрСоединить(УсловияРегистра, Символы.ПС + "	И "),
		ПолеОрганизация,
		ПолеФизическоеЛицо,
		УсловиеОрганизация);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаПереноса));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Формирует содержимое файла переноса (JSON) по переданным исполнительным листам.
//
// Параметры:
//  Ссылки       - Массив из ДокументСсылка.ИсполнительныйЛист
//  ДатаПереноса - Дата
//
// Возвращаемое значение:
//  Строка
//
Функция ВыгрузитьДокументы(Ссылки, ДатаПереноса) Экспорт
	
	КэшОписанийСсылок = Новый Соответствие;
	ОписанияДокументов = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		ОписанияДокументов.Добавить(ОписаниеДокумента(Ссылка, КэшОписанийСсылок));
	КонецЦикла;
	
	Пакет = Новый Структура;
	Пакет.Вставить("Формат", ИмяФормата());
	Пакет.Вставить("ВерсияФормата", ВерсияФормата());
	Пакет.Вставить("Конфигурация", СтрШаблон("%1 %2", Метаданные.Синоним, Метаданные.Версия));
	Пакет.Вставить("ДатаВыгрузки", XMLСтрока(ТекущаяДатаСеанса()));
	Пакет.Вставить("ДатаПереноса", XMLСтрока(НачалоДня(ДатаПереноса)));
	Пакет.Вставить("Документы", ОписанияДокументов);
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Пакет);
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Читает и проверяет содержимое файла переноса.
//
// Параметры:
//  Текст - Строка - содержимое файла.
//
// Возвращаемое значение:
//  Соответствие - пакет переноса.
//
Функция ПрочитатьПакет(Знач Текст) Экспорт
	
	Если СтрНачинаетсяС(Текст, Символ(65279)) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Пакет = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось прочитать файл переноса: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Чтение.Закрыть();
	
	Если ТипЗнч(Пакет) <> Тип("Соответствие") Или Пакет.Получить("Формат") <> ИмяФормата() Тогда
		ВызватьИсключение НСтр("ru = 'Файл не является файлом переноса исполнительных листов.'");
	КонецЕсли;
	Если ТипЗнч(Пакет.Получить("Документы")) <> Тип("Массив") Тогда
		Пакет.Вставить("Документы", Новый Массив);
	КонецЕсли;
	
	Возврат Пакет;
	
КонецФункции

// Возвращает краткие сведения о документах пакета для отображения пользователю.
//
// Параметры:
//  Пакет - Соответствие - см. ПрочитатьПакет.
//
// Возвращаемое значение:
//  Массив из Структура - УИД, Представление, Организация, ФизическоеЛицо, ЕстьВБазе.
//
Функция СводкаПакета(Пакет) Экспорт
	
	ПолноеИмяДокумента = Метаданные.Документы.ИсполнительныйЛист.ПолноеИмя();
	
	Результат = Новый Массив;
	Для Каждого ОписаниеДокумента Из Пакет.Получить("Документы") Цикл
		УИД = ОписаниеДокумента.Получить("УИД");
		Ссылка = Документы.ИсполнительныйЛист.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		
		Сведения = Новый Структура;
		Сведения.Вставить("УИД", УИД);
		Сведения.Вставить("Представление", ОписаниеДокумента.Получить("Представление"));
		Сведения.Вставить("Организация", ПредставлениеРеквизита(ОписаниеДокумента, "Организация"));
		Сведения.Вставить("ФизическоеЛицо", ПредставлениеРеквизита(ОписаниеДокумента, "ФизическоеЛицо"));
		Сведения.Вставить("ЕстьВБазе", СсылкаСуществует(Ссылка, ПолноеИмяДокумента));
		Результат.Добавить(Сведения);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает (обновляет) исполнительные листы в текущей информационной базе по данным пакета.
//
// Параметры:
//  Пакет     - Соответствие - см. ПрочитатьПакет.
//  УИДы      - Массив из Строка - идентификаторы документов пакета, которые нужно загрузить.
//  Настройки - Структура:
//   * ПроводитьДокументы    - Булево - проводить документы, проведенные в источнике.
//   * СохранятьНомера       - Булево - переносить номера документов из источника.
//   * ОбновлятьСуществующие - Булево - перезаписывать документы, перенесенные ранее.
//
// Возвращаемое значение:
//  Структура:
//   * Протокол         - Соответствие - УИД -> Структура (Результат, Сообщение).
//   * Несопоставленные - Массив из Структура - Тип, Представление, УИД, Количество.
//
Функция ЗагрузитьДокументы(Пакет, УИДы, Настройки) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("Настройки", Настройки);
	Контекст.Вставить("КэшСсылок", Новый Соответствие);
	Контекст.Вставить("Несопоставленные", Новый Соответствие);
	Контекст.Вставить("Замечания", Новый Массив);
	
	Протокол = Новый Соответствие;
	Для Каждого ОписаниеДокумента Из Пакет.Получить("Документы") Цикл
		УИД = ОписаниеДокумента.Получить("УИД");
		Если УИДы.Найти(УИД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Контекст.Замечания = Новый Массив;
		Попытка
			Результат = ЗагрузитьДокумент(ОписаниеДокумента, Контекст);
		Исключение
			ОписаниеОшибки = ИнформацияОбОшибке();
			Результат = НСтр("ru = 'Ошибка'");
			Контекст.Замечания.Добавить(КраткоеПредставлениеОшибки(ОписаниеОшибки));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Перенос исполнительных листов'"),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ИсполнительныйЛист,
				ОписаниеДокумента.Получить("Представление"),
				ПодробноеПредставлениеОшибки(ОписаниеОшибки));
		КонецПопытки;
		
		Протокол.Вставить(УИД, Новый Структура("Результат, Сообщение",
			Результат, СтрСоединить(Контекст.Замечания, Символы.ПС)));
	КонецЦикла;
	
	Несопоставленные = Новый Массив;
	Для Каждого КлючИЗначение Из Контекст.Несопоставленные Цикл
		Несопоставленные.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат Новый Структура("Протокол, Несопоставленные", Протокол, Несопоставленные);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтборПоРегиструПлановыеУдержания

Функция ИмяПоляИсполнительногоЛиста(МДРегистра)
	
	ТипДокумента = Тип("ДокументСсылка.ИсполнительныйЛист");
	ИмяНайденногоПоля = "";
	
	Для Каждого КоллекцияПолей Из КоллекцииПолейРегистра(МДРегистра) Цикл
		Для Каждого МДПоле Из КоллекцияПолей Цикл
			Если Не МДПоле.Тип.СодержитТип(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;
			Если МДПоле.Имя = "ДокументОснование" Тогда
				Возврат МДПоле.Имя;
			КонецЕсли;
			Если ПустаяСтрока(ИмяНайденногоПоля) Тогда
				ИмяНайденногоПоля = МДПоле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ИмяНайденногоПоля;
	
КонецФункции

Функция ЕстьБулевоПолеРегистра(МДРегистра, ИмяПоля)
	
	Для Каждого КоллекцияПолей Из КоллекцииПолейРегистра(МДРегистра) Цикл
		МДПоле = КоллекцияПолей.Найти(ИмяПоля);
		Если МДПоле <> Неопределено Тогда
			Возврат МДПоле.Тип.Типы().Количество() = 1 И МДПоле.Тип.СодержитТип(Тип("Булево"));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция КоллекцииПолейРегистра(МДРегистра)
	
	Коллекции = Новый Массив;
	Коллекции.Добавить(МДРегистра.Измерения);
	Коллекции.Добавить(МДРегистра.Ресурсы);
	Коллекции.Добавить(МДРегистра.Реквизиты);
	Возврат Коллекции;
	
КонецФункции

#КонецОбласти

#Область Выгрузка

Функция ОписаниеДокумента(Ссылка, КэшОписанийСсылок)
	
	Объект = Ссылка.ПолучитьОбъект();
	МДДокумента = Объект.Метаданные();
	
	Реквизиты = Новый Структура;
	Для Каждого МДРеквизит Из МДДокумента.Реквизиты Цикл
		Реквизиты.Вставить(МДРеквизит.Имя, ЗакодироватьЗначение(Объект[МДРеквизит.Имя], КэшОписанийСсылок));
	КонецЦикла;
	
	ТабличныеЧасти = Новый Структура;
	Для Каждого МДТабличнаяЧасть Из МДДокумента.ТабличныеЧасти Цикл
		Строки = Новый Массив;
		Для Каждого СтрокаТабличнойЧасти Из Объект[МДТабличнаяЧасть.Имя] Цикл
			ДанныеСтроки = Новый Структура;
			Для Каждого МДРеквизит Из МДТабличнаяЧасть.Реквизиты Цикл
				ДанныеСтроки.Вставить(МДРеквизит.Имя,
					ЗакодироватьЗначение(СтрокаТабличнойЧасти[МДРеквизит.Имя], КэшОписанийСсылок));
			КонецЦикла;
			Строки.Добавить(ДанныеСтроки);
		КонецЦикла;
		ТабличныеЧасти.Вставить(МДТабличнаяЧасть.Имя, Строки);
	КонецЦикла;
	
	Описание = Новый Структура;
	Описание.Вставить("УИД", Строка(Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("Представление", Строка(Ссылка));
	Описание.Вставить("Номер", Объект.Номер);
	Описание.Вставить("Дата", XMLСтрока(Объект.Дата));
	Описание.Вставить("Проведен", Объект.Проведен);
	Описание.Вставить("Реквизиты", Реквизиты);
	Описание.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	
	Возврат Описание;
	
КонецФункции

// Значение кодируется структурой с ключом "Т" (вид значения) и, в зависимости от вида,
// ключами "З" (значение), "Мд" (полное имя метаданных), "УИД", "Пред", "Поиск", "Предопределенное", "Пустая".
Функция ЗакодироватьЗначение(Значение, КэшОписанийСсылок, Глубина = 0)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Новый Структура("Т", "Пусто");
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Новый Структура("Т, З", "Строка", Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Новый Структура("Т, З", "Число", Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Новый Структура("Т, З", "Булево", Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Новый Структура("Т, З", "Дата", XMLСтрока(Значение));
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Новый Структура("Т, З", "УИД", Строка(Значение));
	КонецЕсли;
	
	МДЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МДЗначения = Неопределено Тогда
		Возврат Новый Структура("Т", "НеПоддерживается");
	КонецЕсли;
	
	Если Метаданные.Перечисления.Содержит(МДЗначения) Тогда
		Возврат Новый Структура("Т, Мд, З", "Перечисление", МДЗначения.ПолноеИмя(), XMLСтрока(Значение));
	КонецЕсли;
	
	Если Не ЭтоСсылочныйОбъект(МДЗначения) Тогда
		Возврат Новый Структура("Т", "НеПоддерживается");
	КонецЕсли;
	
	Возврат ОписаниеСсылки(Значение, МДЗначения, КэшОписанийСсылок, Глубина);
	
КонецФункции

Функция ОписаниеСсылки(Ссылка, МДСсылки, КэшОписанийСсылок, Глубина)
	
	ПолноеИмя = МДСсылки.ПолноеИмя();
	Если Ссылка.Пустая() Тогда
		Возврат Новый Структура("Т, Мд, Пустая", "Ссылка", ПолноеИмя, Истина);
	КонецЕсли;
	
	Описание = КэшОписанийСсылок.Получить(Ссылка);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	Описание = Новый Структура("Т, Мд, Пустая", "Ссылка", ПолноеИмя, Ложь);
	Описание.Вставить("УИД", Строка(Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("Пред", Строка(Ссылка));
	
	ИмяПредопределенного = ИмяПредопределенного(Ссылка, МДСсылки);
	Если Не ПустаяСтрока(ИмяПредопределенного) Тогда
		Описание.Вставить("Предопределенное", ИмяПредопределенного);
	КонецЕсли;
	
	// Ограничение глубины исключает зацикливание на взаимных ссылках; такие описания не кэшируются,
	// чтобы та же ссылка на меньшей глубине получила полный набор полей поиска.
	Если Глубина >= МаксимальнаяГлубинаПоиска() Тогда
		Возврат Описание;
	КонецЕсли;
	
	Поиск = Новый Структура;
	ПоляПоиска = ПоляПоиска(МДСсылки);
	Если ПоляПоиска.Количество() > 0 Тогда
		ЗначенияПолей = ЗначенияПолейСсылки(Ссылка, ПолноеИмя, ПоляПоиска);
		Для Каждого ИмяПоля Из ПоляПоиска Цикл
			Поиск.Вставить(ИмяПоля, ЗакодироватьЗначение(ЗначенияПолей[ИмяПоля], КэшОписанийСсылок, Глубина + 1));
		КонецЦикла;
	КонецЕсли;
	Описание.Вставить("Поиск", Поиск);
	
	КэшОписанийСсылок.Вставить(Ссылка, Описание);
	Возврат Описание;
	
КонецФункции

Функция ИмяПредопределенного(Ссылка, МДСсылки)
	
	Если Не (Метаданные.Справочники.Содержит(МДСсылки)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(МДСсылки)
		Или Метаданные.ПланыВидовРасчета.Содержит(МДСсылки)
		Или Метаданные.ПланыСчетов.Содержит(МДСсылки)) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Если Ссылка.Предопределенный Тогда
			Возврат Ссылка.ИмяПредопределенныхДанных;
		КонецЕсли;
	Исключение
		// Битая ссылка или устаревший режим совместимости - сопоставление по другим правилам.
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Функция ЗначенияПолейСсылки(Ссылка, ПолноеИмя, ПоляПоиска)
	
	Результат = Новый Структура;
	ТекстыПолей = Новый Массив;
	Для Каждого ИмяПоля Из ПоляПоиска Цикл
		Результат.Вставить(ИмяПоля, Неопределено);
		ТекстыПолей.Добавить(СтрШаблон("Т.%1 КАК %1", ИмяПоля));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ %1 ИЗ %2 КАК Т ГДЕ Т.Ссылка = &Ссылка",
		СтрСоединить(ТекстыПолей, ", "), ПолноеИмя);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Загрузка

Функция ЗагрузитьДокумент(ОписаниеДокумента, Контекст)
	
	Настройки = Контекст.Настройки;
	МДДокумента = Метаданные.Документы.ИсполнительныйЛист;
	
	Ссылка = Документы.ИсполнительныйЛист.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ОписаниеДокумента.Получить("УИД")));
	
	Если СсылкаСуществует(Ссылка, МДДокумента.ПолноеИмя()) Тогда
		Если Не Настройки.ОбновлятьСуществующие Тогда
			Возврат НСтр("ru = 'Пропущен: уже есть в базе'");
		КонецЕсли;
		Объект = Ссылка.ПолучитьОбъект();
		ЭтоНовый = Ложь;
	Иначе
		Объект = Документы.ИсполнительныйЛист.СоздатьДокумент();
		Объект.УстановитьСсылкуНового(Ссылка);
		Попытка
			Объект.Заполнить(Неопределено);
		Исключение
			Контекст.Замечания.Добавить(СтрШаблон(НСтр("ru = 'Не выполнено заполнение по умолчанию: %1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		ЭтоНовый = Истина;
	КонецЕсли;
	БылПроведен = Объект.Проведен;
	
	Объект.Дата = XMLЗначение(Тип("Дата"), ОписаниеДокумента.Получить("Дата"));
	Если Настройки.СохранятьНомера Тогда
		Объект.Номер = ОписаниеДокумента.Получить("Номер");
	КонецЕсли;
	
	ЗаполнитьРеквизиты(Объект, МДДокумента.Реквизиты, ОписаниеДокумента.Получить("Реквизиты"), Контекст, "");
	
	ТабличныеЧасти = ОписаниеДокумента.Получить("ТабличныеЧасти");
	Если ТипЗнч(ТабличныеЧасти) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из ТабличныеЧасти Цикл
			ИмяТабличнойЧасти = КлючИЗначение.Ключ;
			МДТабличнаяЧасть = МДДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
			Если МДТабличнаяЧасть = Неопределено Тогда
				Если КлючИЗначение.Значение.Количество() > 0 Тогда
					Контекст.Замечания.Добавить(СтрШаблон(
						НСтр("ru = 'Табличная часть ""%1"" отсутствует в документе приемника, данные не перенесены.'"),
						ИмяТабличнойЧасти));
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
			ТабличнаяЧасть.Очистить();
			Для Каждого ДанныеСтроки Из КлючИЗначение.Значение Цикл
				ЗаполнитьРеквизиты(ТабличнаяЧасть.Добавить(), МДТабличнаяЧасть.Реквизиты, ДанныеСтроки,
					Контекст, ИмяТабличнойЧасти + ".");
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Действие = ?(ЭтоНовый, НСтр("ru = 'Создан'"), НСтр("ru = 'Обновлен'"));
	
	Проводить = Настройки.ПроводитьДокументы И ОписаниеДокумента.Получить("Проведен") = Истина;
	Если Проводить Или БылПроведен Тогда
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			ДобавитьСообщенияПользователю(Контекст);
			Возврат СтрШаблон(НСтр("ru = '%1 и проведен'"), Действие);
		Исключение
			Контекст.Замечания.Добавить(СтрШаблон(НСтр("ru = 'Документ не проведен: %1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			ДобавитьСообщенияПользователю(Контекст);
		КонецПопытки;
	КонецЕсли;
	
	Объект.Записать(?(БылПроведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись));
	ДобавитьСообщенияПользователю(Контекст);
	
	Возврат СтрШаблон(НСтр("ru = '%1, не проведен'"), Действие);
	
КонецФункции

Процедура ЗаполнитьРеквизиты(Приемник, МДРеквизиты, Данные, Контекст, ПрефиксИмени)
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Данные Цикл
		ИмяРеквизита = КлючИЗначение.Ключ;
		КодЗначения = КлючИЗначение.Значение;
		
		Если МДРеквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Если ЗакодированоЗаполненноеЗначение(КодЗначения) Тогда
				Контекст.Замечания.Добавить(СтрШаблон(
					НСтр("ru = 'Реквизит ""%1"" отсутствует в документе приемника, значение ""%2"" не перенесено.'"),
					ПрефиксИмени + ИмяРеквизита, ПредставлениеКода(КодЗначения)));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(КодЗначения) <> Тип("Соответствие") Или КодЗначения.Получить("Т") = "НеПоддерживается" Тогда
			Продолжить;
		КонецЕсли;
		
		Сопоставлено = Истина;
		Значение = РаскодироватьЗначение(КодЗначения, Контекст, Сопоставлено);
		Если Сопоставлено Тогда
			Приемник[ИмяРеквизита] = Значение;
		Иначе
			Контекст.Замечания.Добавить(СтрШаблон(
				НСтр("ru = 'Не найдено значение реквизита ""%1"": %2'"),
				ПрефиксИмени + ИмяРеквизита, ПредставлениеКода(КодЗначения)));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  Сопоставлено - Булево - возвращаемый параметр: Ложь, если непустое значение источника не найдено в приемнике.
Функция РаскодироватьЗначение(КодЗначения, Контекст, Сопоставлено)
	
	Сопоставлено = Истина;
	Если ТипЗнч(КодЗначения) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидЗначения = КодЗначения.Получить("Т");
	Если ВидЗначения = "Строка" Или ВидЗначения = "Число" Или ВидЗначения = "Булево" Тогда
		Возврат КодЗначения.Получить("З");
	ИначеЕсли ВидЗначения = "Дата" Тогда
		Возврат XMLЗначение(Тип("Дата"), КодЗначения.Получить("З"));
	ИначеЕсли ВидЗначения = "УИД" Тогда
		Возврат Новый УникальныйИдентификатор(КодЗначения.Получить("З"));
	ИначеЕсли ВидЗначения = "Перечисление" Тогда
		Возврат ЗначениеПеречисления(КодЗначения, Контекст, Сопоставлено);
	ИначеЕсли ВидЗначения = "Ссылка" Тогда
		Возврат НайтиСсылку(КодЗначения, Контекст, Сопоставлено);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗначениеПеречисления(КодЗначения, Контекст, Сопоставлено)
	
	ПолноеИмя = КодЗначения.Получить("Мд");
	ИмяЗначения = Строка(КодЗначения.Получить("З"));
	
	МДПеречисления = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МДПеречисления = Неопределено Или Не Метаданные.Перечисления.Содержит(МДПеречисления) Тогда
		Если Не ПустаяСтрока(ИмяЗначения) Тогда
			Сопоставлено = Ложь;
			ЗарегистрироватьНесопоставленное(Контекст, ПолноеИмя, ИмяЗначения, "");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	МенеджерПеречисления = Перечисления[МДПеречисления.Имя];
	Если ПустаяСтрока(ИмяЗначения) Тогда
		Возврат МенеджерПеречисления.ПустаяСсылка();
	КонецЕсли;
	
	Если МДПеречисления.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Сопоставлено = Ложь;
		ЗарегистрироватьНесопоставленное(Контекст, ПолноеИмя, ИмяЗначения, "");
		Возврат МенеджерПеречисления.ПустаяСсылка();
	КонецЕсли;
	
	Возврат МенеджерПеречисления[ИмяЗначения];
	
КонецФункции

Функция НайтиСсылку(КодЗначения, Контекст, Сопоставлено)
	
	ПолноеИмя = КодЗначения.Получить("Мд");
	ЭтоПустая = (КодЗначения.Получить("Пустая") = Истина);
	
	МДСсылки = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МДСсылки = Неопределено Или Не ЭтоСсылочныйОбъект(МДСсылки) Тогда
		Если Не ЭтоПустая Тогда
			Сопоставлено = Ложь;
			ЗарегистрироватьНесопоставленное(Контекст, ПолноеИмя,
				КодЗначения.Получить("Пред"), КодЗначения.Получить("УИД"));
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = МенеджерОбъекта(МДСсылки);
	Если ЭтоПустая Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	
	КлючКэша = ПолноеИмя + "|" + КодЗначения.Получить("УИД");
	Найденная = Контекст.КэшСсылок.Получить(КлючКэша);
	Если Найденная = Неопределено Тогда
		Найденная = НайтиСсылкуВБазе(КодЗначения, МДСсылки, Менеджер, Контекст);
		Если Найденная = Неопределено Тогда
			Найденная = Менеджер.ПустаяСсылка();
		КонецЕсли;
		Контекст.КэшСсылок.Вставить(КлючКэша, Найденная);
	КонецЕсли;
	
	Если Найденная.Пустая() Тогда
		Сопоставлено = Ложь;
		ЗарегистрироватьНесопоставленное(Контекст, ПолноеИмя,
			КодЗначения.Получить("Пред"), КодЗначения.Получить("УИД"));
	КонецЕсли;
	
	Возврат Найденная;
	
КонецФункции

Функция НайтиСсылкуВБазе(КодЗначения, МДСсылки, Менеджер, Контекст)
	
	ПолноеИмя = МДСсылки.ПолноеИмя();
	
	Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(КодЗначения.Получить("УИД")));
	Если СсылкаСуществует(Ссылка, ПолноеИмя) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	ИмяПредопределенного = КодЗначения.Получить("Предопределенное");
	Если ЗначениеЗаполнено(ИмяПредопределенного) Тогда
		Попытка
			Возврат ПредопределенноеЗначение(ПолноеИмя + "." + ИмяПредопределенного);
		Исключение
			// В приемнике нет такого предопределенного элемента - ищем по правилам.
		КонецПопытки;
	КонецЕсли;
	
	Возврат НайтиСсылкуПоПравилам(МДСсылки, КодЗначения.Получить("Поиск"), Контекст);
	
КонецФункции

Функция НайтиСсылкуПоПравилам(МДСсылки, Поиск, Контекст)
	
	Если ТипЗнч(Поиск) <> Тип("Соответствие") Или Поиск.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Правило Из ПравилаПоиска(МДСсылки) Цикл
		Отбор = Новый Структура;
		Применимо = Истина;
		Для Каждого ИмяПоля Из ПоляПравила(Правило) Цикл
			КодЗначения = Поиск.Получить(ИмяПоля);
			Если КодЗначения = Неопределено Или Не ЕстьПоле(МДСсылки, ИмяПоля) Тогда
				Применимо = Ложь;
				Прервать;
			КонецЕсли;
			ЗначениеСопоставлено = Истина;
			Значение = РаскодироватьЗначение(КодЗначения, Контекст, ЗначениеСопоставлено);
			Если Не ЗначениеСопоставлено Или Не ЗначениеЗаполнено(Значение) Тогда
				Применимо = Ложь;
				Прервать;
			КонецЕсли;
			Отбор.Вставить(ИмяПоля, Значение);
		КонецЦикла;
		
		Если Не Применимо Тогда
			Продолжить;
		КонецЕсли;
		
		Найденные = НайтиСсылкиПоОтбору(МДСсылки, Отбор);
		Если Найденные.Количество() = 1 Тогда
			Возврат Найденные[0];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиСсылкиПоОтбору(МДСсылки, Отбор)
	
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Условия.Добавить("НЕ Т.ПометкаУдаления");
	Если ЭтоИерархияГруппИЭлементов(МДСсылки) Тогда
		Условия.Добавить("НЕ Т.ЭтоГруппа");
	КонецЕсли;
	Для Каждого КлючИЗначение Из Отбор Цикл
		Условия.Добавить(СтрШаблон("Т.%1 = &%1", КлючИЗначение.Ключ));
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ %2",
		МДСсылки.ПолноеИмя(), СтрСоединить(Условия, " И "));
	
	Попытка
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Исключение
		// Поле несравнимого типа (например, строка неограниченной длины) - правило не применяется.
		Возврат Новый Массив;
	КонецПопытки;
	
КонецФункции

Процедура ЗарегистрироватьНесопоставленное(Контекст, ПолноеИмя, Представление, УИД)
	
	Ключ = Строка(ПолноеИмя) + "|" + Строка(УИД) + "|" + Строка(Представление);
	Запись = Контекст.Несопоставленные.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Запись = Новый Структура("Тип, Представление, УИД, Количество",
			Строка(ПолноеИмя), Строка(Представление), Строка(УИД), 0);
		Контекст.Несопоставленные.Вставить(Ключ, Запись);
	КонецЕсли;
	Запись.Количество = Запись.Количество + 1;
	
КонецПроцедуры

Процедура ДобавитьСообщенияПользователю(Контекст)
	
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Контекст.Замечания.Добавить(Сообщение.Текст);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗакодированоЗаполненноеЗначение(КодЗначения)
	
	Если ТипЗнч(КодЗначения) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидЗначения = КодЗначения.Получить("Т");
	Если ВидЗначения = "Ссылка" Тогда
		Возврат КодЗначения.Получить("Пустая") <> Истина;
	ИначеЕсли ВидЗначения = "Дата" Тогда
		Возврат ЗначениеЗаполнено(XMLЗначение(Тип("Дата"), КодЗначения.Получить("З")));
	ИначеЕсли ВидЗначения = "Строка" Или ВидЗначения = "Число" Или ВидЗначения = "Булево"
		Или ВидЗначения = "Перечисление" Или ВидЗначения = "УИД" Тогда
		Возврат ЗначениеЗаполнено(КодЗначения.Получить("З"));
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПредставлениеКода(КодЗначения)
	
	Если ТипЗнч(КодЗначения) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	
	ВидЗначения = КодЗначения.Получить("Т");
	Если ВидЗначения = "Ссылка" Тогда
		Возврат СтрШаблон("%1 (%2)", КодЗначения.Получить("Пред"), КодЗначения.Получить("Мд"));
	ИначеЕсли ВидЗначения = "Перечисление" Тогда
		Возврат СтрШаблон("%1.%2", КодЗначения.Получить("Мд"), КодЗначения.Получить("З"));
	КонецЕсли;
	
	Возврат Строка(КодЗначения.Получить("З"));
	
КонецФункции

Функция ПредставлениеРеквизита(ОписаниеДокумента, ИмяРеквизита)
	
	Реквизиты = ОписаниеДокумента.Получить("Реквизиты");
	Если ТипЗнч(Реквизиты) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	
	КодЗначения = Реквизиты.Получить(ИмяРеквизита);
	Если ТипЗнч(КодЗначения) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	
	Если КодЗначения.Получить("Т") = "Ссылка" Тогда
		Возврат Строка(КодЗначения.Получить("Пред"));
	КонецЕсли;
	
	Возврат Строка(КодЗначения.Получить("З"));
	
КонецФункции

#КонецОбласти

#Область ПравилаПоиска

// Правила сопоставления ссылок, если объект не найден по уникальному идентификатору.
// Одни и те же правила используются при выгрузке (какие поля выгрузить) и при загрузке (как искать).
Процедура ИнициализироватьПравилаПоиска()
	
	ПравилаПоискаСсылок = Новый Соответствие;
	
	ДобавитьПравилоПоиска("Справочник.Организации", "ИНН, КПП; ИНН; Наименование");
	ДобавитьПравилоПоиска("Справочник.Контрагенты", "ИНН, КПП; ИНН; Наименование");
	ДобавитьПравилоПоиска("Справочник.ФизическиеЛица", "ИНН; СтраховойНомерПФР; Наименование, ДатаРождения; Наименование");
	ДобавитьПравилоПоиска("Справочник.Сотрудники",
		"ФизическоеЛицо, ГоловнаяОрганизация, Код; ФизическоеЛицо, ГоловнаяОрганизация; ФизическоеЛицо; Код, Наименование");
	ДобавитьПравилоПоиска("Справочник.БанковскиеСчетаКонтрагентов", "Владелец, НомерСчета; НомерСчета");
	ДобавитьПравилоПоиска("Справочник.БанковскиеСчетаОрганизаций", "Владелец, НомерСчета; НомерСчета");
	ДобавитьПравилоПоиска("Справочник.КлассификаторБанков", "Код; Наименование");
	ДобавитьПравилоПоиска("Справочник.Пользователи", "Наименование");
	ДобавитьПравилоПоиска("Справочник.ПодразделенияОрганизаций", "Владелец, Наименование");
	ДобавитьПравилоПоиска("ПланВидовРасчета.Удержания",
		"Наименование, КатегорияУдержания; Наименование; КатегорияУдержания");
	
	ДобавитьПравилоПоиска("*", "Код, Наименование; Наименование");
	
КонецПроцедуры

Процедура ДобавитьПравилоПоиска(ПолноеИмя, ТекстПравил)
	
	ПравилаПоискаСсылок.Вставить(ПолноеИмя, СтрРазделить(ТекстПравил, ";", Ложь));
	
КонецПроцедуры

Функция ПравилаПоиска(МДСсылки)
	
	Если ПравилаПоискаСсылок = Неопределено Тогда
		ИнициализироватьПравилаПоиска();
	КонецЕсли;
	
	Правила = ПравилаПоискаСсылок.Получить(МДСсылки.ПолноеИмя());
	Если Правила <> Неопределено Тогда
		Возврат Правила;
	КонецЕсли;
	
	// Документы, задачи, бизнес-процессы и узлы обмена сопоставляются только по уникальному идентификатору.
	Если Метаданные.Документы.Содержит(МДСсылки)
		Или Метаданные.Задачи.Содержит(МДСсылки)
		Или Метаданные.БизнесПроцессы.Содержит(МДСсылки)
		Или Метаданные.ПланыОбмена.Содержит(МДСсылки) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат ПравилаПоискаСсылок.Получить("*");
	
КонецФункции

Функция ПоляПравила(Правило)
	
	Поля = Новый Массив;
	Для Каждого ИмяПоля Из СтрРазделить(Правило, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(ИмяПоля);
		Если Не ПустаяСтрока(ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;
	
КонецФункции

Функция ПоляПоиска(МДСсылки)
	
	Поля = Новый Массив;
	Для Каждого Правило Из ПравилаПоиска(МДСсылки) Цикл
		Для Каждого ИмяПоля Из ПоляПравила(Правило) Цикл
			Если Поля.Найти(ИмяПоля) = Неопределено И ЕстьПоле(МДСсылки, ИмяПоля) Тогда
				Поля.Добавить(ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Поля;
	
КонецФункции

Функция МаксимальнаяГлубинаПоиска()
	
	Возврат 2;
	
КонецФункции

#КонецОбласти

#Область Метаданные

Функция ЕстьПоле(МДОбъекта, ИмяПоля)
	
	Попытка
		Если МДОбъекта.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Если ИмяПоля = "Код" Тогда
			Возврат МДОбъекта.ДлинаКода > 0;
		ИначеЕсли ИмяПоля = "Наименование" Тогда
			Возврат МДОбъекта.ДлинаНаименования > 0;
		ИначеЕсли ИмяПоля = "Владелец" Тогда
			Возврат МДОбъекта.Владельцы.Количество() > 0;
		ИначеЕсли ИмяПоля = "Родитель" Тогда
			Возврат МДОбъекта.Иерархический;
		ИначеЕсли ИмяПоля = "Номер" Или ИмяПоля = "Дата" Тогда
			Возврат Метаданные.Документы.Содержит(МДОбъекта);
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоИерархияГруппИЭлементов(МДОбъекта)
	
	Если Метаданные.Справочники.Содержит(МДОбъекта) Тогда
		Возврат МДОбъекта.Иерархический
			И МДОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МДОбъекта) Тогда
		Возврат МДОбъекта.Иерархический;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоСсылочныйОбъект(МДОбъекта)
	
	Возврат Метаданные.Справочники.Содержит(МДОбъекта)
		Или Метаданные.Документы.Содержит(МДОбъекта)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(МДОбъекта)
		Или Метаданные.ПланыВидовРасчета.Содержит(МДОбъекта)
		Или Метаданные.ПланыСчетов.Содержит(МДОбъекта)
		Или Метаданные.ПланыОбмена.Содержит(МДОбъекта)
		Или Метаданные.БизнесПроцессы.Содержит(МДОбъекта)
		Или Метаданные.Задачи.Содержит(МДОбъекта);
	
КонецФункции

Функция МенеджерОбъекта(МДОбъекта)
	
	Имя = МДОбъекта.Имя;
	Если Метаданные.Справочники.Содержит(МДОбъекта) Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Метаданные.Документы.Содержит(МДОбъекта) Тогда
		Возврат Документы[Имя];
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МДОбъекта) Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МДОбъекта) Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МДОбъекта) Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(МДОбъекта) Тогда
		Возврат ПланыОбмена[Имя];
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(МДОбъекта) Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Метаданные.Задачи.Содержит(МДОбъекта) Тогда
		Возврат Задачи[Имя];
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(НСтр("ru = 'Неподдерживаемый тип объекта: %1'"), МДОбъекта.ПолноеИмя());
	
КонецФункции

Функция СсылкаСуществует(Ссылка, ПолноеИмя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК Есть ИЗ %1 КАК Т ГДЕ Т.Ссылка = &Ссылка", ПолноеИмя);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ИмяФормата()
	
	Возврат "ПереносИсполнительныхЛистов";
	
КонецФункции

Функция ВерсияФормата()
	
	Возврат "1.0";
	
