#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ДатаПереноса = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	ПроводитьДокументы = Истина;
	Протокол =
		"1. Откройте обработку в ЗУП и выгрузите файл." + Символы.ПС
		+ "2. Откройте эту же обработку в ERP и загрузите полученный файл.";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)

	Попытка
		Результат = ВыгрузитьНаСервере();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранение исполнительных листов";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json";
	Диалог.ПолноеИмяФайла =
		"ИсполнительныеЛисты_"
		+ Формат(ДатаПереноса, "ДФ=yyyyMMdd")
		+ ".json";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Запись = Новый ЗаписьТекста(Диалог.ПолноеИмяФайла, КодировкаТекста.UTF8);
		Запись.Записать(Результат.Данные);
		Запись.Закрыть();
		Протокол = "Выгружено документов: " + Формат(Результат.Количество, "ЧГ=0")
			+ Символы.ПС + "Файл: " + Диалог.ПолноеИмяФайла;
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выбор файла исполнительных листов";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(Диалог.ПолноеИмяФайла, КодировкаТекста.UTF8);
		Данные = Чтение.Прочитать();
		Чтение.Закрыть();
		Результат = ЗагрузитьНаСервере(Данные);
		Протокол =
			"Создано: " + Формат(Результат.Создано, "ЧГ=0")
			+ "; пропущено: " + Формат(Результат.Пропущено, "ЧГ=0")
			+ "; ошибок: " + Формат(Результат.Ошибок, "ЧГ=0")
			+ Символы.ПС + СтрСоединить(Результат.Протокол, Символы.ПС);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

&НаСервере
Функция ВыгрузитьНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ВыгрузитьИсполнительныеЛисты(ДатаПереноса);

КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(Данные)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗагрузитьИсполнительныеЛисты(Данные, ПроводитьДокументы);

КонецФункции

#КонецОбласти
