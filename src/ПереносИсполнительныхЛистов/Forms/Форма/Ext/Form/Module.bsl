#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаПереноса = НачалоДня(ТекущаяДатаСеанса());
	ПроводитьДокументы = Истина;
	СохранятьНомера = Истина;
	ОбновлятьСуществующие = Ложь;
	
	Если СтрНайти(Метаданные.Имя, "ЗарплатаИУправлениеПерсоналом") > 0 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаВыгрузка;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗагрузка;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаПереноса) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату, на которую удержания должны действовать.'"));
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСписокНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Если КоличествоОтмеченных(ДокументыКВыгрузке) = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного исполнительного листа.'"));
		Возврат;
	КонецЕсли;
	
	Адрес = ВыгрузитьВФайлНаСервере();
	ИмяФайла = СтрШаблон("ИсполнительныеЛисты_%1.json", Формат(ДатаПереноса, "ДФ=yyyyMMdd"));
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'Файл переноса (*.json)|*.json|Все файлы (*.*)|*.*'");
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Выберите файл, выгруженный из ЗУП'");
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(
		Новый ОписаниеОповещения("ПрочитатьФайлЗавершение", ЭтотОбъект), ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если ПустаяСтрока(АдресПакета) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала откройте файл переноса.'"));
		Возврат;
	КонецЕсли;
	
	Если КоличествоОтмеченных(ДокументыКЗагрузке) = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного исполнительного листа.'"));
		Возврат;
	КонецЕсли;
	
	ЗагрузитьНаСервере();
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Перенос исполнительных листов'"), ,
		НСтр("ru = 'Загрузка завершена. Результат по каждому документу - в колонке ""Результат"".'"));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиВыгрузка(Команда)
	
	УстановитьПометку(ДокументыКВыгрузке, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиВыгрузка(Команда)
	
	УстановитьПометку(ДокументыКВыгрузке, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиЗагрузка(Команда)
	
	УстановитьПометку(ДокументыКЗагрузке, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиЗагрузка(Команда)
	
	УстановитьПометку(ДокументыКЗагрузке, Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ДокументыКВыгрузке.Загрузить(Обработка.ДокументыДействующиеНаДату(ДатаПереноса, Организация));
	
	Если ДокументыКВыгрузке.Количество() = 0 Тогда
		СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'На %1 нет действующих исполнительных листов по регистру ""Плановые удержания"".'"),
			Формат(ДатаПереноса, "ДЛФ=D")));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьВФайлНаСервере()
	
	Ссылки = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДокументыКВыгрузке Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Ссылки.Добавить(СтрокаТаблицы.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Текст = Обработка.ВыгрузитьДокументы(Ссылки, ДатаПереноса);
	
	Возврат ПоместитьВоВременноеХранилище(
		ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8), УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ПрочитатьФайлЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПрочитатьФайлНаСервере(ПомещенныйФайл.Хранение, ПомещенныйФайл.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресФайла, ИмяФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Пакет = Обработка.ПрочитатьПакет(Текст);
	
	АдресПакета = ПоместитьВоВременноеХранилище(Пакет, УникальныйИдентификатор);
	
	ДатаПереносаПакета = XMLЗначение(Тип("Дата"), Пакет.Получить("ДатаПереноса"));
	ИнформацияОФайле = СтрШаблон(НСтр("ru = '%1: %2, действующие на %3, документов: %4'"),
		ИмяФайла,
		Пакет.Получить("Конфигурация"),
		Формат(ДатаПереносаПакета, "ДЛФ=D"),
		Пакет.Получить("Документы").Количество());
	
	ДокументыКЗагрузке.Очистить();
	Несопоставленные.Очистить();
	Для Каждого Сведения Из Обработка.СводкаПакета(Пакет) Цикл
		НоваяСтрока = ДокументыКЗагрузке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Сведения);
		НоваяСтрока.Пометка = Не Сведения.ЕстьВБазе Или ОбновлятьСуществующие;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	Пакет = ПолучитьИзВременногоХранилища(АдресПакета);
	Если Пакет = Неопределено Тогда
		АдресПакета = "";
		СообщитьПользователю(НСтр("ru = 'Данные файла больше не доступны. Откройте файл переноса повторно.'"));
		Возврат;
	КонецЕсли;
	
	УИДы = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДокументыКЗагрузке Цикл
		Если СтрокаТаблицы.Пометка Тогда
			УИДы.Добавить(СтрокаТаблицы.УИД);
		КонецЕсли;
	КонецЦикла;
	
	Настройки = Новый Структура;
	Настройки.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	Настройки.Вставить("СохранятьНомера", СохранятьНомера);
	Настройки.Вставить("ОбновлятьСуществующие", ОбновлятьСуществующие);
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ЗагрузитьДокументы(Пакет, УИДы, Настройки);
	
	ЕстьВБазе = Новый Соответствие;
	Для Каждого Сведения Из Обработка.СводкаПакета(Пакет) Цикл
		ЕстьВБазе.Вставить(Сведения.УИД, Сведения.ЕстьВБазе);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ДокументыКЗагрузке Цикл
		СтрокаТаблицы.ЕстьВБазе = (ЕстьВБазе.Получить(СтрокаТаблицы.УИД) = Истина);
		ЗаписьПротокола = Результат.Протокол.Получить(СтрокаТаблицы.УИД);
		Если ЗаписьПротокола <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаписьПротокола);
			СтрокаТаблицы.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Несопоставленные.Очистить();
	Для Каждого Запись Из Результат.Несопоставленные Цикл
		ЗаполнитьЗначенияСвойств(Несопоставленные.Добавить(), Запись);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченных(Таблица)
	
	Количество = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометку(Таблица, Пометка)
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьПользователю(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
