&НаКлиенте
Перем КонтекстФайла;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Инициализация значений реквизитов по умолчанию
	Если Не ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		Объект.ДатаПереноса = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ФорматФайла) Тогда
		Объект.ФорматФайла = "XML";
	КонецЕсли;

	Объект.ТолькоДействующиеПоДатамДокумента = Истина;
	Объект.ПроводитьДокументы               = Истина;
	Объект.ПерезаписыватьСуществующие       = Ложь;
	Объект.СоздаватьНовыеЭлементыНСИ        = Истина;
	Объект.УстанавливатьИсходныйНомерИДату  = Истина;

	Объект.COM_ТипПодключения  = "Файловый";
	Объект.COM_ВерсияПлатформы = "8.3";

	ОбновитьВидимостьЭлементов();

	ДобавитьЗаписьВЖурналНаСервере(ТекущаяДатаСеанса(), "Информация", 
		"Обработка инициализирована. Укажите дату переноса и нажмите 'Заполнить' для отбора действующих документов.");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьДоступностьЭлементовКлиент();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПереносаПриИзменении(Элемент)
	ПоказатьОповещениеПользователя("Внимание", , "Дата переноса изменена. Для обновления списка нажмите 'Заполнить'.", СтатусОповещенияПользователя.Информация);
КонецПроцедуры

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	ОбновитьВидимостьЭлементов();
	ОбновитьДоступностьЭлементовКлиент();
КонецПроцедуры

&НаКлиенте
Процедура ФорматФайлаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		Расширение = ?(ВРег(Объект.ФорматФайла) = "JSON", ".json", ".xml");
		Точка = Найти(Объект.ПутьКФайлу, ".");
		Если Точка > 0 Тогда
			Объект.ПутьКФайлу = Лев(Объект.ПутьКФайлу, Точка - 1) + Расширение;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура COM_ТипПодключенияПриИзменении(Элемент)
	ОбновитьВидимостьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда: Заполнить список действующих документов по регистру ПлановыеУдержания
&НаКлиенте
Процедура КомандаЗаполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		ПоказатьПредупреждение(, "Укажите дату переноса!");
		Возврат;
	КонецЕсли;

	ЗаполнитьДокументыНаСервере();

КонецПроцедуры

// Команда: Отметить все документы в таблице
&НаКлиенте
Процедура КомандаОтметитьВсе(Команда)
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Стр.Пометка = Истина;
	КонецЦикла;
КонецПроцедуры

// Команда: Снять отметки со всех документов в таблице
&НаКлиенте
Процедура КомандаСнятьОтметки(Команда)
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

// Команда: Выгрузить отмеченные документы в файл XML / JSON
&НаКлиенте
Процедура КомандаВыгрузить(Команда)

	// Проверка наличия строк
	КоличествоОтмеченных = 0;
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Если Стр.Пометка Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных документов для выгрузки! Заполните таблицу и отметьте нужные строки.");
		Возврат;
	КонецЕсли;

	// Если путь к файлу не указан, открываем диалог сохранения
	Если ПустаяСтрока(Объект.ПутьКФайлу) Тогда
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Расширение = ?(ВРег(Объект.ФорматФайла) = "JSON", "json", "xml");
		Диалог.Фильтр = СтрШаблон("Файлы %1 (*.%2)|*.%2|Все файлы (*.*)|*.*", Объект.ФорматФайла, Расширение);
		Диалог.ПолноеИмяФайла = СтрШаблон("Выгрузка_ИсполнительныеЛисты_%1.%2", 
			Формат(Объект.ДатаПереноса, "ДФ=yyyyMMdd"), Расширение);
		Диалог.Заголовок = "Выберите файл для сохранения выгрузки";

		Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаДляВыгрузки", ЭтотОбъект);
		Диалог.Показать(Оповещение);
	Иначе
		ВыполнитьВыгрузкуВФайл(Объект.ПутьКФайлу);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаДляВыгрузки(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Объект.ПутьКФайлу = ВыбранныеФайлы[0];
		ВыполнитьВыгрузкуВФайл(Объект.ПутьКФайлу);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузкуВФайл(Знач ПутьКФайлу)

	Попытка
		КоличествоВыгружено = ВыгрузитьВФайлНаСервере(ПутьКФайлу);
		ТекстСообщения = СтрШаблон("Успешно выгружено документов: %1 в файл '%2'", КоличествоВыгружено, ПутьКФайлу);
		ПоказатьОповещениеПользователя("Выгрузка завершена", , ТекстСообщения, СтатусОповещенияПользователя.Успех);
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Команда: Диалог выбора файла для загрузки
&НаКлиенте
Процедура КомандаВыбратьФайл(Команда)

	РежимДиалога = ?(Объект.РежимРаботы = 0, РежимДиалогаВыбораФайла.Сохранение, РежимДиалогаВыбораФайла.Открытие);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалога);
	Расширение = ?(ВРег(Объект.ФорматФайла) = "JSON", "json", "xml");
	Диалог.Фильтр = "Файлы обмена (*.xml;*.json)|*.xml;*.json|Файлы XML (*.xml)|*.xml|Файлы JSON (*.json)|*.json|Все файлы (*.*)|*.*";
	Диалог.Заголовок = ?(Объект.РежимРаботы = 0, "Выберите файл для сохранения выгрузки", "Выберите файл выгрузки из ЗУП для загрузки");

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Объект.ПутьКФайлу = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

// Команда: Загрузить документы из файла в базу ERP
&НаКлиенте
Процедура КомандаЗагрузить(Команда)

	Если ПустаяСтрока(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Укажите файл для загрузки!");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗагрузки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Начать загрузку документов Исполнительный лист в информационную базу ERP?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗагрузки(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Попытка
		РезультатЗагрузки = ЗагрузитьИзФайлаНаСервере(Объект.ПутьКФайлу);
		ТекстРезультата = СтрШаблон("Загрузка завершена! Всего: %1, Создано: %2, Обновлено: %3, Пропущено: %4, Ошибок: %5",
			РезультатЗагрузки.Всего, РезультатЗагрузки.Создано, РезультатЗагрузки.Обновлено, 
			РезультатЗагрузки.Пропущено, РезультатЗагрузки.Ошибок);
		ПоказатьОповещениеПользователя("Загрузка в ERP завершена", , ТекстРезультата, 
			?(РезультатЗагрузки.Ошибок > 0, СтатусОповещенияПользователя.Важное, СтатусОповещенияПользователя.Успех));
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Команда: Проверить COM-подключение к базе ЗУП
&НаКлиенте
Процедура КомандаПроверитьПодключение(Команда)

	Попытка
		РезультатПроверки = ПроверитьПодключениеНаСервере();
		ПоказатьОповещениеПользователя("COM-подключение", , РезультатПроверки, СтатусОповещенияПользователя.Успех);
	Исключение
		ПоказатьПредупреждение(, "Ошибка подключения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Команда: Выполнить прямой перенос документов через COM-соединение
&НаКлиенте
Процедура КомандаПрямойПеренос(Команда)

	Если Не ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		ПоказатьПредупреждение(, "Укажите дату переноса!");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПрямогоПереноса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Выполнить прямой перенос документов из ЗУП в ERP через COM-соединение?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияПрямогоПереноса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = ВыполнитьПрямойПереносНаСервере();
		Текст = СтрШаблон("Прямой перенос завершен! Всего: %1, Создано: %2, Обновлено: %3, Пропущено: %4, Ошибок: %5",
			Результат.Всего, Результат.Создано, Результат.Обновлено, Результат.Пропущено, Результат.Ошибок);
		ПоказатьОповещениеПользователя("Перенос завершен", , Текст,
			?(Результат.Ошибок > 0, СтатусОповещенияПользователя.Важное, СтатусОповещенияПользователя.Успех));
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Команда: Очистить таблицу журнала сообщений
&НаКлиенте
Процедура КомандаОчиститьЖурнал(Команда)
	Объект.ЖурналСообщений.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСервер

// Заполнение таблицы документов на сервере по регистру ПлановыеУдержания
&НаСервере
Процедура ЗаполнитьДокументыНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаРез = ОбработкаОбъект.ПолучитьТаблицуДокументовПоРегистру(
		Объект.ДатаПереноса, 
		Объект.ОрганизацияОтбор, 
		Объект.СотрудникОтбор, 
		Объект.ТолькоДействующиеПоДатамДокумента
	);

	Объект.ТаблицаДокументов.Загрузить(ТаблицаРез);

	ТекстСообщения = СтрШаблон("По регистру 'ПлановыеУдержания' на дату %1 найдено действующих документов: %2",
		Формат(Объект.ДатаПереноса, "ДФ=dd.MM.yyyy"), Объект.ТаблицаДокументов.Количество());
	ДобавитьЗаписьВЖурналНаСервере(ТекущаяДатаСеанса(), "Информация", ТекстСообщения);

КонецПроцедуры

// Выгрузка в файл на сервере
&НаСервере
Функция ВыгрузитьВФайлНаСервере(Знач ПутьКФайлу)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаВыгрузки = Объект.ТаблицаДокументов.Выгрузить();

	ОбработкаОбъект.ВыгрузитьВФайл(ПутьКФайлу, ТаблицаВыгрузки, Объект.ДатаПереноса, Объект.ФорматФайла);

	КоличествоОтмеченных = 0;
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Если Стр.Пометка Тогда
			Стр.СтатусПереноса = "Выгружен";
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	ДобавитьЗаписьВЖурналНаСервере(ТекущаяДатаСеанса(), "Успех", 
		СтрШаблон("Выгрузка успешно выполнена в файл '%1'. Документов: %2", ПутьКФайлу, КоличествоОтмеченных));

	Возврат КоличествоОтмеченных;

КонецФункции

// Загрузка из файла на сервере
&НаСервере
Функция ЗагрузитьИзФайлаНаСервере(Знач ПутьКФайлу)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ПроводитьДокументы",              Объект.ПроводитьДокументы);
	ПараметрыЗагрузки.Вставить("ПерезаписыватьСуществующие",      Объект.ПерезаписыватьСуществующие);
	ПараметрыЗагрузки.Вставить("СоздаватьНовыеЭлементыНСИ",       Объект.СоздаватьНовыеЭлементыНСИ);
	ПараметрыЗагрузки.Вставить("УстанавливатьИсходныйНомерИДату", Объект.УстанавливатьИсходныйНомерИДату);
	ПараметрыЗагрузки.Вставить("ИспользоватьТранзакцию",          Ложь);

	ПротоколСервер = Новый ТаблицаЗначений;
	ПротоколСервер.Колонки.Добавить("Время", Новый ОписаниеТипов("Дата"));
	ПротоколСервер.Колонки.Добавить("Тип",   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ПротоколСервер.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));

	Результат = ОбработкаОбъект.ЗагрузитьИзФайла(ПутьКФайлу, ПараметрыЗагрузки, ПротоколСервер);

	// Перенос записей протокола в форму
	Для Каждого Стр Из ПротоколСервер Цикл
		ДобавитьЗаписьВЖурналНаСервере(Стр.Время, Стр.Тип, Стр.Текст);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверка подключения COM
&НаСервере
Функция ПроверитьПодключениеНаСервере()

	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("ТипПодключения", Объект.COM_ТипПодключения);
	ПараметрыПодключения.Вставить("КаталогИБ",       Объект.COM_КаталогИБ);
	ПараметрыПодключения.Вставить("Сервер1С",        Объект.COM_Сервер1С);
	ПараметрыПодключения.Вставить("ИмяБазы",         Объект.COM_ИмяБазы);
	ПараметрыПодключения.Вставить("Пользователь",    Объект.COM_Пользователь);
	ПараметрыПодключения.Вставить("Пароль",          Объект.COM_Пароль);

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СтрокаПодключения = ОбработкаОбъект.СформироватьСтрокуПодключения(ПараметрыПодключения);

	COMСоединитель = Новый COMОбъект("V83.COMConnector");
	ВнешняяБаза = COMСоединитель.Connect(СтрокаПодключения);

	ИмяКонфигурации = ВнешняяБаза.Метаданные.Имя;
	СинонимКонфигурации = ВнешняяБаза.Метаданные.Синоним;
	ВерсияКонфигурации = ВнешняяБаза.Метаданные.Версия;

	ВнешняяБаза = Неопределено;
	COMСоединитель = Неопределено;

	ТекстРезультата = СтрШаблон("Подключение успешно установлено к конфигурации: '%1' (%2), релиз %3",
		СинонимКонфигурации, ИмяКонфигурации, ВерсияКонфигурации);
	ДобавитьЗаписьВЖурналНаСервере(ТекущаяДатаСеанса(), "Успех", ТекстРезультата);

	Возврат ТекстРезультата;

КонецФункции

// Выполнение прямого переноса COM
&НаСервере
Функция ВыполнитьПрямойПереносНаСервере()

	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("ТипПодключения", Объект.COM_ТипПодключения);
	ПараметрыПодключения.Вставить("КаталогИБ",       Объект.COM_КаталогИБ);
	ПараметрыПодключения.Вставить("Сервер1С",        Объект.COM_Сервер1С);
	ПараметрыПодключения.Вставить("ИмяБазы",         Объект.COM_ИмяБазы);
	ПараметрыПодключения.Вставить("Пользователь",    Объект.COM_Пользователь);
	ПараметрыПодключения.Вставить("Пароль",          Объект.COM_Пароль);

	ПараметрыПереноса = Новый Структура;
	ПараметрыПереноса.Вставить("ДатаПереноса",                   Объект.ДатаПереноса);
	ПараметрыПереноса.Вставить("ПроводитьДокументы",              Объект.ПроводитьДокументы);
	ПараметрыПереноса.Вставить("ПерезаписыватьСуществующие",      Объект.ПерезаписыватьСуществующие);
	ПараметрыПереноса.Вставить("СоздаватьНовыеЭлементыНСИ",       Объект.СоздаватьНовыеЭлементыНСИ);
	ПараметрыПереноса.Вставить("УстанавливатьИсходныйНомерИДату", Объект.УстанавливатьИсходныйНомерИДату);
	ПараметрыПереноса.Вставить("ИспользоватьТранзакцию",          Ложь);

	ПротоколСервер = Новый ТаблицаЗначений;
	ПротоколСервер.Колонки.Добавить("Время", Новый ОписаниеТипов("Дата"));
	ПротоколСервер.Колонки.Добавить("Тип",   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ПротоколСервер.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ВыполнитьПрямойПереносCOM(ПараметрыПодключения, ПараметрыПереноса, ПротоколСервер);

	Для Каждого Стр Из ПротоколСервер Цикл
		ДобавитьЗаписьВЖурналНаСервере(Стр.Время, Стр.Тип, Стр.Текст);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обновление видимости элементов на сервере
&НаСервере
Процедура ОбновитьВидимостьЭлементов()

	// РежимРаботы: 0 - Выгрузка из ЗУП, 1 - Загрузка в ERP, 2 - Прямой перенос COM
	РежимВыгрузки = (Объект.РежимРаботы = 0);
	РежимЗагрузки = (Объект.РежимРаботы = 1);
	РежимCOM      = (Объект.РежимРаботы = 2);

	Элементы.ГруппаПараметрыОтбора.Видимость   = РежимВыгрузки ИЛИ РежимCOM;
	Элементы.ГруппаТаблицаДокументов.Видимость = РежимВыгрузки;
	Элементы.ГруппаПараметрыФайла.Видимость    = РежимВыгрузки ИЛИ РежимЗагрузки;
	Элементы.ГруппаПараметрыЗагрузки.Видимость = РежимЗагрузки ИЛИ РежимCOM;
	Элементы.ГруппаПараметрыCOM.Видимость      = РежимCOM;

	Если РежимCOM Тогда
		Файловый = (Объект.COM_ТипПодключения = "Файловый");
		Элементы.COM_КаталогИБ.Видимость = Файловый;
		Элементы.COM_Сервер1С.Видимость  = Не Файловый;
		Элементы.COM_ИмяБазы.Видимость   = Не Файловый;
	КонецЕсли;

	// Видимость команд
	Элементы.ФормаКомандаЗаполнить.Видимость   = РежимВыгрузки;
	Элементы.ФормаКомандаВыгрузить.Видимость   = РежимВыгрузки;
	Элементы.ФормаКомандаЗагрузить.Видимость   = РежимЗагрузки;
	Элементы.ФормаКомандаПрямойПеренос.Видимость = РежимCOM;
	Элементы.ФормаКомандаПроверитьПодключение.Видимость = РежимCOM;

КонецПроцедуры

// Добавление строки в журнал сообщений на сервере
&НаСервере
Процедура ДобавитьЗаписьВЖурналНаСервере(Знач Время, Знач Тип, Знач Текст)

	НоваяСтрока = Объект.ЖурналСообщений.Добавить();
	НоваяСтрока.Время = Время;
	НоваяСтрока.Тип   = Тип;
	НоваяСтрока.Текст = Текст;

КонецПроцедуры

